---
import {Image,getImage} from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import CentreNetworkExtras from './CentreNetworkExtras.astro';
import CentreEcosystem from './CentreEcosystem.astro';
import CentreLifePurpose from './CentreLifePurpose.astro';
import {centreTour} from '../../deployment/centre-search-repair/centre-tour.mjs';
import room from '../assets/centre-directory/suchitra-interior-5-2.jpg';
import desk from '../assets/centre-directory/suchitra-interior-5-1.jpg';
import exterior from '../assets/centre-directory/suchitra-exterior-0.jpg';
import emblem from '../assets/centre-directory/suchitra-profile-9.jpg';
import share from '../assets/suchitra-social-20260930.png';
import {suchitra,suchitraContent as content,suchitraEnquiry} from '../data/suchitra-content';
import {phone,url} from '../data/site';
import '../styles/centre-page.css';
const photos=[
 {image:exterior,title:'Recognise the building',alt:'Published Suchitra building photograph showing Pinnacle signage above Mahesh Bank.'},
 {image:room,title:'Activity space',alt:'Published Suchitra interior photograph with colourful mats and activity equipment.'},
 {image:desk,title:'Conversation space',alt:'Published Suchitra interior photograph showing a desk and chairs.'}
];
const gallery=await Promise.all(photos.map(async p=>({...p,full:(await getImage({src:p.image,width:900,format:'webp',quality:87})).src})));
const branchId=url(content.path)+'#centre';
const entityGraph=[{'@type':'LocalBusiness','@id':branchId,name:'Pinnacle Blooms Network – Suchitra',image:url(gallery[0].full),url:url(content.path),telephone:'+919100181181',...(suchitra.directTelephone?{contactPoint:{'@type':'ContactPoint',telephone:suchitra.directTelephone,contactType:'local centre enquiries'}}:{}),email:'care@pinnacleblooms.org',parentOrganization:{'@id':url('/verify/#organization')},brand:{'@id':url('/verify/#pinnacle-brand')},address:{'@type':'PostalAddress',streetAddress:'Adjacent to Municipal Park and Mee Seva, above Mahesh Bank, Suchitra Circle, Bowenpally',addressLocality:'Hyderabad',addressRegion:'Telangana',postalCode:'500067',addressCountry:'IN'},hasMap:suchitra.mapsUrl,sameAs:[content.googleProfile]}];
const services=[
 {icon:'voice',name:'Speech & language',text:'Being understood, expressing choices and joining a conversation.',path:'/top-speech-therapy-center-india-proven-improvement-rate'},
 {icon:'sun',name:'Occupational therapy',text:'Getting ready, play, daily routines and participation.',path:'/best-occupational-therapy-center-india-proven-improvement-rate'},
 {icon:'heart',name:'ABA & behavioural support',text:'Understanding a difficult moment and building a useful alternative.',path:'/best-aba-therapy-center-india-proven-improvement-rate'},
 {icon:'book',name:'Special education',text:'Learning in ways that help your child take part.',path:'/best-special-education-center-call-9100181181'}
];
const citation='Pinnacle Blooms Network. Suchitra, Hyderabad centre: location, visit preparation and source trail. Updated 6 October 2026. '+url(content.path);
---
<PageLayout title={content.title} description={content.description} path={content.path} label="Suchitra Centre" shareImage={share} shareVersion="suchitra-v131-20260930" includeService={false} primaryEntityId={branchId} entityGraph={entityGraph} updatedOn="2026-10-06" breadcrumbParent={{name:'Pinnacle Centres',path:'/centers'}} imageAlt="Pinnacle Blooms Network Suchitra creative: a family and professional in an illustrative play conversation; 9100 181 181." imageCaption="Illustrative Pinnacle campaign scene; real Suchitra premises are shown separately." faqs={content.faqs} citations={content.sources.map(source=>source.url)} enquiry={{url:suchitraEnquiry,mobileLabel:'Ask about Suchitra'}}>
 <article class="local-page">
  <section class="local-hero local-wrap" aria-labelledby="local-title">
   <div>
    <p class="local-kicker"><Image src={emblem} alt="" width={54} height={54} format="webp" /> Suchitra · Hyderabad · Telangana</p>
    <p class="local-service-line">Communication · Daily life · Participation</p>
    <h1 id="local-title">Speech and autism support. <em>Here in Suchitra.</em></h1>
    <p class="local-hero-purpose">Toward a self-sufficient, mainstream-included and wonderful life.</p>
    <p class="local-lead">Making a choice. Getting ready. Learning with other children. Tell us what you want to make more possible—and let’s find a useful first step.</p>
    <div class="local-actions"><a class="local-button" href={phone.href} data-cta="hero-call"><Icon name="phone" /> Call {phone.display}</a><a class="local-button local-outline" href={suchitraEnquiry} data-cta="hero-assessment">Ask about a Suchitra visit <Icon name="arrow" /></a></div>
    <p class="local-small"><a href={url('/national-autism-helpline')}>Free telephone guidance, 24/7.</a> We confirm the centre appointment, professional and fees with you.</p>
    <a class="local-text-link" href="#find-us"><Icon name="pin" /> Above Mahesh Bank at Suchitra Circle · Find us</a>
   </div>
   <figure class="local-hero-photo"><Image src={exterior} alt={photos[0].alt} widths={[240,320,480,652]} sizes="(max-width: 370px) 205px, (max-width: 760px) 245px, (max-width: 1000px) 36vw, 335px" format="webp" quality={80} loading="eager" fetchpriority="low" /><figcaption>Recognise Suchitra: the Pinnacle nameboard above Mahesh Bank. Open the full building photo in Directions.</figcaption></figure>
  </section>
  <CentreNetworkExtras branch={suchitra} mode="proof"/>
 <nav class="local-jump local-wrap" aria-label="On this centre page"><a href="#find-us">Directions</a><a href="#life-first">The life we work toward</a><a href="#pinnacle-ecosystem">PinnacleAI journey</a><a href="#support">Support to discuss</a><a href="#first-visit">Your first visit</a><a href="#published-team">Team profiles</a><a href="#centre-gallery">Real centre photos</a><a href="#centre-tour">Centre walkthrough</a><a href="#local-evidence">Evidence</a></nav>
  <section class="local-section local-wrap" id="find-us">
   <p class="local-kicker">Your local starting point</p><h2>Know where you’re going. <em>Know what to ask.</em></h2>
   <div class="local-location">
    <div class="local-card local-address"><h3>Pinnacle Blooms Network – Suchitra</h3><address>{content.address}</address><p>{content.direct}</p><div class="local-actions"><a class="local-button" href={suchitra.mapsUrl} target="_blank" rel="noopener" data-cta="centre-maps"><Icon name="pin" /> Open Suchitra directions</a><a class="local-text-link" href="mailto:care@pinnacleblooms.org">care@pinnacleblooms.org</a></div><p class="local-small">This is Suchitra above Mahesh Bank. <a href="https://www.pinnacleblooms.org/centers/best-autism-speech-aba-occupational-therapy-center-suchitra2-hyderabad-telangana-india">Suchitra II is a separate location.</a> Confirm your appointment address, entrance, lift or parking arrangements before travelling.</p></div>
    <a class="local-exterior" href={gallery[0].full} aria-label="Open full Suchitra building photograph"><Image src={exterior} alt={photos[0].alt} widths={[240,400,600]} sizes="(max-width:760px) 90vw, 32vw" format="webp" loading="lazy" /></a>
   </div>
  </section>
  <CentreNetworkExtras branch={suchitra} mode="location"/>
 <CentreLifePurpose name="Suchitra"/>
  <section class="local-section local-wrap" id="everyday-example" aria-labelledby="local-example-title"><p class="local-kicker">A meaningful goal · a connected plan</p><h2 id="local-example-title">{content.exampleTitle}</h2><blockquote class="local-example-question">{content.exampleQuestion}</blockquote><p class="local-lead">{content.exampleIntro}</p><figure class="local-campaign local-example-scene"><Image src={share} alt="Illustrative family and Pinnacle professional sharing a block activity; a flowing pathway connects communication, home and learning." widths={[480,720,1200]} sizes="(min-width:1000px) 1000px, 92vw" format="webp" loading="lazy" quality={85}/><figcaption>{content.exampleCaption}</figcaption></figure><ol class="local-example-board">{content.exampleSteps.map(([icon,title,text],i)=><li><span>{i+1}</span><Icon name={icon} size={28}/><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol><aside class="centre-example-review"><Icon name="track"/><div><h3>Bring what happened into the next review.</h3><p><strong>An illustrative observation:</strong> “My child took part with me at home, but needed the same cue each time.” That context matters. Discuss the help involved, whether the ability is useful with another person and what to keep or adjust before reassessment.</p></div></aside></section>
  <CentreEcosystem enquiry={suchitraEnquiry} name="Suchitra"/>
  <section class="local-section local-wrap" id="support"><p class="local-kicker">Start with your child, then choose the support</p><h2>What would you like to make <em>easier in everyday life?</em></h2><p class="local-lead">Speech, occupational, behavioural and learning support make different contributions. Discuss your child’s priorities before choosing a programme; confirm what can be arranged at Suchitra.</p><div class="local-service-grid">{services.map(service=><a class="local-card local-service" href={url(service.path)}><Icon name={service.icon} /><h3>{service.name}</h3><p>{service.text}</p><strong>Understand this support <Icon name="arrow" /></strong></a>)}</div><p class="local-integration"><Icon name="people" /><span>For an autistic child, relevant therapies can work toward one everyday direction. Every child does not need every therapy. <a href={url('/autism-therapy')}>See how the contributions connect →</a></span></p></section>
  <section class="local-section local-wrap" id="first-visit"><p class="local-kicker">Let’s make the first step simple</p><h2>Bring your priorities. <em>We’ll discuss the next step.</em></h2><ol class="local-visit"><li><Icon name="voice" /><h3>Tell us one everyday moment.</h3><p>“My child enjoys playing near others. How can we help them join?” Communication, routines, play or learning—start where it matters to your family.</p></li><li><Icon name="people" /><h3>Confirm the right conversation.</h3><p>Ask who can meet your child at Suchitra, what the visit includes, the available appointment and fees. Bring any previous reports you want to discuss.</p></li><li><Icon name="compass" /><h3>Understand before deciding.</h3><p>Discuss present abilities, a useful priority, relevant support and how progress will be reviewed. Ask the questions you need before choosing care.</p></li></ol><div class="local-actions"><a class="local-button" href={phone.href} data-cta="centre-call"><Icon name="phone" /> Talk to us · {phone.display}</a><a class="local-text-link" href={url('/speech-aba-autism-assessments')}>Understand developmental assessment <Icon name="arrow" /></a><a class="local-text-link" href={url('/books/resources/first-conversation')}><Icon name="plan"/> Prepare your first conversation</a></div></section>

  <section class="local-section local-wrap" id="published-team"><p class="local-kicker">The people behind a professional conversation</p><h2>Explore published <em>team profiles.</em></h2><p class="local-lead">These professional roles appear in Suchitra’s published team information. When booking, confirm who will meet your child, their qualifications and the support available for your visit.</p><div class="local-team">{content.team.map(member=><a class="local-card" href={member.url}><Icon name="people" /><h3>{member.name}</h3><p>{member.role}</p><strong>Read the published profile <Icon name="arrow" /></strong></a>)}</div></section>
  <section class="local-section local-wrap" id="centre-gallery"><p class="local-kicker">Real place · published premises photographs</p><h2>Get a feel for <em>the Suchitra centre.</em></h2><div class="local-gallery">{gallery.map(photo=><figure><a href={photo.full} aria-label={'Open full photograph: '+photo.title}><Image src={photo.image} alt={photo.alt} widths={[240,400,600]} sizes="(max-width:760px) 92vw, 30vw" format="webp" loading="lazy" /></a><figcaption>{photo.title} · <a href={photo.full}>Open full photo</a></figcaption></figure>)}</div><p class="local-small">These are first-party Suchitra photographs. Ask about the current rooms, equipment and access arrangements relevant to your visit.</p></section>
  <section class="local-section local-wrap" id="centre-tour" aria-labelledby="centre-tour-title"><p class="local-kicker">Step inside · Suchitra I</p><h2 id="centre-tour-title">See the spaces. <em>Picture your first visit.</em></h2><p class="local-lead">Explore our published Suchitra I walkthrough, then bring your questions about the rooms, activities and support that would be useful for your child.</p><Fragment set:html={centreTour({name:'Suchitra I',videoId:'zT2fIZWRn-c',poster:gallery[1].full,posterAlt:photos[1].alt,width:room.width,height:room.height})}/><a class="local-text-link" href={suchitraEnquiry}>Plan your Suchitra visit <Icon name="arrow" /></a></section>
  <CentreNetworkExtras branch={suchitra} includeTour={false}/>
 <section class="local-section local-proof" id="local-evidence"><div class="local-wrap"><p class="local-kicker">Trust you can inspect</p><h2>One brand. A named operator. <em>Sources with clear scope.</em></h2><div class="local-proof-grid">{content.sources.filter(s=>['identity','purpose','md5','bis','hfr'].includes(s.id)).map(source=><div class="local-card"><Icon name="plan" /><h3>{source.name}</h3><p>{source.scope}</p><a href={source.url}>Read the original source <Icon name="arrow" /></a></div>)}</div><div class="local-actions"><a class="local-text-link" href={content.googleProfile} target="_blank" rel="noopener">Read the Suchitra Google profile <Icon name="arrow" /></a><a class="local-text-link" href={content.googleReview} target="_blank" rel="noopener">Share your own experience on Google <Icon name="arrow" /></a></div><p class="local-small">Use the current public Google profile for reviews. No rating is inferred for every centre.</p><details class="local-sources"><summary>Location sources, reading exports and citation</summary><ul>{content.sources.map(source=><li><a href={source.url}>{source.name}</a> — {source.scope}</li>)}</ul><p><a href="/pinnacle-pages-data/suchitra-evidence.json">Source map · JSON</a> · <a href="/pinnacle-pages-data/suchitra-evidence.txt">Text</a> · <a href="/pinnacle-pages-data/suchitra-machine.md">Markdown reading aid</a> · <a href="/pinnacle-pages-data/centre-contacts/suchitra.vcf">Save centre contact</a></p><blockquote>{citation}</blockquote><button class="local-button local-outline" type="button" id="local-copy-citation" data-cta="centre-copy-citation">Copy this citation</button><p id="local-citation-status" role="status" aria-live="polite"></p></details></div></section>
  <section class="local-section local-wrap" id="questions"><p class="local-kicker">Before you visit</p><h2>Useful answers for <em>a Suchitra conversation.</em></h2><div class="local-faq">{content.faqs.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>
  <section class="local-section local-close"><div class="local-wrap"><p class="local-kicker">Your child. Your priorities. One useful first step.</p><h2>Tell us what you want to <em>make possible.</em></h2><p class="local-lead">You don’t have to choose the whole journey today. Start with one conversation, and ask about the right next step at Suchitra.</p><div class="local-actions"><a class="local-button" href={phone.href} data-cta="final-call"><Icon name="phone" /> {phone.display}</a><a class="local-button local-outline" href={suchitraEnquiry} data-cta="final-enquiry">Ask about Suchitra <Icon name="arrow" /></a></div><div class="local-share"><button type="button" id="local-share" data-cta="centre-share"><Icon name="send" /> Share this centre</button><a href={'https://wa.me/?text='+encodeURIComponent('Pinnacle Blooms Suchitra: location, photos and visit questions. '+url(content.path))} target="_blank" rel="noopener" data-cta="centre-whatsapp">Share via WhatsApp</a><a href={url('/centers')}>Explore other Pinnacle centres</a></div><p id="local-share-status" role="status" aria-live="polite"></p></div></section>
 </article>
 <script define:vars={{canonical:url(content.path),citation}}>
  const status=document.getElementById('local-share-status');
  document.getElementById('local-share')?.addEventListener('click',async()=>{try{if(navigator.share){await navigator.share({title:'Pinnacle Blooms Suchitra',url:canonical});status.textContent='Centre link shared.';}else{await navigator.clipboard.writeText(canonical);status.textContent='Centre link copied.';}}catch(error){status.textContent=error.name==='AbortError'?'':'Share this page using your browser’s share menu.';}});
  document.getElementById('local-copy-citation')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(citation);document.getElementById('local-citation-status').textContent='Citation copied.';}catch{document.getElementById('local-citation-status').textContent='Select and copy the citation shown in the source section.';}});
 </script>
</PageLayout>
