---
import Icon from './Icon.astro';
import { therapyReading } from '../data/therapy-reading.mjs';
interface Props { kind:'speech'|'occupational'; includeInlineStyle?:boolean }
const {kind,includeInlineStyle=true}=Astro.props;
const item=therapyReading[kind];
const titleId=`${kind}-reading-title`;
const cover=(width:number)=>`/cdn-cgi/image/width=${width},quality=85,format=auto,onerror=redirect${item.book.front}`;
---
<section class="pbn-therapy-reading wrap" id={`${kind}-family-reading`} aria-labelledby={titleId} data-therapy-reading={kind}>
 {includeInlineStyle && <style is:inline>
 .pbn-therapy-reading{margin:22px auto 48px;padding:0 22px;scroll-margin-top:150px}.pbn-therapy-reading .pbn-reading-panel{display:grid;grid-template-columns:minmax(190px,.8fr) minmax(0,1.6fr);align-items:center;gap:32px;padding:30px;border:1px solid #d4e5e5;border-left:5px solid #009e9c;border-radius:22px;background:#fff;box-shadow:0 9px 30px #18315d08;color:#18315d}.pbn-therapy-reading .pbn-reading-cover{display:block;color:#18315d;text-decoration:none;text-align:center}.pbn-therapy-reading img{display:block;width:100%;height:auto;object-fit:contain;border-radius:10px}.pbn-therapy-reading .pbn-reading-book-title{display:block;margin-top:12px;font-size:18px;line-height:1.5;font-weight:700}.pbn-therapy-reading .pbn-reading-eyebrow{display:flex;align-items:center;gap:9px;font-size:14px;line-height:1.5;font-weight:700;color:#007477;margin:0 0 12px}.pbn-therapy-reading h2{font-size:clamp(24px,2.4vw,32px);line-height:1.28;margin:0 0 15px;color:#18315d;text-align:left;letter-spacing:normal}.pbn-therapy-reading p{font-size:16px;line-height:1.7;margin:0 0 16px;color:#243a57;text-align:left}.pbn-therapy-reading .pbn-reading-preview{display:inline-flex;align-items:center;gap:10px;min-height:46px;padding:10px 16px;border:2px solid #83288d;border-radius:12px;color:#74217e;background:white;font-size:16px;line-height:1.45;font-weight:700;text-decoration:none}.pbn-therapy-reading nav{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:18px 0}.pbn-therapy-reading nav span{font-size:15px;font-weight:700;flex-basis:100%;margin-bottom:2px}.pbn-therapy-reading nav a{display:inline-flex;align-items:center;min-height:44px;padding:8px 15px;border:1px solid #d7c7df;border-radius:24px;color:#74217e;background:#fbf6ff;font-size:16px;line-height:1.5;font-weight:700;text-decoration:underline;text-underline-offset:3px}.pbn-therapy-reading .pbn-reading-note{font-size:14px;line-height:1.7;color:#435068;margin:0}.pbn-therapy-reading a:hover{text-decoration:underline;text-underline-offset:4px}.pbn-therapy-reading a:focus-visible{outline:3px solid #008c8e;outline-offset:4px}@media(max-width:650px){.pbn-therapy-reading{padding:0 18px;margin:18px auto 36px}.pbn-therapy-reading .pbn-reading-panel{grid-template-columns:1fr;gap:22px;padding:22px 18px}.pbn-therapy-reading .pbn-reading-cover{max-width:290px;justify-self:center}.pbn-therapy-reading h2{font-size:25px}.pbn-therapy-reading .pbn-reading-preview{width:100%;justify-content:center;text-align:center}}
 </style>}
 <div class="pbn-reading-panel">
  <a class="pbn-reading-cover" href={item.book.path+'#preview'} data-cta={`${kind}-book-cover`}><img src={cover(400)} srcset={`${cover(400)} 400w, ${cover(800)} 800w`} sizes="(max-width:650px) 290px, 360px" width="1492" height="1054" loading="lazy" decoding="async" alt={item.book.coverAlt}/><span class="pbn-reading-book-title">{item.book.title}</span></a>
  <div><p class="pbn-reading-eyebrow"><Icon name="book" size={24}/>Read together · Bring your observations back</p><h2 id={titleId}>{item.heading}</h2><p>{item.copy}</p><a class="pbn-reading-preview" href={item.book.path+'#preview'} data-cta={`${kind}-book-preview`}>Read the free English sample <Icon name="arrow" size={20}/></a><nav aria-label={`${item.book.discipline} book language`}><span>Choose your PDF book language</span>{item.languages.map(language=><a href={language.path} lang={language.lang} hreflang={language.lang} data-cta={`${kind}-book-${language.lang}`}>{language.label}</a>)}</nav><p class="pbn-reading-note">{item.note}</p></div>
 </div>
</section>
