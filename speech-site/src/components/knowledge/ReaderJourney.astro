---
import Icon from '../Icon.astro';
import {knowledgeJourney} from '../../lib/knowledge/journey.mjs';
const {title='',category='',lang='en',enrol,service}=Astro.props;
const journey=knowledgeJourney({title,category,service});
const copy=lang==='hi'?{title:'आपके बच्चे के लिए अगला कदम क्या हो सकता है?',text:'अपने बच्चे की बातचीत, रोज़मर्रा के काम या सीखने से जुड़ी बात पूछें। हमारी टीम सही सेवा, सेंटर, पहली मुलाकात और फीस समझने में मदद करेगी।',call:'कॉल करें 9100 181 181',visit:'पहली मुलाकात के बारे में पूछें',centres:'पिनेकल सेंटर खोजें'}:lang==='te'?{title:'మీ బిడ్డకు ఇప్పుడు ఏ సహాయం ఉపయోగపడుతుంది?',text:'మాట్లాడటం, రోజువారీ పనులు లేదా నేర్చుకోవడం గురించి మీ ప్రశ్నలు అడగండి. ఏ సేవ ఉపయోగపడవచ్చు, దగ్గర్లోని సెంటర్, మొదటి విజిట్, ఫీజుల గురించి మా టీమ్ వివరిస్తుంది.',call:'కాల్ చేయండి 9100 181 181',visit:'మొదటి విజిట్ గురించి అడగండి',centres:'దగ్గర్లోని పినాకిల్ సెంటర్ చూడండి'}:{title:'What would help your child next?',text:'Ask about communication, everyday skills or learning. Our team can explain the relevant service, centre, first visit and fees before you decide.',call:'Call 9100 181 181',visit:'Ask about a first visit',centres:'Find a Pinnacle centre'};
---
{!journey.business&&<aside class="reader-journey" aria-label={copy.title} data-knowledge-journey>
 <div><p class="reader-journey-purpose">PINNACLE · YOUR CHILD’S LIFE GIVES EVERY STEP ITS PURPOSE</p><h2>{copy.title}</h2><p>{copy.text}</p></div>
 <div class="reader-journey-actions"><a class="reader-journey-call" href="tel:+919100181181" data-cta="knowledge-call"><Icon name="phone"/>{copy.call}</a><a href={'https://www.pinnacleblooms.org'+(enrol||journey.enrol).replace(/^https:\/\/www\.pinnacleblooms\.org/,'')} data-cta="knowledge-enrol">{copy.visit}<Icon name="arrow"/></a><a href="https://www.pinnacleblooms.org/centers" data-cta="knowledge-centres">{copy.centres}<Icon name="pin"/></a></div>
 {journey.services.length>0&&<nav class="reader-journey-services" aria-label="Relevant service information">{journey.services.map(s=><a href={'https://www.pinnacleblooms.org'+s.path} data-cta="knowledge-service">{s.label} →</a>)}</nav>}
 <p class="reader-journey-note">{lang==='hi'?'हर बच्चे की ज़रूरत अलग होती है। साइन इन करने से जाँच या मुलाकात बुक नहीं होती।':lang==='te'?'ప్రతి బిడ్డ అవసరాలు వేరు. చదవడం లేదా సైన్ ఇన్ చేయడం Assessment లేదా బుకింగ్ కాదు.':'Support is individual to each child. Reading or signing in is not an assessment or a booking.'}</p>
</aside>}
<style>
.reader-journey{margin:24px 0 32px;padding:22px 24px;background:#fff;border:1px solid #e2d9e8;border-left:5px solid #932580;border-radius:16px;color:#213653;display:grid;grid-template-columns:minmax(0,1fr) minmax(230px,.7fr);gap:14px 28px}.reader-journey h2{font-size:24px;line-height:1.3;margin:0 0 10px;color:#213653}.reader-journey p{font-size:16px;line-height:1.65;margin:0}.reader-journey .reader-journey-purpose{font-size:11px;letter-spacing:.065em;font-weight:700;color:#842478;margin-bottom:10px}.reader-journey-actions{display:flex;flex-direction:column;gap:8px;justify-content:center}.reader-journey-actions a{display:flex;align-items:center;gap:8px;border:1px solid #932580;border-radius:10px;padding:11px 14px;min-height:44px;font-weight:700;color:#842478;line-height:1.4;text-decoration:none}.reader-journey-actions .reader-journey-call{background:#932580;color:white}.reader-journey a:focus-visible{outline:3px solid #00a8b4;outline-offset:3px}.reader-journey-services{grid-column:1/-1;display:flex;gap:12px 24px;flex-wrap:wrap}.reader-journey-services a{color:#842478;text-decoration:underline;text-underline-offset:4px;font-weight:700;line-height:1.6}.reader-journey .reader-journey-note{grid-column:1/-1;font-size:13px;color:#475a71}.reader-journey svg{width:20px;height:20px;flex-shrink:0}@media(max-width:620px){.reader-journey{grid-template-columns:1fr;padding:18px;gap:18px}.reader-journey h2{font-size:22px}.reader-journey .reader-journey-purpose{font-size:10px;line-height:1.6}}
</style>
