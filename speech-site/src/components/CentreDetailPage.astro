---
import {Image,getImage} from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import CentreNetworkExtras from './CentreNetworkExtras.astro';
import CentreTrustGallery from './CentreTrustGallery.astro';
import CentreEcosystem from './CentreEcosystem.astro';
import CentreLifePurpose from './CentreLifePurpose.astro';
import brandLogo from '../assets/pinnacle-logo.jpg';
import pathway from '../assets/enrolment-family-life-path-branded-20260929.png';
import CentreStatusContent from './CentreStatusContent.astro';
import {centreDetails} from '../data/centre-detail-content';
import {phone,url} from '../data/site';
import {matchedIssuedCertificates,type CentreCertificateDocument} from '../data/centre-trust';
import '../styles/centre-page.css';
const {id}=Astro.props;
const content=centreDetails.find(page=>page.id===id);
if(!content)throw new Error('Unregistered centre detail '+id);
const documentImports=import.meta.glob<{default:CentreCertificateDocument[]}>('../data/centre-certificates-20261007.json',{eager:true});
const certificateDocuments=documentImports['../data/centre-certificates-20261007.json']?.default||[];
const issuedCertificates=matchedIssuedCertificates(content.branch,certificateDocuments);
const media=import.meta.glob<{default:ImageMetadata}>('../assets/centre-directory/*.jpg',{eager:true});
const posters=import.meta.glob<{default:ImageMetadata}>('../assets/*-social-20261001.png',{eager:true});
const asset=(file:string)=>{const found=media['../assets/centre-directory/'+file]?.default;if(!found)throw new Error('Missing branch media '+file);return found;};
const campaign=posters['../assets/'+content.shareFile]?.default;
const heroFile=content.exterior||content.hero;
const hero=heroFile?asset(heroFile):pathway,emblem=content.emblem?asset(content.emblem):brandLogo;
const share=campaign||hero;
const heroAlt=heroFile?content.photos.find(p=>p.file===heroFile)?.alt||'Pinnacle '+content.label+' premises photograph':'Illustrative Pinnacle family-life pathway; not a photograph of this centre.';
const gallery=await Promise.all(content.photos.map(async p=>({...p,image:asset(p.file),full:(await getImage({src:asset(p.file),width:900,format:'webp',quality:87})).src})));
const heroFull=gallery.find(p=>p.file===heroFile)?.full||(await getImage({src:hero,width:900,format:'webp',quality:85})).src;
const arrivalPhoto=gallery.find(p=>p.file===content.exterior);
const branchId=url(content.path)+'#centre';
const inactive=content.sourceFlag==='INACTIVE';
const entityGraph=content.isInternational?[]:[{'@type':inactive?'Place':'LocalBusiness','@id':branchId,name:'Pinnacle Blooms Network – '+content.label,image:url(heroFull),url:url(content.path),...(inactive?{description:content.direct}:{telephone:'+919100181181',email:'care@pinnacleblooms.org',parentOrganization:{'@id':url('/verify/#organization')},brand:{'@id':url('/verify/#pinnacle-brand')},...(content.localTelephone?{contactPoint:{'@type':'ContactPoint',telephone:content.localTelephone,contactType:'local centre enquiries'}}:{})}),address:{'@type':'PostalAddress',streetAddress:content.street,addressLocality:content.city,addressRegion:content.region,...(content.postcode?{postalCode:content.postcode}:{}),addressCountry:'IN'},hasMap:content.branch.mapsUrl,sameAs:[content.branch.googleBusinessUrl,...content.branch.socialLinks].filter(Boolean),...(content.branch.coordinates?{geo:{'@type':'GeoCoordinates',...content.branch.coordinates}}:{})}];
const services=[
 {value:'speech',icon:'voice',name:'Speech & language',text:'Expressing a choice, being understood and joining a conversation.',path:'/top-speech-therapy-center-india-proven-improvement-rate'},
 {value:'occupational',icon:'sun',name:'Occupational therapy',text:'Getting ready, play, daily routines and participation.',path:'/best-occupational-therapy-center-india-proven-improvement-rate'},
 {value:'aba',icon:'heart',name:'ABA & behavioural support',text:'Understanding a difficult moment and building a useful alternative.',path:'/best-aba-therapy-center-india-proven-improvement-rate'},
 {value:'education',icon:'book',name:'Special education',text:'Learning in ways that help your child take part.',path:'/best-special-education-center-call-9100181181'}
];
const serviceEnquiry=(value:string)=>{const target=new URL(content.enquiry,'https://www.pinnacleblooms.org');target.searchParams.set('service',value);return target.href;};
const citation=`Pinnacle Blooms Network. ${content.label}: ${inactive?'location status, family guidance and alternatives':'location, visit preparation and life-first source trail'}. Updated 7 October 2026. ${url(content.path)}`;
const shareTitle='Pinnacle Blooms '+content.label+(inactive?' · Status & guidance':'');
---
<PageLayout title={content.title} description={content.description} path={content.path} label={content.label+' Centre'} shareImage={share} shareVersion={content.releaseLabel} includeService={false} primaryEntityId={content.isInternational?undefined:branchId} entityGraph={entityGraph} updatedOn={content.updatedOn} breadcrumbParent={{name:'Pinnacle Centres',path:'/centers'}} imageAlt={campaign?(inactive?'Pinnacle Blooms Delhi guidance creative: call before you travel; 9100 181 181.':'Pinnacle Blooms '+content.label+' branded campaign: a family and professional sharing an everyday activity; 9100 181 181.'):heroAlt} imageCaption={campaign?'Illustrative Pinnacle '+content.label+' campaign creative.':heroAlt} shareFit={campaign?'cover':'contain'} faqs={content.faqs} citations={content.sources.map(source=>source.url)} enquiry={{url:content.enquiry,mobileLabel:inactive?'Ask about options':'Ask about a visit'}}>
 {content.isInternational?<article class="local-page"><section class="local-section local-wrap"><p class="local-kicker">Pinnacle Blooms Network · United States enquiries</p><h1>{content.headline}</h1><p class="local-lead">{content.lead}</p><p>This historical California URL is retained for guidance. A current US clinic, address or appointment is not confirmed here.</p><div class="local-actions"><a class="local-button" href={phone.href}>Contact Pinnacle · {phone.display}</a><a class="local-button local-outline" href={url('/centers')}>Explore our centre directory</a></div><a class="local-text-link" href={url('/pinnacleai')}>Explore PinnacleAI and our life-first system →</a><p><a href={url('/verify/')}>Inspect original Pinnacle evidence in Verify →</a></p></section></article>:inactive?<CentreStatusContent content={content} hero={hero} emblem={emblem} gallery={gallery} share={share} services={services} citation={citation} />:<article class="local-page">
  <section class="local-hero local-wrap" aria-labelledby="local-title">
   <div><p class="local-kicker"><Image src={emblem} alt="" width={54} height={54} format="webp" /> {content.label} · {content.region}</p><p class="local-service-line">Support to discuss · Speech · Occupational · ABA · Special education</p><h1 id="local-title">{content.headline} <em>{content.headlineAccent}</em></h1><p class="local-hero-purpose">Toward a self-sufficient, mainstream-included and wonderful life.</p><p class="local-lead">{content.lead}</p><div class="local-actions"><a class="local-button" href={phone.href} data-cta="hero-call"><Icon name="phone" /> Call {phone.display}</a><a class="local-button local-outline" href={content.enquiry} data-cta="hero-assessment">Request an assessment <Icon name="arrow" /></a></div><p class="local-small"><a href={url('/national-autism-helpline')}>Free telephone guidance, 24/7.</a> We confirm the centre appointment, professional and fees with you.</p><a class="local-text-link" href="#find-us"><Icon name="pin" /> {content.landmark}</a></div>
   <figure class="local-hero-photo"><Image src={hero} alt={heroAlt} widths={[320,480,720,960]} sizes="(max-width:760px) 92vw, 40vw" format="webp" quality={85} loading="eager" fetchpriority="high" /><figcaption>{heroFile?'A photograph of Pinnacle '+content.label+'.':'Illustrative Pinnacle family-life pathway.'}</figcaption></figure>
  </section>
  <CentreNetworkExtras branch={content.branch} mode="proof"/>
  <nav class="local-jump local-wrap" aria-label="On this centre page"><a href="#find-us">Directions</a><a href="#life-first">The life we work toward</a><a href="#pinnacle-ecosystem">PinnacleAI journey</a><a href="#everyday-example">An everyday example</a><a href="#support">Support to discuss</a><a href="#first-visit">Your first visit</a><a href="#people-and-families">Pinnacle’s people</a><a href="#family-voices">Families speak</a>{gallery.length>0&&<a href="#centre-gallery">Real centre photos</a>}<a href="#centre-walkthrough">Walkthrough</a><a href="#google-reviews">Google reviews</a><a href="#nearby-centres">Nearby centres</a><a href="#family-resources">Resources & books</a><a href="#local-evidence">Evidence</a></nav>
  <section class="local-section local-wrap" id="find-us"><p class="local-kicker">Your local starting point</p><h2>Know where you’re going. <em>Know what to ask.</em></h2><div class:list={{'local-location':!!arrivalPhoto}}><div class="local-card local-address h-card"><h3 class="p-name">Pinnacle Blooms Network – {content.label}</h3><address class="p-adr">{content.address}</address><p>{content.direct}</p><div class="local-actions"><a class="local-button" href={content.branch.mapsUrl} target="_blank" rel="noopener" data-cta="centre-maps"><Icon name="pin" /> Open directions</a><a class="local-text-link" href="mailto:care@pinnacleblooms.org">care@pinnacleblooms.org</a></div><p class="local-small">{content.arrival}</p>{content.sourceFlag==='INACTIVE'&&<p class="local-small"><strong>Confirm this location before travelling.</strong> The source workbook marks it INACTIVE; its dated facility-register approval does not confirm current operation or appointments. Call the receiving team first.</p>}</div>{arrivalPhoto&&<a class="local-exterior" href={arrivalPhoto.full} aria-label={'Open full '+content.label+' frontage photograph'}><Image src={arrivalPhoto.image} alt={arrivalPhoto.alt} widths={[240,400,600]} sizes="(max-width:760px) 90vw, 32vw" format="webp" loading="lazy" /></a>}</div></section>
  <CentreNetworkExtras branch={content.branch} mode="location"/>
  <CentreLifePurpose name={content.label}/>
  <section class="local-section local-wrap" id="everyday-example"><p class="local-kicker">An everyday example to discuss</p><h2>{content.exampleTitle}</h2><p class="local-lead">{content.exampleQuestion}</p><ol class="branch-example">{content.exampleSteps.map(([title,text],i)=><li class="local-card"><span class="local-stage-number">{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol><aside class="centre-example-review"><Icon name="track"/><div><h3>Bring what happened into the next review.</h3><p><strong>An illustrative observation:</strong> “My child took part with me at home, but needed the same cue each time.” That context matters. Discuss the help involved, whether the ability is useful with another person and what to keep or adjust before reassessment.</p></div></aside><a class="local-text-link" href={content.enquiry} data-cta="centre-enquiry">Bring your own everyday priority <Icon name="arrow" /></a></section>
  <CentreEcosystem enquiry={content.enquiry} name={content.label}/>
  <section class="local-section local-wrap" id="support"><p class="local-kicker">Start with your child, then choose the support</p><h2>What would you like to make <em>easier in everyday life?</em></h2><p class="local-lead">For autism, ADHD, speech or developmental concerns, begin with your child’s present abilities and your family’s priorities. Speech, occupational, behavioural and learning support make different contributions; ask what can be arranged at {content.label}.</p><div class="local-service-grid">{services.map(service=><article class="local-card local-service"><Icon name={service.icon} /><h3>{service.name}</h3><p>{service.text}</p><a class="local-text-link" href={url(service.path)}>Understand this support <Icon name="arrow" /></a><a class="local-button local-outline local-service-enquiry" href={serviceEnquiry(service.value)} data-cta="centre-service-enquiry" aria-label={"Discuss "+service.name+" at "+content.label}>Discuss this support <Icon name="arrow" /></a></article>)}</div><p class="local-integration"><Icon name="people" /><span>Relevant therapies can work toward one everyday direction. Every child does not need every therapy. <a href={url('/autism-therapy')}>See how the contributions connect →</a></span></p></section>
  <CentreTrustGallery kind="visit" name={content.label} enquiry={content.enquiry}/>

  <CentreTrustGallery kind="photos" name={content.label} photos={gallery} hasExterior={!!content.exterior}/>
  <CentreNetworkExtras branch={content.branch}/>
  <section class="local-section local-proof" id="local-evidence"><div class="local-wrap"><p class="local-kicker">Trust you can inspect</p><h2>One brand. A named operator. <em>Sources with clear scope.</em></h2><div class="local-proof-grid">{content.sources.filter(s=>['identity','purpose','md5','bis','hfr'].includes(s.id)).map(source=><div class="local-card"><Icon name="plan" /><h3>{source.name}</h3><p>{source.displayScope||source.scope}</p><a href={source.url}>Read the source <Icon name="arrow" /></a></div>)}</div><div class="centre-certificate-documents">{issuedCertificates.map(document=><article class="local-card"><Icon name="shield"/><h3>Issued NHA / HFR facility certificate</h3><p><strong>{document.hfrId}</strong> · {document.date}</p><p>{document.title}</p><p class="local-small">Issued facility-register document matched to this centre and identifier. Confirm current appointments and available services with the team.</p><a class="local-text-link" href={document.driveUrl} target="_blank" rel="noopener">Open the original issued certificate <Icon name="arrow"/></a></article>)}</div><div class="local-actions"><a class="local-text-link" href={content.branch.mapsUrl} target="_blank" rel="noopener">Open Google directions <Icon name="arrow" /></a>{content.review&&<a class="local-text-link" href={content.review} target="_blank" rel="noopener">Leave your own Google review <Icon name="arrow" /></a>}</div><details class="local-sources"><summary>Location sources, reading exports and citation</summary><ul>{content.sources.map(source=><li><a href={source.url}>{source.name}</a> — {source.scope}</li>)}</ul><p><a href={'/pinnacle-pages-data/'+content.id+'-evidence.json'}>Source map · JSON</a> · <a href={'/pinnacle-pages-data/'+content.id+'-evidence.txt'}>Text</a> · <a href={'/pinnacle-pages-data/'+content.id+'-machine.md'}>Markdown reading aid</a> · <a href={'/pinnacle-pages-data/centre-contacts/'+content.id+'.vcf'}>Save centre contact</a></p><blockquote>{citation}</blockquote><button class="local-button local-outline" type="button" id="local-copy-citation" data-cta="centre-copy-citation">Copy this citation</button><p id="local-citation-status" role="status" aria-live="polite"></p></details></div></section>
  <section class="local-section local-wrap" id="questions"><p class="local-kicker">Before you visit</p><h2>Useful answers for <em>a {content.label} conversation.</em></h2><div class="local-faq">{content.faqs.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>
  <section class="local-section local-close"><div class="local-wrap"><p class="local-kicker">Your child. Your priorities. One useful first step.</p><h2>Tell us what you want to <em>make possible.</em></h2><p class="local-lead">{content.callMotivation || <>You don’t have to choose the whole journey today. Start with one conversation and ask about a useful next step at {content.label}.</>}</p><div class="local-actions"><a class="local-button" href={phone.href} data-cta="final-call"><Icon name="phone" /> {phone.display}</a><a class="local-button local-outline" href={content.enquiry} data-cta="final-enquiry">Ask about this centre <Icon name="arrow" /></a></div><div class="local-share"><button type="button" id="local-share" data-cta="centre-share"><Icon name="send" /> Share this centre</button><a href={'https://wa.me/?text='+encodeURIComponent(shareTitle+': location, photos and visit questions. '+url(content.path))} target="_blank" rel="noopener" data-cta="centre-whatsapp">Share via WhatsApp</a><a href={url('/centers')}>Explore other Pinnacle centres</a></div><p id="local-share-status" role="status" aria-live="polite"></p></div></section>
 </article>}
 <script define:vars={{canonical:url(content.path),citation,shareTitle}}>
  const status=document.getElementById('local-share-status');
  document.getElementById('local-share')?.addEventListener('click',async()=>{try{if(navigator.share){await navigator.share({title:shareTitle,url:canonical});status.textContent='Centre link shared.';}else{await navigator.clipboard.writeText(canonical);status.textContent='Centre link copied.';}}catch(error){status.textContent=error.name==='AbortError'?'':'Share this page using your browser’s share menu.';}});
  document.getElementById('local-copy-citation')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(citation);document.getElementById('local-citation-status').textContent='Citation copied.';}catch{document.getElementById('local-citation-status').textContent='Select and copy the citation shown in the source section.';}});
 </script>
</PageLayout>
<style>
 .branch-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.6rem;margin-top:2rem}.branch-gallery figure{margin:0}.branch-gallery img{width:100%;height:auto;max-height:460px;object-fit:contain;border-radius:28px;background:#f5f8fa}.branch-gallery figcaption{font-weight:700;line-height:1.7;margin-top:.8rem}.branch-example{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));list-style:none;padding:0;gap:1rem;margin-block:2rem}@media(max-width:1024px){.branch-example{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.branch-gallery,.branch-example{grid-template-columns:1fr}.branch-gallery img{max-height:430px}}
</style>

<style>
.centre-certificate-documents{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;margin-block:1.5rem}.centre-certificate-documents:empty{display:none}.centre-certificate-documents h3{font-size:1.12rem;line-height:1.55}.centre-certificate-documents p{overflow-wrap:anywhere}.centre-certificate-documents>article>svg{color:#08746f}@media(max-width:760px){.centre-certificate-documents{grid-template-columns:1fr}}
</style>

<style>.local-service-enquiry{margin-top:1rem;font-size:1rem;min-height:48px}.local-service>p{flex:1}@media(max-width:560px){.local-service-grid{grid-template-columns:1fr}.local-service{min-width:0}}</style>
