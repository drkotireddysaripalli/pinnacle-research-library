---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { phone, url } from '../data/site';
import emblem from '../assets/pinnacle-emblem-official.png';
import AssessmentOffer from './AssessmentOffer.astro';
import type { ServiceContent } from '../data/service-content';
interface Props { content: ServiceContent }
const { content } = Astro.props;
const slides = [{image:content.image.source,alt:content.image.alt,caption:content.image.caption}];
---
<section class="sales-hero" aria-labelledby={content.id+'-title'}>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow"><span class="brand-dot"></span> Every Child Counts®</p>
      <h1 id={content.id+'-title'}><span class="service-title">{content.label} for children</span> {content.hero.heading}<br /><em>{content.hero.emphasis}</em></h1>
      <p class="hero-intro"><strong>{content.hero.lead}</strong> {content.hero.copy}</p>
      <ol class="hero-mechanism" aria-label="Everyday goals">{content.hero.moments.map(moment=><li><Icon name={moment.icon} size={22} />{moment.label}</li>)}</ol>
      {content.assessmentOffer && <div class="hero-assessment-offer"><span>Speech &amp; language assessment</span><AssessmentOffer compact /></div>}
      <div class="hero-actions"><a class="button primary" href={phone.href} data-cta="hero-call"><Icon name="phone" />Call {phone.display}</a><a class="button outline" href={url('/enroll#contact-form-title')} data-cta="hero-assessment">{content.assessmentOffer ? 'Book your FREE assessment' : 'Request an assessment'} <Icon name="arrow" /></a></div>
      <p class="guidance-note">Free guidance, 24/7. Ongoing therapy is priced separately.</p>
      <div class="hero-evidence"><Icon name="shield" size={18} /><span>PinnacleAI software: <a href={url('/verify/evidence/records/md5.html')}>MD-5 licence</a> · <a href={url('/verify/evidence/bis.pdf#page=2')}>BIS scope</a></span></div>
      <a class="hero-discover" href="#everyday-communication">See what this means for your child <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-visual" data-carousel role="region" aria-roledescription="carousel" aria-label="Communication in everyday life">
      {slides.map((slide, index) => <figure class="hero-slide" role="group" aria-roledescription="slide" aria-label={(index+1)+' of '+slides.length} hidden={index!==0}>
        <Image src={slide.image} widths={[480,720,960,1200]} sizes="(min-width: 1360px) 680px, (min-width: 761px) 50vw, calc(100vw - 36px)" width={1200} height={1000} fit="cover" format="webp" quality={80} alt={slide.alt} loading={index===0 ? 'eager' : 'lazy'} fetchpriority={index===0 ? 'high' : 'auto'} />
      </figure>)}
      <div class="life-badge"><span class="badge-icon official-badge"><Image src={emblem} width={64} height={64} format="webp" alt="Pinnacle official pinwheel emblem" /></span><div><strong>The child’s life comes first.</strong><span>Goals. Practice. Progress. Participation.</span></div></div>
      <div class="slider-controls" hidden><button type="button" data-prev aria-label="Previous image">←</button><span aria-live="polite" data-count>1 / {slides.length}</span><button type="button" data-next aria-label="Next image">→</button></div>
    </div>
  </div>
</section>
<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const slides = [...carousel.querySelectorAll<HTMLElement>('.hero-slide')];
    const controls = carousel.querySelector<HTMLElement>('.slider-controls');
    let active = 0;
    const show = (delta: number) => {
      active = (active + delta + slides.length) % slides.length;
      slides.forEach((slide,index) => { slide.hidden = index !== active; });
      const count = carousel.querySelector('[data-count]');
      if (count) count.textContent = (active + 1) + ' / ' + slides.length;
    };
    if (controls) controls.hidden = slides.length < 2;
    carousel.querySelector('[data-prev]')?.addEventListener('click', () => show(-1));
    carousel.querySelector('[data-next]')?.addEventListener('click', () => show(1));
  }
</script>
