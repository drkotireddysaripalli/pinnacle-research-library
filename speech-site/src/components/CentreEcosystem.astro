---
import {Image} from 'astro:assets';
import Icon from './Icon.astro';
import {centreEcosystem,centreNarrativeChapters,centreHomeParticipation} from '../data/centre-story';
import {assessmentContent} from '../data/assessment-content';
import {phone,url} from '../data/site';
import system from '../assets/pinnacleai-life-path-20260930.png';
import ability from '../assets/abilityscore-possibility-20261005.png';
import readiness from '../assets/readiness-possibility-20261005.png';
import independence from '../assets/self-sufficient-social-20261001.png';
import participation from '../assets/mainstream-social-20261001.png';
const {enquiry,name}=Astro.props;
const images:Record<string,ImageMetadata>={ability,readiness,independence,participation};
const chapters=centreNarrativeChapters.map(chapter=>({...chapter,items:chapter.letter==='A'?centreEcosystem.slice(1,3):chapter.letter==='D'?centreEcosystem.slice(4,6):[]}));
const stages=assessmentContent.stages;
---
<section class="local-section local-wrap centre-ecosystem" id="pinnacle-ecosystem" aria-labelledby="centre-system-title">
 <p class="local-kicker"><Icon name="loop"/>PinnacleAI® at Pinnacle {name}</p>
 <h2 id="centre-system-title">One system. <em>Your child’s whole life.</em></h2>
 <p class="local-lead">Our mission is a self-sufficient, mainstream life for 900 Million children worldwide. For your family, it becomes a personal journey: understand your child, choose meaningful goals, connect the right support and keep learning from what happens in everyday life.</p>
 <article class="ecosystem-system" id="centre-pinnacleai">
  <figure><Image src={system} alt="Illustrative PinnacleAI creative connecting measurement, family, therapies, everyday practice and a child’s life" widths={[480,720,1000]} sizes="(max-width:760px) 92vw, 46vw" format="webp" loading="lazy" quality={82}/></figure>
  <div><p class="local-kicker"><Icon name="loop"/>The whole Pinnacle system, around your child</p><h3>A clear starting point. A reason for every next step.</h3><p>{centreEcosystem[0].text}</p><div class="ecosystem-data"><Icon name="measure" size={28}/><div><strong>4 Billion Clinical Data Points</strong><span>PinnacleAI’s stated knowledge foundation. Explore the system dossier and source trail.</span></div></div><p>The scale belongs to the wider system. The goal and plan belong to your child.</p><a class="ecosystem-link" href={url('/pinnacleai')}>Explore PinnacleAI® <Icon name="arrow"/></a><a class="ecosystem-link" href={url('/verify/evidence/records/dossier.html')}>Inspect the system dossier <Icon name="arrow"/></a></div>
 </article>
 <nav class="ecosystem-chapter-nav" aria-label="Explore the PinnacleAI journey at this centre">{chapters.map(chapter=><a href={'#centre-chapter-'+chapter.id}><span>{chapter.letter}</span>{chapter.title}<Icon name="arrow" size={20}/></a>)}</nav>
 <div id="connected-pathway" class="ecosystem-journey">
  {chapters.map(chapter=><article class={'ecosystem-chapter chapter-'+chapter.id} id={'centre-chapter-'+chapter.id} aria-labelledby={'centre-'+chapter.id+'-title'}>
   <header><span class="ecosystem-chapter-mark">{chapter.letter}</span><div><p class="local-kicker">{chapter.stages.length===1?'Stage 7':'Stages '+chapter.stages.join(' & ')} · PinnacleAI®</p><h3 id={'centre-'+chapter.id+'-title'}>{chapter.title}</h3><p>{chapter.purpose}</p></div></header>
   {chapter.items.length>0&&<div class="ecosystem-grid">{chapter.items.map(item=><article class="ecosystem-card" id={'centre-'+item.id}><figure><Image src={images[item.visual]} alt={'Illustrative Pinnacle '+item.title+' creative: '+item.role} widths={[320,480,720]} sizes="(max-width:760px) 92vw, 44vw" format="webp" loading="lazy" quality={82}/></figure><div class="ecosystem-copy"><p class="local-kicker"><Icon name={item.icon}/>{item.title}</p><h4>{item.role}</h4><p>{item.text}</p><a class="ecosystem-link" href={url(item.path)}>Explore {item.title} <Icon name="arrow"/></a></div></article>)}</div>}
   {chapter.letter==='A'&&<div class="ecosystem-planning"><Icon name="plan" size={30}/><p><strong>A plan that keeps your child’s context together.</strong> <a href={url('/personal-development-kernel')}>Personal Development Kernel</a> connects relevant abilities, family priorities and support. <a href={url('/prognose')}>Prognose</a> supports a planning and readiness discussion that can change as your child’s abilities change.</p></div>}
   {chapter.letter==='B'&&<><p class="ecosystem-statement">Let the centre become the starting point.<br/><em>Let the learning travel into your child’s day.</em></p><div class="ecosystem-home-scenes">{centreHomeParticipation.map(scene=><div><Icon name={scene.icon} size={32}/><h4>{scene.title}</h4><p>{scene.text}</p></div>)}</div><p class="ecosystem-module-links"><a href={url('/therapeuticai')}><Icon name="heart"/>TherapeuticAI®</a><a href="#support"><Icon name="people"/>Explore the four therapy contributions</a><a href={url('/everyday-therapy')}><Icon name="home"/>Everyday Therapy™</a></p></>}
   {chapter.letter==='C'&&<div class="ecosystem-review-flow" aria-label="How real-life observations guide the next plan"><div><Icon name="home" size={30}/><h4>What happened in life?</h4><p>Describe the ability, person, setting, comfort and help involved.</p></div><span aria-hidden="true">→</span><div><Icon name="track" size={30}/><h4>What does that tell us?</h4><p>Family and professional review what became useful and what still needs support.</p></div><span aria-hidden="true">→</span><div><Icon name="loop" size={30}/><h4>What should change next?</h4><p>Reassess and agree whether to continue, adapt or reconsider the plan.</p></div></div>}
   <ol class:list={['ecosystem-stage-pair',{'ecosystem-stage-final':chapter.stages.length===1}]} aria-label={'Stages '+chapter.stages.join(' and ')} start={chapter.stages[0]}>{chapter.stages.map(number=><li><span class="local-stage-number" aria-hidden="true">{number}</span><div><h4>{stages[number-1].title}</h4><p>{stages[number-1].text}</p>{['B','C'].includes(chapter.letter)&&<a class="local-text-link" href={url(stages[number-1].path)}>Explore this part <Icon name="arrow" size={18}/></a>}</div></li>)}</ol>
   <aside class="ecosystem-family"><Icon name="people"/><p><strong>{chapter.letter==='B'?'Your home. Your routine. A part you can understand.':chapter.letter==='D'?'Recognise progress in the moments that matter.':'Your part in the next decision.'}</strong> {chapter.family}</p></aside>
  </article>)}
 </div>
 <aside class="ecosystem-source-note"><Icon name="shield"/><p>PinnacleAI GPT-OS is Class B non-diagnostic developmental-support software for ages 0–12. Professionals interpret information with your family. <a href={url('/verify/evidence/records/md5.html')}>MD-5 intended use</a> · <a href={url('/verify/evidence/records/bis.html')}>BIS licence and named scope</a>. Software licensing and certification are separate from a child’s individual result.</p></aside>
 <div class="ecosystem-evidence"><div><p class="local-kicker"><Icon name="shield"/>Confidence with an inspectable source</p><h3>The purpose. The science. <em>The evidence behind it.</em></h3><p>Meet our people, hear families in their own words and inspect the records behind our claims. Each brings a different perspective to your decision.</p></div><div class="ecosystem-evidence-links">{centreEcosystem.slice(6,9).map(item=><a id={'centre-'+item.id} href={url(item.path)}><Icon name={item.icon} size={28}/><span><strong>{item.title}</strong><span>{item.text}</span></span><Icon name="arrow"/></a>)}</div></div>
 <div class="ecosystem-next"><div><h3>Begin your child’s journey at Pinnacle {name}.</h3><p>You can start with one everyday priority. We’ll discuss the suitable professional, assessment, appointment and fees with you.</p></div><div class="local-actions"><a class="local-button" href={phone.href} data-cta="centre-call"><Icon name="phone"/>Call {phone.display}</a>{enquiry&&<a class="local-button local-outline" href={enquiry} data-cta="centre-enquiry"><Icon name="plan"/>Request an assessment <Icon name="arrow"/></a>}</div></div>
</section>
<style>
 .ecosystem-system{display:grid;grid-template-columns:1.05fr 1fr;gap:2.2rem;align-items:center;margin:2.5rem 0;border:1px solid #d9e4e6;border-radius:30px;background:#fff;overflow:hidden;padding:1.7rem}.ecosystem-system figure{margin:0}.ecosystem-system img{width:100%;height:auto}.ecosystem-system h3{font-size:clamp(1.7rem,3vw,2.5rem);line-height:1.25;margin:.7rem 0 1rem}.ecosystem-data{display:flex;align-items:center;gap:.75rem;border-left:4px solid #96277e;background:#fbf5fc;padding:1rem;margin:1.3rem 0;color:#7d246f}.ecosystem-data>svg{flex:none}.ecosystem-data strong{font-size:clamp(1.25rem,2vw,1.7rem);display:block}.ecosystem-data span{display:block;font-size:1rem;line-height:1.6;margin-top:.4rem;color:#385263}
 .ecosystem-chapter-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem;margin:2rem 0 3rem}.ecosystem-chapter-nav a{display:flex;align-items:center;gap:.6rem;min-height:64px;padding:1rem;border:1px solid #d9e4e6;border-radius:16px;text-decoration:none;font-weight:700;font-size:1rem;line-height:1.5}.ecosystem-chapter-nav a>span{font-size:1.4rem;color:#087568}.ecosystem-chapter-nav a>svg{margin-left:auto}.ecosystem-chapter{margin-top:3rem;padding-top:2.3rem;border-top:1px solid #d9e4e6;scroll-margin-top:2rem}.ecosystem-chapter>header{display:flex;align-items:flex-start;gap:1.2rem;margin-bottom:1.7rem}.ecosystem-chapter>header h3{font-size:clamp(1.7rem,3vw,2.5rem);line-height:1.22;letter-spacing:-.025em;margin:.4rem 0 .8rem}.ecosystem-chapter>header p{max-width:940px;margin-bottom:0}.ecosystem-chapter-mark{display:grid;place-items:center;flex:none;width:66px;height:66px;color:#08746f;background:#eef8f6;border-radius:20px;font-size:2.2rem;font-weight:700}.chapter-everyday .ecosystem-chapter-mark{color:#96277e;background:#fcf1fa}.chapter-review .ecosystem-chapter-mark{color:#5e38a0;background:#f6f1fc}.chapter-life .ecosystem-chapter-mark{color:#087568;background:#eef8f6}
 .ecosystem-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem}.ecosystem-card{min-width:0;border:1px solid #d9e4e6;border-radius:26px;overflow:hidden;background:#fff;display:flex;flex-direction:column}.ecosystem-card figure{margin:0;padding:1rem;background:#fafcfc}.ecosystem-card img{width:100%;height:auto;aspect-ratio:1.6;object-fit:contain;max-height:330px}.ecosystem-copy{padding:1.5rem;flex:1;display:flex;flex-direction:column}.ecosystem-copy h4,.ecosystem-stage-pair h4,.ecosystem-home-scenes h4,.ecosystem-review-flow h4{font-size:1.3rem;line-height:1.45;margin:.5rem 0}.ecosystem-copy>p{margin:.4rem 0 1.1rem;line-height:1.7}.ecosystem-copy>a{margin-top:auto}.ecosystem-link{display:flex;align-items:center;justify-content:space-between;gap:.5rem;min-height:48px;border-top:1px solid #e2e9ec;padding-top:.85rem;color:#8f2879;font-weight:700;text-decoration:none!important}.ecosystem-link:hover{color:#08746f}.ecosystem-link:focus-visible{outline:3px solid #8f2879;outline-offset:4px;border-radius:6px}
 .ecosystem-planning{display:flex;align-items:flex-start;gap:1rem;background:#f4f9fc;padding:1.3rem;border-radius:20px;margin:1.5rem 0}.ecosystem-planning>svg{color:#087568;margin-top:.4rem}.ecosystem-planning p{margin:0}.ecosystem-planning strong{display:block;margin-bottom:.4rem}.ecosystem-stage-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem;list-style:none;padding:0;margin:1.8rem 0}.ecosystem-stage-pair>li{display:flex;align-items:flex-start;gap:.8rem;padding:1.2rem;border:1px solid #d9e4e6;border-radius:20px;background:#fff}.ecosystem-stage-pair .local-stage-number{flex:none;margin:.3rem 0 0}.ecosystem-stage-pair h4{margin-top:0}.ecosystem-stage-pair p{margin:.5rem 0}.ecosystem-stage-final{grid-template-columns:1fr}.ecosystem-family{display:flex;align-items:flex-start;gap:.8rem;border-left:4px solid #087568;padding:1rem 1.2rem;background:#f3faf7}.ecosystem-family>svg{color:#087568;margin-top:.4rem}.ecosystem-family p{margin:0}.ecosystem-family strong{display:block;margin-bottom:.35rem}
 .ecosystem-statement{font-size:clamp(1.45rem,2.5vw,2rem);font-weight:700;line-height:1.5!important;margin:2rem 0}.ecosystem-home-scenes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;background:#fcf7fc;border-radius:24px;padding:1.6rem}.ecosystem-home-scenes>div{padding:.4rem .7rem}.ecosystem-home-scenes svg{color:#96277e}.ecosystem-module-links{display:flex;flex-wrap:wrap;gap:.8rem;margin:1.3rem 0}.ecosystem-module-links a{display:flex;align-items:center;gap:.5rem;font-weight:700;padding:.7rem .9rem;border:1px solid #d9c7e0;border-radius:14px;min-height:48px}.ecosystem-review-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:1rem;padding:1.6rem;background:#f7f4fc;border-radius:24px}.ecosystem-review-flow>div{padding:.5rem}.ecosystem-review-flow>span{font-size:1.6rem;color:#7537a5}.ecosystem-review-flow svg{color:#7537a5}.ecosystem-review-flow p{margin-bottom:0}
 .ecosystem-planning p a,.ecosystem-source-note p a{text-decoration:underline;text-underline-offset:.18em;text-decoration-thickness:1px}
 .ecosystem-source-note{display:flex;align-items:flex-start;gap:.8rem;padding:1.2rem;margin:2rem 0;background:#f4f9fc;border-radius:18px}.ecosystem-source-note>svg{color:#087568;margin-top:.4rem}.ecosystem-source-note p{margin:0;font-size:1rem;line-height:1.7}.ecosystem-evidence{display:grid;grid-template-columns:1fr 1.15fr;gap:2rem;align-items:start;margin-top:3rem}.ecosystem-evidence h3{font-size:1.8rem;line-height:1.3}.ecosystem-evidence-links{display:grid;gap:.8rem}.ecosystem-evidence-links>a{display:flex;align-items:flex-start;gap:1rem;padding:1.3rem;border:1px solid #d9e4e6;border-radius:20px;text-decoration:none}.ecosystem-evidence-links>a>svg{margin-top:.3rem}.ecosystem-evidence-links>a>svg:last-child{margin-left:auto}.ecosystem-evidence-links strong{display:block;font-size:1.25rem;margin-bottom:.45rem}.ecosystem-evidence-links span>span{display:block;color:#293b58;line-height:1.65}.ecosystem-next{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;margin-top:2.5rem;padding:1.6rem;border-left:5px solid #92207f;background:#fcf7fc;border-radius:0 24px 24px 0}.ecosystem-next p{margin-bottom:0}
 @media(max-width:1000px){.ecosystem-system{gap:1.4rem;padding:1.3rem}.ecosystem-chapter-nav{grid-template-columns:repeat(2,minmax(0,1fr))}.ecosystem-home-scenes{gap:.5rem;padding:1rem}.ecosystem-review-flow{gap:.5rem;padding:1rem}}@media(max-width:760px){.ecosystem-system,.ecosystem-grid,.ecosystem-stage-pair,.ecosystem-home-scenes,.ecosystem-evidence{grid-template-columns:1fr}.ecosystem-system{padding:1rem;gap:1rem;border-radius:24px}.ecosystem-system h3{font-size:1.8rem}.ecosystem-copy{padding:1.25rem}.ecosystem-card img{aspect-ratio:auto;max-height:330px}.ecosystem-chapter>header{gap:.8rem}.ecosystem-chapter-mark{width:48px;height:48px;font-size:1.7rem;border-radius:14px}.ecosystem-chapter-nav a{padding:.8rem;gap:.45rem;font-size:.95rem}.ecosystem-chapter-nav a>svg{display:none}.ecosystem-review-flow{grid-template-columns:1fr}.ecosystem-review-flow>span{transform:rotate(90deg);justify-self:center}.ecosystem-home-scenes>div{padding:1rem .7rem}.ecosystem-source-note,.ecosystem-next{padding:1.2rem}.ecosystem-family{padding:1rem}.ecosystem-stage-pair>li{padding:1rem}}
</style>
