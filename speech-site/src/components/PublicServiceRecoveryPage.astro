---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import TherapyTogether from './TherapyTogether.astro';
import {recoveryServices} from '../data/public-service-recovery';
import {assessmentContent} from '../data/assessment-content';
import {phone,url} from '../data/site';
import emblem from '../assets/pinnacle-emblem-official.png';
const content=recoveryServices[Astro.props.kind as keyof typeof recoveryServices];
const enquiry=url('/enroll-autism-speech-aba-therapies-india?service=help');
const faqs=[{question:content.question,answer:content.answer},{question:'What should I confirm before a visit?',answer:'Confirm the suitable service, professional and qualifications, preferred centre, appointment, fee and what explanation or written output is included.'},{question:'Does an enquiry diagnose my child?',answer:assessmentContent.faqs.find(x=>x.question==='Does this assessment diagnose autism or ADHD?')!.answer}];
---
<PageLayout path={content.path} title={content.title} description={content.description} label={content.label} shareImage={emblem} imageAlt="Pinnacle Blooms Network emblem" imageCaption="Pinnacle Blooms Network" documentOnly includeService={false} updatedOn="2026-10-13" faqs={faqs} citations={[url('/speech-aba-autism-assessments'),url('/verify/'),url('/policies')]} enquiry={{url:enquiry,mobileLabel:'Enquire'}}>
 <article class="care-route wrap">
  <header class="care-route-opening"><p class="eyebrow">Pinnacle Blooms Network · {content.label}</p><h1>{content.opening}<br/><em>{content.emphasis}</em></h1><p class="care-route-lead">{content.lead}</p><div class="care-route-actions"><a class="button primary" href={phone.href} data-cta="hero-call"><Icon name="phone"/>Call {phone.display}</a><a class="button outline" href={enquiry} data-cta="hero-enquiry">Request a conversation <Icon name="arrow"/></a></div><p class="care-route-note">Free telephone guidance, 24/7 · Professional, appointment and fees confirmed with you.</p></header>
  <section aria-labelledby="care-route-question"><p class="eyebrow">A useful first answer</p><h2 id="care-route-question">{content.question}</h2><p>{content.answer}</p><div class="care-route-moments">{content.moments.map((moment,i)=><div><Icon name={['home','people','compass'][i]}/><h3>{moment}</h3><p>{['Start with a meaningful example from your child’s actual day.','Bring your questions and relevant reports you already have.','Ask what happens next, who will help and how progress will be reviewed.'][i]}</p></div>)}</div><p>{content.next}</p></section>
  <section aria-labelledby="care-route-path"><p class="eyebrow">Child centred · Parent and family centred</p><h2 id="care-route-path">A starting picture.<br/>A plan with a purpose.</h2><p>{assessmentContent.direct}</p><ol class="care-route-stages">{assessmentContent.stages.map(stage=><li><a href={stage.path}><Icon name={stage.icon}/><strong>{stage.title}</strong></a><p>{stage.text}</p></li>)}</ol><a class="text-link" href="/speech-aba-autism-assessments">Understand child development assessment →</a></section>
  <section aria-labelledby="care-route-therapies"><p class="eyebrow">Choose relevant support</p><h2 id="care-route-therapies">Explore the service.<br/>Connect it with everyday life.</h2><TherapyTogether active="" /><p><a href="/physiotherapy">Physiotherapy enquiries</a> · <a href="/child-psychological-counseling">Child psychology and counselling</a> · <a href="/centers">Find a centre</a></p><p class="care-route-note">A published centre or service page is not a current appointment roster. We confirm the suitable professional and arrangements before your visit.</p></section>
  <section id="questions" aria-labelledby="care-route-questions"><p class="eyebrow">Before you choose</p><h2 id="care-route-questions">Your questions. A clear next step.</h2>{faqs.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</section>
  <section class="care-route-close" aria-labelledby="care-route-next"><h2 id="care-route-next">One question today.<br/>A clearer next step for your family.</h2><p>Tell us what your child enjoys and what you want to make more possible. We will help check the right first conversation.</p><div class="care-route-actions"><a class="button primary" href={phone.href} data-cta="final-call"><Icon name="phone"/>Call {phone.display}</a><a class="button outline" href={enquiry} data-cta="final-enquiry">Enquire at Pinnacle <Icon name="arrow"/></a></div><p><a href="/national-autism-helpline">National Autism Helpline</a> · <a href="/verify/">Licences, research and evidence</a> · <a href="/policies">Our policies</a></p></section>
 </article>
</PageLayout>
<style>
 .care-route{padding-top:44px;padding-bottom:60px}.care-route-opening{max-width:920px}.care-route h1{font-size:clamp(2.2rem,4vw,3.8rem);line-height:1.14;letter-spacing:-.035em}.care-route h1 em{color:#652579;font-style:normal}.care-route-lead{font-size:clamp(1.12rem,1.7vw,1.4rem);line-height:1.7;max-width:850px}.care-route p{line-height:1.75}.care-route-actions{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0 16px}.care-route-note{font-size:1rem;color:#46536d}.care-route section{padding:48px 0;border-top:1px solid #e6dde8;margin-top:32px}.care-route h2{font-size:clamp(1.7rem,3vw,2.6rem);line-height:1.25}.care-route-moments{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:28px 0}.care-route-moments>div{border:1px solid #ded5e2;border-radius:22px;padding:24px;background:#fbf8fc}.care-route h3{font-size:1.1rem;line-height:1.5}.care-route-stages{padding-left:26px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 36px;margin:28px 0}.care-route-stages a{display:flex;gap:8px;align-items:center}.care-route details{padding:18px 0;border-bottom:1px solid #e6dde8}.care-route summary{font-weight:700;cursor:pointer;line-height:1.6}.care-route-close{max-width:900px}.care-route a:not(.button){text-decoration:underline;text-underline-offset:3px}@media(max-width:700px){.care-route{padding-top:28px}.care-route-moments,.care-route-stages{grid-template-columns:1fr}.care-route section{padding:30px 0}.care-route-actions .button{min-height:48px}}
</style>
