---
import PageLayout from '../layouts/PageLayout.astro';
import ActionStrip from './ActionStrip.astro';
import CentreDirectory from './CentreDirectory.astro';
import Icon from './Icon.astro';
import TherapyBookCompanion from './TherapyBookCompanion.astro';
import { Image } from 'astro:assets';
import emblem from '../assets/pinnacle-emblem-official.png';
import earlyPlay from '../assets/occupational-everyday-steps-20261005.png';
import lifeInView from '../assets/occupational-life-in-view-20260930.png';
import firstConversation from '../assets/occupational-first-conversation-20260930.png';
import observeReview from '../assets/occupational-observe-review-20260930.png';
import occupationalCreative from '../assets/occupational-therapy-pinnacle-creative-20260929.png';
import { occupationalContent as content, occupationalEnquiry, occupationalRoutes } from '../data/occupational-content';
import { phone, url } from '../data/site';
import '../styles/occupational.css';

const canonical = url(content.path);
const mobileCentreAction = {url:'#centres',mobileLabel:'Find a centre'};
const whatsappShare = 'https://wa.me/?text=' + encodeURIComponent('Occupational therapy for everyday life at Pinnacle Blooms. Start with one activity that matters: ' + canonical);
const firstCallSteps = [
  ['heart','Tell us the moment','Share one activity you would like your child to enjoy or manage more confidently.'],
  ['pin','Check who and where','We help check a suitable centre, current OT professional, appointment and fees.'],
  ['people','Meet the professional','At an appropriate visit, the OT listens and observes through age-appropriate activity.'],
  ['compass','Agree a first goal','Understand what the team proposes to learn or try next, and why it matters in daily life.']
];
const reviewQuestions = [
  ['What did your child do?','Name the activity, not just an exercise score.'],
  ['Where did it happen?','Look for use at home, in play, at school or elsewhere.'],
  ['What support was needed?','Notice the people, materials and setting that helped.'],
  ['What should change next?','Use the answer to adjust the goal, method or environment.']
];
---
<PageLayout
  path={content.path}
  label={content.label}
  serviceName={content.name}
  serviceType={content.type}
  serviceAreaServed={null}
  title={content.title}
  description={content.description}
  socialTitle="Occupational Therapy for Everyday Life | Pinnacle Blooms"
  socialDescription="Start with one activity that matters to your child. See how assessment, therapy, family practice and review connect to life at home and school."
  citations={content.citations}
  faqs={content.faqs}
  imageAlt="Pinnacle Blooms Occupational Therapy poster: Everyday skills. A life that grows. Call 9100 181 181."
  imageCaption="Occupational therapy for everyday activities and growing participation at Pinnacle Blooms Network."
  shareImage={occupationalCreative}
  shareVersion="20260930-chatgpt"
  publishedOn="2026-09-29"
  updatedOn="2026-10-05"
  enquiry={mobileCentreAction}
>
  <section class="ot-hero" aria-labelledby="occupational-title">
    <div class="wrap ot-hero-grid">
      <div class="ot-hero-copy">
        <p class="eyebrow"><span class="brand-dot"></span>Pinnacle Blooms Network® · Children's OT</p>
        <h1 id="occupational-title">Occupational therapy for children. <em>More ways to take part in everyday life.</em></h1>
        <p class="ot-hero-lead">Play, mealtimes, dressing and learning with others can all matter. Tell us one moment you would like your child to enjoy or manage more confidently.</p>
        <div class="ot-hero-actions">
          <a class="button primary" href={phone.href} data-cta="ot-hero-call"><Icon name="phone"/>Call {phone.display}</a>
          <a class="button outline" href="#centres" data-cta="ot-hero-centres"><Icon name="pin"/>Find a Pinnacle centre</a>
        </div>
        <p class="ot-hero-help">Free staffed telephone guidance, 24/7. Ask us to check the suitable OT professional, centre, visit and fees before you decide. <a href={url('/national-autism-helpline')}>How the Pinnacle/BHCL helpline works →</a></p>
      </div>
      <figure class="ot-hero-art">
        <Image src={earlyPlay} widths={[480,720,960,1200]} sizes="(min-width:960px) 48vw, calc(100vw - 36px)" width={earlyPlay.width} height={earlyPlay.height} format="webp" quality={82} loading="eager" fetchpriority="high" alt="Pinnacle Blooms Occupational Therapy: Small everyday steps. More life to join. A child explores a jacket zip with their mother and therapist. Call 9100 181 181."/>
      </figure>
    </div>
    <div class="wrap ot-hero-direction"><Icon name="compass" size={30}/><p><strong>Start with the life you want your child to join.</strong> Your child's growing self-sufficiency and participation in family, school and community life guide what the OT assesses, which goals and people fit, what your family practises and what we review together.</p></div>
  </section>
  <ActionStrip focused firstLabel="Your first conversation" firstHref="#first-conversation" evidenceHref="#evidence" enrolHref={occupationalEnquiry}/>

  <span class="legacy-section-anchor" id="service-fit" aria-hidden="true"></span>
  <section class="section wrap ot-recognition" id="family-moments" aria-labelledby="ot-moments-title">
    <div class="ot-section-heading">
      <p class="eyebrow">Start with your child’s day</p>
      <h2 id="ot-moments-title">What would you like to become <em>easier?</em></h2>
      <p>For a younger child, it may be reaching for a toy or joining a meal. For another, it may be dressing, handling learning materials or taking part in a school morning. Your child is more than a label or checklist. Begin with what you notice; a diagnosis is not required to make the first call.</p>
    </div>
    <ol class="ot-three-questions" aria-label="Three questions that guide the work">
      <li><span>01</span><strong>What matters in your child’s life?</strong></li>
      <li><span>02</span><strong>What will we try together?</strong></li>
      <li><span>03</span><strong>Is it helping in daily life?</strong></li>
    </ol>
    <div class="ot-route-grid">{occupationalRoutes.map((route,i)=><details class="ot-route">
      <summary><span class="ot-route-icon"><Icon name={route.icon} size={28}/></span><span><small>Everyday activity {i+1}</small><strong>{route.title}</strong><span class="ot-route-short">{route.short}</span></span><span class="ot-route-plus" aria-hidden="true">+</span></summary>
      <p>{route.detail}</p>
    </details>)}</div>
    <p class="ot-context-note">Autism, ADHD or developmental delay may be part of a child’s story. The activity and individual assessment determine whether OT and any particular approach are appropriate.</p>
  </section>

  <section class="section ot-answer" id="what-ot-does" aria-labelledby="ot-answer-title"><div class="wrap ot-answer-grid">
    <div><p class="eyebrow">A direct answer</p><h2 id="ot-answer-title">What does occupational therapy help a child do?</h2><p class="ot-answer-lead">A child’s occupational therapist looks at <strong>the child, the activity and the surroundings together.</strong> They observe what helps or gets in the way, choose a meaningful goal with the family, then use suitable practice, adaptations and review to support participation in everyday life.</p><p>That may mean changing a task’s steps, materials, environment or support. The assessment determines which approach fits. Your family should be able to ask, in plain words: <strong>what are we working toward, and why?</strong></p></div>
    <aside class="ot-definition-card"><Icon name="home" size={42}/><h3>Life is made of everyday activities.</h3><p>Self-care, play, learning and time with other people all belong in the occupational-therapy conversation when they matter to the child.</p><div><a href="https://wfot.org/about/about-occupational-therapy">WFOT · what OT is ↗</a><a href="https://www.aota.org/practice/domain-and-process/occupations-everyday-activities">AOTA · everyday occupations ↗</a></div><small>Professional descriptions of OT; they are not endorsements of Pinnacle.</small></aside>
  </div></section>

  <span class="legacy-section-anchor" id="assessment-start" aria-hidden="true"></span>
  <section class="section wrap ot-first-call" id="first-conversation" aria-labelledby="ot-first-title">
    <div class="ot-first-heading"><div><p class="eyebrow">Your first step is a conversation</p><h2 id="ot-first-title">Bring one everyday moment. <em>We’ll help find the starting point.</em></h2></div><p>Call and tell us which activity matters most to your family. We will listen and help check a suitable OT conversation, location, current availability, appointment and fees before you choose a visit.</p></div>
    <ol class="ot-call-steps">{firstCallSteps.map(([icon,title,copy],i)=><li><span class="ot-step-number">{i+1}</span><Icon name={icon} size={30}/><h3>{title}</h3><p>{copy}</p></li>)}</ol>
    <div class="ot-call-panel"><div><strong>One useful call. A clearer next step.</strong><p>At the first professional conversation, an OT can hear your priorities, observe your child through suitable activities and discuss a starting goal. Bring your own observations or existing information if you wish.</p><small>The guidance itself is free; ordinary network call charges may apply. Centre visits and therapy have separately confirmed fees.</small></div><a class="button primary" href={phone.href} data-cta="ot-first-call"><Icon name="phone"/>Call {phone.display}</a></div>
  </section>

  <span class="legacy-section-anchor" id="everyday-participation" aria-hidden="true"></span>
  <section class="section ot-goal" id="goal-in-life" aria-labelledby="ot-goal-title"><div class="wrap">
    <div class="ot-goal-grid"><div class="ot-goal-copy"><p class="eyebrow">An illustrative example</p><h2 id="ot-goal-title">Getting ready is about <em>joining in.</em></h2><p>A preschool child wants to put on a favourite jacket before joining play. The family and OT choose one manageable part of getting ready. In this example, the child reaches for the zip and wants to try, but finds lining up its two parts difficult while standing.</p><p><strong>The goal is taking part in getting ready.</strong> We look at the child, the jacket, the position and the help needed together—not just the fastener.</p></div><figure class="ot-goal-art"><Image src={firstConversation} widths={[480,720,960,1280]} sizes="(min-width:960px) 53vw, calc(100vw - 36px)" width={firstConversation.width} height={firstConversation.height} format="webp" quality={80} loading="lazy" decoding="async" alt="A child explores a jacket fastener with their mother and a professional wearing a full-sleeve Pinnacle Blooms coat."/><figcaption>A familiar activity gives the professional conversation a starting point.</figcaption></figure></div>
    <ol class="ot-goal-cycle"><li><span>1</span><strong>Notice the exact step</strong><p>The child wants to try. Aligning the two zip parts is difficult in this standing position.</p></li><li><span>2</span><strong>Make a supported start</strong><p>The OT and family choose comfortable supported sitting and a larger zip pull. An adult connects the zip at the bottom.</p></li><li><span>3</span><strong>Let the child take part</strong><p>The child tries pulling up the zip with the help they need. Practice is unhurried; they can ask for help or stop.</p></li><li><span>4</span><strong>Review what happened</strong><p>Name the step completed, position, comfort and help needed. Use that observation to decide what to adapt next.</p></li></ol>
    <aside class="ot-observation" aria-labelledby="ot-observation-title"><Icon name="heart" size={34}/><div><h3 id="ot-observation-title">An observation the team can use</h3><p>“With the jacket on, seated and with an adult starting the zip, my child pulled it up using the larger pull.”</p><small>This describes one supported step. Managing the whole jacket or doing it in another setting needs its own observation.</small></div></aside>
    <div class="ot-other-examples"><article><Icon name="loop"/><h3>If the pull is still difficult</h3><p>The OT may adjust the pull, position or amount of help. The next decision follows the child’s response, rather than simply adding repetitions.</p></article><article><Icon name="book"/><h3>If it works in that setting</h3><p>Discuss a suitable next step or another familiar setting. Check comfort and support again; one success does not show independent dressing everywhere.</p></article></div>
    <p class="source-note ot-source-links">This example explains a decision; it is not a patient result or an individual recommendation. General dressing adaptations: <a href="https://www.ghc.nhs.uk/our-teams-and-services/children-and-young-people/physical-health/childrens-occupational-therapy/">Gloucestershire NHS · dressing and zips</a> and <a href="https://www.chesterfieldroyal.nhs.uk/all-services-and-wards/childrens-occupational-therapy/getting-dressed">Chesterfield NHS · getting dressed</a>.</p>
  </div></section>

  <section class="section wrap ot-life" id="pinnacle-difference" aria-labelledby="ot-life-title">
    <div class="ot-life-grid"><div><p class="eyebrow">The PinnacleAI® life-first paradigm shift</p><h2 id="ot-life-title">The activity is a step. <em>Your child’s life gives it direction.</em></h2><p>At Pinnacle, we begin with the question: <strong>what should this child be able to do in their own life?</strong> If the goal is getting ready to join play, that purpose guides what abilities we look at, what the OT assesses, whether another professional is needed, what the family can practise and what we check next.</p><p>You help choose what matters. The professional team shapes suitable care around that goal. We ask whether an ability works where your child lives, plays and learns, and change course when the connection is missing.</p><a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>See the documented life-first approach <Icon name="arrow"/></a></div><figure class="ot-life-art"><Image src={lifeInView} widths={[480,760,1100,1536]} sizes="(min-width:960px) 50vw, calc(100vw - 36px)" width={lifeInView.width} height={lifeInView.height} format="webp" quality={80} loading="lazy" decoding="async" alt="Illustrated path from a child managing a bag with family support to joining a friend and taking part in learning."/><figcaption>Home, people and learning remain in view together.</figcaption></figure></div>
    <div class="ot-purpose"><Image src={emblem} width={52} height={52} format="webp" alt=""/><p><strong>The life we work toward:</strong> growing self-sufficiency, school readiness, mainstream participation and a wonderful life—with appropriate support for each child.</p></div>
    <ol class="ot-stage-peek" aria-label="Seven connected stages">{content.pathway.stages.map(([icon,title],i)=><li><span class="ot-stage-step"><b>{i+1}</b><Icon name={icon} size={21}/></span><strong>{title}</strong></li>)}</ol>
    <nav class="ot-system-links" aria-label="Explore the PinnacleAI system"><a href={url('/pinnacleai')}>Explore PinnacleAI <Icon name="arrow"/></a><a href={url('/everyday-therapy')}>Everyday practice with guidance <Icon name="home"/></a><a href={url('/fusion-module')}>Track and correct <Icon name="loop"/></a><a href={url('/reassess-review-repeat')}>Reassess and review <Icon name="measure"/></a></nav>
    <details class="ot-stage-disclosure"><summary><span><strong>Explore the seven connected stages</strong><small>See how an OT goal travels from understanding to everyday participation.</small></span><span aria-hidden="true">+</span></summary><ol>{content.pathway.stages.map(([icon,title,copy],i)=><li><span class="ot-stage-icon"><b>{i+1}</b><Icon name={icon} size={29}/></span><h3>{title}</h3><p>{copy}</p></li>)}</ol><p>The stages explain the family journey. They do not promise a particular result or replace the OT’s individual assessment.</p></details>
  </section>

  <section class="section ot-review" id="review-progress" aria-labelledby="ot-review-title"><div class="wrap">
    <div class="ot-review-heading"><div><p class="eyebrow">Your observations belong in review</p><h2 id="ot-review-title">How will we know whether the goal <em>helps in real life?</em></h2></div><p>You and the OT can name a starting point and agree what participation would look like. What happens beyond the therapy room helps the team decide what to keep, adapt or reconsider. Home practice should be manageable, not a test of the parent.</p></div>
    <ol class="ot-review-questions">{reviewQuestions.map(([question,answer],i)=><li><span>0{i+1}</span><h3>{question}</h3><p>{answer}</p></li>)}</ol>
    <figure class="ot-review-art"><Image src={observeReview} widths={[480,760,1100,1536]} sizes="(min-width:960px) 1020px, calc(100vw - 36px)" width={observeReview.width} height={observeReview.height} format="webp" quality={78} loading="lazy" decoding="async" alt="A mother watches her child practise a familiar activity at home, then discusses observations with an occupational therapist while her child plays nearby."/><figcaption><Image src={emblem} width={35} height={35} format="webp" alt=""/><span>What you notice at home helps shape the next professional review.</span></figcaption></figure>
    <div class="ot-review-bottom"><div class="ot-team"><h3>Bring the right people around one goal.</h3><p>Some goals may benefit from speech therapy, behavioural support or special education. Those professionals contribute when assessment indicates their role; every child does not need every therapy.</p><nav aria-label="Related child development services"><a href={url('/top-speech-therapy-center-india-proven-improvement-rate')}>Speech therapy →</a><a href={url('/best-aba-therapy-center-india-proven-improvement-rate')}>Behavioural support / ABA →</a><a href={url('/best-special-education-center-call-9100181181')}>Special education →</a><a href={url('/autism-therapy')}>Integrated autism support →</a></nav></div><aside class="ot-technology"><Icon name="measure" size={37}/><h3>Where PinnacleAI® fits</h3><p><a href={url('/abilityscore')}>AbilityScore®</a> can help record a structured starting picture. The <a href={url('/seven-readiness-indexes')}>seven Readiness Indexes</a> can focus discussion about readiness. PinnacleAI GPT-OS v1.0.0 is licensed as non-diagnostic developmental-support software for children aged 0–12, supporting ability mapping, readiness tracking, forecasting and plan support.</p><p><strong>Professionals interpret the information and decide care with your family.</strong> A number never defines your child or the life you are working toward.</p><a href={url('/verify/evidence/records/md5.html')}>Inspect the MD-5 software scope →</a><a href={url('/verify/evidence/records/bis.html')}>See the BIS schedule and modules →</a></aside></div>
  </div></section>

  <TherapyBookCompanion kind="occupational"/>
  <section class="section wrap ot-proof" id="evidence" aria-labelledby="ot-proof-title">
    <div class="ot-section-heading"><p class="eyebrow">Confidence you can inspect</p><h2 id="ot-proof-title">Know the place. <em>See the evidence.</em></h2><p>Choose a location, see available centre photos and address details, then ask who can provide occupational therapy there. We publish records behind the organisation, technology and research so you can inspect them before deciding.</p></div>
    <div class="ot-proof-grid"><article><span class="ot-proof-icon"><Icon name="measure" size={30}/></span><p class="eyebrow">Documented work</p><h3>31,052,382 defined services</h3><p>A dated factual-findings report counted cumulative services, including therapies, assessments, screenings and parent training, as at 17 July 2026. This is service volume, not OT outcomes.</p><a href={url('/verify/evidence/assurance-map.html')}>See the count and its scope →</a></article><article><span class="ot-proof-icon"><Icon name="shield" size={30}/></span><p class="eyebrow">Licensed support technology</p><h3>Class B · non-diagnostic</h3><p>Form MD-5 lists PinnacleAI GPT-OS v1.0.0 as developmental-support software. The BIS record describes its named software scope. Neither certifies an OT or guarantees a therapy result.</p><a href={url('/verify/evidence/records/md5.html')}>Read the MD-5 record →</a><a href={url('/verify/evidence/records/bis.html')}>Read the BIS record →</a></article><article><span class="ot-proof-icon"><Icon name="book" size={30}/></span><p class="eyebrow">Open research trail</p><h3>Follow each work to its source.</h3><p>Explore original publications and summaries with their actual publication status. A study’s presence in the library does not establish an outcome for your child.</p><a href={url('/verify/evidence/research-library.html')}>Explore the research library →</a></article></div>
    <p class="source-note ot-source-links"><a href="/pinnacle-pages-data/occupational-therapy-evidence.txt">Claims and sources for this page</a> · <a href="/pinnacle-pages-data/occupational-therapy-evidence.json">Download the source map (JSON)</a> · <a href={url('/verify/evidence/cite.html')}>How to cite Pinnacle evidence</a></p>
  </section>

  <CentreDirectory pagePath={content.path} enquiryTarget={occupationalEnquiry}/>

  <section class="section wrap faq-section ot-faq" id="questions" aria-labelledby="ot-faq-title"><div><p class="eyebrow">Before you decide</p><h2 id="ot-faq-title">Eight clear answers. <em>One useful next step.</em></h2><p>Begin with the activity in your child’s day. We can help confirm the right professional and place.</p></div><div>{content.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></section>

  <section class="final-cta ot-final" id="next-step" aria-labelledby="ot-next-title"><div class="wrap"><div class="close-sun official-close"><Image src={emblem} width={96} height={96} format="webp" loading="lazy" alt="Pinnacle Blooms Network emblem"/></div><p class="eyebrow">Every Child Counts®</p><h2 id="ot-next-title">Start with one moment that matters.</h2><p>Call and tell us what you would like your child to do with more confidence. We will listen, help check the suitable OT professional, centre, appointment and fees, then explain the next step before you decide.</p><div class="final-actions"><a class="button white" href={phone.href} data-cta="ot-final-call"><Icon name="phone"/>Call {phone.display}</a><a class="button light-outline" href="#centres" data-cta="ot-final-centres">Find a centre <Icon name="arrow"/></a><a class="button light-outline" href={occupationalEnquiry} data-cta="ot-final-enrol">Begin enrolment <Icon name="arrow"/></a></div><p class="ot-final-guidance">Free, staffed telephone guidance 24/7. Ordinary network call charges may apply. Centre visits and therapy have separately confirmed fees.</p><div class="ot-share-actions"><a href={whatsappShare} target="_blank" rel="noopener noreferrer" data-cta="ot-share-whatsapp">Share this page on WhatsApp ↗</a><button type="button" data-ot-share hidden>Share with family</button><button type="button" data-ot-copy hidden>Copy page link</button><p data-ot-share-status role="status" aria-live="polite"></p></div><a class="helpline-link" href={url('/national-autism-helpline')}>Pinnacle / BHCL National Autism Helpline →</a></div></section>
<script>
  const shareButton = document.querySelector<HTMLButtonElement>('[data-ot-share]');
  const copyButton = document.querySelector<HTMLButtonElement>('[data-ot-copy]');
  const status = document.querySelector<HTMLElement>('[data-ot-share-status]');
  const pageUrl = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href || location.href;
  if (shareButton && navigator.share) {
    shareButton.hidden = false;
    shareButton.addEventListener('click', async () => {
      try { await navigator.share({title:'Occupational Therapy for Everyday Life | Pinnacle Blooms',url:pageUrl}); }
      catch (error) { if ((error as Error).name !== 'AbortError' && status) status.textContent = 'Use the WhatsApp link or copy the page link.'; }
    });
  }
  if (copyButton && navigator.clipboard) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pageUrl); if (status) status.textContent = 'Page link copied.'; }
      catch { if (status) status.textContent = 'Please copy the page address from your browser.'; }
    });
  }
</script>
</PageLayout>
