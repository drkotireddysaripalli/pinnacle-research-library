---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSlider from './HeroSlider.astro';
import ActionStrip from './ActionStrip.astro';
import Icon from './Icon.astro';
import LifePath from './LifePath.astro';
import TherapyTogether from './TherapyTogether.astro';
import CentreDirectory from './CentreDirectory.astro';
import EvidenceLinks from './EvidenceLinks.astro';
import { Image } from 'astro:assets';
import emblem from '../assets/pinnacle-emblem-official.png';
import schoolbagJourney from '../assets/occupational-schoolbag-journey-20260929.png';
import occupationalCreative from '../assets/occupational-therapy-pinnacle-creative-20260929.png';
import { occupationalContent as content, occupationalEnquiry } from '../data/occupational-content';
import { proofCards } from '../data/speech';
import { phone, url } from '../data/site';
---
<PageLayout path={content.path} label={content.label} serviceName={content.name} serviceType={content.type} title={content.title} description={content.description} citations={content.citations} faqs={content.faqs} imageAlt="Pinnacle Blooms occupational therapy story connecting therapy, home, learning and school participation, with the phone number 9100 181 181." imageCaption="Occupational therapy for everyday activities and growing independence at Pinnacle Blooms Network." shareImage={occupationalCreative} publishedOn="2026-09-29" updatedOn="2026-09-29" enquiry={content.enquiry}>
  <HeroSlider content={content} /><ActionStrip focused />

  <section class="section occupational-brand-story" aria-label="Occupational therapy from clinic practice to everyday participation">
    <div class="wrap">
      <figure>
        <Image src={occupationalCreative} widths={[640,960,1280,1680]} sizes="(min-width:1360px) 1280px, calc(100vw - 28px)" width={1680} height={945} format="webp" quality={84} loading="eager" decoding="async" fetchpriority="high" alt="Pinnacle Blooms occupational therapy pathway from professional support through home routines to school participation, with the words Everyday activities, growing independence and the contact number 9100 181 181."/>
        <figcaption>Professional support, family-guided practice and review connected to the everyday life the child is growing toward.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap service-fit" id="service-fit" aria-labelledby="ot-fit-title">
    <div class="fit-heading"><p class="eyebrow">The everyday activity is the starting point</p><h2 id="ot-fit-title">What would you like<br/><em>to become easier?</em></h2></div>
    <p class="occupational-intro">Occupational therapy focuses on participation in meaningful everyday activities—the things a child needs, wants or is expected to do. At Pinnacle, the activity is connected to the child’s wider life, family priorities and growing independence.</p>
    <div class="concern-grid">{content.concerns.map(concern=><article><span class="concern-icon"><Icon name={concern.icon} size={30}/></span><h3>{concern.title}</h3><p>{concern.copy}</p></article>)}</div>
    <p class="source-note">Occupational-therapy scope is described in plain language by the <a href="https://wfot.org/about/about-occupational-therapy">World Federation of Occupational Therapists ↗</a> and <a href="https://www.aota.org/practice/domain-and-process/occupations-everyday-activities">AOTA’s occupations guidance ↗</a>. These references do not endorse Pinnacle.</p>
    <div class="assessment-route" id="assessment-start"><a href="#first-conversation"><Icon name="clock"/>Your first conversation</a><a href="#centres"><Icon name="pin"/>Find your centre</a><a href="#questions"><Icon name="book"/>Common questions</a></div>
  </section>

  <section class="section occupational-first" id="first-conversation" aria-labelledby="ot-first-title"><div class="wrap occupational-first-grid">
    <div><p class="eyebrow">Begin with participation, not a label</p><h2 id="ot-first-title">Bring one everyday moment.<br/><em>We’ll help find the starting point.</em></h2><p>Tell us about an activity that matters: getting dressed, using a spoon, joining play, writing, packing a school bag or moving through a routine. The occupational therapist considers the child, the activity and the environment before discussing suitable next steps.</p><ul class="occupational-checks"><li><Icon name="heart"/><span><strong>Your priorities</strong>What your child and family want daily life to make possible.</span></li><li><Icon name="measure"/><span><strong>Professional assessment</strong>Observation, conversation and appropriate tools chosen by the therapist.</span></li><li><Icon name="compass"/><span><strong>A clear next step</strong>Goals, possible support, centre, appointment and fees explained before you decide.</span></li></ul><div class="occupational-actions"><a class="button primary" href={occupationalEnquiry}>Arrange a first conversation <Icon name="arrow"/></a><a class="button outline" href={phone.href}><Icon name="phone"/>Call {phone.display}</a></div></div>
    <aside class="occupational-definition"><Icon name="home" size={38}/><p class="eyebrow">A direct answer</p><h3>What is occupational therapy for children?</h3><p>It is professional support for a child’s participation in meaningful everyday activities. The work may address the activity, the abilities involved, the environment or a combination—based on individual assessment.</p><a href="https://wfot.org/about/about-occupational-therapy">Read the current WFOT definition →</a></aside>
  </div></section>

  <section class="section wrap difference" id="pinnacle-difference" aria-labelledby="ot-difference-title">
    <div class="story-heading"><p class="eyebrow">Seven connected stages · One life in view</p><h2 id="ot-difference-title">Do not stop at the exercise.<br/><em>Build toward the life it serves.</em></h2><p>A brick matters because it helps form a home. A car part matters because it helps make the journey possible. In the same way, an activity or technique gains direction from the everyday life your child is growing toward.</p></div>
    <p class="life-purpose-line">The life we work toward: <strong>growing self-sufficiency · mainstream participation · a wonderful life.</strong></p>
    <LifePath pathway={content.pathway}/>
    <a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Read the documented life-first approach <Icon name="arrow"/></a>
  </section>

  <section class="section occupational-example" id="everyday-participation" aria-labelledby="ot-example-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">One goal. Therapy, home and school connected.</p><h2 id="ot-example-title">Pack the school bag.<br/><em>Carry the ability into life.</em></h2></div><p>The point is not to complete a clinic activity once. The point is to understand what helps, practise appropriately and see whether the child can participate in the real routine with growing independence.</p></div>
    <figure class="occupational-story"><Image src={schoolbagJourney} widths={[480,800,1200,1664]} sizes="(min-width:1360px) 1280px, calc(100vw - 36px)" width={1664} height={934} format="webp" quality={80} loading="lazy" decoding="async" alt="An Indian child practises packing a school bag with an occupational-therapy professional and mother, then carries the bag while joining another child at school."/><figcaption>Illustrative pathway: assess the routine, agree the goal, practise with suitable support, observe at home or school, review and adjust.</figcaption></figure>
    <ol class="occupational-cycle"><li><span>1</span><h3>Choose a meaningful activity</h3><p>For example, packing a familiar school bag with the family.</p></li><li><span>2</span><h3>Understand the starting point</h3><p>Observe the sequence, materials, environment and support the child needs.</p></li><li><span>3</span><h3>Practise appropriately</h3><p>The therapist and family agree a manageable way to practise the routine.</p></li><li><span>4</span><h3>Review real participation</h3><p>Notice where it works, what support helps and what needs to change.</p></li></ol>
    <div class="technology-bridge"><Icon name="plan" size={30}/><p><strong>Where PinnacleAI fits.</strong> Its licensed scope includes ability measurement, readiness tracking, progress forecasting and adaptive plan support. Professionals review the information with the family; the software is non-diagnostic and does not replace clinical judgement. <a href={url('/verify/evidence/records/md5.html')}>Inspect the MD-5 scope ↗</a></p></div>
    <p class="source-note">This is an illustration of the process, not an actual child’s treatment plan or a promised result. The therapist defines assessment, goals, methods and review with the family.</p>
  </div></section>

  <section class="section wrap occupational-family" id="family-school" aria-labelledby="ot-family-title"><div><p class="eyebrow">Family knowledge belongs in the plan</p><h2 id="ot-family-title">The therapy room sees one moment.<br/><em>You see the rest of the day.</em></h2><p>Your observations help the team understand what happens during real routines: what made participation easier, what support was needed and where the activity still breaks down. The team uses that information in review without treating home practice as a test of the parent.</p><EvidenceLinks group="practice" label="How family observations and everyday practice connect"/></div><div class="occupational-family-cards"><article><Icon name="home"/><h3>At home</h3><p>Choose manageable moments that fit family life and the agreed plan.</p></article><article><Icon name="book"/><h3>At school</h3><p>When relevant, share useful observations about tasks, materials and participation.</p></article><article><Icon name="loop"/><h3>Back in review</h3><p>Use what happened to refine the goal, activity, environment or support.</p></article></div></section>

  <TherapyTogether current="occupational" />

  <section class="section evidence-section" id="evidence" aria-labelledby="ot-evidence-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">Confidence you can inspect</p><h2 id="ot-evidence-title">A clear promise.<br/><em>A visible evidence trail.</em></h2></div><p>Pinnacle publishes the organisation, software scope, research status and limitations behind its approach. A licence defines the software’s permitted scope; it does not guarantee an individual therapy result.</p></div>
    <div class="evidence-cards">{proofCards.map(card=><article><span class="proof-icon"><Icon name={card.title.startsWith('Class')?'shield':card.title.startsWith('BIS')?'plan':'book'} size={35}/></span><span class="card-tag">{card.tag}</span><h3>{card.title}</h3><p>{card.text}</p><span class="record-reference">{card.ref}</span><a class="text-link" href={url(card.link)}>{card.label} <Icon name="arrow"/></a></article>)}</div>
    <div class="occupational-source-grid"><article><h3>Occupational therapy definition</h3><p>WFOT explains participation in meaningful occupations, assessment, planning and cooperation with families and other professionals.</p><a href="https://wfot.org/about/about-occupational-therapy">World Federation of Occupational Therapists ↗</a></article><article><h3>Everyday activities and outcomes</h3><p>AOTA describes daily occupations including self-care, education, play, leisure and social participation.</p><a href="https://www.aota.org/practice/domain-and-process/occupations-everyday-activities">American Occupational Therapy Association ↗</a></article><article><h3>Rehabilitation and functioning</h3><p>WHO describes rehabilitation as support for functioning in interaction with the environment.</p><a href="https://www.who.int/news-room/fact-sheets/detail/rehabilitation">World Health Organization ↗</a></article></div>
    <p class="source-note source-downloads"><a href="/pinnacle-pages-data/occupational-therapy-evidence.txt">Claims and sources for this page</a> · <a href="/pinnacle-pages-data/occupational-therapy-evidence.json">Download source map (JSON)</a></p>
  </div></section>

  <CentreDirectory pagePath={content.path} enquiryTarget={occupationalEnquiry}/>

  <section class="section wrap faq-section" id="questions" aria-labelledby="ot-faq-title"><div><p class="eyebrow">Before you decide</p><h2 id="ot-faq-title">Clear answers.<br/><em>A practical next step.</em></h2><a class="text-link" href="https://wfot.org/about/about-occupational-therapy">Occupational therapy · WFOT ↗</a></div><div>{content.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></section>

  <section class="final-cta" id="next-step" aria-labelledby="ot-next-title"><div class="wrap"><div class="close-sun official-close"><Image src={emblem} width={96} height={96} format="webp" loading="lazy" alt="Pinnacle official pinwheel emblem"/></div><p class="eyebrow">Every Child Counts®</p><h2 id="ot-next-title">Start with one activity<br/>that matters in your child’s life.</h2><p>Tell us what you would like your child to do with greater participation.<br/>We’ll help you find a centre and arrange an appropriate first conversation.</p><div class="final-actions"><a class="button white" href={phone.href}><Icon name="phone"/>Call {phone.display}</a><a class="button light-outline" href={occupationalEnquiry}>Start a conversation <Icon name="arrow"/></a></div><div class="close-moments"><span><Icon name="home"/>A routine to manage.</span><span><Icon name="heart"/>A choice to make.</span><span><Icon name="people"/>A life to take part in.</span></div><p class="final-guidance">Free guidance, 24/7 · Service, professional, appointment and fees confirmed by the team.</p><a class="helpline-link" href={url('/national-autism-helpline')}>Pinnacle / BHCL National Autism Helpline →</a></div></section>
</PageLayout>
