---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSlider from './HeroSlider.astro';
import ActionStrip from './ActionStrip.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import AnalogyStories from './AnalogyStories.astro';
import LifePath from './LifePath.astro';
import campaign from '../assets/speech-life-campaign.png';
import firstVisit from '../assets/speech-first-visit.png';
import { faqs, phone, url, speechPath } from '../data/site';
import { steps, stepSources, centres, proofCards } from '../data/speech';
const { focused = false } = Astro.props;
const slides = [{image:campaign,alt:'Illustrative scene of a mother listening as her child points during play, with a school participation vignette.',caption:'AI-generated campaign illustration; not a patient outcome.'}];
---
<PageLayout path={speechPath} label="Speech Therapy" serviceName="Speech and language therapy for children" title="Speech Therapy for Children: Assessment & Care | Pinnacle Blooms" description="Explore speech therapy built around your child’s everyday life: assessment, family practice, progress review and PinnacleAI evidence. Call 9100 181 181." shareImage={campaign} focused={focused}>
  <HeroSlider slides={slides} /><ActionStrip focused />

  <section class="section wrap example-section" id="everyday-communication" aria-labelledby="example-title">
    <div class="story-heading"><p class="eyebrow">Small moments. Everyday possibilities.</p><h2 id="example-title">A way to ask.<br /><em>A chance to take part.</em></h2><p>Speech therapy supports understanding, expression and interaction. At Pinnacle, we connect those skills to the life your child is working toward.</p></div>
    <div class="worked-example">
      <div class="example-goal"><span class="example-label">One everyday goal</span><div class="spoken-goal"><Icon name="voice" size={48} /><strong>“I need help.”</strong></div><p>At home or school. Through speech, gestures or another appropriate communication method.</p></div>
      <ol class="example-scenes">
        <li><span class="example-scene-icon"><Icon name="people" size={42} /></span><span class="example-step">01 · Together</span><h3>Find a way to ask.</h3><p>Agree a useful communication goal with your child, family and therapist.</p></li>
        <li><span class="example-scene-icon"><Icon name="home" size={42} /></span><span class="example-step">02 · Everyday</span><h3>Take it into life.</h3><p>Practise in familiar routines, with the guidance and support your child needs.</p></li>
        <li><span class="example-scene-icon"><Icon name="loop" size={42} /></span><span class="example-step">03 · Review</span><h3>See what changes.</h3><p>Notice where it works and how much help is needed. Adjust the next step.</p></li>
      </ol>
    </div>
    <div class="review-question"><Icon name="track" size={27} /><p>The question we keep coming back to:<br /><strong>Where can your child use this—and with how much help?</strong></p></div>
    <p class="source-note">This is an illustrative planning and review example, not a patient case, product screenshot or individual treatment plan. <a href="https://www.asha.org/njc/communication-bill-of-rights/">Communication rights · NJC / ASHA ↗</a></p>
  </section>

  <AnalogyStories />

  <section class="section wrap difference" id="pinnacle-difference" aria-labelledby="difference-title">
    <div class="story-heading"><p class="eyebrow">Seven connected stages · One life in view</p><h2 id="difference-title">Start with the life.<br /><em>Work toward it every day.</em></h2><p>The purpose shapes the abilities, goals, people, methods, practice and review. Your family takes part throughout.</p></div>
    <LifePath />
    <a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Read the complete PinnacleAI paradigm-shift story <Icon name="arrow" /></a>
    <details class="technical-walkthrough" id="pinnacleai-steps"><summary><span><strong>Inside PinnacleAI: nine explanations of the technology</strong><small>Optional detail: how measurement, planning, practice and review connect.</small></span><span aria-hidden="true">+</span></summary><div class="technical-content"><p class="source-note">The seven stages above describe the family-facing pathway. These nine explanations unpack the philosophy and technology; they are not a separate nine-stage treatment programme.</p>
      <ol class="stack-grid">{steps.map((step,i)=><li class:list={['stack-card','phase-'+(Math.floor(i/3)+1)]}><div class="technical-step"><span class="step-top"><span class="step-number">{String(i+1).padStart(2,'0')}</span><Icon name={step.icon} size={27} /></span><h3>{step.title}</h3><strong>{step.layer}</strong><p>{step.detail}</p><a href={url(stepSources[i])}>Source and scope ↗</a></div></li>)}</ol>
      <p class="source-note">PinnacleAI GPT-OS v1.0.0 is non-diagnostic developmental-support software for children aged 0–12. Professionals guide care decisions with the family. The technology descriptions are linked to their public company and regulatory source records.</p>
    </div></details>
  </section>

  <section class="first-visit-section section" id="first-visit" aria-labelledby="visit-title"><div class="wrap">
    <div class="visit-story"><div class="visit-story-copy"><p class="eyebrow">Your first step</p><h2 id="visit-title">Bring your questions.<br /><em>Let’s find a starting point.</em></h2><p>Tell the therapist what matters to your family. Together, explore how your child communicates through conversation, play, structured tasks and observation.</p>
      <div class="visit-facts"><div><Icon name="clock" size={27} /><strong>About 1 hour</strong><span>Assessment, depending on your child.</span></div><div><Icon name="book" size={27} /><strong>A written report</strong><span>The guide allows a couple of days.</span></div><div><Icon name="plan" size={27} /><strong>₹2,599</strong><span>Published speech assessment price.</span></div></div>
      <a class="button primary" href={url('/enroll#contact-form-title')} data-cta="visit-enquiry">Request your child’s assessment <Icon name="arrow" /></a><p class="visit-price-note">Special Speech and Language Assessment · <a href={url('/speech-aba-autism-assessments')}>Catalogue checked 27 September 2026 ↗</a>. Confirm inclusions, timings and the current fee with your centre.</p>
    </div><figure class="visit-story-art"><Image src={firstVisit} widths={[480,720,1000]} sizes="(min-width: 1360px) 620px, (min-width: 761px) 48vw, calc(100vw - 36px)" width={1000} height={667} format="webp" quality={80} alt="Illustrative first visit: a mother and therapist listen as a child chooses a picture card." loading="lazy" decoding="async" /><figcaption>AI-generated illustration, not an actual patient, professional or centre.</figcaption><div class="visit-art-note"><Icon name="heart" size={27} /><strong>Your child.<br />Your questions.<br /><em>A shared starting point.</em></strong></div></figure></div>
    <details class="visit-practical"><summary>Session structure, fees and what to confirm <span aria-hidden="true">+</span></summary><p>The <a href={url(speechPath)}>published speech-service guide</a>, checked 27 September 2026, describes 40 minutes of therapy plus 5 minutes of parent review. Confirm the named therapist and qualifications, assessment/report timings, therapy schedule and centre-specific quotation before booking. This page does not reserve a slot.</p></details>
  </div></section>

  <section class="section evidence-section" id="evidence" aria-labelledby="evidence-title"><div class="wrap"><div class="split-heading"><div><p class="eyebrow">Open. Honest. Transparent. Self-critical.</p><h2 id="evidence-title">See what supports<br /><em>the PinnacleAI story.</em></h2></div><p>Open the licence, the named developmental modules and a relevant communication study. Each source answers a different question.</p></div>
    <div class="evidence-cards">{proofCards.map((card,i)=><article><span class="proof-icon"><Icon name={['shield','plan','measure'][i]} size={35} /></span><p class="card-tag">{card.tag}</p><h3>{card.title}</h3><p>{card.text}</p><span class="record-reference">{card.ref}</span><a class="text-link" href={url(card.link)}>{card.label} ↗</a></article>)}</div>
    <p class="source-note">Software licences describe the named device and documented scope. Research findings apply to the populations and methods studied. Your child’s goals and progress are individual.</p>
    <details class="research-detail"><summary>AbilityScore research: what is published and what is planned <span aria-hidden="true">+</span></summary><ul><li><a href={url('/verify/evidence/research-library.html#zenodo-19482123')}>Methodology and preliminary findings</a> — how AbilityScore is constructed; preliminary operational measurement findings.</li><li><a href={url('/verify/evidence/research-library.html#zenodo-19482476')}>External-validation protocol</a> — a planned study; it does not report completed external-validation results.</li></ul></details>
    <div class="evidence-bottom"><a class="button outline" href={url('/verify/')}><Icon name="book" />Explore Pinnacle Verify</a><a class="text-link" href={url('/verify/evidence/research-library.html')}>Research &amp; publication status →</a><a class="text-link" href={url('/verify/evidence/pinnacleai-regulatory-journey.html')}>Full story, including the Free Sale Certificate →</a></div>
  </div></section>

  <section class="section wrap centres-section" id="centres" aria-labelledby="centres-title"><div class="split-heading"><div><p class="eyebrow">People and places, closer to you</p><h2 id="centres-title">Find a Pinnacle centre.<br /><em>Meet the people behind the plan.</em></h2></div><p>Explore published centre and team details. Call to confirm the current address, speech therapist, qualifications and appointments before visiting.</p></div>
    <div class="centre-filter" hidden><label for="centre-city">Three example centres</label><select id="centre-city"><option value="all">Show all three</option>{centres.map(c=><option value={c.city}>{c.city}</option>)}</select><span id="centre-count" role="status">3 locations shown</span></div>
    <div class="centre-cards">{centres.map(centre=><article data-city={centre.city}><p class="card-tag">{centre.city}</p><h3>{centre.name}</h3><p>{centre.address}</p>{centre.team.length>0 ? <details class="listed-team"><summary>Speech therapists listed by this centre</summary><p>{centre.team.join(' · ')}</p></details> : <div class="listed-team"><strong>Speech appointments</strong><p>Contact the centre team to confirm the available professional.</p></div>}<a href={url(centre.path)} class="text-link" data-cta="centre-profile">View this centre and its team <Icon name="arrow" /></a></article>)}</div>
    <p class="source-note">Public centre pages checked 27 September 2026. Staff names are published listings; individual qualifications, registration and appointment availability still need confirmation. Explore other locations for the wider network.</p>
    <div class="centre-actions"><a href={url('/contact')} class="button outline" data-cta="all-centres"><Icon name="pin" />Explore other locations</a><a class="text-link" href={phone.href} data-cta="centre-call">Confirm a centre · {phone.display} →</a><a class="text-link" href={url('/verify/evidence/centre-entity-reference.html')}>Inspect centre registry references ↗</a></div>
  </section>

  <section class="section wrap faq-section" aria-labelledby="faq-title"><div><p class="eyebrow">Before you decide</p><h2 id="faq-title">Clear answers.<br /><em>A simpler next step.</em></h2><a class="text-link" href="https://www.asha.org/public/early-identification-of-speech-language-and-hearing-disorders/">Communication development · ASHA ↗</a></div><div>{faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></section>

  <section class="final-cta" id="next-step" aria-labelledby="next-title"><div class="wrap"><div class="close-sun"><Icon name="sun" size={52} /></div><p class="eyebrow">Every Child Counts®</p><h2 id="next-title">Your hopes deserve<br />a clear next step.</h2><p>Tell us what you want to become easier for your child.<br />Let’s discuss the assessment, the right centre and a way forward.</p><div class="final-actions"><a class="button white" href={phone.href} data-cta="final-call"><Icon name="phone" />Call {phone.display}</a><a class="button light-outline" href={url('/enroll#contact-form-title')} data-cta="final-enquiry">Request your child’s assessment <Icon name="arrow" /></a></div><div class="close-moments"><span><Icon name="voice" />A way to ask.</span><span><Icon name="heart" />A choice to make.</span><span><Icon name="people" />A life to take part in.</span></div><p class="final-guidance">Free guidance, 24/7 · Assessment and therapy fees are separate.</p><a class="helpline-link" href={url('/national-autism-helpline')}>Pinnacle / BHCL National Autism Helpline →</a></div></section>
</PageLayout>
<script>
  const select = document.querySelector<HTMLSelectElement>('#centre-city');
  const filter = document.querySelector<HTMLElement>('.centre-filter');
  if (select && filter) {
    filter.hidden = false;
    select.addEventListener('change', () => {
      let count = 0;
      for (const card of document.querySelectorAll<HTMLElement>('.centre-cards [data-city]')) {
        card.hidden = select.value !== 'all' && card.dataset.city !== select.value;
        if (!card.hidden) count++;
      }
      const status = document.querySelector('#centre-count');
      if (status) status.textContent = count + (count === 1 ? ' location shown' : ' locations shown');
    });
  }
</script>
