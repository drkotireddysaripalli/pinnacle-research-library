---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSlider from './HeroSlider.astro';
import ActionStrip from './ActionStrip.astro';
import Icon from './Icon.astro';
import AssessmentOffer from './AssessmentOffer.astro';
import EvidenceLinks from './EvidenceLinks.astro';
import { Image } from 'astro:assets';
import '../styles/speech-revision.css';

import emblem from '../assets/pinnacle-emblem-official.png';
import communicationJourney from '../assets/speech-communication-journey-branded-20260929.png';
import TherapyTogether from './TherapyTogether.astro';
import { speechContent, serviceInformationPath, speechStages } from '../data/speech-content';
import shareCard from '../assets/speech-share-20260928.png';
import firstVisit from '../assets/speech-first-visit-branded-20261001.png';
import decisionArt from '../assets/speech-everyday-review-branded-20261001.png';

import SpeechResources from './SpeechResources.astro';
import TherapyBookCompanion from './TherapyBookCompanion.astro';
import { speechOffer } from '../data/speech-offer';
import CentreDirectory from './CentreDirectory.astro';
import { phone, url, speechPath } from '../data/site';
import { steps, stepSources, proofCards } from '../data/speech';
const { focused = false } = Astro.props;
const content = speechContent;
---
<PageLayout updatedOn="2026-10-01" serviceAreaServed={null} enquiry={content.enquiry} path={content.path} label={content.label} serviceName={content.name} serviceType={content.type} assessmentOffer={content.assessmentOffer} title={content.title} description={content.description} citations={content.citations} faqs={content.faqs} imageAlt="A Pinnacle Blooms speech-therapy card showing an Indian mother and child using picture cards, with the message Be understood, Make choices, Join in and the phone number 9100 181 181." imageCaption="Speech therapy for children at Pinnacle Blooms Network." shareImage={shareCard} focused={focused}>
  <div class="speech-revision"><HeroSlider content={content} /><ActionStrip focused speechActions firstLabel="Plan our first visit" firstHref="#first-visit" evidenceHref="#evidence" enrolHref={speechOffer.url}/>

  <span class="legacy-section-anchor" id="ChildrenServices-section" aria-hidden="true"></span><section class="wrap service-fit" id="service-fit" aria-labelledby="fit-title">
    <div class="fit-heading"><p class="eyebrow">Your child. Your everyday priorities.</p><h2 id="fit-title">What would you like<br /><em>to become easier?</em></h2></div>
    <div class="concern-grid">{content.concerns.map(concern=><article><span class="concern-icon"><Icon name={concern.icon} size={30} /></span><h3>{concern.title}</h3><p>{concern.copy}</p></article>)}</div>
    <p class="source-note">Tell us what you are noticing. If speech is getting stuck or hearing is a concern, we’ll discuss the appropriate professional next step. <a href="https://www.nidcd.nih.gov/health/speech-and-language">Speech and language milestones · US NIDCD ↗</a></p>
    <span class="legacy-section-anchor" id="assessment-section" aria-hidden="true"></span><div class="assessment-route" id="assessment-start"><a href="#first-visit"><Icon name="clock"/> Your first visit</a><a href="#centres"><Icon name="pin"/> Find your centre</a><a href={serviceInformationPath}><Icon name="book"/> Assessment details</a></div>
<details class="speech-age-detail"><summary>From early gestures to school conversations <Icon name="arrow"/></summary><p>We begin with your child’s present abilities, including when speech delay, autism, ADHD or developmental delay brings your family to us. Assessment determines the appropriate support.</p><figure class="speech-age-visual"><Image src={communicationJourney} widths={[480,760,1100,1536]} sizes="(min-width:1100px) 1100px, calc(100vw - 36px)" width={1536} height={864} format="webp" quality={82} loading="lazy" alt="An Indian mother and preschool child communicating through play, with connected scenes of a baby using gestures and a seven-year-old participating in class. The official Pinnacle emblem and evidence labels are shown in the artwork."/><figcaption>One connected communication journey—from early shared attention toward greater participation at home, in learning and at school. <a href={url('/verify/evidence/records/md5.html')}>MD-5</a> · <a href={url('/verify/evidence/records/bis.html')}>BIS scope</a> · <a href={url('/verify/evidence/cite.html')}>Citations</a>. Assessment, goals and progress remain individual.</figcaption></figure></details>
  </section>

<span class="legacy-section-anchor" id="why-section" aria-hidden="true"></span><section class="section speech-purpose" id="pinnacle-purpose" aria-labelledby="purpose-title"><div class="wrap">
<div class="speech-purpose-grid"><div><p class="eyebrow">The PinnacleAI paradigm shift</p><h2 id="purpose-title">Start with the life.<br/><em>Give every skill a purpose.</em></h2><p>We work toward a self-sufficient, mainstream-included life for your child. That direction shapes the abilities we assess, the goals we agree, the people and methods we bring together, and what we practise and review.</p><p><strong>Your family helps shape the journey.</strong> Your hopes, your child’s preferences and what you notice at home belong in the plan.</p><EvidenceLinks group="purpose" label="Read the life-first approach"/></div><aside class="speech-home-analogy"><Icon name="home" size={48}/><h3>You plan a home around the life inside it.</h3><p>Then you choose the bricks. In the same way, a word or a therapy technique gains purpose through what it lets your child do—ask, choose, connect and take part.</p><strong>Life sets the direction.<br/>Skills help us work toward it.</strong></aside></div>
<div class="speech-proof-preview" aria-label="Evidence behind our approach"><a href={url('/verify/evidence/records/md5.html')}><Icon name="shield"/><span><strong>Licensed developmental-support software</strong>Read the Class B / MD-5 scope →</span></a><a href={url('/verify/evidence/research-library.html')}><Icon name="book"/><span><strong>Research you can inspect</strong>Read publications and their status →</span></a><a href="#evidence"><Icon name="people"/><span><strong>An accountable organisation</strong>See the records behind our work →</span></a></div></div></section>  <span class="legacy-section-anchor" id="what-section" aria-hidden="true"></span><section class="section wrap example-section" id="everyday-communication" aria-labelledby="example-title">
    <div class="story-heading"><p class="eyebrow">See the difference in an everyday moment</p><h2 id="example-title">A way to ask.<br /><em>More life to join.</em></h2><p>Speech therapy supports understanding, expression and interaction. At Pinnacle, we connect those skills to the life your child is working toward.</p></div>
<div class="speech-example-grid"><figure class="speech-example-creative"><Image src={decisionArt} widths={[390,600,800,1122]} sizes="(min-width:1100px) 520px, (min-width:900px) 44vw, calc(100vw - 36px)" format="webp" quality={82} loading="lazy" decoding="async" alt="Pinnacle-branded illustrative sequence: a child asks for help with a toy box, practises with family, and joins a parent and speech professional to review the next step."/><figcaption>One illustrative goal, carried into everyday practice and review.</figcaption></figure>    <div class="worked-example">
      <div class="example-goal"><span class="example-label">An illustrative everyday goal</span><div class="spoken-goal"><Icon name="voice" size={48} /><strong>“I need help.”</strong></div><p>At home or school. Through speech, gestures or another appropriate communication method.</p></div>
      <ol class="example-scenes decision-scenes">
        <li><span class="example-scene-icon"><Icon name="heart" size={34} /></span><span class="example-step">Notice + listen</span><h3>“Help me open it.”</h3><p>A child brings a closed toy box to an adult. The family wants asking for help to become easier.</p></li>
        <li><span class="example-scene-icon"><Icon name="measure" size={34} /></span><span class="example-step">Understand + agree</span><h3>Know the starting point.</h3><p>We assess the starting point with the family and agree a suitable way to ask. Together, we observe where it happens and how much support is needed.</p></li>
        <li><span class="example-scene-icon"><Icon name="home" size={34} /></span><span class="example-step">Practise + observe</span><h3>Make room for it in life.</h3><p>We work with the family to choose familiar moments to practise the agreed communication method with appropriate support.</p></li>
        <li><span class="example-scene-icon"><Icon name="track" size={34} /></span><span class="example-step">Review the evidence</span><h3>What worked—and where?</h3><p>In this example, the child asks one familiar adult after a prompt. We still need to observe whether they can ask another adult.</p></li>
        <li class="changed-decision"><span class="example-scene-icon"><Icon name="loop" size={34} /></span><span class="example-step">Change the next decision</span><h3>Keep the goal. Adjust the practice.</h3><p>We agree with the family how to practise with another familiar adult, what support to use and what to review next.</p></li>
      </ol>
    </div>
    </div><div class="technology-bridge"><Icon name="plan" size={30} /><p><strong>Where PinnacleAI fits.</strong> Its ability measurement, readiness tracking, progress forecasting and adaptive plan support help us organise the work. Our professionals review the observations with your family and guide the next step. <a href={url('/verify/evidence/records/md5.html')}>See the licensed software scope ↗</a></p></div>
    <div class="review-question"><Icon name="track" size={27} /><p>The question we keep coming back to:<br /><strong>Where can your child use this—and with how much help?</strong></p></div>
    <p class="source-note">Illustrative example, not a patient case. We agree each child’s own goals and support with their family.</p>
    <EvidenceLinks group="review" label="See how observations lead to the next decision" />
  </section>

<span class="legacy-section-anchor" id="Advantages-section" aria-hidden="true"></span><section class="section speech-pathway" id="pinnacle-difference" aria-labelledby="difference-title"><div class="wrap"><div class="story-heading"><p class="eyebrow">PinnacleAI · Seven connected family stages</p><h2 id="difference-title">A clear direction.<br/><em>A plan that keeps learning.</em></h2><p>Measurement, planning and tracking matter because they help us decide what to do next. PinnacleAI supports the work; our professionals guide care decisions with you.</p></div><ol class="speech-stages">{speechStages.map((stage,i)=><li id={'speech-stage-'+(i+1)}><div class="speech-stage-top"><span>{String(i+1).padStart(2,'0')}</span><Icon name={stage.icon} size={28}/></div><h3>{stage.title}</h3><p class="speech-stage-question">{stage.question}</p><p>{stage.text}</p><a href={url(stage.path)}>{stage.link} →</a></li>)}</ol><div class="speech-review-loop"><Icon name="loop" size={28}/><p><strong>Review brings us back to the child.</strong> Reassessment may change the next goal, method or support. We keep working toward growing independence and participation at the child’s pace.</p></div><div class="speech-section-actions"><a class="button primary" href={phone.href} data-cta="pinnacleai-call"><Icon name="phone"/>Talk with us · {phone.display}</a><a class="text-link" href={url('/pinnacleai')}>Explore the whole PinnacleAI system →</a></div>    <details class="technical-walkthrough" id="pinnacleai-steps"><summary><span><strong>Inside PinnacleAI: nine explanations of the technology</strong><small>Optional detail: how measurement, planning, practice and review connect.</small></span><span aria-hidden="true">+</span></summary><div class="technical-content"><p class="source-note">Here is how PinnacleAI supports our seven-stage family pathway. These nine explanations describe its philosophy and technology, not a separate nine-stage treatment programme.</p>
      <ol class="stack-grid">{steps.map((step,i)=><li class:list={['stack-card','phase-'+(Math.floor(i/3)+1)]}><div class="technical-step"><span class="step-top"><span class="step-number">{String(i+1).padStart(2,'0')}</span><Icon name={step.icon} size={27} /></span><h3>{step.title}</h3><strong>{step.layer}</strong><p>{step.detail}</p><a href={url(stepSources[i])}>See the supporting record ↗</a></div></li>)}</ol>
      <p class="source-note">PinnacleAI GPT-OS v1.0.0 is non-diagnostic developmental-support software for children aged 0–12. Professionals guide care decisions with the family. You can inspect the programme and licence records behind these explanations.</p>
    </div></details>
</div></section>  <span class="legacy-section-anchor" id="procedure-section" aria-hidden="true"></span><section class="first-visit-section section" id="first-visit" aria-labelledby="visit-title"><div class="wrap">
    <div class="visit-story"><div class="visit-story-copy"><p class="eyebrow">Let’s make the first step simple</p><h2 id="visit-title">Your child. Your hopes.<br /><em>A clear starting point.</em></h2><p>Tell us what matters to your family. We explore how your child communicates through conversation, play, structured tasks and observation, then explain the findings and next steps.</p>
      <div class="visit-facts"><div><Icon name="clock" size={27} /><strong>About 1 hour</strong><span>Assessment, depending on your child.</span></div><div><Icon name="book" size={27} /><strong>A written report</strong><span>We’ll confirm when your report will be ready.</span></div><div><Icon name="plan" size={27} /><AssessmentOffer /><span>Speech &amp; language assessment.</span></div></div>
      <a class="button primary" href={speechOffer.url} data-cta="visit-enquiry">Arrange your FREE assessment <Icon name="arrow" /></a><p class="visit-price-note"><a href={serviceInformationPath}>Assessment details and current offer ↗</a>. Our team will contact you to confirm the centre and appointment. Ongoing therapy is priced separately.</p>
    </div><figure class="visit-story-art"><Image src={firstVisit} widths={[480,720,1000,1536]} sizes="(min-width: 1360px) 620px, (min-width: 1100px) 48vw, calc(100vw - 36px)" width={1000} height={667} format="webp" quality={80} alt="Pinnacle first-visit creative: parents and child choose picture cards with a professional; Your child, your hopes, a clear first step; FREE speech assessment and 9100 181 181." loading="lazy" decoding="async" /></figure></div>
    <p class="source-note"><a href="/speech-therapy/first-visit-guide">Print or share your first-visit guide ↗</a></p>
    <span class="legacy-section-anchor" id="Cost-section" aria-hidden="true"></span><div class="speech-fees" id="assessment-fees"><Icon name="plan" size={30}/><div><h3>FREE assessment. Ongoing therapy explained separately.</h3><p>The speech assessment’s listed value is <s>₹25,999</s>; this offer is <strong>FREE</strong>. Before you enrol, we explain the recommended plan, schedule and applicable ongoing therapy fees. You can ask about fees on your first call.</p></div></div><details class="visit-practical" id="session-details"><summary>Session structure, fees and what to confirm <span aria-hidden="true">+</span></summary><p>Our <a href={serviceInformationPath}>speech-service guide</a> describes 40 minutes of therapy plus 5 minutes of parent review. Before you book, we’ll confirm your therapist, qualifications, appointment and report timings, session structure and any ongoing therapy fees. Bring relevant reports, your questions and examples of communication at home or school. Your appointment is arranged with the centre.</p></details>
    <div class="parent-part" id="family-practice"><Icon name="people" size={36} /><div><h3>Your knowledge of your child belongs in the plan.</h3><p>We help you turn agreed goals into manageable practice in your routines. Tell us what engaged your child, where help was needed and what did not work. We use those observations with you to shape the next step.</p></div></div>
    <EvidenceLinks group="practice" label="Support for everyday practice and family participation" />
  </div></section>

<TherapyBookCompanion kind="speech"/>
<TherapyTogether current="speech"/>  <section class="section evidence-section" id="evidence" aria-labelledby="evidence-title"><div class="wrap"><div class="split-heading"><div><p class="eyebrow">Open. Honest. Transparent. Self-critical.</p><h2 id="evidence-title">Confidence you can<br /><em>look into.</em></h2></div><p>We make the records behind our work available to you: the software licence, its named modules and research relevant to communication. Follow a source as deeply as you wish.</p></div>
    <div class="evidence-cards">{proofCards.map((card,i)=><article><span class="proof-icon"><Icon name={['shield','plan','measure'][i]} size={35} /></span><p class="card-tag">{card.tag}</p><h3>{card.title}</h3><p>{card.text}</p><span class="record-reference">{card.ref}</span><a class="text-link" href={url(card.link)}>{card.label} ↗</a></article>)}</div>
    <p class="source-note">Software licences describe the named device and documented scope. Research findings apply to the populations and methods studied. Your child’s goals and progress are individual.</p>
    <details class="research-detail"><summary>AbilityScore research: what is published and what is planned <span aria-hidden="true">+</span></summary><ul><li><a href={url('/verify/evidence/research-library.html#zenodo-19482123')}>Methodology and preliminary findings</a> — how AbilityScore is constructed; preliminary operational measurement findings.</li><li><a href={url('/verify/evidence/research-library.html#zenodo-19482476')}>External-validation protocol</a> — a planned study; it does not report completed external-validation results.</li></ul></details>
<details class="research-detail"><summary>The organisation behind your care <span aria-hidden="true">+</span></summary><div id="organisation-behind-care"><p>Pinnacle Blooms Network is a brand of Bharath Healthcare Laboratories Private Limited. Our public records identify the legal operator, system certificates and regulatory milestones.</p><EvidenceLinks group="identity" label="Identity and institutional assurance"/><EvidenceLinks group="quality" label="Quality and information-security systems"/><EvidenceLinks group="journey" label="PinnacleAI journey and Free Sale Certificate"/></div></details>    <div class="evidence-bottom"><a class="button outline" href={url('/verify/')}><Icon name="book" />Explore Pinnacle Verify</a><a class="text-link" href={url('/verify/evidence/research-library.html')}>Research &amp; publication status →</a><a class="text-link" href={url('/verify/evidence/cite.html')}>Cite Pinnacle’s original sources →</a></div>
    <p class="source-note source-downloads"><a href="/pinnacle-pages-data/speech-evidence.txt">Claims and sources for this page</a> · <a href="/pinnacle-pages-data/speech-evidence.json">Download source map (JSON)</a></p>
  </div></section>

<CentreDirectory compact pagePath={speechPath} enquiryTarget={speechOffer.url} serviceNotice="These are published Pinnacle locations. Call to confirm speech therapy, the suitable professional and appointment availability at your preferred centre."/><SpeechResources governmentResources/>  <section class="section wrap faq-section" id="questions" aria-labelledby="faq-title"><div><p class="eyebrow">Before you decide</p><h2 id="faq-title">Clear answers.<br /><em>A simpler next step.</em></h2><p>Call with the question you have today. You do not need to choose a therapy before speaking with us.</p><a class="text-link" href={phone.href} data-cta="family-journey-call">Call 9100 181 181 →</a></div><div>{content.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></section>

<section class="speech-share wrap" aria-labelledby="speech-share-title"><div><h2 id="speech-share-title">Discuss the next step together.</h2><p>Share this page with your partner, family or your child’s teacher.</p></div><div class="speech-share-actions"><a href={'https://wa.me/?text='+encodeURIComponent('Speech therapy shaped around your child’s everyday life. '+url(speechPath))} target="_blank" rel="noopener noreferrer" data-cta="speech-whatsapp">Share on WhatsApp ↗</a><button type="button" data-speech-share hidden>Share page</button><button type="button" data-speech-copy hidden>Copy page link</button><a href={url('/verify/evidence/cite.html')}>Citations &amp; sources →</a></div><p role="status" aria-live="polite"></p></section>
  <span class="legacy-section-anchor" id="admission-section" aria-hidden="true"></span><section class="final-cta" id="next-step" aria-labelledby="next-title"><div class="wrap"><div class="close-sun official-close"><Image src={emblem} width={96} height={96} format="webp" loading="lazy" alt="Pinnacle official pinwheel emblem" /></div><p class="eyebrow">Every Child Counts®</p><h2 id="next-title">Your hopes deserve<br />a clear next step.</h2><p>Tell us what you want to become easier for your child.<br />We’ll help you arrange a FREE assessment, find a centre and understand the next step.</p><div class="final-actions"><a class="button white" href={phone.href} data-cta="final-call"><Icon name="phone" />Call {phone.display}</a><a class="button light-outline" href={speechOffer.url} data-cta="final-enquiry">Arrange your FREE assessment <Icon name="arrow" /></a></div><div class="close-moments"><span><Icon name="voice" />A way to ask.</span><span><Icon name="heart" />A choice to make.</span><span><Icon name="people" />A life to take part in.</span></div><p class="final-guidance">FREE speech assessment · Free guidance, 24/7 · Ongoing therapy is priced separately.</p><a class="helpline-link" href={url('/national-autism-helpline')}>Pinnacle / BHCL National Autism Helpline →</a></div></section>

</div><script>
  function revealLinkedDetails(){
    let hash=''; try { hash=decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target=document.getElementById(hash);
    if(target){let parent=target.parentElement;while(parent){if(parent instanceof HTMLDetailsElement)parent.open=true;parent=parent.parentElement;}}
    if(hash==='Cost-section'||hash==='session-details'){
      const details=document.querySelector<HTMLDetailsElement>('#session-details');
      if(details){details.open=true;details.scrollIntoView({block:'start'});}
    }
  }
  const sharing=document.querySelector<HTMLElement>('.speech-share');
  if(sharing){
    const canonical=document.querySelector<HTMLLinkElement>('link[rel="canonical"]')!.href;
    const status=sharing.querySelector<HTMLElement>('[role="status"]')!;
    const copy=async()=>{try{await navigator.clipboard.writeText(canonical);status.textContent='Page link copied.';}catch{status.textContent='Copy this link: '+canonical;}};
    const copyButton=sharing.querySelector<HTMLButtonElement>('[data-speech-copy]')!;
    copyButton.hidden=false;copyButton.addEventListener('click',copy);
    const share=sharing.querySelector<HTMLButtonElement>('[data-speech-share]')!;
    if(navigator.share){share.hidden=false;share.addEventListener('click',async()=>{try{await navigator.share({title:'Speech therapy for children — Pinnacle Blooms Network',url:canonical});}catch(error){if((error as Error).name!=='AbortError')await copy();}});}
  }
  revealLinkedDetails();
  window.addEventListener('hashchange',revealLinkedDetails);

</script>

</PageLayout>
