---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import lockup from '../assets/pinnacle-blooms-network-lockup.png';
import policies,{presentPolicy} from '../data/policy-presentation';
import '../styles/policy-pages.css';
import {url} from '../data/site';
const {page:original}=Astro.props;
const page=presentPolicy(original);
---
<PageLayout title={page.title} description={page.description} path={page.path} label={page.label} shareImage={lockup} shareFit="contain" imageAlt="Pinnacle Blooms Network official emblem and wordmark" imageCaption={page.label} includeService={false} documentOnly={true} updatedOn={page.effectiveOn} breadcrumbParent={{name:'Policies',path:'/policies'}} enquiry={{url:url('/contact-information'),mobileLabel:'Contact information'}} citations={page.legalSources.map(source=>source.url)}>
 <section class="wrap policy-hero"><a class="policy-back" href={url('/policies')}><Icon name="arrow"/>All policies</a><p class="eyebrow">Pinnacle Blooms Network · {page.group}</p><div class="policy-title-line"><Icon name={page.icon} size={42}/><h1>{page.label}</h1></div><p>{page.summary}</p><p class="policy-version">Effective: <strong>{page.printedRevision}</strong> · Version {page.version}</p><ul class="policy-highlights">{page.highlights.map(item=><li><Icon name="check" size={20}/>{item}</li>)}</ul></section>
 <div class="wrap policy-layout">
  <aside class="policy-navigation" aria-label="Policy navigation">{page.toc.length>0&&<details open={page.toc.length<=25}><summary>On this page</summary><ol>{page.toc.map(section=><li data-level={section.level}><a href={'#'+section.id}>{section.title}</a></li>)}</ol></details>}<a class="policy-contact" href={url('/contact-information')}><Icon name="mail"/>Contact information</a><a class="policy-contact" href={url('/privacy-policy')}><Icon name="shield"/>Privacy policy</a></aside>
  <article class="policy-document" id={page.sourceBodyId||undefined} aria-label={page.label} set:html={page.html}/>
 </div>
 {page.legalSources.length>0&&<section class="wrap policy-legal-sources"><h2>Legal references</h2><p>These sources inform the relevant wording. Applicable provisions and commencement dates determine when a requirement applies.</p><ul>{page.legalSources.map(source=><li><a href={source.url}>{source.title}</a></li>)}</ul></section>}
 <section class="wrap section policy-related"><p class="eyebrow">Policies and governance</p><h2>Find the related policy.</h2><nav aria-label="Related policies">{policies.filter(policy=>policy.slug!==page.slug).map(policy=><a href={url(policy.path)}><Icon name={policy.icon} size={22}/>{policy.label} <Icon name="arrow" size={19}/></a>)}</nav><div class="policy-reading"><a href={url('/policies')}>All policies</a><a href={url('/pinnacle-pages-data/'+page.slug+'-policy.md')}>Plain reading version</a><a href={url('/pinnacle-pages-data/'+page.slug+'-policy-source.json')}>Current edition and historical provenance</a></div></section>
<script is:inline>const policyToc=document.querySelector(".policy-navigation details");if(policyToc&&matchMedia("(max-width:760px)").matches)policyToc.open=false;document.querySelector('[data-open-analytics]')?.addEventListener('click',event=>{const panel=document.querySelector('[data-speech-measurement]');if(panel&&!panel.hidden){event.preventDefault();panel.id='website-preferences';panel.open=true;panel.scrollIntoView({block:'center'});panel.querySelector('[data-measurement-choice]')?.focus();}});</script>
</PageLayout>
