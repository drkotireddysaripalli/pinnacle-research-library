---
import {Image} from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import {therapeuticaiContent as c} from '../data/therapeuticai-content';
import {pinnacleWave} from '../data/pinnacleai-wave';
import {phone,url} from '../data/site';
import hero from '../assets/therapeuticai-purpose-20261005.png';
import social from '../assets/pinnacleai-therapeuticai-social-20260930.png';
import '../styles/therapeuticai.css';
const page=pinnacleWave.find(p=>p.slug==='therapeuticai')!;
const canonical=url('/therapeuticai');
const graph=[{'@type':'DefinedTerm','@id':canonical+'#module',name:'TherapeuticAI',url:canonical,description:c.direct,isPartOf:{'@id':url('/pinnacleai')+'#software'},subjectOf:c.sources.map(s=>url(s.href))}];
---
<PageLayout path="/therapeuticai" label="TherapeuticAI®" title={page.title} description={page.description} shareImage={social} shareVersion="2026-09-30-pinnacleai-editorial" imageAlt="TherapeuticAI · the right activity has a reason · Pinnacle Blooms Network · 9100 181 181" includeService={false} primaryEntityId={canonical+'#module'} entityGraph={graph} citations={c.sources.map(s=>url(s.href))} faqs={c.faqs} publishedOn="2026-09-30" updatedOn={c.updatedOn} breadcrumbParent={{name:'PinnacleAI®',path:'/pinnacleai'}}>
<div class="therapeuticai-page">
 <section class="therapeuticai-hero therapeuticai-wrap" aria-labelledby="therapeuticai-title">
  <div><p class="therapeuticai-kicker"><Icon name="sun" size={22}/>PinnacleAI® · TherapeuticAI®</p><h1 id="therapeuticai-title">Every activity.<br/><em>A reason in your child’s life.</em></h1><p class="therapeuticai-lead">{c.lead}</p><div class="therapeuticai-actions"><a class="therapeuticai-btn therapeuticai-primary" href={phone.href} data-cta="pinnacleai-call"><Icon name="phone"/>Call {phone.display}</a><a class="therapeuticai-btn" href={url('/enroll-autism-speech-aba-therapies-india')} data-cta="final-enquiry">Plan a first conversation <Icon name="arrow"/></a></div><p class="therapeuticai-purpose">{c.purpose}</p><p class="therapeuticai-help">Telephone guidance is free. We’ll explain the suitable professional, centre, first visit and fees before you decide.</p><a class="therapeuticai-text-link" href={url('/centers')}><Icon name="pin" size={20}/>Find a Pinnacle centre →</a></div>
  <figure class="therapeuticai-hero-art"><Image src={hero} widths={[400,640,900,1254]} sizes="(min-width: 1000px) 46vw, (min-width: 700px) 620px, 100vw" format="webp" quality={80} loading="eager" fetchpriority="high" alt="Illustrative child choosing play with a parent and Pinnacle therapist; meaningful goal, professional choice and observation connect in a TherapeuticAI pathway."/><figcaption>A meaningful goal. A professional choice. A response that matters.</figcaption></figure>
 </section>
 <nav class="therapeuticai-jump therapeuticai-wrap" aria-label="On this page"><a href="#what-it-does"><Icon name="compass" size={18}/>What TherapeuticAI does</a><a href="#worked-example"><Icon name="sun" size={18}/>One play-box decision</a><a href="#family-role"><Icon name="people" size={18}/>Your family’s role</a><a href="#sources"><Icon name="shield" size={18}/>Licences &amp; evidence</a><a href="#next-step"><Icon name="phone" size={18}/>Begin with Pinnacle</a></nav>
 <section id="what-it-does" class="therapeuticai-section therapeuticai-tint"><div class="therapeuticai-wrap therapeuticai-definition"><div><p class="therapeuticai-kicker">The goal gives the activity its meaning</p><h2>Choosing what to practise<br/><em>starts with why it matters.</em></h2><p>{c.direct}</p><a href={url('/verify/evidence/records/bis.html')}>Read the BIS named-module scope →</a></div><aside class="therapeuticai-quote"><Icon name="home" size={34}/><blockquote>Bricks make a home when they work together for the people who will live there.</blockquote><p>In the same way, communication, movement, learning and everyday practice need a shared purpose in your child’s life. We connect suitable contributions around that purpose.</p><a href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Explore the PinnacleAI paradigm shift →</a></aside></div></section>
 <section id="worked-example" class="therapeuticai-section"><div class="therapeuticai-wrap"><div class="therapeuticai-heading"><p class="therapeuticai-kicker">From a life priority to a support decision</p><h2>{c.example.title}</h2><p>{c.example.intro}</p></div><ol class="therapeuticai-observations">{c.example.cards.map(o=><li><p class="therapeuticai-kicker">{o.label}</p><Icon name={o.icon} size={30}/><h3>{o.title}</h3><p>{o.text}</p></li>)}</ol><div class="therapeuticai-revision"><Icon name="loop" size={31}/><div><p class="therapeuticai-kicker">04 · The next choice changes</p><h3>Recognise the request. Adapt the adult’s support.</h3><p>{c.example.revision}</p></div></div><div class="therapeuticai-next-decision"><Icon name="chart" size={30}/><div><h3>What the next review needs to know.</h3><p>{c.example.checkpoint}</p></div></div><div class="therapeuticai-review-branches">{c.example.branches.map(b=><article><Icon name="loop" size={25}/><h3>{b.title}</h3><p>{b.text}</p></article>)}</div><p class="therapeuticai-source-note">This fictional workflow explains a decision; your child’s activity and communication support need individual professional guidance. <a href={url('/personal-development-kernel')}>See how the child’s context stays connected →</a></p></div></section>
 <section id="family-role" class="therapeuticai-section therapeuticai-tint"><div class="therapeuticai-wrap"><div class="therapeuticai-heading"><p class="therapeuticai-kicker">You help shape the journey</p><h2>Your family deserves<br/><em>an understandable plan.</em></h2><p>We want you to leave with a clear reason for the activity, manageable guidance and a useful next conversation.</p></div><div class="therapeuticai-family">{c.family.map(f=><article><Icon name={f.icon} size={30}/><h3>{f.title}</h3><p>{f.text}</p></article>)}</div><a class="therapeuticai-text-link" href={url('/everyday-therapy')}>Explore guided everyday practice →</a></div></section>
 <section id="architecture" class="therapeuticai-section"><div class="therapeuticai-wrap"><div class="therapeuticai-heading"><p class="therapeuticai-kicker">Inside PinnacleAI®</p><h2>A purpose. A choice.<br/><em>Practice with feedback.</em></h2><p>TherapeuticAI joins the planning conversation to guided activity. Human responsibility stays visible at each connection.</p></div><ol class="therapeuticai-architecture">{c.architecture.map((a,i)=><li><span class="therapeuticai-step-number">0{i+1}</span><Icon name={a.icon} size={30}/><h3>{a.title}</h3><p>{a.text}</p><a href={url(a.href)}>Explore this connection →</a></li>)}</ol><details class="therapeuticai-access"><summary>What should stay visible in the activity’s review?</summary><p>The goal, the reason for the support, who selected it, the child’s observed response and the next decision. Keep supported performance separate from independent use, and one setting separate from use across settings.</p><a href={url('/fusion-module')}>How tracking informs correction →</a></details></div></section>
 <section id="pinnacleai-journey" class="therapeuticai-section therapeuticai-tint"><div class="therapeuticai-wrap"><div class="therapeuticai-heading"><p class="therapeuticai-kicker">The whole system stays with the purpose</p><h2>From understanding your child<br/><em>to participation in life.</em></h2><p>Choosing an activity is one part of a continuing journey. The family, relevant professionals, home and school observations help keep that work connected.</p></div><ol class="therapeuticai-stages">{c.stages.map((s,i)=><li><span>{i+1}</span><Icon name={s.icon} size={27}/><h3>{s.title}</h3><p>{s.text}</p><a href={url(s.href)}>Explore this part →</a></li>)}</ol><p class="therapeuticai-source-note"><a href={url('/pinnacleai')}>The whole PinnacleAI system</a> · <a href={url('/seven-readiness-indexes')}>Seven Readiness Indexes</a> · <a href={url('/mainstream')}>Mainstream participation</a></p><h3 class="therapeuticai-therapy-title">Different expertise. A shared reason to contribute.</h3><div class="therapeuticai-therapies">{c.therapies.map(t=><a href={url(t.href)}><strong>{t.name}<Icon name="arrow" size={19}/></strong><span>{t.text}</span></a>)}</div><p>We coordinate suitable contributions around your child’s needs. Every child does not need every therapy. <a href={url('/autism-therapy')}>See how integrated autism support connects them →</a></p></div></section>
 <section id="sources" class="therapeuticai-section"><div class="therapeuticai-wrap"><div class="therapeuticai-heading"><p class="therapeuticai-kicker">Inspect the evidence behind the system</p><h2>Clear responsibilities.<br/><em>Documents you can read.</em></h2><p>Pinnacle Blooms Network is operated by Bharath Healthcare Laboratories Private Limited. Our Verify library brings the original instruments, methods and research trail into one place.</p></div><div class="therapeuticai-sources">{c.sources.map(s=><article><p class="therapeuticai-kicker">{s.label}</p><h3><Icon name="shield" size={25}/>{s.title}</h3><p>{s.text}</p><p class="therapeuticai-source-detail">{s.detail}</p><a href={url(s.href)}>Inspect the source →</a></article>)}</div><div class="therapeuticai-actions therapeuticai-source-downloads"><a href="/pinnacle-pages-data/therapeuticai-sources.json">Source map · JSON</a><a href="/pinnacle-pages-data/therapeuticai-sources.txt">Plain text</a><a href="/pinnacle-pages-data/therapeuticai-reading.md">Markdown reading aid</a><a href={url('/verify/evidence/cite.html')}>Citation library</a><a href={'https://wa.me/?text='+encodeURIComponent('TherapeuticAI: a meaningful goal, professional choice and activity review. '+canonical)}>Share on WhatsApp</a></div></div></section>
 <section id="questions" class="therapeuticai-section therapeuticai-tint"><div class="therapeuticai-wrap therapeuticai-faq-layout"><div><p class="therapeuticai-kicker">Before you decide</p><h2>Your questions.<br/><em>A clearer next step.</em></h2><p>Understanding the activity’s purpose should make the journey easier for your family.</p></div><div class="therapeuticai-faq">{c.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
 <section id="next-step" class="therapeuticai-close"><div class="therapeuticai-wrap"><p class="therapeuticai-kicker">Every Child Counts®</p><h2>Tell us one everyday moment<br/>you want to make easier.</h2><p>Playing together. Asking for help. Joining a classroom activity. Let’s begin with your child’s life and make the next conversation useful for your family.</p><ul><li><Icon name="heart"/>Share your child’s interests and your priority.</li><li><Icon name="people"/>Discuss suitable support and a centre.</li><li><Icon name="compass"/>Understand the first visit and fees.</li></ul><div class="therapeuticai-actions"><a class="therapeuticai-btn therapeuticai-primary" href={phone.href} data-cta="pinnacleai-close-call"><Icon name="phone"/>Call {phone.display}</a><a class="therapeuticai-btn" href={url('/enroll-autism-speech-aba-therapies-india')} data-cta="final-enquiry">Plan a first conversation <Icon name="arrow"/></a><a class="therapeuticai-text-link" href={url('/centers')}>Find a centre →</a></div><p class="therapeuticai-help">Telephone guidance is free. We will explain the suitable professional, centre, first visit and fees before you decide.</p></div></section>
</div>
</PageLayout>
