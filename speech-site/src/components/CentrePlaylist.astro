---
import Icon from './Icon.astro';
const {story}=Astro.props;
---
<article class={'playlist-card playlist-'+story.tone} data-playlist={story.list}>
 <div class="playlist-stage" data-centre-video>
  <img src={'https://i.ytimg.com/vi/'+story.video+'/hqdefault.jpg'} alt={'Official Pinnacle video preview · '+story.title} width="480" height="360" loading="lazy" referrerpolicy="no-referrer"/>
  <span class="playlist-label"><Icon name={story.icon} size={18}/>{story.label}</span>
  <button class="playlist-play" type="button" data-video-load aria-label={story.watch}>
   <span class="playlist-play-symbol"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 4.5v15l12-7.5Z"/></svg></span>
   <span class="playlist-watch">{story.watch}</span>
  </button>
  <template><iframe title={story.title+' playlist'} src={story.embed} allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></template>
 </div>
 <div class="playlist-copy">
  <p class="playlist-series"><Icon name={story.icon} size={20}/>{story.title}</p>
  <h3>{story.question}</h3><p>{story.text}</p>
  <ul class="playlist-topics" aria-label="In this collection">{story.topics.map((topic:string)=><li><Icon name="check" size={16}/>{topic}</li>)}</ul>
  <a class="playlist-collection" href={story.url} target="_blank" rel="noopener">
   <span class="playlist-collection-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 5h12M3 10h12M3 15h7"/><path d="m16 12 5 3-5 3Z"/></svg></span>
   <span>Explore the full collection<small>Watch more on Pinnacle’s YouTube channel</small></span><Icon name="arrow" size={22}/>
  </a>
 </div>
</article>
<style>
 .playlist-card{--story-accent:#08746f;--story-tint:#eef8f6;border:1px solid #d6e3e5;border-radius:28px;background:#fff;overflow:hidden;min-width:0;box-shadow:0 8px 32px #17344e08;display:flex;flex-direction:column}.playlist-magenta{--story-accent:#96277e;--story-tint:#fcf1fa}.playlist-purple{--story-accent:#6b36a8;--story-tint:#f6f1fc}.playlist-navy{--story-accent:#17344e;--story-tint:#f0f5f8}
 .playlist-stage{aspect-ratio:16/9;position:relative;background:#edf4f3;display:flex;align-items:center;justify-content:center;isolation:isolate}.playlist-stage>img{width:100%;height:100%;object-fit:contain}.playlist-stage:after{content:'';position:absolute;inset:60% 0 0;background:linear-gradient(transparent,#142e4dd9);pointer-events:none;z-index:0}.playlist-label{position:absolute;top:1rem;left:1rem;display:flex;align-items:center;gap:.45rem;background:#fff;color:var(--story-accent);border-radius:30px;padding:.5rem .8rem;font-size:.85rem;font-weight:700;box-shadow:0 2px 8px #18315d18;z-index:1}
 .playlist-play{position:absolute;inset:auto 1.1rem 1rem;display:flex;gap:.75rem;align-items:center;width:calc(100% - 2.2rem);border:0;background:transparent;color:#fff;padding:0;text-align:left;cursor:pointer;z-index:1;font:700 1.05rem/1.35 Sintony,sans-serif}.playlist-play-symbol{display:grid;place-items:center;flex:none;width:60px;height:60px;border-radius:50%;background:#fff;color:var(--story-accent);box-shadow:0 3px 14px #13294435}.playlist-play-symbol svg{margin-left:3px}.playlist-watch{max-width:18rem;text-shadow:0 1px 3px #0008}.playlist-play:hover .playlist-play-symbol{background:var(--story-tint);transform:scale(1.05)}.playlist-play:focus-visible{outline:3px solid #fff;outline-offset:6px;border-radius:10px}.playlist-stage:has(iframe):after{display:none}.playlist-stage iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
 .playlist-copy{padding:1.7rem;display:flex;flex-direction:column;flex:1}.playlist-series{display:flex;align-items:center;gap:.55rem;color:var(--story-accent);font-size:.9rem!important;font-weight:700;line-height:1.5!important;margin:0 0 .8rem!important}.playlist-copy h3{font-size:clamp(1.35rem,2vw,1.7rem);line-height:1.3;letter-spacing:-.025em;margin:0}.playlist-copy>p:not(.playlist-series){margin:1rem 0;line-height:1.7}.playlist-topics{display:flex;gap:.65rem 1rem;flex-wrap:wrap;list-style:none;padding:0;margin:.15rem 0 1.4rem;font-size:.88rem;color:#385263}.playlist-topics li{display:flex;align-items:center;gap:.35rem}.playlist-topics svg{color:var(--story-accent);flex:none}
 .playlist-collection{display:flex;align-items:center;gap:.75rem;min-height:66px;margin-top:auto;border-top:1px solid #e2e9ec;padding-top:1rem;text-decoration:none!important;color:var(--story-accent);font-size:1rem;font-weight:700}.playlist-collection-icon{display:grid;place-items:center;width:42px;height:42px;flex:none;background:var(--story-tint);border-radius:12px}.playlist-collection>span:nth-child(2){flex:1}.playlist-collection small{display:block;color:#526675;font-size:.78rem;font-weight:400;line-height:1.5;margin-top:.2rem}.playlist-collection:hover{color:#17344e}.playlist-collection:focus-visible{outline:3px solid var(--story-accent);outline-offset:4px;border-radius:8px}@media(max-width:760px){.playlist-copy{padding:1.3rem}.playlist-label{top:.7rem;left:.7rem;font-size:.78rem}.playlist-play{inset:auto .9rem .85rem;font-size:.94rem}.playlist-play-symbol{width:52px;height:52px}.playlist-topics{font-size:.82rem}}@media(prefers-reduced-motion:reduce){.playlist-play:hover .playlist-play-symbol{transform:none}}
</style>
