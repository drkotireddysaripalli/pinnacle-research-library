---
import {Image} from 'astro:assets';
import type {ImageMetadata} from 'astro';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import {url,phone} from '../data/site';
import {assessmentContent} from '../data/assessment-content';
import '../styles/life-outcomes.css';
import '../styles/institutional.css';
const {page}=Astro.props;
const assets=import.meta.glob<{default:ImageMetadata}>('../assets/*',{eager:true});
const poster=assets['../assets/'+page.slug+'-social-20261001.png'].default;
const enquiry=url('/enroll-autism-speech-aba-therapies-india?service=help');
const frameworkScene=page.kind==='framework'?assets['../assets/framework-help-journey-20261001.png'].default:null;
const aboutScene=page.kind==='about'?assets['../assets/about-family-continuity-20261001.png'].default:null;
const personId=(id:string)=>id==='koti'||id==='sreeja'?url('/verify/evidence/research-library.html#'+(id==='koti'?'koti-reddy-saripalli':'sreeja-reddy-saripalli')):url(page.path+'#'+id);
const personNodes=page.kind==='leadership'?page.people.map((person:any)=>({'@type':'Person','@id':personId(person.id),name:person.name,url:person.profile,jobTitle:person.role})):[];
const listId=url(page.path+'#leadership');
const reportId='https://doi.org/10.5281/zenodo.15487405';
const entityGraph=page.kind==='leadership'?[...personNodes,{'@type':'ItemList','@id':listId,name:'Pinnacle leadership',itemListElement:page.people.map((person:any,i:number)=>({'@type':'ListItem',position:i+1,item:{'@id':personId(person.id)}}))}]:page.kind==='framework'?[{'@type':'CreativeWork','@id':reportId,name:'Pinnacle Global Autism Framework',identifier:'10.5281/zenodo.15487405',url:reportId,version:'1.0',datePublished:'2025-05-22',genre:'Institution-authored report',author:{'@type':'Person','@id':personId('koti'),name:'Koti Reddy Saripalli'},editor:{'@type':'Person','@id':personId('sreeja'),name:'Sreeja Reddy Saripalli'}}]:[];
const therapies=[['Speech therapy','/top-speech-therapy-center-india-proven-improvement-rate'],['Occupational therapy','/best-occupational-therapy-center-india-proven-improvement-rate'],['ABA / behavioural support','/best-aba-therapy-center-india-proven-improvement-rate'],['Special education','/best-special-education-center-call-9100181181'],['Integrated autism support','/autism-therapy']];
---
<PageLayout title={page.title} description={page.description} path={page.path} label={page.label} shareImage={poster} shareVersion={'institutional-v136-'+page.slug+'-20261001'} imageAlt={page.imageAlt} imageCaption="Illustrative Pinnacle campaign creative" documentOnly={true} includeService={false} pageType={page.kind==='about'?'AboutPage':page.kind==='leadership'?'CollectionPage':'WebPage'} primaryEntityId={page.kind==='about'?url('/verify/#pinnacle-brand'):page.kind==='leadership'?listId:reportId} entityGraph={entityGraph} citations={page.sources.map((s:any)=>s.url)} faqs={page.faqs} updatedOn={page.updatedOn} enquiry={{url:enquiry,mobileLabel:'Start an enquiry'}}>
 <section class="wrap life-hero institutional-hero"><div>{page.kind==='framework'&&<span id="opening-portrait" class="fragment-alias" aria-hidden="true"/>}<p class="eyebrow">{page.eyebrow}</p><h1>{page.headline}<em>{page.accent}</em></h1><p class="life-lead">{page.lead}</p><div class="life-actions"><a class="button primary" href={phone.href} data-cta="hero-call"><Icon name="telephone"/>{phone.display}</a><a class="button secondary" href={enquiry} data-cta="hero-assessment">Start a first conversation <Icon name="arrow"/></a></div><p class="life-small">Pinnacle / BHCL · Free 24/7 telephone guidance. The receiving team confirms your appointment, suitable professional, service and fees.</p></div><figure class="life-poster"><Image src={poster} widths={[480,800,1200]} sizes="(max-width:760px) 94vw, 48vw" width={1200} format="webp" loading="eager" fetchpriority="high" alt={page.imageAlt}/><figcaption>Family priorities, relevant support and a life-first purpose.</figcaption></figure></section>
 <nav class="wrap life-jump" aria-label="On this page">{page.jump.map((item:any)=><a href={'#'+item.id}>{item.label}</a>)}<a href="#questions">Your questions</a></nav>
 {page.kind==='about'&&<>
  <section id="service-section" class="section wrap"><p class="eyebrow">Why families come to Pinnacle</p><h2>More possibilities in your child’s day.</h2><p class="life-answer">{page.directAnswer}</p><div class="life-grid">{page.priorities.map((item:any)=><article><span class="life-icon"><Icon name={item.icon} size={30}/></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><div class="life-therapies institutional-related"><h3>The contributions serve the child’s life.</h3><p>Assessment helps understand the starting picture. Relevant therapy and teaching, guided family practice and review keep the work connected with useful activities beyond a session.</p><nav aria-label="Explore relevant support">{therapies.map(([name,path])=><a href={url(path)}>{name}</a>)}</nav></div></section>
  <section id="family-journey" class="section life-tint"><div class="wrap institutional-case"><p class="eyebrow">Your family’s continuing journey</p><h2>From your first question to the next useful step.</h2><p class="life-answer">{page.journeyIntro}</p><figure class="institutional-case-scene"><Image src={aboutScene!} widths={[480,800,1200,1536]} sizes="(max-width:760px) 94vw, 1120px" width={1536} format="webp" loading="lazy" alt="Pinnacle-branded illustrative creative showing a family conversation, child-focused play and understanding, supported practice at home, and family-professional review, joined by a luminous pathway."/><figcaption>{page.journeyCaption}</figcaption></figure><ol class="institutional-case-board institutional-family-board" aria-label="The family journey from first conversation to review">{page.journey.map((step:any,i:number)=><li><span class="institutional-case-number">{i+1}</span><div><span class="life-icon"><Icon name={step.icon} size={27}/></span><h3>{step.title}</h3><p>{step.text}</p><a class="text-link" href={url(step.path)}>{step.linkLabel} <Icon name="arrow"/></a></div></li>)}</ol><a class="button primary" href={phone.href} data-cta="family-journey-call"><Icon name="telephone"/>Talk about what matters for your child · {phone.display}</a></div></section>
  <section id="relevant-support" class="section wrap"><p class="eyebrow">Let the everyday priority guide the contribution</p><h2>Explore the support that fits the question.</h2><p>A family exploring autism, ADHD, communication or developmental concerns can begin with the part of the day they want to understand. Relevant assessment helps clarify the suitable contributions.</p><div class="life-grid institutional-concerns">{page.concerns.map((item:any)=><article><span class="life-icon"><Icon name={item.icon} size={30}/></span><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={url(item.path)}>{item.linkLabel} <Icon name="arrow"/></a></article>)}</div></section>
  <section id="Vision-section" class="section life-tint"><div class="wrap life-purpose"><div><p class="eyebrow">Our vision · a life-first direction</p><h2>Self-sufficiency. Participation. A wonderful life.</h2><p>The life your family wants to open up gives the work its purpose from the start. It determines the abilities to understand, the goals to choose, the people and methods involved, the everyday practice and the review.</p><a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Explore the PinnacleAI® paradigm shift <Icon name="arrow"/></a></div><aside id="Mission-section"><Icon name="home" size={42}/><h3>Build for the whole life.</h3><p>A home’s bricks have a purpose because of the life they make possible. Assessment and therapy techniques matter in the same way: their value becomes clearer in what your child can do and take part in.</p><a href={url('/pinnacle-global-autism-framework')}>See how the framework connects the work →</a></aside></div></section>
  <section id="Values-section" class="section wrap"><p class="eyebrow">How the purpose becomes practical</p><h2>A direction you understand. A journey you help shape.</h2><div class="life-grid">{page.values.map((item:any)=><article><span class="life-icon"><Icon name={item.icon} size={30}/></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
  <section id="BHCL-section" class="section institutional-identity"><div class="wrap"><p class="eyebrow">Brand and legal operator</p><h2>Pinnacle Blooms Network.<br/>Bharath Healthcare Laboratories Private Limited.</h2><p class="life-answer">Pinnacle is the child-development brand. Bharath Healthcare Laboratories Private Limited is its legal operator. The Verify portal preserves separate company, brand, software and publication identities.</p><dl class="institutional-facts"><div><dt>Brand</dt><dd>Pinnacle Blooms Network</dd></div><div><dt>Legal operator</dt><dd>Bharath Healthcare Laboratories Private Limited</dd></div><div><dt>Incorporation shown on the corporate PAN</dt><dd>22 November 2016</dd></div><div><dt>Corporate identity trail</dt><dd><a href={url('/verify/#chapter-identity')}>Read the original records and review dates →</a></dd></div></dl><aside id="KGV-section" class="institutional-group"><h3>Kotii Group context</h3><p>Kotii Group’s focus is research-led technology for people and businesses. Koti Reddy Saripalli is its Founder Chairman. Meet the people and explore the distinct company and research records behind our work.</p><a href={url('/leadership')}>Meet our leadership →</a></aside></div></section>
 </>}
 {page.kind==='leadership'&&<>
  <section id="people" class="section wrap"><span id="published-leadership" class="fragment-alias" aria-hidden="true"/><p class="eyebrow">The people leading our purpose</p><h2>Meet Koti and Sreeja.</h2><p class="life-answer">{page.directAnswer}</p><div class="institutional-people institutional-founders">{page.people.map((person:any)=><article id={person.id}><Image src={assets['../assets/'+person.photo].default} widths={[240,480,720]} sizes="(max-width:650px) 88vw, 44vw" width={720} format="webp" loading="lazy" alt={'Portrait of '+person.name}/><div><h3>{person.name}</h3><p class="institutional-role">{person.role}</p><h4>{person.contributionTitle}</h4><p>{person.biography}</p><p>{person.contribution}</p><a href={person.profile}>Explore {person.id==='koti'?'Koti’s':'Sreeja’s'} profile <Icon name="arrow"/></a><a href={person.creditUrl}>Read {person.id==='koti'?'the research':'the writing and editorial credits'} <Icon name="arrow"/></a></div></article>)}</div></section>
  <section id="credits" class="section life-tint"><div class="wrap"><p class="eyebrow">Research and writing · distinct contributions</p><h2>Understand the work. Read the originals.</h2><div class="institutional-credits">{page.people.map((person:any)=><article><Icon name="book" size={34}/><h3>{person.name}</h3><h4>{person.credit}</h4><p>{person.creditText}</p><a href={person.creditUrl}>Explore the original works and credits →</a>{person.id==='sreeja'&&<p class="institutional-book-link"><a href={url('/verify/evidence/records/books.html')}>Parent handbooks and The Voice of the Unheard →</a></p>}</article>)}</div><a class="text-link" href={url('/verify/evidence/publications/zenodo-15487405.html')}>Pinnacle Global Autism Framework: Koti, author · Sreeja, editor <Icon name="arrow"/></a></div></section>
  <section id="responsibility" class="section wrap"><p class="eyebrow">What it means for a family choosing support</p><h2>Purpose you can discuss. Evidence you can follow.</h2><div class="life-grid">{page.values.map((item:any)=><article><span class="life-icon"><Icon name={item.icon} size={30}/></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
 </>}
 {page.kind==='framework'&&<>
  <section id="framework-meaning" class="section wrap"><span id="pgaf-intro" class="fragment-alias" aria-hidden="true"/><span id="the-silence-india-lived-with" class="fragment-alias" aria-hidden="true"/><span id="the-rise-of-pinnacle" class="fragment-alias" aria-hidden="true"/><p class="eyebrow">The purpose determines the work</p><h2>Your child’s life is the starting point.</h2><p class="life-answer">{page.directAnswer}</p><ol class="institutional-direction" aria-label="Life-first direction">{['Life possibilities','Abilities and goals','People and methods','Everyday practice','Review and next step'].map((label,i)=><li><span>{i+1}</span><strong>{label}</strong>{i<4&&<Icon name="arrow"/>}</li>)}</ol><p>Useful techniques and measures are like parts of a car: they serve the journey the whole car is built to make. Your child’s day gives those individual contributions their direction.</p><a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Read the complete documented explanation <Icon name="arrow"/></a></section>
  <section id="everyday-example" class="section life-tint"><div class="wrap institutional-case"><span id="real-lives-real-proof" class="fragment-alias" aria-hidden="true"/><p class="eyebrow">An illustrative planning example</p><h2>“I want my child to ask for help and join in.”</h2><p class="life-answer">{page.exampleIntro}</p><figure class="institutional-case-scene"><Image src={frameworkScene!} widths={[480,800,1200,1536]} sizes="(max-width:760px) 94vw, 1120px" width={1536} format="webp" loading="lazy" alt="Pinnacle-branded illustrative creative connecting a child’s block-building interest, a help picture in a learning setting, and family-professional review. The same everyday priority guides home and classroom support."/><figcaption>{page.exampleCaption}</figcaption></figure><ol class="institutional-case-board" aria-label="Illustrative help-and-participation planning example">{page.example.map((step:any,i:number)=><li><span class="institutional-case-number">{i+1}</span><div><span class="life-icon"><Icon name={step.icon} size={27}/></span><h3>{step.title}</h3><p>{step.text}</p>{step.path&&<a class="text-link" href={url(step.path)}>{step.linkLabel} <Icon name="arrow"/></a>}</div></li>)}</ol><p class="life-small">{page.exampleScope}</p><a class="button primary" href={phone.href} data-cta="example-call"><Icon name="telephone"/>Talk about your child’s everyday priority · {phone.display}</a></div></section>
  <section id="seven-stages" class="section wrap"><span id="the-innovation-stack" class="fragment-alias" aria-hidden="true"/><span id="global-adaptability" class="fragment-alias" aria-hidden="true"/><p class="eyebrow">Seven stages · one child’s life</p><h2>Understand. Support. Practise. Review.</h2><ol class="life-stages institutional-stages">{assessmentContent.stages.map((stage,i)=><li><span class="life-stage-number">{i+1}</span><Icon name={stage.icon} size={32}/><h3>{stage.title}</h3><p>{stage.text}</p><a href={url(stage.path)}>Explore this part →</a></li>)}</ol><div class="life-therapies"><h3>Relevant therapies contribute to the same purpose.</h3><p>Communication, routines, learning and participation can need different kinds of support. Relevant professional contributions follow the child-specific priorities.</p><nav aria-label="Therapies within the framework">{therapies.map(([name,path])=><a href={url(path)}>{name}</a>)}</nav></div><details class="institutional-module-detail"><summary>See how the PinnacleAI® modules support continuity</summary><p>AbilityScore® and the readiness views support the starting picture and planning discussion. Child context, professionally chosen support, everyday practice, observations and reassessment connect the work over time.</p><nav aria-label="PinnacleAI modules">{[['Personal Development Kernel','/personal-development-kernel'],['Prognose','/prognose'],['TherapeuticAI','/therapeuticai'],['Everyday Therapy','/everyday-therapy'],['Fusion','/fusion-module'],['Reassess, review and repeat','/reassess-review-repeat']].map(([name,path])=><a href={url(path)}>{name} →</a>)}</nav><p>Human judgement, family knowledge and the child’s response guide decisions. Read the <a href={url('/pinnacleai')}>whole PinnacleAI ecosystem</a> and its non-diagnostic software scope.</p></details></section>
  <section id="family-role" class="section life-tint"><div class="wrap"><span id="why-this-model-works" class="fragment-alias" aria-hidden="true"/><span id="why-this-moment-matters" class="fragment-alias" aria-hidden="true"/><p class="eyebrow">Your family knows the child’s day</p><h2>Bring that knowledge into the journey.</h2><div class="life-grid">{page.values.map((item:any)=><article><span class="life-icon"><Icon name={item.icon} size={30}/></span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html#human-agency-in-goals')}>Read how family agency shapes the work <Icon name="arrow"/></a></div></section>
  <section id="publication" class="section wrap"><span id="india-global-recognition" class="fragment-alias" aria-hidden="true"/><p class="eyebrow">Original publication · a stable citation</p><h2>The Pinnacle Global Autism Framework report.</h2><dl class="institutional-facts"><div><dt>Publication</dt><dd>Institution-authored report · 22 May 2025 · version 1.0</dd></div><div><dt>Author</dt><dd><a href={url('/verify/evidence/research-library.html#koti-reddy-saripalli')}>Koti Reddy Saripalli</a></dd></div><div><dt>Editor</dt><dd><a href={url('/verify/evidence/research-library.html#sreeja-reddy-saripalli')}>Sreeja Reddy Saripalli</a></dd></div><div><dt>DOI</dt><dd><a href={reportId}>10.5281/zenodo.15487405</a></dd></div></dl><p>Read the report’s original publication trail, credits and version in the <a href={url('/verify/evidence/publications/zenodo-15487405.html')}>public Verify record</a>. Independent peer-review was not established in the current catalogue. The report version is separate from the licensed software version.</p></section>
 </>}
 <section id="evidence" class="section life-proof"><div class="wrap">{page.kind==='framework'&&<div class="institutional-research-aliases">{Array.from({length:12},(_,i)=><span id={'study-'+(i+1)} class="fragment-alias" aria-hidden="true"/>)}<p>Explore the current <a href={url('/verify/evidence/research-library.html')}>research catalogue</a> for individual works, methods, versions and publication status.</p></div>}<p class="eyebrow">Confidence with a source you can inspect</p><h2>Purpose, people and evidence belong together.</h2><div class="life-source-grid">{page.sources.map((source:any)=><article><Icon name="shield" size={27}/><h3>{source.title}</h3><p>{source.meaning}</p><a href={source.url}>Read the source →</a></article>)}</div><div class="life-downloads"><a href={url('/pinnacle-pages-data/'+page.slug+'-evidence.json')}>Source map · JSON</a><a href={url('/pinnacle-pages-data/'+page.slug+'-evidence.txt')}>Readable source map</a><a href={url('/verify/evidence/cite.html')}>Citation library</a></div></div></section>
 <section id="questions" class="section wrap"><p class="eyebrow">Questions families ask</p><h2>Understand the direction before choosing the next step.</h2><div class="faq">{page.faqs.map((faq:any)=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></section>
 <section class="section life-close"><div class="wrap">{page.kind==='framework'&&<><span id="what-comes-next" class="fragment-alias" aria-hidden="true"/><span id="global-impact" class="fragment-alias" aria-hidden="true"/></>}<p class="eyebrow">Start with one meaningful everyday possibility</p><h2>Tell us what you want to make more possible.</h2><p>Being understood. Getting ready. Learning or joining in. Bring the moment that matters to your family. The first conversation helps clarify the suitable professional, centre and next step.</p><div class="life-actions"><a class="button primary" href={phone.href} data-cta="final-call"><Icon name="telephone"/>Call {phone.display}</a><a class="button secondary" href={url('/centers')}>Find a Pinnacle centre <Icon name="arrow"/></a><a class="button secondary" href={enquiry} data-cta="final-assessment">Send an enquiry <Icon name="arrow"/></a></div><div class="life-downloads"><a href={'https://wa.me/?text='+encodeURIComponent(page.title+' '+url(page.path))}>Share on WhatsApp</a><a href={url('/pinnacle-pages-data/'+page.slug+'-machine.md')}>Copy-ready reading page</a></div></div></section>
</PageLayout>
