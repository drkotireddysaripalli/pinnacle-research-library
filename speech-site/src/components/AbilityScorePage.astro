---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import {Image} from 'astro:assets';
import {abilityContent as c} from '../data/abilityscore-content';
import {url,phone} from '../data/site';
import hero from '../assets/abilityscore-possibility-20261005.png';
import social from '../assets/pinnacleai-abilityscore-social-20260930.png';
import '../styles/abilityscore-page.css';
const canonical=url('/abilityscore');
const graph=[{'@type':'DefinedTerm','@id':canonical+'#module',name:'AbilityScore®',description:c.direct,url:canonical,subjectOf:c.sources.map(s=>url(s.href))}];
const shareText=encodeURIComponent('AbilityScore®: understand your child’s abilities and the next everyday possibility. '+canonical);
---
<PageLayout path="/abilityscore" label="AbilityScore®" title={c.title} description={c.description} shareImage={social} shareVersion="2026-09-30-pinnacleai-editorial" imageAlt="AbilityScore®: understand abilities, plan for life. Pinnacle Blooms Network family and professional creative, with 9100 181 181." imageCaption="AbilityScore® · illustrated Pinnacle brand creative" includeService={false} primaryEntityId={canonical+'#module'} entityGraph={graph} faqs={c.faqs} citations={c.sources.map(s=>url(s.href))} updatedOn={c.updated} breadcrumbParent={{name:'PinnacleAI®',path:'/pinnacleai'}}>
<div class="ability-page" data-wave-module="abilityscore">
 <section class="ability-hero ability-container" aria-labelledby="ability-title">
  <div class="ability-hero-copy"><p class="ability-eyebrow"><Icon name="measure"/>PinnacleAI® · Begin with ability</p><h1 id="ability-title"><span class="ability-subject">AbilityScore®</span>Understand your child’s abilities.<br/><em>Give the next step a reason.</em></h1><p class="ability-lead">{c.lead}</p><div class="ability-actions"><a class="ability-button ability-primary" href={phone.href} data-cta="pinnacleai-call"><Icon name="phone"/>Call {phone.display}</a><a class="ability-button ability-secondary" href={url('/enroll-autism-speech-aba-therapies-india')} data-cta="final-enquiry">Plan a first visit <Icon name="arrow"/></a></div><p class="ability-guidance">Telephone guidance is free. We’ll explain the appropriate professional, assessment, centre and fees before you decide.</p><a class="ability-inline-link" href={url('/centers')}><Icon name="pin" size={19}/>Find a Pinnacle centre <Icon name="arrow" size={18}/></a></div>
  <figure class="ability-hero-image"><Image src={hero} widths={[480,800,1200,1536]} sizes="(min-width:1000px) 50vw, 100vw" format="webp" quality={83} loading="eager" fetchpriority="high" alt="AbilityScore: from ability to everyday possibility. A young child chooses a red car with family and a Pinnacle professional; Notice, Understand, Plan and Review form a continuing pathway."/></figure>
 </section>
 <nav class="ability-jump ability-container" aria-label="On this page">{[['What the score explains','#what-it-does'],['From measurement to a plan','#from-measurement'],['Follow one child’s goal','#worked-example'],['Understand your report','#read-the-report'],['Verify the sources','#sources'],['Begin with Pinnacle','#next-step']].map(([label,href])=><a href={href}><Icon name="arrow" size={16}/>{label}</a>)}</nav>

 <section class="ability-section ability-container" id="what-it-does" aria-labelledby="ability-meaning-title"><div class="ability-intro"><div><p class="ability-eyebrow">The starting picture. The next possibility.</p><h2 id="ability-meaning-title">What does AbilityScore®<br/><em>help your family understand?</em></h2><p>{c.direct}</p><p>{c.purpose}</p></div><aside class="ability-purpose"><Icon name="home" size={36}/><h3>Every brick matters because of the home it helps build.</h3><p>Your child’s abilities matter because of the life they can help make possible: a request understood, a routine joined, a choice respected. That purpose gives assessment its direction.</p><a href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Explore the PinnacleAI Paradigm Shift <Icon name="arrow" size={18}/></a></aside></div><div class="ability-architecture">{c.architecture.map(a=><div><Icon name={a.icon} size={27}/><strong>{a.value}</strong><span>{a.label}</span></div>)}</div><p class="ability-source-note">Architecture described in <a href={url('/verify/evidence/records/dossier.html')}>Evidence Dossier v2.0-M, Chapter 9, pp. 40–42 · 25 July 2026</a>. These are versioned design quantities. They describe the measurement system, not a child’s outcome. Ask which assessment version is used for your child.</p></section>

 <section class="ability-section ability-soft" id="from-measurement" aria-labelledby="ability-flow-title"><div class="ability-container"><div class="ability-section-head"><p class="ability-eyebrow">How the starting picture becomes useful</p><h2 id="ability-flow-title">Assessment. Explanation. Action.<br/><em>Then a better-informed next decision.</em></h2><p>The clinician administers the assessment. Your family contributes the context. Together, you connect the information with a step that matters in your child’s day.</p></div><ol class="ability-decision-flow">{c.flow.map((s,i)=><li><span>{String(i+1).padStart(2,'0')} <Icon name={s.icon} size={25}/></span><h3>{s.title}</h3><p>{s.copy}</p></li>)}</ol><div class="ability-comparison">{c.comparison.map(s=><article><p class="ability-eyebrow">{s.name}</p><h3>{s.question}</h3><p>{s.copy}</p></article>)}</div><p class="ability-source-note"><a href={url('/seven-readiness-indexes')}>Explore the seven readiness views</a> · <a href={url('/personal-development-kernel')}>How the child’s context stays connected</a> · <a href={url('/prognose')}>How planning uses a revisable forecast</a></p></div></section>

 <section class="ability-section ability-container" id="worked-example" aria-labelledby="ability-example-title"><div class="ability-section-head"><p class="ability-eyebrow">Follow a real-life question</p><h2 id="ability-example-title">{c.example.title}</h2><p>{c.example.intro}</p></div><div class="ability-example-grid"><figure class="ability-example-image"><Image src={social} widths={[480,800,1200]} sizes="(min-width:1000px) 38vw, 100vw" format="webp" quality={82} loading="lazy" alt="AbilityScore branded illustration: a child choosing a favourite activity with family and a Pinnacle professional, beside an abstract measurement display."/><figcaption>A choice already present can become the starting point for a useful goal.</figcaption></figure><ol class="ability-example-steps">{c.example.steps.map(([title,copy],i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol></div><div class="ability-review-heading"><p class="ability-eyebrow"><Icon name="loop"/>The review changes something specific</p><h3>What happens next depends on what the child can use.</h3></div><div class="ability-review-grid">{c.example.reviews.map(r=><article><dl><dt>What the family notices</dt><dd>{r.observation}</dd><dt>What the team changes</dt><dd>{r.decision}</dd><dt>What to check next</dt><dd>{r.check}</dd></dl></article>)}</div><p class="ability-keyline"><Icon name="people" size={30}/><span><strong>The useful change belongs in your child’s life.</strong> The assessment and everyday observations help the people around your child decide what to keep, adapt or explore next.</span></p></section>

 <section class="ability-section ability-soft" id="read-the-report" aria-labelledby="ability-report-title"><div class="ability-container"><div class="ability-section-head"><p class="ability-eyebrow">Clarity you can take home</p><h2 id="ability-report-title">A report should leave you<br/><em>with an explained next step.</em></h2><p>You can ask the professional to connect the report with your child’s everyday experience. These four questions help make that conversation concrete.</p></div><ol class="ability-decision-flow">{c.reportQuestions.map(([title,copy],i)=><li><span>{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol><a class="ability-button ability-secondary" href={url('/verify/#report-explorer')}>Explore the report-format guide <Icon name="arrow"/></a></div></section>

 <section class="ability-section ability-container" id="pinnacleai-journey" aria-labelledby="ability-journey-title"><div class="ability-section-head"><p class="ability-eyebrow">The whole PinnacleAI® system</p><h2 id="ability-journey-title">AbilityScore begins the picture.<br/><em>The whole system works toward the life.</em></h2><p>Measurement connects with a child-specific plan, suitable therapies, family practice and review. Your child’s self-sufficient, mainstream-included life gives every stage its purpose.</p></div><ol class="ability-journey">{c.stages.map((s,i)=><li><span class="ability-stage-number">{i+1}</span><Icon name={s.icon} size={28}/><h3>{s.title}</h3><p>{s.copy}</p><a href={s.href.startsWith('#')?s.href:url(s.href)}>Explore this part <Icon name="arrow" size={17}/></a></li>)}</ol><div class="ability-system-links"><a href={url('/pinnacleai')}>Explore PinnacleAI® <Icon name="arrow"/></a><a href={url('/self-sufficient')}>Self-Sufficient <Icon name="arrow"/></a><a href={url('/mainstream')}>Mainstream Included <Icon name="arrow"/></a></div></section>

 <section class="ability-section ability-soft" id="connected-therapies" aria-labelledby="ability-therapy-title"><div class="ability-container"><div class="ability-section-head"><p class="ability-eyebrow">The right people for the purpose</p><h2 id="ability-therapy-title">Each contribution has a reason<br/><em>in your child’s plan.</em></h2><p>Appropriate professionals recommend which support fits the assessed abilities and family priority. Your child’s goal brings the relevant contributions together.</p></div><div class="ability-therapy-grid">{c.therapies.map(t=><a href={url(t.href)} class="ability-therapy"><Icon name={t.icon} size={30}/><h3>{t.title}</h3><p>{t.copy}</p><span>Explore the therapy <Icon name="arrow" size={18}/></span></a>)}</div><p class="ability-source-note"><a href={url('/autism-therapy')}>See how suitable therapies integrate for autism support</a>. The assessment informs a discussion; each child’s needs determine the proposed contributions.</p></div></section>

 <section class="ability-section ability-container" id="sources" aria-labelledby="ability-source-title"><div class="ability-section-head"><p class="ability-eyebrow">Open. Honest. Transparent. Self-critical.</p><h2 id="ability-source-title">A method you can understand.<br/><em>Sources you can inspect.</em></h2><p>Pinnacle Blooms Network is operated by Bharath Healthcare Laboratories Private Limited, the legal licence holder. Explore the measurement design, Indian software licence and published research separately.</p></div><div class="ability-proof-grid">{c.sources.map(s=><article><Icon name={s.id==='bis'||s.id==='md5'?'shield':'book'} size={29}/><p class="ability-eyebrow">{s.label}</p><strong class="ability-proof-value">{s.value}</strong><h3>{s.title}</h3><p>{s.copy}</p><a href={url(s.href)}>Inspect the source <Icon name="arrow" size={18}/></a></article>)}</div><details class="ability-citations"><summary>For researchers, teachers and anyone sharing this explanation</summary><p>The July 2026 company dossier describes the architecture used in this explanation. The April <a href={url('/verify/evidence/records/methodology.html')}>methodology preprint</a> and <a href={url('/verify/evidence/records/external-validation.html')}>external-validation protocol</a> have their own versions and research status. Read each source in that context; this page does not present planned validation as completed independent findings.</p><p><strong>Suggested citation:</strong> Pinnacle Blooms Network. <cite>AbilityScore®: Understand Your Child’s Abilities.</cite> Updated 5 October 2026. Bharath Healthcare Laboratories Private Limited.</p><div class="ability-downloads"><a href="/pinnacle-pages-data/abilityscore-sources.json">Source map · JSON</a><a href="/pinnacle-pages-data/abilityscore-sources.txt">Plain text</a><a href="/pinnacle-pages-data/abilityscore-reading.md">Markdown reading aid</a><a href={url('/verify/evidence/cite.html')}>Cite original evidence</a></div></details></section>

 <section class="ability-section ability-soft" id="questions" aria-labelledby="ability-questions-title"><div class="ability-container ability-faq"><div><p class="ability-eyebrow">Before you begin</p><h2 id="ability-questions-title">Questions families ask.</h2><p>Bring the questions that matter to your child. Understand the proposed next step before making a decision.</p><a class="ability-inline-link" href={phone.href} data-cta="pinnacleai-call"><Icon name="phone"/>9100 181 181</a></div><div>{c.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></div></section>

 <section class="ability-section ability-container" id="next-step" aria-labelledby="ability-next-title"><div class="ability-first-step"><div><p class="ability-eyebrow">Let’s begin with your child</p><h2 id="ability-next-title">Tell us what your child can do.<br/><em>And what you want to make possible.</em></h2><p>Start with one everyday moment. We’ll help you explore the suitable professional, assessment and first conversation so you can begin with clarity.</p><div class="ability-actions"><a class="ability-button ability-primary" href={phone.href} data-cta="pinnacleai-close-call"><Icon name="phone"/>Call {phone.display}</a><a class="ability-button ability-secondary" href={url('/enroll-autism-speech-aba-therapies-india')} data-cta="final-enquiry">Plan a first visit <Icon name="arrow"/></a></div><p class="ability-guidance">Telephone guidance is free. The team confirms the centre, professional, availability and fees with you.</p></div><aside><Icon name="pin" size={34}/><h3>Bring your family’s starting point.</h3><p>Share what your child enjoys, what already works and what you would like help understanding. Existing reports can support the conversation.</p><a href={url('/centers')}>Find a Pinnacle centre <Icon name="arrow" size={18}/></a><a href={url('/speech-aba-autism-assessments')}>Explore assessment and the first step <Icon name="arrow" size={18}/></a><a href={url('/books/resources/first-conversation')}>Take a first-conversation planning sheet <Icon name="arrow" size={18}/></a></aside></div><div class="ability-share"><p>Share this explanation with your family or care team.</p><a href={'https://wa.me/?text='+shareText} target="_blank" rel="noopener noreferrer"><Icon name="send" size={18}/>Share on WhatsApp</a><a href={'mailto:?subject='+encodeURIComponent('AbilityScore® · Understand your child’s abilities')+'&body='+shareText}><Icon name="mail" size={18}/>Share by email</a><a href="#sources"><Icon name="book" size={18}/>Cite this page</a></div></section>
</div>
</PageLayout>
