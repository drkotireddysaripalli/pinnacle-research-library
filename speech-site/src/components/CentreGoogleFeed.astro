---
import Icon from './Icon.astro';
interface Props {branch:{id:string;name:string;googleBusinessUrl?:string;mapsUrl?:string;reviewUrl?:string};}
const {branch}=Astro.props;
const listing=branch.googleBusinessUrl||branch.mapsUrl;
---
<section class="local-section local-wrap google-feed" id="google-reviews" data-centre-google={branch.id} aria-labelledby="google-feed-title">
 <p class="local-kicker">Public feedback and centre updates</p>
 <h2 id="google-feed-title">Another perspective. <em>From our Google listing.</em></h2>
 <p class="local-lead">Read recent public feedback and published centre updates, then explore the full listing on Google.</p>
 <div class="google-feed-source local-card">
  <div><Icon name="heart"/><p data-google-overall>Read the current rating and family feedback directly on our Google listing.</p><p class="local-small" data-google-status role="status">Recent Google feedback loads when you reach this section.</p></div>
  <div class="local-actions"><a class="local-button" href={listing} target="_blank" rel="noopener"><Icon name="pin"/> Read all reviews on Google</a>{branch.reviewUrl&&<a class="local-text-link" href={branch.reviewUrl} target="_blank" rel="noopener">Leave your own review <Icon name="arrow"/></a>}</div>
 </div>
 <div data-google-review-section hidden>
  <div class="google-rail-heading"><div><h3>Selected 5-star Google reviews</h3><p class="local-small">A selection of recent public 5-star reviews with written feedback. These personal experiences do not predict another child’s outcome. The overall Google rating includes all ratings.</p></div><div class="google-rail-controls"><button type="button" data-google-previous aria-label="Previous Google reviews" aria-controls={'google-review-rail-'+branch.id}><Icon name="arrow"/></button><button type="button" data-google-next aria-label="Next Google reviews" aria-controls={'google-review-rail-'+branch.id}><Icon name="arrow"/></button></div></div>
  <div class="google-review-rail" id={'google-review-rail-'+branch.id} data-google-review-rail role="region" aria-label="Selected five-star Google reviews" tabindex="0"></div>
 </div>
 <div class="google-post-section" data-google-post-section hidden><h3>Recent updates on Google</h3><div class="google-post-grid" data-google-posts></div></div>
 <noscript><p><a href={listing} target="_blank" rel="noopener">Read this centre’s reviews and updates on Google.</a></p></noscript>
</section>
<script>
 import {initCentreGoogleFeeds} from '../scripts/centre-google-feed';
 initCentreGoogleFeeds();
</script>
<style>
.google-feed [hidden]{display:none!important}.google-feed-source{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.5rem;align-items:center}.google-feed-source>div{min-width:0}.google-feed-source>div>svg{color:#8f2879}.google-feed-source p{margin:.7rem 0}.google-overall-rating{color:#8f2879;font-size:2.1rem}.google-rail-heading{display:flex;gap:1.5rem;align-items:flex-start;justify-content:space-between;margin-top:2.2rem}.google-rail-heading h3,.google-post-section h3{font-size:1.5rem;color:#18315d}.google-rail-heading>div:first-child{max-width:740px}.google-rail-controls{display:flex;gap:.65rem;flex:none}.google-rail-controls button{display:grid;place-items:center;width:48px;height:48px;border:1px solid #c8dcd8;border-radius:50%;color:#08746f;background:#fff;cursor:pointer}.google-rail-controls button:hover{background:#edf8f5}.google-rail-controls button:disabled{opacity:.4;cursor:default}.google-review-rail{display:flex;gap:1rem;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;padding:.6rem .15rem 1.2rem;scrollbar-width:thin}.google-review-card{flex:0 0 min(82vw,370px);scroll-snap-align:start;border:1px solid #d9e6e3;border-radius:22px;padding:1.4rem;background:#fcfdfc;overflow-wrap:anywhere;display:flex;flex-direction:column}.google-review-card blockquote{margin:1rem 0;white-space:pre-wrap;font-size:1rem;line-height:1.75;color:#18315d}.google-review-author{font-weight:700;color:#08746f}.google-review-date{font-size:.85rem;color:#52657b;margin:.6rem 0}.google-review-stars{color:#8f2879;letter-spacing:.15em}.google-review-card>a{margin-top:auto;padding-top:1rem;font-size:.9rem}.google-post-section{margin-top:2.2rem}.google-post-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.google-post-card{border:1px solid #d9e6e3;border-radius:22px;padding:1.3rem;overflow-wrap:anywhere;background:#fff}.google-post-card img{display:block;width:100%;aspect-ratio:16/10;object-fit:contain;background:#f4faf8;border-radius:14px}.google-post-card p{white-space:pre-wrap;font-size:.96rem;line-height:1.7}.google-post-card time{display:block;font-size:.85rem;color:#52657b;margin:.8rem 0}.google-post-card details summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:700;color:#08746f}.google-feed :is(button,a,[tabindex]):focus-visible{outline:3px solid #08746f;outline-offset:4px}.google-feed :global(.google-overall-rating){color:#8f2879;font-size:2.1rem}.google-feed :global(.google-review-card){flex:0 0 min(82vw,370px);scroll-snap-align:start;border:1px solid #d9e6e3;border-radius:22px;padding:1.4rem;background:#fcfdfc;overflow-wrap:anywhere;display:flex;flex-direction:column}.google-feed :global(.google-review-card blockquote){margin:1rem 0;white-space:pre-wrap;font-size:1rem;line-height:1.75;color:#18315d}.google-feed :global(.google-review-author){font-weight:700;color:#08746f}.google-feed :global(.google-review-date){font-size:.85rem;color:#52657b;margin:.6rem 0}.google-feed :global(.google-review-stars){color:#8f2879;letter-spacing:.15em}.google-feed :global(.google-review-card>a){margin-top:auto;padding-top:1rem;font-size:.9rem}.google-feed :global(.google-post-card){border:1px solid #d9e6e3;border-radius:22px;padding:1.3rem;overflow-wrap:anywhere;background:#fff}.google-feed :global(.google-post-card img){display:block;width:100%;aspect-ratio:16/10;object-fit:contain;background:#f4faf8;border-radius:14px}.google-feed :global(.google-post-card p){white-space:pre-wrap;font-size:.96rem;line-height:1.7}.google-feed :global(.google-post-card time){display:block;font-size:.85rem;color:#52657b;margin:.8rem 0}.google-feed :global(.google-post-card details summary){cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:700;color:#08746f}@media(max-width:900px){.google-feed-source{grid-template-columns:1fr}.google-post-grid{grid-template-columns:1fr}.google-rail-heading{gap:.7rem}.google-rail-controls{gap:.4rem}.google-rail-controls button{width:44px;height:44px}}
</style>
