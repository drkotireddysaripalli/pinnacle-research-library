---
import PageLayout from '../layouts/PageLayout.astro';
import {Image} from 'astro:assets';
import Icon from './Icon.astro';
import CentreDirectory from './CentreDirectory.astro';
import TherapyTogether from './TherapyTogether.astro';
import hero from '../assets/assessment-hero-20260930.png';
import share from '../assets/assessment-social-20260930.png';
import emblem from '../assets/pinnacle-emblem-official.png';
import {assessmentContent as content,assessmentEnquiry} from '../data/assessment-content';
import {phone,url} from '../data/site';
import '../styles/assessment.css';
const lenses=[
 ['sun','What your child already does','Strengths, interests, preferences and ways of communicating belong at the beginning.'],
 ['home','What happens in everyday life','Bring one example from play, a meal, getting ready, learning or being with other people.'],
 ['compass','What you want to make possible','Choose a meaningful priority with the professional. Understand what to work on and how to review it.']
];
const example=[
 ['people','Begin with the family’s moment','“My child enjoys playing near other children. How can we help them invite someone to join?”'],
 ['measure','Understand abilities and context','The professional considers communication, play, comfort, support and what already works.'],
 ['plan','Agree one useful next step','An accessible gesture, picture, word or other invitation may be explored if appropriate for this child.'],
 ['track','Review what becomes usable','Discuss where it worked, what help was needed and what the family or professional should try next.']
];
const prep=[['people','Tell us a little','Your child’s age, one everyday question and a preferred location are enough to begin.'],['shield','Check the appointment','Ask who conducts it, why it fits your question, the format, fee and arrangements.'],['book','Know the next step','Ask what explanation or written output is included and when progress will be reviewed.']];
const proof=content.sources.filter(source=>['purpose','methods','md5','bis'].includes(source.id));
---
<PageLayout path={content.path} title={content.title} description={content.description} label="Child Development Assessment" serviceName="Child development assessment enquiries" serviceType="Developmental assessment and support planning enquiries" serviceAreaServed={null} shareImage={share} shareVersion="assessment-v130-20260930" imageAlt="Pinnacle Blooms child development assessment poster: Understand today, choose the next step; an Indian family with a child-development professional and phone 9100 181 181." imageCaption="Understand today. Choose the next step. Pinnacle Blooms Network." citations={content.sources.map(source=>source.url)} faqs={content.faqs} publishedOn="2026-09-30" updatedOn="2026-09-30" enquiry={{url:assessmentEnquiry,mobileLabel:'First conversation'}}>
 <section class="assessment-hero wrap" aria-labelledby="assessment-title">
  <div class="assessment-hero-copy"><p class="eyebrow">Child Development Assessment · Pinnacle Blooms Network</p><h1 id="assessment-title">{content.opening}<br/><em>{content.emphasis}</em></h1><p class="assessment-lead">{content.lead}</p><div class="assessment-actions"><a class="button primary" href={phone.href} data-cta="hero-call"><Icon name="phone"/>Call {phone.display}</a><a class="button outline" href={assessmentEnquiry} data-cta="hero-assessment">Start a conversation <Icon name="arrow"/></a></div><p class="assessment-guidance">Free telephone guidance · 24/7. Assessment, professional, appointment and fees confirmed with you.</p><p class="assessment-promise">Growing self-sufficiency. Mainstream participation.<br/><strong>The child’s life gives every next step its purpose.</strong></p></div>
  <figure class="assessment-hero-art"><Image src={hero} widths={[480,720,1080,1448]} sizes="(min-width:1000px) 46vw, 100vw" width={1448} height={1086} format="webp" quality={82} loading="eager" fetchpriority="high" alt="An Indian child explores a block with his mother, father and a Pinnacle-branded child-development professional; illustrated home, play and school possibilities surround the conversation."/><figcaption>Start with your child. Understand the present. Choose the next step together.</figcaption></figure>
 </section>
 <nav class="assessment-jump wrap" aria-label="On this assessment page"><a href="#what-assessment-clarifies">What you can understand</a><a href="#life-first">Why life comes first</a><a href="#first-visit">Before your first visit</a><a href="#evidence">Inspect the sources</a><a href="#centres">Find a centre</a></nav>
 <section class="section wrap" id="what-assessment-clarifies" aria-labelledby="assessment-answer-title"><span id="what-section" class="legacy-section-anchor" aria-hidden="true"></span><p class="eyebrow">A starting picture you can understand</p><h2 id="assessment-answer-title">More than a score.<br/><em>A useful next-step conversation.</em></h2><p class="assessment-intro">{content.direct}</p><div class="assessment-lens">{lenses.map(([icon,title,text])=><article><span class="assessment-icon"><Icon name={icon} size={32}/></span><h3>{title}</h3><p>{text}</p></article>)}</div><div class="assessment-boundary"><Icon name="shield" size={27}/><p><strong>Assessment, screening and diagnosis have different purposes.</strong> If you need a diagnostic answer about autism, ADHD or a health concern, ask about the appropriate qualified professional or pathway. A call, online form or software score does not diagnose. <a href="https://www.cdc.gov/autism/diagnosis/index.html">Read the distinction ↗</a></p></div></section>
 <section class="section assessment-purpose" id="life-first" aria-labelledby="assessment-purpose-title"><span id="why-section" class="legacy-section-anchor" aria-hidden="true"></span><div class="wrap assessment-purpose-grid"><div><p class="eyebrow">PinnacleAI® · A life-first direction</p><h2 id="assessment-purpose-title">Understand the abilities.<br/><em>Keep the whole life in view.</em></h2><p>A car’s parts matter because they make the journey possible. Likewise, a measured skill matters when it helps your child communicate a need, manage a routine, learn or take part with others.</p><p>Pinnacle begins with the child’s growing self-sufficiency and mainstream participation. That purpose guides what to understand, which goals to choose, which people and methods fit, and what to practise and review.</p><a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Read Pinnacle’s documented paradigm shift <Icon name="arrow"/></a></div><aside class="assessment-purpose-card"><Icon name="compass" size={38}/><h3>The life sets the direction.</h3><ol><li>What does your child want or need to do?</li><li>Which abilities and supports could help?</li><li>What will you and the professional review?</li></ol><p>One shared purpose. Child-specific decisions.</p></aside></div></section>
 <section class="section wrap" id="everyday-example" aria-labelledby="assessment-example-title"><p class="eyebrow">One everyday moment · An illustrative example</p><h2 id="assessment-example-title">Joining a game.<br/><em>A small question with a life purpose.</em></h2><p class="assessment-intro">Assessment can connect the family’s question with a relevant ability and an explained next step. This example shows that reasoning; it is not a patient story or a prescription.</p><ol class="assessment-example">{example.map(([icon,title,text],i)=><li><span class="assessment-step-number">{i+1}</span><Icon name={icon} size={26}/><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>
 <section class="section assessment-pathway" id="connected-pathway" aria-labelledby="assessment-pathway-title"><div class="wrap"><p class="eyebrow">Assessment begins the conversation. The child’s life continues it.</p><h2 id="assessment-pathway-title">Seven connected stages.<br/><em>Every stage serves everyday life.</em></h2><p class="assessment-intro">Assessment is a starting point within Pinnacle’s documented pathway. Relevant professionals and your family interpret the information, choose support and review change over time.</p><ol class="assessment-stages">{content.stages.map((stage,i)=><li><span class="assessment-stage-index">{i+1}</span><Icon name={stage.icon} size={32}/><h3>{stage.title}</h3><p>{stage.text}</p><a href={url(stage.path)}>How this stage works <Icon name="arrow" size={16}/></a></li>)}</ol><p class="source-note">This explains programme direction. Each child’s needs, progress and support differ; independence, speech, school admission and any particular timetable are not guaranteed.</p></div></section>
 <section class="section wrap assessment-technology" id="abilityscore" aria-labelledby="assessment-score-title"><div><p class="eyebrow">AbilityScore® · Structure for the human conversation</p><h2 id="assessment-score-title">A developmental scale.<br/><em>Read with the child’s context.</em></h2><p>AbilityScore uses a 0–1000 developmental ability scale. Professionals read it with age, assessed skills and everyday observations. Readiness views and PinnacleAI records can support planning; they do not replace professional judgement or decide care by themselves.</p><p>PinnacleAI GPT-OS v1.0.0 is licensed as Class B, non-diagnostic developmental-support software for children aged 0–12. That is the software’s intended-use scope, not a promise that every assessment format is available for every child.</p><div class="assessment-inline-links"><a href={url('/abilityscore')}>Explore AbilityScore →</a><a href={url('/pinnacleai')}>See the complete PinnacleAI system →</a></div></div><aside class="assessment-scale"><span class="eyebrow">0–1000</span><h3>Explain what the score means.</h3><ul><li>Which abilities were assessed?</li><li>What support was needed?</li><li>How does age and setting affect interpretation?</li><li>What useful next step follows?</li></ul><p>The methodology is a preprint. The external-validation publication is a protocol.</p><a href="https://zenodo.org/records/19482123">Methodology ↗</a> · <a href="https://zenodo.org/records/19482476">Validation protocol ↗</a></aside></section>
 <section class="section assessment-first" id="first-visit" aria-labelledby="assessment-visit-title"><span id="assessment-section" class="legacy-section-anchor" aria-hidden="true"></span><div class="wrap"><p class="eyebrow">Prepare for your first conversation</p><h2 id="assessment-visit-title">You bring one everyday question.<br/><em>We help check a suitable first step.</em></h2><div class="assessment-prep">{prep.map(([icon,title,text],i)=><article><span class="assessment-icon"><Icon name={icon} size={30}/></span><p class="assessment-small-label">Step {i+1}</p><h3>{title}</h3><p>{text}</p></article>)}</div><div class="assessment-actions"><a class="button primary" href={phone.href} data-cta="final-call"><Icon name="phone"/>Call {phone.display}</a><a class="button outline" href={assessmentEnquiry} data-cta="visit-enquiry">Arrange a conversation <Icon name="arrow"/></a></div><p class="assessment-guidance">Keep medical reports and detailed child information for your private professional conversation. Calling does not commit your family to a therapy package.</p></div></section>
 <TherapyTogether current="assessment"/>
 <section class="section wrap" id="evidence" aria-labelledby="assessment-evidence-title"><p class="eyebrow">Confidence you can inspect</p><h2 id="assessment-evidence-title">Understand the approach.<br/><em>Read the evidence behind it.</em></h2><div class="assessment-proof">{proof.map(source=><article><span class="assessment-icon"><Icon name={source.id==='methods'?'measure':source.id==='purpose'?'compass':'shield'} size={28}/></span><h3>{source.name}</h3><p>{source.scope}</p><a class="text-link" href={source.url}>Inspect the original source <Icon name="arrow" size={16}/></a></article>)}</div><details class="assessment-more-sources"><summary>Assessment principles, research status and further sources</summary><ul>{content.sources.filter(source=>!proof.includes(source)).map(source=><li><a href={source.url}>{source.name} ↗</a><p>{source.scope}</p></li>)}</ul></details><p class="source-note">Licences describe their named software and quality scope. External sources explain assessment principles and do not endorse Pinnacle. A licence or profile does not establish an individual child’s outcome.</p><div class="assessment-downloads"><a href="/pinnacle-pages-data/assessment-evidence.json"><Icon name="download"/>Source map · JSON</a><a href="/pinnacle-pages-data/assessment-evidence.txt"><Icon name="book"/>Claims and sources · text</a><a href="/pinnacle-pages-data/assessment-machine.md"><Icon name="book"/>Reading copy · Markdown</a><a href={url('/verify/evidence/cite.html')}><Icon name="award"/>Cite Pinnacle sources</a></div></section>
 <CentreDirectory pagePath={content.path} enquiryTarget={assessmentEnquiry} serviceNotice="Published Pinnacle locations are a directory, not a confirmed assessment roster. Call 9100 181 181 to check the suitable assessment, professional, current fees and appointment at your preferred centre before travelling."/>
 <section class="section wrap faq-section" id="questions" aria-labelledby="assessment-faq-title"><div><p class="eyebrow">Before you choose</p><h2 id="assessment-faq-title">Your questions.<br/><em>A clearer first step.</em></h2></div><div>{content.faqs.map(faq=><details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p>{faq.question==='Is the assessment free?'&&<p><a href={url('/speech-therapy/service-information#fees')}>Read the current speech and language assessment offer →</a></p>}</details>)}</div></section>
 <section class="final-cta" id="next-step" aria-labelledby="assessment-next-title"><div class="wrap"><div class="close-sun"><Image src={emblem} width={96} height={96} format="webp" loading="lazy" alt="Pinnacle Blooms Network pinwheel emblem"/></div><p class="eyebrow">Every Child Counts®</p><h2 id="assessment-next-title">One question today.<br/>A clearer next step for your child.</h2><p>Tell us what your child enjoys and what you want to make more possible.<br/>We’ll help check the right first professional conversation.</p><div class="final-actions"><a class="button white" href={phone.href} data-cta="final-call"><Icon name="phone"/>Call {phone.display}</a><a class="button light-outline" href={assessmentEnquiry} data-cta="final-enquiry">Start my family’s conversation <Icon name="arrow"/></a></div><p class="final-guidance">Free telephone guidance, 24/7 · Appointment, professional and fees confirmed with you.</p><a class="helpline-link" href={url('/national-autism-helpline')}>Pinnacle / BHCL National Autism Helpline →</a></div></section>
</PageLayout>
