---
import PageLayout from '../layouts/PageLayout.astro';
import EnrolmentCallback from './EnrolmentCallback.astro';
import HeroSlider from './HeroSlider.astro';
import ActionStrip from './ActionStrip.astro';
import Icon from './Icon.astro';
import TherapyTogether from './TherapyTogether.astro';
import CentreDirectory from './CentreDirectory.astro';
import EvidenceLinks from './EvidenceLinks.astro';
import { Image } from 'astro:assets';
import emblem from '../assets/pinnacle-emblem-official.png';
import firstConversation from '../assets/autism-first-conversation-20260930.png';
import schoolMorning from '../assets/autism-school-morning-20260929.png';
import shareCard from '../assets/autism-social-integrated-20260930.png';
import { autismTherapyContent as content, autismEnquiry } from '../data/autism-therapy-content';
import { phone, url } from '../data/site';

const proofCards = [
  {tag:'Licensed software scope',title:'Class B · MD-5',text:'PinnacleAI GPT-OS v1.0.0 is licensed as non-diagnostic developmental-support software for children aged 0–12. This is software scope, not an autism-therapy result.',ref:'MFG/MD/2026/000248',link:'/verify/evidence/records/md5.html',label:'Read the licence and scope'},
  {tag:'Named software and quality scope',title:'BIS · IS 23485:2019',text:'The BIS record names the documented device and modules. It does not certify an individual therapist or guarantee how a child will progress.',ref:'MD/L-2026029599 · schedule',link:'/verify/evidence/records/bis.html',label:'Read the BIS record and limits'},
  {tag:'Research source trail',title:'Methods. Findings. Context.',text:'Explore Pinnacle’s original publications and source records with their study design, cohort, publication status and limits visible.',ref:'Original sources · publication status',link:'/verify/evidence/research-library.html',label:'Explore the research library'}
];

const conversationLens = [
  ['sun','Strengths and interests','What does your child enjoy, seek out, understand and already do?'],
  ['voice','Communication','How does your child understand, express needs, choose, refuse or ask for help?'],
  ['home','Daily routines','Which moments at home or in the community feel easy, difficult or unpredictable?'],
  ['book','Play and learning','How does your child explore, play, learn and participate with other people?'],
  ['heart','Comfort and health','Could pain, sleep, feeding, hearing, anxiety, sensory conditions or another health need matter?'],
  ['people','Family priorities','What change would make daily life more possible for your child and family?']
];
const firstCallSteps = [
  ['people','Tell us one moment','Share what your child enjoys, what is difficult and what you want to make more possible.'],
  ['shield','Check a suitable next step','The team can check the relevant professional, centre, visit availability and current fees.'],
  ['compass','Decide together','After the options are explained, your family chooses whether and how to continue.']
];
const disciplines = [
  ['voice','Speech and communication','Needs, choices, ideas, understanding and interaction through an accessible method.','/top-speech-therapy-center-india-proven-improvement-rate'],
  ['home','Occupational therapy','Everyday routines, play, self-care, sensory-motor access and participation.','/best-occupational-therapy-center-india-proven-improvement-rate'],
  ['heart','ABA / behavioural support','Understand patterns and develop useful, acceptable alternatives when indicated.','/best-aba-therapy-center-india-proven-improvement-rate'],
  ['book','Special Education','Learning access, educational abilities and classroom participation.','/best-special-education-center-call-9100181181'],
  ['people','Family and school','Priorities and observations from the child’s daily settings, shared with consent.'],
  ['shield','Relevant health professionals','Hearing, pain, sleep, feeding, mental health or other factors when indicated.']
];
const stageLinks=[['/abilityscore','AbilityScore®'],['/prognose','Readiness & planning'],['/therapeuticai','Relevant intervention'],['/everyday-therapy','Everyday Therapy'],['/fusion-module','Track & correct'],['/reassess-review-repeat','Reassess & review'],['/self-sufficient','Self-sufficient life']];
const morningSteps = [
  ['The life goal','The family wants the child to take part in getting ready for school: choose a familiar item, pack it and ask for help when needed. Participation is the purpose; finishing quickly is not the measure.'],
  ['The starting observation','In this fictional example, the child chooses a familiar bottle from two options. When asked to “get ready”, the child waits and the parent completes the packing. Choosing is an observed strength; the broad instruction and packing sequence still need to be understood.'],
  ['One agreed adjustment','After observing the routine, the speech and language professional and family agree a clear way to request help. The educational professional makes the next step visible: one picture for “bottle in bag”, with the actual bottle and open bag nearby. At home, the parent will offer the same picture, bottle and open bag, give the child time to try or request help, and note the assistance and comfort to discuss at review. They agree to try that one step rather than add more instructions.'],
  ['The right contribution, when needed','If reaching, gripping, clothing or sensory conditions make that step difficult, an occupational therapist considers access and the environment. If moving between activities remains difficult, suitable behavioural support examines predictability, communication and the context. Each contribution has a reason; four therapies are not prescribed automatically.'],
  ['The next checkpoint','At the review agreed with the family, ask: did the child choose, begin the packing step or request help; what prompt or assistance was used; was the child comfortable? With consent, compare the same supported step at school. The response to this adjustment has not yet been observed.']
];
const reviewBranches=[
 ['check','A useful supported step','If the child uses the step comfortably with the agreed help, keep that support long enough to understand when it is useful. Decide together whether and how to change the help. A prompted action is not yet independent use.'],
 ['plan','The step is still inaccessible','If the child does not begin, revisit the instruction, communication method, objects and setting. The relevant professional and family choose one adjustment to review; simply adding more sessions does not answer what blocked participation.'],
 ['heart','Comfort or the priority changes','If the child communicates distress or the family priority changes, pause the demand and reconsider the plan. Pain, sudden change or loss of abilities calls for the appropriate health review.']
];

---
<PageLayout path={content.path} label={content.label} serviceName={content.name} serviceType={content.type} serviceAreaServed={null} title={content.title} description={content.description} citations={content.citations} faqs={content.faqs} imageAlt="Pinnacle Blooms Autism Therapy: one child, one life-first direction, with relevant support and 9100 181 181." imageCaption="A family-led, child-specific direction for communication, routines, learning and participation." shareImage={shareCard} shareVersion="2026-09-30-autism-life-first" publishedOn="2026-09-29" updatedOn="2026-10-05" enquiry={content.enquiry}>
  <HeroSlider content={{...content,enquiry:{...content.enquiry,url:'#callback',label:'Request a callback'}}} />
  <EnrolmentCallback service="autism"/>
  <ActionStrip focused firstLabel="First conversation" firstHref="#first-conversation" />

  <section class="section wrap service-fit autism-fit" id="what-section" aria-labelledby="autism-fit-title">
    <div class="fit-heading"><p class="eyebrow">Begin with your child—not a therapy list</p><h2 id="autism-fit-title">What would you like<br/><em>to become more possible?</em></h2></div>
    <p class="occupational-intro">Different children experience autism differently. Start with your child’s strengths, preferences and everyday life, then understand where support may help.</p>
    <div class="concern-grid">{content.concerns.map(concern=><article><span class="concern-icon"><Icon name={concern.icon} size={30}/></span><h3>{concern.title}</h3><p>{concern.copy}</p></article>)}</div>
    <aside class="aba-direct-answer autism-direct-answer"><Icon name="compass" size={36}/><div><p class="eyebrow">A direct answer</p><h3>Autism therapy is not one fixed programme.</h3><p>We start with the everyday life your child wants to take part in. Depending on assessment, we bring together only the therapies, family and school supports, and health referrals that fit. Communication, play, learning, routines, sensory-motor participation and behaviour may each matter differently. Every autistic child does not need every therapy.</p></div><a href="https://www.who.int/news-room/fact-sheets/detail/autism-spectrum-disorders">Read the WHO autism fact sheet ↗</a></aside>
    <p class="source-note">WHO describes autism as diverse and support needs as individual and evolving. WHO does not endorse Pinnacle or determine an individual child’s plan.</p>
    <div class="assessment-route"><a href="#first-conversation"><Icon name="clock"/>First conversation</a><a href="#everyday-example"><Icon name="people"/>See one connected example</a><a href="#centres"><Icon name="pin"/>Find a centre</a></div>
  </section>

  <span id="assessment-section" class="legacy-section-anchor" aria-hidden="true"></span>
<section class="section aba-first autism-first" id="first-conversation" aria-labelledby="autism-first-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">Bring one everyday moment</p><h2 id="autism-first-title">You do not need to assemble<br/><em>the team alone.</em></h2></div><p>Tell us what your child enjoys, what feels difficult and what you hope can become more possible. We listen first, consider the wider picture and help identify a suitable professional next step.</p></div>
    <ol class="aba-first-steps">{firstCallSteps.map(([icon,title,text],i)=><li><span>{i+1}</span><Icon name={icon} size={26}/><h3>{title}</h3><p>{text}</p></li>)}</ol>
    <div class="aba-first-actions"><a class="button primary" href={phone.href} data-cta="autism-first-call"><Icon name="phone"/>Call {phone.display}</a><a class="button outline" href={autismEnquiry} data-cta="autism-first-enquiry">Start my child’s first conversation <Icon name="arrow"/></a></div>
    <figure class="autism-first-visual"><Image src={firstConversation} widths={[480,800,1200,1680]} sizes="(min-width:1360px) 1280px, calc(100vw - 36px)" width={1732} height={918} format="webp" quality={80} loading="lazy" decoding="async" alt="An Indian child uses a picture card to share a choice with his mother and a child-development professional; home, school and play moments appear along a colourful pathway."/><figcaption>One family observation can start a useful conversation. A professional helps decide what to understand next.</figcaption></figure>
    <details class="autism-lens-details"><summary>What might a professional want to understand?</summary><div class="aba-lens-grid">{conversationLens.map(([icon,title,text])=><article><span><Icon name={icon} size={27}/></span><h3>{title}</h3><p>{text}</p></article>)}</div></details>
    <div class="technology-bridge"><Icon name="shield" size={30}/><p><strong>A clear boundary.</strong> A call, online form or PinnacleAI record does not diagnose autism. Diagnosis requires an appropriately qualified diagnostic pathway. Sudden changes, loss of abilities, pain or health concerns need appropriate medical or qualified professional review.</p></div>
  </div></section>

  <span id="why-section" class="legacy-section-anchor" aria-hidden="true"></span>
<section class="section wrap difference autism-difference" id="pinnacle-difference" aria-labelledby="autism-difference-title">
    <div class="story-heading"><p class="eyebrow">Pinnacle’s life-first direction</p><h2 id="autism-difference-title">Your child’s life sets the direction.<br/><em>The right support follows.</em></h2><p>Bricks matter because they form the home a family will live in. Likewise, a therapy technique matters when it helps your child communicate, learn, participate or do more in everyday life. We choose the relevant contributions around that purpose; there is no compulsory four-therapy bundle.</p></div>
    <p class="life-purpose-line">The life we work toward: <strong>growing self-sufficiency · mainstream participation · a wonderful life.</strong></p>
    <div class="aba-discipline-grid autism-disciplines">{disciplines.map(([icon,title,text,href])=><article><span><Icon name={icon} size={28}/></span><h3>{title}</h3><p>{text}</p>{href&&<a class="text-link" href={url(href)}>How this support can help <Icon name="arrow" size={16}/></a>}</article>)}</div>
    <p class="autism-selection-note"><strong>A child may need one contribution, several or a different route.</strong> Assessment determines relevance. Pinnacle does not prescribe every therapy to every child.</p>
    <div class="autism-system" id="pinnacleai-journey"><p class="eyebrow">PinnacleAI® · Seven connected stages</p><h3>One purpose connects every next step.</h3><p>We bring the starting picture, relevant support and everyday observations into a continuing cycle. Your family helps shape the priorities; professionals interpret what the information means for your child.</p><ol class="autism-stage-grid">{content.pathway.stages.map(([icon,title,text],i)=><li><span class="autism-stage-number">{i+1}</span><Icon name={icon} size={28}/><h4>{title}</h4><p>{text}</p><a href={url(stageLinks[i][0])}>{stageLinks[i][1]} <Icon name="arrow" size={18}/></a></li>)}</ol><nav class="autism-system-links" aria-label="The wider PinnacleAI system"><a href={url('/pinnacleai')}>Explore PinnacleAI® →</a><a href={url('/seven-readiness-indexes')}>Seven Readiness Indexes →</a><a href={url('/personal-development-kernel')}>Your child-specific plan →</a><a href={url('/mainstream')}>Mainstream participation →</a></nav></div>
    <figure class="life-horizon"><Image src={content.pathway.image} widths={[480,800,1200,1600]} sizes="(min-width:1360px) 1280px, calc(100vw - 36px)" width={1600} height={900} format="webp" quality={78} alt={content.pathway.alt} loading="lazy" decoding="async"/><figcaption>{content.pathway.caption}</figcaption></figure>
    <div class="special-paradigm-links"><a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Read the documented life-first approach <Icon name="arrow"/></a><EvidenceLinks group="practice" label="See how goals, practice and feedback connect"/></div>
    <p class="source-note">This is Pinnacle’s programme direction. “Toward” describes the purpose of planning and review; it is not a guarantee of speech, independence, school admission, mainstream inclusion or a particular result.</p>
  </section>

  <span id="procedure-section" class="legacy-section-anchor" aria-hidden="true"></span>
<section class="section aba-example autism-example" id="everyday-example" aria-labelledby="autism-example-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">One morning routine · Different contributions · One child</p><h2 id="autism-example-title">Getting ready for school.<br/><em>One meaningful life goal.</em></h2></div><p>Follow one family priority from a starting observation to a professional adjustment and a clear next review. This is an illustrative explanation, not a patient story or an individual treatment plan.</p></div>
    <figure class="aba-story autism-story"><Image src={schoolMorning} widths={[480,800,1200,1680]} sizes="(min-width:1360px) 1280px, calc(100vw - 36px)" width={1536} height={864} format="webp" quality={82} loading="lazy" decoding="async" alt="The same Indian child communicates a choice with his mother, prepares a school bag with his father and participates with a teacher and peers in a classroom."/><figcaption>One child, one family priority and only the relevant professional contributions, connected by practice and review.</figcaption></figure>
    <ol class="aba-cycle autism-morning-steps">{morningSteps.map(([title,text],i)=><li><span>{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
    <div class="autism-review-decisions"><p class="eyebrow">A review changes what happens next</p><h3>Continue, adapt or reconsider—with a reason.</h3><div class="autism-review-branches">{reviewBranches.map(([icon,title,text])=><article><Icon name={icon} size={28}/><h4>{title}</h4><p>{text}</p></article>)}</div><p class="source-note">One successful supported step would not establish independent packing, school readiness or generalisation. The next observation determines the next decision. <a href={url('/fusion-module')}>See how tracking and correction connect →</a></p></div>
    <div class="aba-first-actions"><a class="button primary" href={phone.href} data-cta="autism-example-call"><Icon name="phone"/>Call {phone.display}</a><a class="button outline" href={autismEnquiry}>Talk about my child’s everyday goal <Icon name="arrow"/></a></div>
  </div></section>

  <span id="Advantages-section" class="legacy-section-anchor" aria-hidden="true"></span>
<section class="section wrap occupational-family autism-family" id="family-school" aria-labelledby="autism-family-title"><div><p class="eyebrow">Family, child and school knowledge belongs in review</p><h2 id="autism-family-title">A session sees one moment.<br/><em>You see the rest of the day.</em></h2><p>Parents and caregivers bring priorities and observations from everyday life. With consent and privacy safeguards, teachers can add what happens in learning and classroom routines. The child’s communication, preferences and comfort remain central.</p><EvidenceLinks group="practice" label="How everyday observations shape the next step"/></div><div class="occupational-family-cards"><article><Icon name="home"/><h3>At home</h3><p>Use only manageable, agreed supports in natural routines. Family partnership is not blame or unpaid therapy.</p></article><article><Icon name="book"/><h3>At school</h3><p>Share useful observations with consent and ask what helps the child understand, communicate and participate.</p></article><article><Icon name="loop"/><h3>Back in review</h3><p>Use what happened to continue, adapt, refer, pause or complete a support as appropriate.</p></article></div></section>

  <section class="section aba-review autism-review" id="measurement-and-review" aria-labelledby="autism-review-title"><div class="wrap aba-review-grid">
    <div><p class="eyebrow">PinnacleAI® · Measurement with life still in view</p><h2 id="autism-review-title">Measurement keeps the plan accountable.<br/><em>People keep it human.</em></h2><p>PinnacleAI GPT-OS v1.0.0 is listed on Form MD-5 as Class B Developmental Support Software (Non-Diagnostic) for children aged 0–12. It supports developmental ability measurement, readiness tracking, progress forecasting and adaptive therapy-plan support. Professionals and families remain responsible for decisions.</p><div class="aba-proof-links"><a href={url('/verify/evidence/records/md5.html')}>Inspect the MD-5 licensed scope ↗</a><a href={url('/verify/evidence/records/bis.html')}>Inspect the BIS schedule and limits ↗</a><a href={url('/verify/evidence/records/fsc.html')}>Inspect the Free Sale Certificate ↗</a><a href={url('/verify/evidence/research-library.html')}>Inspect research status and methods ↗</a></div></div>
    <aside class="aba-observation"><Icon name="loop" size={34}/><p class="eyebrow">Bring these questions into review</p><h3>Is the ability becoming usable in life?</h3><ul><li>What could the child understand, communicate or do?</li><li>What mattered to the child and family?</li><li>What support helped?</li><li>What support was still needed?</li><li>Did it appear in another relevant setting?</li><li>What should the team change next?</li></ul></aside>
  </div></section>

  <span id="ChildrenServices-section" class="legacy-section-anchor" aria-hidden="true"></span>
  <TherapyTogether current="autism" />

  <section class="section evidence-section" id="evidence" aria-labelledby="autism-evidence-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">Confidence you can inspect</p><h2 id="autism-evidence-title">Hope with direction.<br/><em>Claims with visible sources and limits.</em></h2></div><p>Pinnacle publishes source documents, research statuses and boundaries. Licences define the software and management-system scope; they do not diagnose autism, credential every professional or guarantee an individual child’s outcome.</p></div>
    <div class="evidence-cards">{proofCards.map(card=><article><span class="proof-icon"><Icon name={card.title.startsWith('Class')?'shield':card.title.startsWith('BIS')?'plan':'book'} size={35}/></span><span class="card-tag">{card.tag}</span><h3>{card.title}</h3><p>{card.text}</p><span class="record-reference">{card.ref}</span><a class="text-link" href={url(card.link)}>{card.label} <Icon name="arrow"/></a></article>)}</div>
    <div class="aba-source-grid"><article><h3>Diverse needs and integrated support</h3><p>WHO describes autism as diverse and calls for individualised, integrated services with participation by autistic people and families.</p><a href="https://www.who.int/news-room/fact-sheets/detail/autism-spectrum-disorders">WHO autism fact sheet ↗</a></article><article><h3>Individual, multidisciplinary planning</h3><p>NICE recommends assessment of strengths, needs, communication, health, environment and family context, with coordinated support.</p><a href="https://www.nice.org.uk/guidance/cg170/chapter/Recommendations">NICE support guidance ↗</a></article><article><h3>Ask about professional registration</h3><p>RCI publishes norms and routes for recognised rehabilitation qualifications and registration where applicable.</p><a href="https://rehabcouncil.nic.in/norms-guidelines/">Rehabilitation Council of India ↗</a></article></div>
    <div class="special-provider-check"><Icon name="shield" size={34}/><div><p class="eyebrow">Five questions before you choose</p><h3>Ask what will be understood, connected and reviewed.</h3><ol><li>What qualification and current registration applies to the professional?</li><li>What child and family priority is this goal connected to?</li><li>Why is each recommended service relevant?</li><li>How will communication, dignity and preferences be respected?</li><li>When will progress be reviewed and the plan corrected?</li></ol></div></div>
    <div class="aba-transparency"><a href={url('/verify/')}><Icon name="shield"/>Verify evidence library</a><a href={url('/verify/evidence/pinnacleai-regulatory-journey.html')}><Icon name="book"/>PinnacleAI regulatory journey</a><a href={url('/verify/evidence/research-library.html')}><Icon name="sun"/>Research source trail</a><a href={url('/verify/evidence/cite.html')}><Icon name="link"/>Cite Pinnacle sources</a></div>
    <p class="source-note">External sources explain applicable principles and do not endorse Pinnacle. Regulatory records establish their stated scope and status, not a particular child’s outcome.</p>
    <p class="source-note source-downloads"><a href="/pinnacle-pages-data/autism-therapy-evidence.txt">Claims and sources for this page</a> · <a href="/pinnacle-pages-data/autism-therapy-evidence.json">Download source map (JSON)</a></p>
  </div></section>

  <CentreDirectory pagePath={content.path} enquiryTarget={autismEnquiry} serviceNotice="These 62 entries are published Pinnacle network locations, not a confirmed autism-therapy specialist roster. Call 9100 181 181 to check the suitable professional, current service, appointment and fees at a particular centre before travelling."/>

  <span id="Cost-section" class="legacy-section-anchor" aria-hidden="true"></span>
<section class="section wrap faq-section" id="questions" aria-labelledby="autism-faq-title"><div><p class="eyebrow">Before you decide</p><h2 id="autism-faq-title">Clear answers.<br/><em>A child-specific first step.</em></h2><a class="text-link" href="https://www.who.int/news-room/fact-sheets/detail/autism-spectrum-disorders">Autism and individual support · WHO ↗</a></div><div>{content.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></section>

  <span id="admission-section" class="legacy-section-anchor" aria-hidden="true"></span>
<section class="final-cta" id="next-step" aria-labelledby="autism-next-title"><div class="wrap"><div class="close-sun official-close"><Image src={emblem} width={96} height={96} format="webp" loading="lazy" alt="Pinnacle official pinwheel emblem"/></div><p class="eyebrow">Every Child Counts®</p><h2 id="autism-next-title">Start with one everyday moment<br/>you want to make more possible.</h2><p>Tell us about your child’s strengths, the moment that concerns you and what matters to your family.<br/>We’ll help you find a suitable centre and first professional conversation.</p><div class="final-actions"><a class="button white" href={phone.href}><Icon name="phone"/>Call {phone.display}</a><a class="button light-outline" href={autismEnquiry}>Start my child’s first conversation <Icon name="arrow"/></a></div><div class="close-moments"><span><Icon name="voice"/>A need to communicate.</span><span><Icon name="home"/>A routine to navigate.</span><span><Icon name="people"/>A life to take part in.</span></div><p class="final-guidance">Free guidance, 24/7 · Service, professional, appointment and fees confirmed by the team.</p><a class="helpline-link" href={url('/national-autism-helpline')}>Pinnacle / BHCL National Autism Helpline →</a></div></section>
</PageLayout>

<style>
  .autism-review .aba-review-grid>div>.eyebrow{color:#baf2ec}
  .autism-morning-steps{display:grid;grid-template-columns:1fr;gap:16px}.autism-morning-steps>li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:16px}.autism-morning-steps>li>span{align-self:start}.autism-stage-grid>li:last-child{grid-column:1/-1;background:#f2fcfa}.autism-stage-grid>li:last-child p{max-width:800px}
  .autism-system{margin:38px 0 28px}.autism-system>h3,.autism-review-decisions>h3{font-size:clamp(1.45rem,2.1vw,2rem);line-height:1.35;color:#14274e}.autism-system>p{max-width:900px}
  .autism-stage-grid{list-style:none;padding:0;margin:25px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.autism-stage-grid>li{min-width:0;padding:24px;border:1px solid #dce8eb;border-top:4px solid #008f83;border-radius:22px;background:#fff;display:flex;flex-direction:column;align-items:flex-start;position:relative}.autism-stage-grid>li:nth-child(even){border-top-color:#8d269b}.autism-stage-number{position:absolute;right:22px;top:19px;font-size:1.6rem;font-weight:700;color:#8d269b}.autism-stage-grid h4,.autism-review-branches h4{font-size:1.13rem;line-height:1.5;color:#14274e;margin:14px 0 9px}.autism-stage-grid p,.autism-review-branches p{font-size:1rem;line-height:1.75}.autism-stage-grid a{display:inline-flex;align-items:center;gap:8px;min-height:44px;margin-top:auto;padding-top:10px;color:#732294;font-weight:700;text-decoration:underline;text-underline-offset:4px}.autism-system-links{display:flex;flex-wrap:wrap;gap:12px 22px}.autism-system-links a{display:inline-flex;align-items:center;min-height:44px;font-weight:700;color:#732294;text-decoration:underline;text-underline-offset:4px}
  .life-horizon figcaption{padding:14px 22px;background:#fff;color:#214162;font-size:1rem;line-height:1.6}.autism-review-decisions{margin-top:30px}.autism-review-branches{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:24px 0}.autism-review-branches article{min-width:0;padding:24px;border-radius:20px;background:#fff;border-left:5px solid #008f83}.autism-review-branches article:nth-child(2){border-color:#8d269b}.autism-review-branches article:nth-child(3){border-color:#d82872}.autism-morning-steps{max-width:1000px}.autism-morning-steps p{line-height:1.8}
  @media(max-width:1000px){.autism-stage-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.autism-review-branches{grid-template-columns:1fr}}
