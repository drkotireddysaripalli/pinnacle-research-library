---
import {Image} from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import {fusionContent as c} from '../data/fusion-content';
import {pinnacleWave} from '../data/pinnacleai-wave';
import {phone,url} from '../data/site';
import hero from '../assets/fusion-editorial-20260930.png';
import social from '../assets/pinnacleai-fusion-social-20260930.png';
import '../styles/fusion.css';
const page=pinnacleWave.find(p=>p.slug==='fusion-module')!;
const canonical=url('/fusion-module');
const graph=[{'@type':'DefinedTerm','@id':canonical+'#module',name:'PinnacleAI Fusion Module',url:canonical,description:c.direct,isPartOf:{'@id':url('/pinnacleai')+'#software'},subjectOf:c.sources.map(s=>url(s.href))}];
const destinations: Record<string,string>={'/everyday-therapy':'Everyday Therapy','/personal-development-kernel':'Personal Development Kernel','/therapeuticai':'TherapeuticAI','/reassess-review-repeat':'Reassessment','/abilityscore':'AbilityScore®','/prognose':'Prognose & planning','/autism-therapy':'Integrated autism therapy','#worked-example':'Fusion in the example','/self-sufficient':'Self-sufficient life'};
const link=(href:string)=>href.startsWith('#')?href:url(href);
---
<PageLayout path="/fusion-module" label="Fusion tracking and correction" title={page.title} description={page.description} shareImage={social} shareVersion="2026-09-30-pinnacleai-editorial" imageAlt="PinnacleAI Fusion · connecting home, therapy and school observations · Pinnacle Blooms Network · 9100 181 181" includeService={false} primaryEntityId={canonical+'#module'} entityGraph={graph} citations={c.sources.map(s=>url(s.href))} faqs={c.faqs} publishedOn="2026-09-30" updatedOn={c.updatedOn} breadcrumbParent={{name:'PinnacleAI®',path:'/pinnacleai'}}>
<div class="fusion-page">
 <section class="fusion-hero fusion-wrap" aria-labelledby="fusion-title">
  <div><p class="fusion-kicker"><Icon name="loop" size={22}/>PinnacleAI® · Fusion</p><h1 id="fusion-title">What happens in your child’s day<br/><em>should shape the next step.</em></h1><p class="fusion-lead">{c.lead}</p><div class="fusion-actions"><a class="fusion-btn fusion-primary" href={phone.href} data-cta="pinnacleai-call"><Icon name="phone"/>Call {phone.display}</a><a class="fusion-btn" href={url('/enroll-autism-speech-aba-therapies-india')} data-cta="final-enquiry">Begin with Pinnacle <Icon name="arrow"/></a></div><p class="fusion-purpose">{c.purpose}</p><p class="fusion-help">Telephone guidance is free. We’ll explain the suitable professional, centre, first visit and fees before you decide.</p><a class="fusion-text-link" href={url('/centers')}><Icon name="pin" size={20}/>Find a Pinnacle centre →</a></div>
  <figure class="fusion-hero-art"><Image src={hero} widths={[400,640,900,1536]} sizes="(min-width: 1000px) 46vw, (min-width: 700px) 620px, 100vw" format="webp" quality={80} loading="eager" fetchpriority="high" alt="Illustrated Pinnacle child, family and professional, with therapy, home and school scenes connected into a shared review."/><figcaption>Therapy. Home. School where relevant. One child at the centre of review.</figcaption></figure>
 </section>
 <nav class="fusion-jump fusion-wrap" aria-label="On this page"><a href="#worked-example"><Icon name="people" size={18}/>One child · three settings</a><a href="#what-it-does"><Icon name="loop" size={18}/>What Fusion does</a><a href="#architecture"><Icon name="track" size={18}/>From observation to decision</a><a href="#sources"><Icon name="shield" size={18}/>Licences &amp; evidence</a><a href="#next-step"><Icon name="phone" size={18}/>Begin with Pinnacle</a></nav>
 <section id="what-it-does" class="fusion-section fusion-tint"><div class="fusion-wrap fusion-definition"><div><p class="fusion-kicker">The plain answer</p><h2>Feedback matters when<br/><em>it changes what happens next.</em></h2><p>{c.direct}</p><p>Your family sees parts of your child’s life that an appointment cannot show. We bring those observations into the care discussion so the plan can respond to life beyond the therapy room.</p><a class="fusion-text-link" href={url('/verify/evidence/records/bis.html')}>See Fusion in the BIS module schedule →</a></div><aside class="fusion-quote"><Icon name="compass" size={34}/><blockquote>A route needs direction.<br/>It also needs course correction.</blockquote><p>Your child’s life gives the direction. What happens during practice helps the family and professional decide the next turn. Fusion connects those observations with review.</p><a href="#worked-example">Follow one decision below →</a></aside></div></section>
 <section id="worked-example" class="fusion-section"><div class="fusion-wrap"><div class="fusion-heading"><p class="fusion-kicker">See the difference. Understand the decision.</p><h2>{c.example.title}</h2><p>{c.example.intro}</p></div>
  <p class="fusion-scan-summary"><strong>The decision in this example:</strong> keep the picture cue, choose a quieter setting and make pausing easy. See the observations that led to it below.</p>
  <div class="fusion-observations">{c.example.cards.map(o=><article><p class="fusion-kicker"><Icon name={o.icon} size={26}/>{o.label}</p><h3>{o.title}</h3><dl><dt>Setting</dt><dd>{o.setting}</dd><dt>Adult support</dt><dd>{o.support}</dd><dt>Child’s response</dt><dd>{o.response}</dd></dl><p class="fusion-observation-meaning"><strong>What this tells us</strong>{o.meaning}</p></article>)}</div>
  <div class="fusion-comparison"><Icon name="track" size={34}/><div><p class="fusion-kicker">Compare the context, not just the result</p><h3>Keep support and setting in the picture.</h3><p>{c.example.comparison}</p></div></div>
  <div class="fusion-revision"><Icon name="people" size={34}/><div><p class="fusion-kicker">The professional decision in this example</p><h3>Keep the picture cue. Change the setting.</h3><p>{c.example.decision}</p></div></div>
  <div class="fusion-checkpoint"><p class="fusion-kicker"><Icon name="clock" size={20}/>The next agreed checkpoint</p><h3>What did the revised support make possible?</h3><p>{c.example.checkpoint}</p></div><div class="fusion-review-branches">{c.example.branches.map(b=><article><Icon name="loop" size={25}/><h3>{b.title}</h3><p>{b.text}</p></article>)}</div><p class="fusion-source-note">The child’s choice and comfort remain part of the decision. <a href={url('/top-speech-therapy-center-india-proven-improvement-rate#everyday-communication')}>Explore how a communication goal carries into everyday life →</a></p>
 </div></section>
 <section id="architecture" class="fusion-section fusion-tint"><div class="fusion-wrap"><div class="fusion-heading"><p class="fusion-kicker">Inside PinnacleAI®</p><h2>Observations in.<br/><em>A clear next decision out.</em></h2><p>Fusion’s place in the system is the return journey: from what actually happened to what the professional and family decide to do next.</p></div><ol class="fusion-architecture">{c.architecture.map((a,i)=><li><span class="fusion-step-number">0{i+1}</span><Icon name={a.icon} size={30}/><h3>{a.title}</h3><p>{a.text}</p><a href={url(a.href)}>{destinations[a.href]} →</a></li>)}</ol><div class="fusion-feedback"><Icon name="loop" size={30}/><p><strong>The next observation comes back around.</strong> It can support the decision—or give the team a reason to change it. A higher rating alone cannot tell the whole story.</p></div><details class="fusion-access"><summary>Who contributes, and who decides?</summary><p>The child’s response, family knowledge and relevant professional observations guide review. School or other outside input needs appropriate consent and authorised access. Different roles contribute where useful; they are not a requirement for every child.</p><p>Ask your professional how to share an observation in your current care programme and when it will be reviewed. Private records stay in the agreed care channel. This page does not provide access to a child’s record.</p><a href={url('/verify/evidence/records/dossier.html')}>Read the architecture and evidence context →</a></details></div></section>
 <section id="pinnacleai-journey" class="fusion-section"><div class="fusion-wrap"><div class="fusion-heading"><p class="fusion-kicker">Seven stages. One child’s life.</p><h2>Track the practice.<br/><em>Keep the purpose bigger than the task.</em></h2><p>A turn with a ball matters because it can contribute to choice, communication and participation. Fusion connects the observations to the wider journey toward a self-sufficient, mainstream-included life.</p></div><ol class="fusion-stages">{c.stages.map((s,i)=><li><span>{i+1}</span><Icon name={s.icon} size={27}/><h3>{s.title}</h3><p>{s.text}</p><a href={link(s.href)}>{destinations[s.href]} →</a></li>)}</ol><p class="fusion-source-note"><a href={url('/pinnacleai')}>Explore PinnacleAI®</a> · <a href={url('/seven-readiness-indexes')}>Seven Readiness Indexes</a> · <a href={url('/mainstream')}>Mainstream participation</a> · <a href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>The paradigm shift</a></p><h3 class="fusion-therapy-title">Different expertise. The same meaningful goal.</h3><div class="fusion-therapies">{c.therapies.map(t=><a href={url(t.href)}><strong>{t.name}<Icon name="arrow" size={19}/></strong><span>{t.text}</span></a>)}</div><p>Relevant professionals can use the shared observations to coordinate their contributions. <a href={url('/autism-therapy')}>Explore integrated autism therapy</a>. The plan follows the child’s needs; it is not a compulsory bundle.</p></div></section>
 <section id="sources" class="fusion-section fusion-tint"><div class="fusion-wrap"><div class="fusion-heading"><p class="fusion-kicker">Inspect the records. Understand the scope.</p><h2>Named in the licence schedule.<br/><em>Connected to evidence you can read.</em></h2><p>Pinnacle Blooms Network is operated by Bharath Healthcare Laboratories Private Limited. These records let your family and professional examine the module’s documented role and the software’s intended use.</p></div><div class="fusion-sources">{c.sources.map(s=><article><p class="fusion-kicker">{s.label}</p><h3><Icon name={s.href.includes('bis')||s.href.includes('md5')?'shield':'book'} size={25}/>{s.title}</h3><p>{s.text}</p><p class="fusion-source-detail">{s.detail}</p><a href={url(s.href)}>Inspect the source →</a></article>)}</div><div class="fusion-actions fusion-source-downloads"><a href="/pinnacle-pages-data/fusion-module-sources.json">Source map · JSON</a><a href="/pinnacle-pages-data/fusion-module-sources.txt">Plain text</a><a href="/pinnacle-pages-data/fusion-module-reading.md">Markdown reading aid</a><a href={url('/verify/evidence/research-library.html')}>Research &amp; publication status</a><a href={url('/verify/evidence/cite.html')}>Citation library</a><a href={'https://wa.me/?text='+encodeURIComponent('PinnacleAI Fusion: how everyday observations can shape the next support decision. '+canonical)}>Share on WhatsApp</a></div></div></section>
 <section id="questions" class="fusion-section"><div class="fusion-wrap fusion-faq-layout"><div><p class="fusion-kicker">Questions worth bringing to review</p><h2>Your observations matter.<br/><em>You should understand what they change.</em></h2><p>You do not need to become a technology expert to contribute something useful about your child’s day.</p></div><div class="fusion-faq">{c.faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
 <section id="next-step" class="fusion-close"><div class="fusion-wrap"><p class="fusion-kicker">Every Child Counts®</p><h2>Tell us where it works.<br/>Tell us where it is still hard.</h2><p>One everyday observation is a good place to begin. We’ll help you find the suitable professional conversation, understand the next visit and choose your next step.</p><ul><li><Icon name="heart"/>Tell us what your child enjoys and what you hope to make easier.</li><li><Icon name="people"/>Discuss the relevant professional and centre.</li><li><Icon name="compass"/>Understand the first visit and fees before deciding.</li></ul><div class="fusion-actions"><a class="fusion-btn fusion-primary" href={phone.href} data-cta="pinnacleai-close-call"><Icon name="phone"/>Call {phone.display}</a><a class="fusion-btn" href={url('/enroll-autism-speech-aba-therapies-india')} data-cta="final-enquiry">Begin with Pinnacle <Icon name="arrow"/></a><a class="fusion-text-link" href={url('/centers')}>Find a centre →</a></div><p class="fusion-help">Telephone guidance is free. Care choices and review follow your child’s needs and the professional discussion.</p></div></section>
</div>
</PageLayout>
