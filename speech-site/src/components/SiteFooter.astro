---
import { Image, getImage } from 'astro:assets';
import wordmark from '../assets/pinnacle-blooms-network-lockup.png';
import operator from '../assets/bhcl-emblem-official.png';
import footerShapes from '../assets/portal-footer-shapes.png';
import { url, phone } from '../data/site';
import navigation from '../data/portal-navigation.json';
import Icon from './Icon.astro';
import PortalFooterGroup from './PortalFooterGroup.astro';
import VerifyFooter from './VerifyFooter.astro';
const shapes=await getImage({src:footerShapes,format:'webp',quality:80});
---
<footer class="portal-site-footer">
 <VerifyFooter />
 <div class="portal-footer" style={`--portal-footer-art:url('${shapes.src}')`}>
  <div class="portal-footer-art"><div class="portal-container">
    <div class="portal-footer-evidence"><div><h2>A useful first conversation.</h2><p>Tell us what you want to make possible in your child’s everyday life. Start with one conversation about your priorities and a suitable next step.</p><a class="portal-footer-start" href={phone.href} data-cta="footer-call"><Icon name="phone"/> {phone.display}</a><a href={url('/verify/')}>Explore Pinnacle Verify →</a><a href={url('/verify/evidence/cite.html')}>Citations &amp; downloadable references →</a><a href={url('/verify/evidence/pinnacleai-regulatory-journey.html')}>The complete PinnacleAI story →</a></div><div class="portal-footer-brands"><a href={url('/')} aria-label="Pinnacle Blooms Network home"><Image src={wordmark} width={260} height={97} format="webp" loading="lazy" alt="Pinnacle Blooms Network"/></a><a href={url('/verify/#chapter-identity')}><Image src={operator} width={90} height={90} format="webp" loading="lazy" alt="Bharath Healthcare Laboratories Private Limited company emblem"/><span>Bharath Healthcare Laboratories<br/>Private Limited</span></a></div></div>
    <div class="portal-footer-columns">
      <section class="portal-footer-purpose" aria-labelledby="portal-purpose-title">
        <h2 id="portal-purpose-title">Pinnacle Blooms Network</h2>
        <div class="portal-purpose-copy"><Icon name="heart"/><div><p>Core purposed to help children grow toward a self-sufficient, mainstream-included life—with possibilities for school, work, family and a wonderful life.</p><p>We bring assessment, therapies, family participation, everyday practice and review together around that purpose.</p></div></div>
        <div class="portal-contact-item"><Icon name="telephone"/><div><a class="portal-footer-phone" href={phone.href} data-cta="footer-call">{phone.display}</a><a href={url('/national-autism-helpline')}>National Autism Helpline</a><span>Free guidance, 24/7 · Pinnacle / BHCL</span></div></div>
        <div class="portal-contact-item"><Icon name="mail"/><a href="mailto:care@pinnacleblooms.org">care@pinnacleblooms.org</a></div>
        <details class="portal-locations"><summary>Locations · find your centre</summary><ul>{navigation.locations.map(link=><li><a href={url(link.url)}>{link.label}</a></li>)}</ul><a class="portal-all-centres" href={url('/centers')}>Explore all centres →</a></details>
      </section>
      <div>{navigation.footerColumns[0].map(group=><PortalFooterGroup group={group}/>)}</div>
      <div>{navigation.footerColumns[1].map(group=><PortalFooterGroup group={group}/>)}</div>
      <div>{navigation.footerColumns[2].map(group=><PortalFooterGroup group={group}/>)}<details class="portal-community"><summary>Our community</summary>{navigation.community.map((link,index)=><a href={url(link.url)}><span class="portal-social-icon" aria-hidden="true">{['f','𝕏','◎','▶','in','p','☎'][index]}</span>{link.label}</a>)}<a class="portal-feedback" href="https://www.facebook.com/pinnacleblooms.org/">Comments &amp; feedback</a></details></div>
    </div>
    <nav class="portal-footer-policies" aria-label="Legal"><a href={url('/policies')}>All policies &amp; your rights</a>{navigation.legal.map(link=><a href={url(link.url)}>{link.label}</a>)}<a href={url('/sitemap')}>Sitemap</a></nav>
    <div class="portal-footer-identity"><span>© {new Date().getFullYear()} Pinnacle Blooms Network · Operated by Bharath Healthcare Laboratories Private Limited.</span><a href="https://www.bhclpl.org">Bharath Healthcare →</a></div>
    <a class="portal-review-link" href="https://www.trustpilot.com/review/pinnacleblooms.org">Review us on <strong>★ Trustpilot</strong></a>
    <details id="website-preferences" class="measurement-settings portal-measurement" data-speech-measurement hidden><summary>Optional analytics preferences</summary><p>With your permission, Google Analytics measures page visits and call or enquiry-link clicks. These are not completed calls or bookings. We exclude form details, query parameters and advertising identifiers from these events. Advertising personalisation is off.</p><div><button type="button" data-measurement-choice="accepted">Allow analytics</button><button type="button" data-measurement-choice="declined">Keep analytics off</button></div><p data-measurement-status role="status">Optional analytics is off until you choose.</p></details>
    <p class="portal-footer-note">Information on this page supports a conversation with your care team. Goals, support and progress are individual to each child.</p>
  </div></div>
 </div>
</footer>
