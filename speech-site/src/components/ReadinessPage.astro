---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import {Image} from 'astro:assets';
import {readinessContent as c} from '../data/readiness-content';
import {url,phone} from '../data/site';
import hero from '../assets/readiness-possibility-20261005.png';
import participation from '../assets/pinnacleai-mainstream-v162.png';
import social from '../assets/pinnacleai-readiness-social-20260930.png';
import '../styles/readiness-page.css';
const canonical=url('/seven-readiness-indexes');
const terms=c.indexes.map(index=>({'@type':'DefinedTerm','@id':canonical+'#'+index.id,name:index.name,description:index.meaning,url:canonical+'#'+index.id,inDefinedTermSet:{'@id':canonical+'#indexes'}}));
const graph=[{'@type':'DefinedTermSet','@id':canonical+'#indexes',name:'PinnacleAI Seven Readiness Indexes',description:c.direct,url:canonical,hasDefinedTerm:terms.map(t=>({'@id':t['@id']})),subjectOf:c.sources.slice(0,3).map(s=>url(s.href))},...terms];
const shareText=encodeURIComponent('PinnacleAI®: understand seven readiness areas and your child’s next step. '+canonical);
---
<PageLayout path="/seven-readiness-indexes" label="7 Readiness Indexes" title={c.title} description={c.description} shareImage={social} shareVersion="2026-09-30-pinnacleai-editorial" imageAlt="7 Readiness Indexes. Seven views. One child. Pinnacle Blooms Network family and professional creative, with 9100 181 181." imageCaption="PinnacleAI® Seven Readiness Indexes · illustrated brand creative" includeService={false} primaryEntityId={canonical+'#indexes'} entityGraph={graph} faqs={c.faqs} citations={c.sources.map(s=>url(s.href))} updatedOn={c.updated} breadcrumbParent={{name:'PinnacleAI®',path:'/pinnacleai'}}>
<div class="ready-page" data-wave-module="seven-readiness-indexes">
  <section class="ready-hero ready-container" aria-labelledby="readiness-title">
    <div class="ready-hero-copy"><p class="ready-eyebrow"><Icon name="compass"/>PinnacleAI® · Your child’s whole life</p><h1 id="readiness-title"><span class="ready-subject">7 Readiness Indexes</span>Understand today.<br/><em>Make the next possibility clearer.</em></h1><p class="ready-lead">{c.lead}</p><div class="ready-actions"><a class="ready-button ready-primary" href={phone.href} data-cta="pinnacleai-call"><Icon name="phone"/>Call {phone.display}</a><a class="ready-button ready-secondary" href={url('/enroll-autism-speech-aba-therapies-india')} data-cta="final-enquiry">Plan a first visit <Icon name="arrow"/></a></div><p class="ready-guidance">Telephone guidance is free. We’ll explain the professional, centre, assessment and fees before you decide.</p><a class="ready-inline-link" href={url('/centers')}><Icon name="pin" size={19}/>Find a Pinnacle centre <Icon name="arrow" size={18}/></a></div>
    <figure class="ready-hero-image"><Image src={hero} widths={[480,800,1200,1536]} sizes="(min-width:1000px) 50vw, 100vw" format="webp" quality={83} loading="eager" fetchpriority="high" alt="PinnacleAI 7 Readiness Indexes: family and a Pinnacle professional help a young child prepare for peer play; understand, support and review the next possibility."/></figure>
  </section>
  <nav class="ready-jump ready-container" aria-label="On this page">{[['The seven indexes','#seven-indexes'],['See one child’s goal','#worked-example'],['Read the report','#read-the-report'],['The whole PinnacleAI journey','#pinnacleai-journey'],['Verify the sources','#sources'],['Begin with Pinnacle','#next-step']].map(([label,href])=><a href={href}><Icon name="arrow" size={16}/>{label}</a>)}</nav>

  <section class="ready-section ready-container ready-intro" id="what-it-does" aria-labelledby="ready-meaning-title"><div><p class="ready-eyebrow">The role of readiness</p><h2 id="ready-meaning-title">Your child’s next opportunity.<br/><em>A clearer reason for every step.</em></h2><p>{c.direct}</p><p>{c.purpose}</p></div><aside class="ready-purpose"><Icon name="home" size={36}/><h3>The home gives every brick its purpose.</h3><p>In the same way, your child’s life gives each ability and therapy goal its purpose. Asking for help, sharing play and joining a school routine are the reasons to understand readiness.</p><a href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Explore the PinnacleAI Paradigm Shift <Icon name="arrow" size={18}/></a></aside></section>

  <section class="ready-section ready-soft" id="seven-indexes" aria-labelledby="ready-seven-title"><div class="ready-container"><div class="ready-section-head"><p class="ready-eyebrow">Seven perspectives. One child’s life.</p><h2 id="ready-seven-title">What does each readiness index help you understand?</h2><p>Start with a question your family recognises. Our team connects the relevant view with what has been observed and what could help next.</p></div><div class="ready-index-grid">{c.indexes.map((index,i)=><article id={index.id} class="ready-index" style={`--ready-accent:${index.colour}`}><div class="ready-index-heading"><span class="ready-index-icon"><Icon name={index.icon} size={30}/></span><div><p class="ready-eyebrow">View {String(i+1).padStart(2,'0')}</p><h3>{index.name}</h3></div></div><p class="ready-question">{index.question}</p><p>{index.meaning}</p><dl><div><dt>In everyday life</dt><dd>{index.moment}</dd></div><div><dt>Talk it through with us</dt><dd>{index.discuss}</dd></div></dl><a href={url(index.link)}>{index.linkLabel} <Icon name="arrow" size={18}/></a></article>)}</div><p class="ready-source-note">Names: <a href={url('/verify/evidence/records/bis.html')}>BIS module schedule</a>. Conceptual roles: <a href={url('/verify/evidence/records/dossier.html')}>Evidence Dossier v2.0-M, Chapter 10, pp. 43–44</a>. The everyday examples explain how a family discussion may use those concepts; they are not scoring criteria.</p></div></section>

  <section class="ready-section ready-container" id="worked-example" aria-labelledby="ready-example-title"><div class="ready-section-head"><p class="ready-eyebrow">Follow one meaningful goal</p><h2 id="ready-example-title">{c.example.title}</h2><p>{c.example.intro}</p></div><div class="ready-example-grid"><figure class="ready-example-image"><Image src={participation} widths={[480,800,1200]} sizes="(min-width:1000px) 38vw, 100vw" format="webp" quality={82} loading="lazy" alt="PinnacleAI Mainstream Included creative: a young child, family and supportive adults connected with school and shared participation."/><figcaption>The purpose is participation in the child’s actual life.</figcaption></figure><ol class="ready-example-steps">{c.example.steps.map(([title,text],i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div><p class="ready-keyline"><Icon name="people" size={30}/><span><strong>The useful change is in the child’s day.</strong> The review asks whether the child can take part, communicate and use support—not only whether a number changed.</span></p></section>

  <section class="ready-section ready-soft" id="read-the-report" aria-labelledby="ready-report-title"><div class="ready-container"><div class="ready-section-head"><p class="ready-eyebrow">Understand your child’s report</p><h2 id="ready-report-title">Bring the number back to the real moment.</h2><p>Ask our professional to explain the report version, scale, observations and support behind the view. Different report editions have used different scales; they should not be compared without an explanation.</p></div><ol class="ready-decision-flow">{c.decisionFlow.map(([label,copy],i)=><li><span>{String(i+1).padStart(2,'0')}</span><h3>{label}</h3><p>{copy}</p></li>)}</ol><div class="ready-report-bottom"><p><strong>Four useful questions:</strong> What was assessed? What help was present? What does this mean for the next goal? When and how will we review it?</p><a class="ready-button ready-secondary" href={url('/verify/#report-explorer')}>Explore the report-format guide <Icon name="arrow"/></a></div><p class="ready-source-note">Readiness does not diagnose a condition, set a universal school pass mark or promise a date for independence. Your professional interprets the current report with you.</p></div></section>

  <section class="ready-section ready-container" id="pinnacleai-journey" aria-labelledby="ready-journey-title"><div class="ready-section-head"><p class="ready-eyebrow">The whole PinnacleAI® system</p><h2 id="ready-journey-title">Readiness gives the next step context.<br/><em>The whole system carries it into life.</em></h2><p>These seven readiness areas are different from the seven stages of the family journey below. The stages connect measurement, a child-specific plan, suitable intervention, everyday practice and review around the life your child is working toward.</p></div><ol class="ready-journey">{c.stages.map((stage,i)=><li><span class="ready-stage-number">{i+1}</span><Icon name={stage.icon} size={28}/><h3>{stage.title}</h3><p>{stage.detail}</p><a href={url(stage.href)}>Explore this part <Icon name="arrow" size={17}/></a></li>)}</ol><div class="ready-system-links"><a href={url('/pinnacleai')}>Explore the PinnacleAI system <Icon name="arrow"/></a><a href={url('/prognose')}>How a revisable forecast supports planning <Icon name="arrow"/></a><a href={url('/self-sufficient')}>The purpose: Self-Sufficient <Icon name="arrow"/></a></div></section>

  <section class="ready-section ready-soft" id="connected-therapies" aria-labelledby="ready-therapy-title"><div class="ready-container"><div class="ready-section-head"><p class="ready-eyebrow">The right people for the goal</p><h2 id="ready-therapy-title">Different contributions.<br/><em>One child’s opportunity.</em></h2><p>Readiness helps frame the question. Qualified professionals decide which assessment, methods and contributions are suitable. Your child’s plan can bring these together when relevant.</p></div><div class="ready-therapy-grid">{c.therapies.map(t=><a href={url(t.href)} class="ready-therapy"><Icon name={t.icon} size={30}/><h3>{t.title}</h3><p>{t.detail}</p><span>Explore the therapy <Icon name="arrow" size={18}/></span></a>)}</div><p class="ready-source-note">For families exploring autism support, <a href={url('/autism-therapy')}>see how suitable therapies join around the whole child’s life</a>. A diagnosis or an index alone does not prescribe every therapy.</p></div></section>

  <section class="ready-section ready-container" id="sources" aria-labelledby="ready-source-title"><div class="ready-section-head"><p class="ready-eyebrow">Open. Honest. Transparent. Self-critical.</p><h2 id="ready-source-title">Understand our approach.<br/><em>Inspect the evidence behind it.</em></h2><p>Pinnacle Blooms Network is operated by Bharath Healthcare Laboratories Private Limited, the legal licence holder. Each record below answers a specific question.</p></div><div class="ready-proof-grid">{c.sources.map(s=><article><Icon name={s.id==='bis'||s.id==='md5'?'shield':'book'} size={29}/><p class="ready-eyebrow">{s.label}</p><strong class="ready-proof-value">{s.value}</strong><h3>{s.title}</h3><p>{s.copy}</p><a href={url(s.href)}>Inspect the source <Icon name="arrow" size={18}/></a></article>)}</div><details class="ready-citations"><summary>For researchers, teachers and anyone sharing this explanation</summary><p>The product dossier describes the conceptual areas; the BIS schedule establishes their names and scope. The <a href={url('/verify/evidence/records/methodology.html')}>methodology preprint</a> reports preliminary research, with validation questions kept separate from product description. No child-level report or proprietary scoring threshold is published here.</p><p><strong>Suggested citation:</strong> Pinnacle Blooms Network. <cite>7 Readiness Indexes: Your Child’s Next Step.</cite> Updated 5 October 2026. Bharath Healthcare Laboratories Private Limited.</p><div class="ready-downloads"><a href="/pinnacle-pages-data/seven-readiness-indexes-sources.json">Source map · JSON</a><a href="/pinnacle-pages-data/seven-readiness-indexes-sources.txt">Plain text</a><a href="/pinnacle-pages-data/seven-readiness-indexes-reading.md">Markdown reading aid</a><a href={url('/verify/evidence/cite.html')}>Cite original evidence</a></div></details></section>

  <section class="ready-section ready-soft" id="questions" aria-labelledby="ready-questions-title"><div class="ready-container ready-faq"><div><p class="ready-eyebrow">Clarity before you begin</p><h2 id="ready-questions-title">Questions families ask.</h2><p>Bring the questions that matter to your child. You can understand the proposed next step before making a decision.</p><a class="ready-inline-link" href={phone.href} data-cta="pinnacleai-call"><Icon name="phone"/>9100 181 181</a></div><div>{c.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></div></section>

  <section class="ready-section ready-container" id="next-step" aria-labelledby="ready-next-title"><div class="ready-first-step"><div><p class="ready-eyebrow">Let’s begin with your child</p><h2 id="ready-next-title">One real goal.<br/><em>One useful first conversation.</em></h2><p>Tell us what you want to make possible: being understood, joining play, managing a routine or participating at school. We’ll help you explore an appropriate assessment and professional next step.</p><div class="ready-actions"><a class="ready-button ready-primary" href={phone.href} data-cta="pinnacleai-close-call"><Icon name="phone"/>Call {phone.display}</a><a class="ready-button ready-secondary" href={url('/enroll-autism-speech-aba-therapies-india')} data-cta="final-enquiry">Plan a first visit <Icon name="arrow"/></a></div><p class="ready-guidance">Telephone guidance is free. The team confirms the suitable centre, professional, visit and fees with you.</p></div><aside><Icon name="pin" size={34}/><h3>Find the right place to begin.</h3><p>Browse our centre directory and ask the team to confirm the relevant support at your preferred location.</p><a href={url('/centers')}>Find a Pinnacle centre <Icon name="arrow" size={18}/></a><a href={url('/speech-aba-autism-assessments')}>What an assessment can help clarify <Icon name="arrow" size={18}/></a><a href={url('/books/resources/first-conversation')}>Take a first-conversation planning sheet <Icon name="arrow" size={18}/></a></aside></div><div class="ready-share"><p>Share this explanation with your family or care team.</p><a href={'https://wa.me/?text='+shareText} target="_blank" rel="noopener noreferrer"><Icon name="send" size={18}/>Share on WhatsApp</a><a href={'mailto:?subject='+encodeURIComponent('PinnacleAI® · 7 Readiness Indexes')+'&body='+shareText}><Icon name="mail" size={18}/>Share by email</a><a href="#sources"><Icon name="book" size={18}/>Cite this page</a></div></section>
</div>
</PageLayout>
