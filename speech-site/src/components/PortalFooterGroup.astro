---
import Icon from './Icon.astro';
import { url } from '../data/site';
const { group }=Astro.props;
const single=group.links.length===1;
const headingUrl=single?group.links[0].url:({'Research Studies':'/research-studies','Pinnacle TV':'https://www.youtube.com/channel/UCAAuGmvPSBRiCnDlEcXYwEQ','Franchise Opportunity':'/franchises'} as Record<string,string>)[group.title];
---
{single?<nav class="portal-footer-group portal-single-link" aria-label={group.title}><h3><Icon name={group.icon} size={18}/><a href={url(headingUrl)}>{group.title}</a></h3></nav>:<details class="portal-footer-group" aria-label={group.title}><summary><Icon name={group.icon} size={18}/><span>{group.title}</span><Icon name="chevron" size={16}/></summary><div>{headingUrl&&<a class="portal-group-overview" href={url(headingUrl)}>Explore {group.title} →</a>}<ul>{group.links.map((link:{label:string,url:string})=><li><a href={url(link.url)}>{link.label}</a></li>)}</ul></div></details>}
