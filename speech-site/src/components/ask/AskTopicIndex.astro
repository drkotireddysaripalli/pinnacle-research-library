---
import {ASK,pretty} from '../../lib/ask/content';
const {items=[]}=Astro.props;
const groups=new Map<string,any[]>();
for(const item of [...items].sort((a,b)=>a.slug.localeCompare(b.slug))){
 const key=/^[a-z]/i.test(item.slug)?item.slug[0].toUpperCase():'#';
 groups.set(key,[...(groups.get(key)||[]),item]);
}
---
<section class="ask-wrap ask-section">
 <p class="ask-eyebrow">ASK PINNACLE · TOPIC INDEX</p>
 <h1>Find a topic. Explore its questions.</h1>
 <p class="ask-lead">Browse published questions about child development, communication, learning, everyday skills and therapy. Each topic connects you with its explanations, sources and related perspectives.</p>
 <p><a href={ASK+'/dayc-2'}>DAYC-2 assessment questions</a> · <a href={ASK+'/lens/ability/child-characteristics'}>Understanding child characteristics</a></p>
 <nav aria-label="Topic initials" class="topic-initials">{[...groups.keys()].map(key=><a href={'#topics-'+key}>{key}</a>)}</nav>
 {[...groups.entries()].map(([key,rows])=><section id={'topics-'+key} class="topic-letter"><h2>{key}</h2><ul>{rows.map(item=><li><a href={ASK+'/'+encodeURIComponent(item.slug)}>{pretty(item.slug)}</a></li>)}</ul></section>)}
</section>
<style>
 .topic-initials{display:flex;flex-wrap:wrap;gap:.6rem;margin:2rem 0}
 .topic-initials a{display:grid;place-items:center;min-width:44px;min-height:44px;border:1px solid #bbb;border-radius:8px;font-weight:700}
 .topic-letter{scroll-margin-top:2rem;border-top:1px solid #ddd;padding:1.25rem 0}
 .topic-letter ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem 2rem;list-style:none;padding:0}
 .topic-letter a{display:block;padding:.55rem 0;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}
 @media(max-width:760px){.topic-letter ul{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:480px){.topic-letter ul{grid-template-columns:1fr}}
</style>
