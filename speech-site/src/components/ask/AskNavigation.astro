---
import Icon from '../Icon.astro';const {q='',lang='en'}=Astro.props;
---
<nav class="ask-nav" aria-label="Ask navigation"><div class="ask-nav-inner"><a class="ask-wordmark" href="/ask"><Icon name="book"/>Ask Pinnacle</a><form class="ask-search-form" action="/ask/search" method="get" role="search"><label class="ask-sr" for="ask-query">Search published answers</label><input id="ask-query" name="q" type="search" value={q} maxlength="200" placeholder={lang==='te'?'మీ ప్రశ్నను వెతకండి':'What would you like to understand?'}/><button type="submit" aria-label="Search answers"><Icon name="search"/></button></form><a href="/ask/lens" class="ask-nav-browse">Browse topics →</a><div class="ask-nav-identity" data-nosnippet>
 <button type="button" class="ask-nav-account" data-ask-sign-in><Icon name="people" size={20}/>Sign in</button>
 <details class="ask-profile" data-ask-profile hidden>
  <summary aria-label="Your Pinnacle profile"><img data-ask-avatar width="36" height="36" alt="" referrerpolicy="no-referrer" hidden/><span class="ask-avatar-fallback" data-ask-avatar-fallback></span><span class="ask-profile-name" data-ask-profile-name></span><span class="ask-verified-badge" data-ask-verified-badge role="img" aria-label="WhatsApp number not yet verified"><Icon name="check" size={13}/></span></summary>
  <div class="ask-profile-menu">
   <div class="ask-profile-top"><span>Your Pinnacle account</span><button type="button" data-ask-profile-close aria-label="Close profile">×</button></div>
   <div class="ask-profile-person"><img data-ask-avatar width="64" height="64" alt="" referrerpolicy="no-referrer" hidden/><span class="ask-avatar-fallback" data-ask-avatar-fallback></span><h2><span data-ask-profile-name></span> <span class="ask-verified-badge" data-ask-verified-badge role="img" aria-label="WhatsApp number not yet verified"><Icon name="check" size={14}/></span></h2><p data-ask-verification-label>Signed in with Google</p></div>
   <div class="ask-profile-actions">
    <button type="button" data-ask-verify-open><Icon name="shield" size={22}/><span data-ask-verify-text>Get Verified</span><Icon name="chevron" size={16}/></button>
    <button type="button" data-ask-contact="call"><Icon name="phone" size={22}/><span>Call Pinnacle</span><Icon name="chevron" size={16}/></button>
    <button type="button" data-ask-contact="whatsapp"><Icon name="voice" size={22}/><span>WhatsApp Pinnacle</span><Icon name="chevron" size={16}/></button>
    <form method="post" action="/ask/auth/logout" data-ask-logout><input type="hidden" name="csrf" value=""/><input type="hidden" name="returnTo" value="/ask"/><button type="submit"><Icon name="arrow" size={22}/><span>Log out of Pinnacle</span></button></form>
   </div>
   <p class="ask-profile-foot"><a href="https://www.pinnacleblooms.org/privacy-policy">Privacy</a><span aria-hidden="true">·</span><a href="https://www.pinnacleblooms.org/terms-of-use">Terms</a></p>
  </div>
 </details>
 </div></div></nav>
<style>
.ask-sr{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
.ask-nav-account{display:inline-flex;align-items:center;gap:7px;min-height:44px;font-size:14px;font-weight:700;font-family:inherit;white-space:nowrap;border:0;background:transparent;color:#842478;cursor:pointer}
.ask-nav-identity{position:relative;flex-shrink:0}.ask-nav-identity [hidden]{display:none!important}.ask-profile summary{display:flex;align-items:center;gap:8px;min-height:44px;cursor:pointer;font-size:14px;font-weight:700;color:#213653;list-style:none;border-radius:24px;padding:4px 8px}.ask-profile summary:hover{background:#f8f3f8}.ask-profile summary::-webkit-details-marker{display:none}.ask-profile summary img,.ask-avatar-fallback{width:36px;height:36px;border-radius:50%;object-fit:cover}.ask-avatar-fallback{display:grid;place-items:center;background:#8f2879;color:white}.ask-profile-name{max-width:140px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ask-profile-menu{position:absolute;right:0;top:calc(100% + 10px);width:min(350px,calc(100vw - 32px));max-height:calc(100dvh - 100px);overflow:auto;border:1px solid #ded8e5;border-radius:26px;background:#fcf9fd;padding:12px;box-shadow:0 12px 40px #21365328;z-index:100}.ask-profile-top{display:flex;align-items:center;justify-content:space-between;padding:0 6px 6px 12px;font-size:13px;color:#536176}.ask-profile-top button{width:40px;height:40px;min-height:40px;border:0;border-radius:50%;background:transparent;font-size:26px;color:#344860;cursor:pointer}.ask-profile-person{text-align:center;padding:4px 8px 22px}.ask-profile-person>img,.ask-profile-person>.ask-avatar-fallback{width:64px;height:64px;object-fit:cover;border-radius:50%;margin:0 auto 12px;font-size:24px;display:block}.ask-profile-person>.ask-avatar-fallback{display:grid}.ask-profile-person h2{font-size:20px;line-height:1.4;margin:0 0 5px;color:#213653;overflow-wrap:anywhere}.ask-profile-person p{font-size:13px;color:#536176;margin:0}.ask-verified-badge{display:inline-grid;place-items:center;width:20px;height:20px;flex-shrink:0;vertical-align:middle;border-radius:50%;background:#d7dbe1;color:#657185}.ask-verified-badge[data-verified=true]{background:#b5208c;color:white;box-shadow:0 0 0 3px #b5208c12,0 0 10px #b5208c25}.ask-profile-actions{background:white;border:1px solid #e8e4ec;border-radius:18px;overflow:hidden}.ask-profile-actions>button,.ask-profile-actions form button{font:inherit;display:flex;align-items:center;gap:14px;width:100%;min-height:52px;text-align:left;padding:13px 17px;border:0;background:white;color:#213653;cursor:pointer;font-size:15px}.ask-profile-actions button span{flex:1}.ask-profile-actions>button+button,.ask-profile-actions form{border-top:1px solid #efedf2}.ask-profile-actions button:hover,.ask-profile-top button:hover{background:#f7f0f7}.ask-profile-actions button:focus-visible,.ask-profile summary:focus-visible{outline:3px solid #8f2879;outline-offset:-3px}.ask-profile-actions button svg{color:#8f2879;flex-shrink:0}.ask-profile-foot{display:flex;gap:14px;justify-content:center;margin:14px 0 2px;font-size:12px;color:#657185}.ask-profile-foot a{color:inherit;text-decoration:none}
@media(max-width:760px){.ask-nav-identity{order:0;margin-left:auto}.ask-nav-browse{order:3}.ask-profile-name{max-width:96px}}
@media(max-width:390px){.ask-profile-name{max-width:70px}}
</style>
