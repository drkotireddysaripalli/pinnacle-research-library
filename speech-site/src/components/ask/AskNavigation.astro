---
import Icon from '../Icon.astro';const {q='',lang='en'}=Astro.props;
---
<nav class="ask-nav" aria-label="Ask navigation"><div class="ask-nav-inner"><a class="ask-wordmark" href="/ask"><Icon name="book"/>Ask Pinnacle</a><form class="ask-search-form" action="/ask/search" method="get" role="search"><label class="ask-sr" for="ask-query">Search published answers</label><input id="ask-query" name="q" type="search" value={q} maxlength="200" placeholder={lang==='te'?'మీ ప్రశ్నను వెతకండి':'What would you like to understand?'}/><button type="submit" aria-label="Search answers"><Icon name="search"/></button></form><a href="/ask/lens" class="ask-nav-browse">Browse topics →</a><div class="ask-nav-identity" data-nosnippet>
 <button type="button" class="ask-nav-account" data-ask-sign-in><Icon name="people" size={20}/>Sign in</button>
 <details class="ask-profile" data-ask-profile hidden><summary aria-label="Your Google profile"><img data-ask-avatar width="32" height="32" alt="" referrerpolicy="no-referrer" hidden/><span class="ask-avatar-fallback" data-ask-avatar-fallback></span><span class="ask-profile-name" data-ask-profile-name></span><span aria-hidden="true">⌄</span></summary><div class="ask-profile-menu"><p>Signed in with Google</p><form method="post" action="/ask/auth/logout" data-ask-logout><input type="hidden" name="csrf" value=""/><input type="hidden" name="returnTo" value="/ask"/><button type="submit">Log out</button></form></div></details>
 </div></div></nav>
<style>
.ask-sr{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
.ask-nav-account{display:inline-flex;align-items:center;gap:7px;min-height:44px;font-size:14px;font-weight:700;font-family:inherit;white-space:nowrap;border:0;background:transparent;color:#842478;cursor:pointer}
.ask-nav-identity{position:relative;flex-shrink:0}.ask-nav-identity [hidden]{display:none!important}.ask-profile summary{display:flex;align-items:center;gap:8px;min-height:44px;cursor:pointer;font-size:14px;font-weight:700;color:#213653;list-style:none}.ask-profile summary::-webkit-details-marker{display:none}.ask-profile summary img,.ask-avatar-fallback{width:32px;height:32px;border-radius:50%;object-fit:cover}.ask-avatar-fallback{display:grid;place-items:center;background:#8f2879;color:white}.ask-profile-name{max-width:140px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ask-profile-menu{position:absolute;right:0;top:100%;width:220px;border:1px solid #dfd5e5;border-radius:12px;background:white;padding:16px;box-shadow:0 8px 24px #21365320;z-index:30}.ask-profile-menu p{font-size:13px;color:#536176;margin:0 0 8px}.ask-profile-menu button{font:inherit;border:0;background:#f7f0f7;color:#842478;cursor:pointer;min-height:44px;width:100%;border-radius:6px}
@media(max-width:760px){.ask-nav-identity{order:0;margin-left:auto}.ask-nav-browse{order:3}.ask-profile-name{max-width:96px}}
@media(max-width:390px){.ask-profile-name{max-width:70px}}
</style>
