---
import {ASK,SITE,contact} from '../../lib/ask/content';
import {renderMarkdown} from '../../lib/ask/markdown';
import {answerReading,answerContext,answerCitation,answerNavigation,pathway} from '../../lib/ask/answer-presentation';
import AnswerCards from './AnswerCards.astro';import AskContact from './AskContact.astro';import Icon from '../Icon.astro';
import AskReadingPaths from './AskReadingPaths.astro';
const {answer:a}=Astro.props;
const faq=Array.isArray(a.faq)?a.faq.filter(x=>x.q&&x.a):[];
const sources=(Array.isArray(a.authority_links)?a.authority_links:[]).filter(x=>/^https?:\/\//.test(x.url||x.href||''));
const reading=answerReading(a.answer_md||'');const context=answerContext(a);const citation=answerCitation(a);
const navigation=answerNavigation(a);const lensGroups=[...new Set(navigation.links.map(x=>x.group))];
const card=a.canonical+'.png';const te=a.lang==='te';
const date=(s:string)=>s&&Number.isFinite(Date.parse(s))?new Date(s).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}):'';
const sourceScope=(s:any)=>{try{return new URL(s.url||s.href).pathname.replace(/\/+$/,'')?'Source reference':'Organisation website · further reading';}catch{return 'Source reference'}};
const materialSlugs=new Set((a.related_materials||[]).map(x=>x.slug));const techniqueSlugs=new Set((a.related_techniques||[]).map(x=>x.slug));
const materials=(a.resources||[]).filter(x=>materialSlugs.has(x.slug));const techniques=(a.resources||[]).filter(x=>techniqueSlugs.has(x.slug));
---
<article class="ask-wrap ask-article" data-ask-answer>
 <nav class="ask-breadcrumb" aria-label="Breadcrumb"><a href={ASK}>Ask Pinnacle</a>{context.parent&&<><span aria-hidden="true">›</span><a href={context.parent.url}>{context.parent.label}</a></>}{context.topic&&<><span aria-hidden="true">›</span><a href={context.topic.url}>{context.topic.label}</a></>}</nav>
<figure class="ask-answer-hero"><a href={card} aria-label="Open this answer image at full size"><img src={card} width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" alt={a.title+" — Pinnacle Ask answer card with a short explanation and QR link"}/></a><figcaption>Read the full answer below. <a href={card} download={a.slug+".png"}>Save this answer’s image</a></figcaption></figure>
 <header class="ask-article-title"><p class="ask-eyebrow">{te?'మీ ప్రశ్నకు సమాధానం':'YOUR QUESTION. A CLEARER NEXT STEP.'}</p><h1>{a.h1||a.title}</h1>{a.summary&&<div class="ask-direct-answer answer-summary"><span class="ask-answer-label">{te?'సంక్షిప్తంగా':'THE SHORT ANSWER'}</span><p>{a.summary}</p></div>}<div class="ask-meta"><span>Pinnacle Blooms Network</span>{a.content_updated_at&&<span>Page updated <time datetime={a.content_updated_at}>{date(a.content_updated_at)}</time></span>}{a.published_at&&<span>Published <time datetime={a.published_at}>{date(a.published_at)}</time></span>}{a.last_reviewed_at&&<span>Content record updated <time datetime={a.last_reviewed_at}>{date(a.last_reviewed_at)}</time></span>}</div>
 {(a.alternates||[]).length>1&&<nav class="ask-chips" aria-label="Read this answer in another language">{a.alternates.map(x=><a href={x.href} lang={x.lang}>{x.lang==='te'?'తెలుగులో చదవండి':'Read in English'}</a>)}</nav>}
 </header>
 <nav class="ask-jump-links" aria-label="On this page"><a href="#explanation"><Icon name="book" size={18}/>Read the answer</a>{a.reading_paths?.length>0&&<a href="#related-questions"><Icon name="layers" size={18}/>Connected questions</a>}<a href="#sources"><Icon name="shield" size={18}/>Sources</a><a href="#ask-answer-share"><Icon name="send" size={18}/>Share this answer</a><a href="#pinnacle-next-step"><Icon name="compass" size={18}/>Your next step</a></nav>
 <div class="ask-reading-layout"><div class="ask-reading-main">
 {reading.outline.length>2&&<details class="ask-contents"><summary>In this answer <span>{reading.outline.length} sections</span></summary><ol>{reading.outline.map(h=><li><a href={'#'+h.id}>{h.title}</a></li>)}</ol></details>}
 <div id="explanation" class="ask-prose" set:html={reading.html}/>
 {(a.what_to_watch||a.everyday_tip)&&<section class="ask-everyday" id="everyday-life"><p class="ask-eyebrow">CONNECT THE ANSWER TO YOUR CHILD’S DAY</p><h2>Something to notice. Something to discuss.</h2><div class="ask-practical">{a.what_to_watch&&<section><Icon name="compass"/><h3>What to notice</h3><p>{a.what_to_watch}</p></section>}{a.everyday_tip&&<section><Icon name="home"/><h3>In everyday life</h3><p>{a.everyday_tip}</p></section>}</div><p class="ask-small">Bring your observations and questions to your child’s professional. Choose activities that suit your child’s comfort, abilities and agreed plan.</p><a class="ask-text-action" href={context.enrol}>Bring your questions to a first visit <Icon name="arrow" size={18}/></a></section>}
 {faq.length>0&&<section id="answer-questions" class="ask-faq"><h2>Questions families ask</h2>{faq.map(f=><details><summary>{f.q}</summary><div class="ask-prose" set:html={renderMarkdown(f.a)}/></details>)}</section>}
 <section id="sources" class="ask-sources"><p class="ask-eyebrow">FOLLOW THE SOURCE</p><h2>References behind this answer.</h2>{sources.length?<ul class="ask-source-list">{sources.map(s=><li><Icon name="book" size={22}/><div><span>{sourceScope(s)}</span><a href={s.url||s.href} rel="noopener">{s.label||s.title||s.name||s.url}</a></div></li>)}</ul>:<p>Follow any source links within the explanation above. This record has no separately listed references.</p>}<p class="ask-small">References are supplied with this answer. An organisation homepage offers further reading; it does not establish an independent review of this page.</p>{a.editorial?.developed_by&&<p class="ask-small">Content attribution: {a.editorial.developed_by}.</p>}{a.editorial?.reviewed_by&&<p class="ask-small">Reviewer field in the source record: {a.editorial.reviewed_by}{a.editorial.reviewed_at&&' · '+date(a.editorial.reviewed_at)}.</p>}</section>
 </div>
 <aside class="ask-reading-aside"><div class="ask-aside-card"><Icon name="heart"/><h2>Your child’s next step matters.</h2><p>Tell us what you see at home and what you want your child to be able to do. We’ll help you explore the appropriate service and a first visit.</p><a class="ask-button" href={contact.tel} data-cta="ask-answer-call"><Icon name="phone" size={18}/>Call {contact.phone}</a><a href={contact.centres}>Find a Pinnacle centre →</a><p class="ask-small">Telephone guidance is free. Confirm appointments, services and fees with the team.</p></div>
 <nav class="ask-aside-card ask-aside-evidence" aria-label="Connected topics and Pinnacle services"><Icon name="compass"/><h2>Explore the connection.</h2>{context.topic&&<a href={context.topic.url}>More about {context.topic.label} →</a>}{context.services.map(t=><a href={t.url}>{t.title} at Pinnacle →</a>)}<a href={SITE+'/speech-aba-autism-assessments'}>Understand developmental assessment →</a><a href={SITE+'/pinnacleai'}>Explore PinnacleAI® →</a></nav></aside></div>

 <AskReadingPaths answer={a} topic={context.topic}/>
 {(navigation.links.length>0||navigation.topics.length>0)&&<section class="ask-connected" id="connected-perspectives"><p class="ask-eyebrow">PEOPLE, TOPICS &amp; DEVELOPMENT</p><h2>See the connections.</h2><p>Browse the wider question collections connected with this answer’s audience, developmental area and stage.</p><nav aria-label="Answer categories and dimensions" class="ask-chips">{navigation.topics.map(t=><a href={t.url}><Icon name="book" size={17}/>{t.label}</a>)}{context.topic&&<a href={context.topic.url}>{context.topic.label} →</a>}<a href={ASK+(te?'/te':'')+'/lens'}>All perspectives →</a></nav><div class="ask-lens-groups">{lensGroups.map(group=><nav aria-label={group}><h3>{group}</h3><ul>{navigation.links.filter(x=>x.group===group).map(x=><li><a href={x.url}>{x.label}<Icon name="arrow" size={16}/></a></li>)}</ul></nav>)}</div></section>}
 <section id="ask-answer-share" class="ask-share-panel"><div><p class="ask-eyebrow">ONE ANSWER. EASY TO PASS ON.</p><h2>Share it with your family or care team.</h2><p>Keep the question, short explanation and QR link together in this answer’s own card. Its QR code brings readers back to the full answer and source links.</p><div class="ask-share"><button type="button" data-ask-share="native"><Icon name="send"/>Share answer</button><a href={'https://wa.me/?text='+encodeURIComponent(a.title+' '+a.canonical)} rel="noopener">WhatsApp</a><button type="button" data-ask-share="link">Copy link</button><a href={card} download={a.slug+'.png'}><Icon name="download"/>Download card</a></div><p role="status" aria-live="polite" data-ask-share-status></p></div>
 <div class="ask-citation-box"><h3>Cite this answer</h3><p data-ask-citation>{citation}</p><div class="ask-share"><button type="button" data-ask-share="citation">Copy citation</button><a href={a.canonical+'.md'}>Read as text</a><a href={a.canonical+'.json'}>Structured answer</a><a href={ASK+'/dataset'}>Reuse &amp; citation guide →</a></div><p class="ask-small">Copy citation includes your access date. Public reading access does not assign reuse rights to third-party source material.</p></div></section>

 <section id="pinnacle-next-step" class="ask-life-section"><p class="ask-eyebrow">FROM UNDERSTANDING TO PURPOSEFUL SUPPORT</p><h2>One question. Your child’s whole life.</h2><p class="ask-lead">Your child’s self-sufficient, mainstream-included life is the purpose from the beginning. At Pinnacle, that purpose shapes what we understand, the goals we choose, the people we bring together, everyday practice and review.</p><div class="ask-service-path"><div><Icon name="people"/><h3>Connect this question with the right support.</h3><p>{context.services.length?'Explore how the relevant service contributes to everyday abilities, then speak with us about your child.':'Start with your child’s strengths, your observations and what you want everyday life to become.'}</p><div class="ask-path-links">{context.services.map(t=><a href={t.url}>{t.title} <Icon name="arrow" size={18}/></a>)}<a href={SITE+'/speech-aba-autism-assessments'}>Developmental assessment <Icon name="arrow" size={18}/></a></div></div><div><Icon name="pin"/><h3>Make the next conversation useful.</h3><p>Bring the situations you notice at home or school. We’ll explain a suitable service, centre and first visit, including availability and fees, before you decide.</p><div class="ask-path-links"><a href={context.enrol}>Arrange a first visit <Icon name="arrow" size={18}/></a><a href={contact.centres}>Choose a Pinnacle centre <Icon name="arrow" size={18}/></a></div></div></div>
 <details class="ask-system-path"><summary><span>How PinnacleAI® connects the journey</span><span>Explore the seven stages <Icon name="chevron" size={18}/></span></summary><ol>{pathway.map((step,i)=><li><span class="ask-step-number">{i+1}</span><div><a href={SITE+step.url}>{step.title} <Icon name={step.icon} size={20}/></a><p>{step.detail}</p></div></li>)}</ol><p><a href={SITE+'/pinnacleai'}>Explore the whole PinnacleAI® system →</a> · <a href={SITE+'/mainstream'}>Participation at school and in the community →</a></p></details>
 </section>
 <section class="ask-proof-links" aria-labelledby="ask-evidence-title"><div><p class="ask-eyebrow">PINNACLE’S EVIDENCE, OPEN TO YOU</p><h2 id="ask-evidence-title">Look at the evidence behind our work.</h2><p>Read our research, inspect the original regulatory documents and check what each institutional measure means.</p></div><div class="ask-proof-grid"><a href={SITE+'/verify/evidence/claim-ledger.html'}><Icon name="measure"/><strong>Measures &amp; definitions</strong><span>Dated figures, source records and their scope.</span></a><a href={SITE+'/verify/evidence/records/md5.html'}><Icon name="shield"/><strong>MD-5 · Class B SaMD</strong><span>Manufacturing licence for non-diagnostic developmental-support software.</span></a><a href={SITE+'/verify/evidence/cite.html'}><Icon name="book"/><strong>Research &amp; citations</strong><span>Find the exact work, its status and how to cite it.</span></a></div></section>
 {techniques.length>0&&<section class="ask-section"><h2>Related techniques</h2><AnswerCards items={techniques}/></section>}{materials.length>0&&<section class="ask-section"><h2>Related materials</h2><AnswerCards items={materials}/></section>}
 {!a.reading_paths?.length&&a.related?.length>0&&<section class="ask-section" id="related-answers"><p class="ask-eyebrow">KEEP EXPLORING</p><h2>Your next question may be here.</h2>{context.topic&&<p><a href={context.topic.url}>Explore all questions about {context.topic.label} →</a></p>}<AnswerCards items={a.related.slice(0,8)}/></section>}
 <p class="ask-small">General information supports a conversation with an appropriately qualified professional. Advice, goals and support depend on the individual child.</p>
</article><AskContact/>
