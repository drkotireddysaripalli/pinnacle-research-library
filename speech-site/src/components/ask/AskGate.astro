---
import {Image} from 'astro:assets';
import logo from '../../assets/pinnacle-blooms-network-lockup.png';
---
<dialog id="ask-reader-gate" open aria-labelledby="ask-gate-title" aria-describedby="ask-gate-description" data-nosnippet>
 <div class="ask-gate-card">
  <Image src={logo} width={260} height={97} alt="Pinnacle Blooms Network" format="webp" loading="eager" class="ask-gate-logo"/>
  <h2 id="ask-gate-title">Sign in to Ask Pinnacle</h2>
  <p id="ask-gate-description">Continue with Google. Then keep reading.</p>
  <form method="post" action="/ask/auth/google" data-ask-google-form>
   <input type="hidden" name="csrf" value=""/><input type="hidden" name="returnTo" value="/ask"/>
   <button type="submit" class="ask-google-button" disabled>
    <svg aria-hidden="true" viewBox="0 0 48 48" width="22" height="22"><path fill="#4285F4" d="M43.61 20.46H42V20H24v8h11.3C33.65 32.66 29.22 36 24 36c-6.63 0-12-5.37-12-12s5.37-12 12-12c3.06 0 5.84 1.15 7.96 3.04l5.66-5.66C34.05 6.05 29.27 4 24 4 12.95 4 4 12.95 4 24s8.95 20 20 20 20-8.95 20-20c0-1.34-.14-2.65-.39-3.54Z"/><path fill="#34A853" d="m6.31 32.39 6.57-5.06A12 12 0 0 0 24 36c3.17 0 6.05-1.23 8.19-3.23l6.19 5.24A19.94 19.94 0 0 1 24 44c-7.99 0-14.88-4.69-17.69-11.61Z"/><path fill="#FBBC05" d="M4 24c0-3.23.77-6.28 2.12-8.97l6.57 5.07A11.99 11.99 0 0 0 12 24c0 1.17.17 2.31.49 3.38l-6.57 5.06A19.9 19.9 0 0 1 4 24Z"/><path fill="#EA4335" d="M24 4c5.27 0 10.05 2.05 13.62 5.38l-5.66 5.66A11.94 11.94 0 0 0 24 12c-5.16 0-9.56 3.26-11.25 7.84l-6.58-5.07A19.99 19.99 0 0 1 24 4Z"/></svg>
    Continue with Google
   </button>
  </form>
  <p class="ask-gate-status" role="status" data-ask-gate-status>Checking your sign-in…</p>
  <button type="button" class="ask-gate-retry" data-ask-session-retry hidden>Try again</button>
  <p class="ask-gate-privacy">We use your Google name, email and profile picture to create your Ask reader profile. No additional form.</p>
  <p class="ask-gate-links"><a href="https://www.pinnacleblooms.org/privacy-policy">Privacy</a><span aria-hidden="true">·</span><a href="tel:+919100181181">Call 9100 181 181</a></p>
  <noscript><p>Enable JavaScript to sign in with Google.</p></noscript>
 </div>
</dialog>
<script is:inline>document.getElementById('ask-reader-gate').close();document.getElementById('ask-reader-gate').showModal();</script>
<script src="../../scripts/ask-reader.ts"></script>
<style>
 #ask-reader-gate{position:fixed;inset:0;margin:auto;width:min(460px,calc(100% - 32px));max-height:calc(100dvh - 32px);padding:0;border:1px solid #ded8e7;border-radius:24px;background:#fff;color:#213653;box-shadow:0 20px 80px #162c5533;overflow:auto;z-index:2147483646;font-family:inherit}
 #ask-reader-gate::backdrop{background:#18234080;backdrop-filter:blur(3px)}
 .ask-gate-card{padding:30px;text-align:center}.ask-gate-logo{width:210px;max-width:85%;height:auto;margin:0 auto 14px;display:block}
 #ask-gate-title{font-size:26px;line-height:1.25;color:#213653;margin:16px 0 12px;letter-spacing:-.02em}
 #ask-gate-description{font-size:17px;line-height:1.5;margin:0 0 24px;color:#344860}
 .ask-google-button{min-height:50px;width:100%;display:flex;justify-content:center;align-items:center;gap:12px;border:1px solid #747775;border-radius:8px;background:#fff;color:#1f1f1f;font-family:inherit;font-size:16px;font-weight:600;line-height:1.4;cursor:pointer;padding:12px 16px}
 .ask-google-button:hover{background:#f6f7fa}.ask-google-button:focus-visible,.ask-gate-retry:focus-visible{outline:3px solid #8f2879;outline-offset:4px}.ask-google-button:disabled{opacity:.55;cursor:wait}.ask-google-button svg{flex-shrink:0}
 .ask-gate-status{font-size:14px;line-height:1.5;color:#344860;margin:14px 0;min-height:21px}.ask-gate-privacy{font-size:13px;line-height:1.6;color:#536176;margin:18px 0 12px}.ask-gate-links{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;font-size:14px;margin:0}.ask-gate-links a,.ask-gate-retry{color:#842478;text-decoration:underline;text-underline-offset:3px}.ask-gate-retry{background:none;border:0;font:inherit;cursor:pointer;min-height:44px}
 @media(max-width:380px){.ask-gate-card{padding:24px 20px}#ask-gate-title{font-size:26px}.ask-google-button{font-size:15px}}
</style>
