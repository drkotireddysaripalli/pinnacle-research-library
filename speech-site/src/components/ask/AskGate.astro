---
import {Image} from 'astro:assets';
import logo from '../../assets/pinnacle-blooms-network-lockup.png';
import googleMark from '../../assets/google-sign-in-g-official.png';
const {brand='Ask Pinnacle'}=Astro.props;
---
<dialog id="ask-reader-gate" open aria-labelledby="ask-gate-title" aria-describedby="ask-gate-description" data-nosnippet>
 <div class="ask-gate-card">
  <div class="ask-gate-brand">
   <Image src={logo} width={300} height={112} alt="Pinnacle Blooms Network" format="webp" loading="eager" class="ask-gate-logo"/>
   <h2 id="ask-gate-title">{brand}</h2>
   <p class="ask-gate-purpose">Child-development knowledge.<br/>For families everywhere.</p>
   <p class="ask-gate-audience">Questions, explanations and sources for families and professionals.</p>
   <div class="ask-gate-signature" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  </div>
  <div class="ask-gate-action">
  <h3>Sign in to keep reading.</h3>
  <p id="ask-gate-description">Use your Google account to continue.<br/>No additional form.</p>
  <div class="ask-gate-sign-in">
  <form method="post" action="/ask/auth/google" data-ask-google-form>
   <input type="hidden" name="csrf" value=""/><input type="hidden" name="returnTo" value="/ask"/><input type="hidden" name="credential" value=""/><input type="hidden" name="library" value=""/>
   <button type="submit" class="ask-google-button" disabled>
    <Image src={googleMark} width={20} height={20} alt="" loading="eager"/>
    Continue with Google
   </button>
  </form>
  <div data-ask-google-button hidden></div>
  </div>
  <p class="ask-gate-status" role="status" data-ask-gate-status>Checking your sign-in…</p>
  <button type="button" class="ask-gate-retry" data-ask-session-retry hidden>Try again</button>
  <p class="ask-gate-privacy">Google shares your name, email and photo for your Pinnacle reader profile. Signing in does not book a visit or subscribe you to marketing.</p>
  <p class="ask-gate-links"><a href="https://www.pinnacleblooms.org/privacy-policy">Privacy</a><span aria-hidden="true">·</span><a href="tel:+919100181181">Call 9100 181 181</a></p>
  <noscript><p>Enable JavaScript to sign in with Google.</p></noscript>
  </div>
 </div>
</dialog>
<script is:inline>document.getElementById('ask-reader-gate').close();document.getElementById('ask-reader-gate').showModal();</script>
<script src="../../scripts/ask-reader.ts"></script>
<style>
 #ask-reader-gate{position:fixed;inset:0;margin:auto;width:min(920px,calc(100% - 40px));max-height:calc(100dvh - 40px);padding:0;border:1px solid #ded8e7;border-radius:28px;background:#fff;color:#213653;box-shadow:0 20px 80px #162c5533;overflow:auto;z-index:2147483646;font-family:inherit}
 #ask-reader-gate::backdrop{background:#18234080;backdrop-filter:blur(3px)}
 .ask-gate-card{display:grid;grid-template-columns:1.12fr 1fr;gap:42px;padding:44px;text-align:left;align-items:center}.ask-gate-brand,.ask-gate-action{min-width:0}.ask-gate-logo{width:256px;max-width:100%;height:auto;aspect-ratio:300/112;margin:0 0 24px;display:block}
 #ask-gate-title{font-size:40px;line-height:1.15;color:#8f2879;margin:0 0 14px;letter-spacing:-.025em}
 .ask-gate-purpose{font-size:22px;line-height:1.4;color:#213653;margin:0 0 18px;font-weight:700}.ask-gate-audience{font-size:15px;line-height:1.7;color:#475a71;margin:0;max-width:35ch}.ask-gate-signature{display:flex;gap:7px;margin-top:24px}.ask-gate-signature span{height:5px;width:30px;border-radius:5px;background:#8f2879}.ask-gate-signature span:nth-child(2){background:#00a8b4}.ask-gate-signature span:nth-child(3){background:#ef3e9a}.ask-gate-signature span:nth-child(4){background:#f3b900}.ask-gate-signature span:nth-child(5){background:#54a63b}
 .ask-gate-action{padding-left:30px;border-left:1px solid #e5e7eb}.ask-gate-action h3{font-size:23px;line-height:1.35;color:#213653;margin:0 0 14px}
 #ask-gate-description{font-size:16px;line-height:1.65;margin:0 0 25px;color:#344860}
 .ask-google-button{min-height:50px;width:100%;display:flex;justify-content:center;align-items:center;gap:12px;border:1px solid #747775;border-radius:8px;background:#fff;color:#1f1f1f;font-family:inherit;font-size:16px;font-weight:600;line-height:1.4;cursor:pointer;padding:12px 16px}
 .ask-google-button:hover{background:#f6f7fa}.ask-google-button:focus-visible,.ask-gate-retry:focus-visible{outline:3px solid #8f2879;outline-offset:4px}.ask-google-button:disabled{opacity:.55;cursor:wait}.ask-google-button img{flex-shrink:0}
 .ask-gate-sign-in{min-height:50px}.ask-gate-status{font-size:14px;line-height:1.5;color:#344860;margin:14px 0;min-height:42px}.ask-gate-privacy{font-size:13px;line-height:1.65;color:#536176;margin:20px 0 18px}.ask-gate-links{display:flex;gap:12px;flex-wrap:wrap;font-size:14px;margin:0}.ask-gate-links a,.ask-gate-retry{color:#842478;text-decoration:underline;text-underline-offset:3px}.ask-gate-retry{background:none;border:0;font:inherit;cursor:pointer;min-height:44px}
 @media(max-width:760px){.ask-gate-card{grid-template-columns:1fr;gap:20px;padding:24px}.ask-gate-action{padding:20px 0 0;border-left:0;border-top:1px solid #e5e7eb}.ask-gate-logo{width:180px;margin-bottom:16px}#ask-gate-title{font-size:32px}.ask-gate-purpose{font-size:18px;margin-bottom:12px}.ask-gate-audience{font-size:14px;max-width:none}.ask-gate-signature{display:none}.ask-gate-action h3{font-size:22px}#ask-gate-description{font-size:15px;margin-bottom:20px}}
 @media(max-width:380px){#ask-reader-gate{width:calc(100% - 24px);max-height:calc(100dvh - 24px);border-radius:20px}.ask-gate-card{padding:22px;gap:20px}.ask-gate-logo{width:180px}#ask-gate-title{font-size:29px}.ask-google-button{font-size:14px;padding-inline:10px}.ask-gate-audience{line-height:1.5}.ask-gate-action h3{font-size:20px}.ask-gate-privacy{font-size:12px}}
</style>
