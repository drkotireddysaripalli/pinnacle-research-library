---
import Icon from './Icon.astro';
import {Image} from 'astro:assets';
import CentrePlaylist from './CentrePlaylist.astro';
import {centreStoryPlaylists} from '../data/centre-story';
import {phone,url} from '../data/site';
import {centreWalkthrough,officialCentrePlaylist} from '../data/centre-network-content';
const {branch,mode='full',includeTour=true}=Astro.props;
const tour=centreWalkthrough(branch.id);
const mapUrl='https://www.google.com/maps?q='+encodeURIComponent('Pinnacle Blooms Network '+branch.name+', '+branch.address)+'&output=embed';
const listing=branch.googleBusinessUrl||branch.mapsUrl;
const rating=branch.reviewSnapshot;
const premises=import.meta.glob<{default:ImageMetadata}>('../assets/centre-directory/*.jpg',{eager:true});
const previewFile=branch.images?.find((p:any)=>p.kind==='exterior')?.file||branch.images?.[0]?.file;
const tourPreview=previewFile?premises['../assets/centre-directory/'+previewFile]?.default:null;
const resources=[
 {icon:'voice',title:'Ask Pinnacle',text:'Explore answers to the questions families bring to us.',href:'https://pinnacleblooms.org/ask'},
 {icon:'sun',title:'Sunshine',text:'Discover the wider child-development knowledge collection.',href:url('/sunshine')},
 {icon:'plan',title:'Frequently asked questions',text:'Read practical explanations and related questions.',href:url('/faq')},
 {icon:'book',title:'Pinnacle Materials',text:'Explore the existing learning and family materials portal.',href:'https://materials.pinnacleblooms.org/'},
 {icon:'home',title:'Everyday Therapy',text:'Understand how guided practice can continue in your child’s day.',href:url('/everyday-therapy')},
 {icon:'compass',title:'Intervention & family resources',text:'Find practical resources and discuss their suitability with your professional.',href:url('/autism-speech-aba-parent-family-resources')}
];
---
{mode==='location'&&<section class="local-section local-wrap" id="local-area"><p class="local-kicker">Plan a useful local visit</p><h2>Your route to <em>Pinnacle {branch.name}.</em></h2><div class="centre-area-grid"><div class="local-card"><h3>Call Pinnacle first</h3><p>Call <a href={phone.href} data-cta="centre-call"><strong>{phone.display}</strong></a> to discuss your child’s priorities, suitable support and an assessment appointment.</p>{branch.directTelephone&&<p class="local-secondary">Local centre alternative: <a href={'tel:'+branch.directTelephone} data-cta="local-centre-call">{branch.directTelephone}</a></p>}<p>Confirm the entrance, floor, lift or parking arrangements your family needs. The team confirms appointment hours and fees.</p><div class="local-actions"><a class="local-button local-outline" href={listing} target="_blank" rel="noopener"><Icon name="pin"/> View this centre on Google</a></div></div><div class="local-card centre-map" data-centre-map><Icon name="pin"/><h3>{branch.address}</h3><button class="local-button" type="button" data-map-load><Icon name="pin"/> Show Google map</button><p class="local-small">Load the interactive Google map here, or <a href={branch.mapsUrl} target="_blank" rel="noopener">open directions</a>.</p><template><iframe title={'Google map for Pinnacle '+branch.name} src={mapUrl} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></template></div></div>{(branch.catchmentLocalities?.length||branch.catchmentPostcodes?.length)&&<div class="local-card centre-catchment"><h3>Coming from a nearby area?</h3><p>Families planning a visit can use these localities and postcodes from our centre register to compare the location and travel arrangements.</p>{branch.catchmentLocalities?.length>0&&<ul class="centre-location-tags" aria-label="Nearby localities">{branch.catchmentLocalities.map((place:string)=><li>{place}</li>)}</ul>}{branch.catchmentPostcodes?.length>0&&<details><summary>Nearby postcodes</summary><ul class="centre-location-tags">{branch.catchmentPostcodes.map((code:string)=><li>{code}</li>)}</ul></details>}<p class="local-small">These areas are a location guide. Confirm your actual travel route and appointment with us.</p></div>}</section>}
{mode==='proof'&&<aside class="local-wrap centre-proof-ribbon" aria-label="Pinnacle network evidence"><a href={url('/pinnacleai')}><strong>PinnacleAI®</strong><span>4 Billion Clinical Data Points · Explore the system and evidence</span></a><a href={url('/verify/evidence/operating-metrics.html')}><strong>31 Million+</strong><span>Documented services*</span></a><a href={url('/verify/evidence/operating-metrics.html')}><strong>790,000+</strong><span>Beneficiary / family registrations*</span></a><a href={url('/verify/')}><strong>Explore Verify <Icon name="arrow"/></strong><span>Original licences, reports and evidence</span></a><p>*Network counts at 17 July 2026. Services include assessments, screenings and parent training; registrations and individual outcomes are different measures. <a href={url('/verify/')}>Inspect the figures and original reports.</a></p></aside>}
{mode==='full'&&<>
 {includeTour&&<section class="local-section local-wrap" id="centre-walkthrough"><p class="local-kicker">See the place before your visit</p><h2>Walk through <em>Pinnacle {branch.name}.</em></h2>{tour?<div class="centre-video-card"><div class="centre-video-stage" data-centre-video>{tour.provider==='youtube'?<img class="centre-tour-preview" src={'https://i.ytimg.com/vi/'+tour.id+'/hqdefault.jpg'} alt={branch.name+' official centre walkthrough preview'} width="480" height="360" loading="lazy" referrerpolicy="no-referrer"/>:tourPreview?<Image class="centre-tour-preview" src={tourPreview} alt={'Pinnacle '+branch.name+' premises photograph; open the supplied video for the walkthrough'} widths={[480,720,1000]} sizes="(max-width:760px) 92vw, 80vw" format="webp" loading="lazy"/>:<div class="centre-tour-fallback"><Icon name="video" size={56}/><h3>{branch.name} centre walkthrough</h3><p>See the spaces before planning your visit.</p></div>}<span class="centre-tour-label"><Icon name="pin" size={18}/>{branch.name} · Centre walkthrough</span>{tour.provider==='youtube'?<button class="centre-tour-play" type="button" data-video-load aria-label={'Watch the '+branch.name+' centre walkthrough'}><span><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 4.5v15l12-7.5Z"/></svg></span>Watch the centre walkthrough</button>:<a class="centre-tour-play" href={tour.url} target="_blank" rel="noopener"><span><Icon name="video" size={28}/></span>Open the supplied centre walkthrough</a>}{tour.provider==='youtube'&&<template><iframe title={branch.name+' centre walkthrough'} src={tour.embed} allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></template>}</div><p><a class="local-text-link" href={tour.url} target="_blank" rel="noopener">Open the {tour.provider==='youtube'?'YouTube':'supplied centre'} video <Icon name="arrow"/></a></p><p class="local-small">{tour.provider==='drive'&&<>The supplied video opens in Google Drive, which may ask you to sign in. You can also <a href={officialCentrePlaylist} target="_blank" rel="noopener">browse our public YouTube centre tours</a>. </>}Rooms and equipment may have changed since filming. Confirm the arrangements for your visit.</p></div>:<div class="local-card"><p>Explore our published network centre walkthroughs and ask our team for the tour matched to your appointment location.</p><a class="local-button local-outline" href={officialCentrePlaylist} target="_blank" rel="noopener"><Icon name="video"/> Explore centre walkthroughs</a></div>}</section>}
 <section class="local-section centre-voices" id="people-and-families"><div class="local-wrap"><p class="local-kicker">People, purpose and lived experience</p><h2>A network working toward <em>your child’s wonderful life.</em></h2><p class="local-lead">Hear our professionals describe their promise to children, and families describe what PinnacleAI®, AbilityScore® and the journey have meant to them.</p><div class="centre-playlist-grid">{centreStoryPlaylists.map(story=><CentrePlaylist story={story}/>)}</div><p class="local-small">Also explore <a href="https://www.youtube.com/playlist?list=PL0lwT9W0zVpjQqvH9N7SRnoU-7Bf-Eg9J" target="_blank" rel="noopener">staff voices</a>, and parent stories in <a href="https://www.youtube.com/playlist?list=PL0lwT9W0zVpiLzk_r8kAcZyj7GP3VKeBx" target="_blank" rel="noopener">Telugu</a>, <a href="https://www.youtube.com/playlist?list=PL0lwT9W0zVpg2CkzXyMhuAoRStYgnD7eM" target="_blank" rel="noopener">Hindi</a> and <a href="https://www.youtube.com/playlist?list=PL0lwT9W0zVpi9IP0yiRylaeLsB922vyjY" target="_blank" rel="noopener">English</a>. These are network stories, not a roster of this branch’s current staff. A family’s experience does not guarantee the same result for every child.</p></div></section>
 <section class="local-section local-wrap" id="google-reviews"><p class="local-kicker">Read the centre’s public feedback</p><h2>Get another perspective. <em>Visit our Google listing.</em></h2><div class="centre-review-card local-card"><div><Icon name="heart"/>{rating?<><strong class="centre-rating">{rating.rating.toFixed(1)} <span>/ 5</span></strong><p>{rating.reviews.toLocaleString('en-IN')} reviews in the supplied centre register.</p><p class="local-small">The workbook snapshot is undated. Open Google for the current rating, review count and individual reviews.</p></>:<p>Read the current rating and family feedback directly on our Google listing.</p>}</div><div class="local-actions"><a class="local-button" href={listing} target="_blank" rel="noopener"><Icon name="pin"/> Read reviews on Google</a>{branch.reviewUrl&&<a class="local-text-link" href={branch.reviewUrl} target="_blank" rel="noopener">Leave your own review <Icon name="arrow"/></a>}</div></div></section>
 <section class="local-section local-wrap" id="nearby-centres"><p class="local-kicker">Find the location that fits your family</p><h2>{branch.nearbyCentres?.length?'Compare nearby':'Explore other'} <em>Pinnacle centres.</em></h2><p class="local-lead">Compare the location with your routine, then confirm the suitable professional, service and appointment with our team.</p>{branch.nearbyCentres?.length>0&&<div class="centre-extra-grid">{branch.nearbyCentres.map((c:any)=><a class="local-card centre-nearby" href={c.url}><Icon name="pin"/><h3>{c.name}</h3><p>{c.city} · approximately {c.distanceKm} km in a straight line</p><strong>See the centre, directions and visit details <Icon name="arrow"/></strong></a>)}</div>}<p class="local-small">Distances use supplied coordinates and are approximate, not road distance or travel time.</p><a class="local-button local-outline" href={url('/centers')}><Icon name="pin"/> Explore all Pinnacle centres</a></section>
 <section class="local-section centre-resources" id="family-resources"><div class="local-wrap"><p class="local-kicker">Clarity can continue beyond this page</p><h2>Answers, ideas and <em>resources for your family.</em></h2><div class="centre-extra-grid">{resources.map(r=><a class="local-card centre-resource" href={r.href}><Icon name={r.icon}/><h3>{r.title}</h3><p>{r.text}</p><strong>Explore <Icon name="arrow"/></strong></a>)}</div></div></section>
 <section class="local-section local-wrap" id="centre-books"><p class="local-kicker">Learn at your own pace</p><h2>Pinnacle books and resources. <em>A companion to understanding.</em></h2><p class="local-lead">Explore parent learning about speech and communication, occupational therapy, everyday behaviour and special education. Choose the relevant title, language and format on its own page.</p><div class="centre-extra-grid"><a class="local-card centre-resource" href={url('/books')}><Icon name="book"/><h3>Explore Pinnacle books</h3><p>Browse the complete parent-learning collection and available formats.</p><strong>View books <Icon name="arrow"/></strong></a><a class="local-card centre-resource" href={url('/shop')}><Icon name="home"/><h3>Visit the Pinnacle Shop</h3><p>See the current offerings, prices and purchasing options.</p><strong>Open Shop <Icon name="arrow"/></strong></a><a class="local-card centre-resource" href={url('/books/resources/first-conversation')}><Icon name="plan"/><h3>Prepare your first conversation</h3><p>Use the free planning sheet to bring your priorities and questions.</p><strong>Open the planning sheet <Icon name="arrow"/></strong></a></div><p class="local-small">Books are optional learning resources. They do not replace individual assessment or professional guidance.</p></section>
</>}
<script>
 document.querySelectorAll('[data-map-load],[data-video-load]').forEach(button=>button.addEventListener('click',()=>{const stage=button.closest('[data-centre-map],[data-centre-video]');const template=stage?.querySelector('template');if(template){stage.replaceChildren(template.content.cloneNode(true));stage.querySelector('iframe')?.focus();}}));
</script>
<style>
 .centre-playlist-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;margin:2rem 0}.centre-area-grid,.centre-review-card{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.4rem}.centre-extra-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;margin:2rem 0}.centre-extra-grid .local-card{min-width:0}.centre-resource,.centre-nearby{text-decoration:none!important}.centre-resource strong,.centre-nearby strong{display:flex;align-items:center;gap:.5rem}.centre-resource:hover,.centre-nearby:hover{border-color:#8f2879}.centre-map{min-height:310px}.centre-map iframe{border:0;width:100%;height:340px;border-radius:22px}.centre-catchment{margin-top:1.6rem}.centre-catchment summary{cursor:pointer;font-weight:700;min-height:44px;padding:.8rem 0}.centre-location-tags{display:flex;flex-wrap:wrap;gap:.6rem;list-style:none;padding:0}.centre-location-tags li{background:#f0f8f6;border:1px solid #d2e6e0;border-radius:24px;padding:.5rem .85rem;font-size:1rem}.centre-video-stage{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;min-height:280px;border:1px solid #d9e8e3;background:#f2faf7;border-radius:26px;padding:2rem;text-align:center}.centre-video-stage>svg{width:52px;height:52px;color:#8f2879}.centre-video-stage:has(iframe){padding:0;aspect-ratio:16/9}.centre-video-stage iframe{border:0;width:100%;height:100%;min-height:280px;border-radius:26px}.centre-voices{background:#fcf7fc}.centre-resources{background:#f4faf9}.centre-review-card{align-items:center}.centre-rating{display:block;color:#8f2879;font-size:3rem;margin-top:.5rem}.centre-rating span{font-size:1.25rem;color:#18315d}.centre-proof-ribbon{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin-top:1rem;border-block:1px solid #dee6eb;padding-block:1.5rem}.centre-proof-ribbon>a{text-decoration:none;padding:.7rem}.centre-proof-ribbon strong{display:flex;align-items:center;gap:.4rem;font-size:1.35rem;color:#8f2879}.centre-proof-ribbon span{display:block;margin-top:.6rem;line-height:1.6;color:#17344e}.centre-proof-ribbon p{grid-column:1/-1;font-size:.85rem!important;margin:.2rem .7rem!important}.local-secondary{font-size:1rem!important}.local-secondary a{text-decoration:underline}@media(max-width:900px){.centre-extra-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.centre-proof-ribbon{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.centre-playlist-grid,.centre-area-grid,.centre-extra-grid,.centre-review-card{grid-template-columns:1fr}.centre-proof-ribbon strong{font-size:1.14rem}.centre-proof-ribbon span{font-size:.94rem}.centre-proof-ribbon{gap:.4rem}.centre-video-stage{padding:1.2rem}.centre-video-stage iframe{min-height:220px}.centre-map iframe{height:300px}.centre-rating{font-size:2.5rem}}
</style>

<style>
.centre-video-stage{position:relative;aspect-ratio:16/9;padding:0!important;overflow:hidden;min-height:0!important;isolation:isolate;background:#edf4f3}.centre-tour-preview{width:100%;height:100%;object-fit:contain;display:block}.centre-video-stage:after{content:"";position:absolute;inset:65% 0 0;background:linear-gradient(transparent,#142e4dda);z-index:0;pointer-events:none}.centre-video-stage:has(iframe):after{display:none}.centre-tour-label{position:absolute;top:1rem;left:1rem;display:flex;align-items:center;gap:.45rem;padding:.6rem .85rem;border-radius:26px;background:#fff;color:#18315d;font-size:.9rem;font-weight:700;z-index:1}.centre-tour-play{position:absolute;bottom:1.2rem;left:1.2rem;display:flex;align-items:center;gap:.8rem;min-height:60px;max-width:calc(100% - 2.4rem);padding:0;border:0;background:transparent;color:#fff;font:700 1.1rem/1.4 Sintony,sans-serif;cursor:pointer;text-shadow:0 1px 3px #0008;z-index:1}.centre-tour-play>span{display:grid;place-items:center;width:60px;height:60px;border-radius:50%;background:#fff;color:#96277e;flex:none}.centre-tour-play:focus-visible{outline:3px solid white;outline-offset:6px;border-radius:8px}.centre-tour-play:hover>span{background:#fcf1fa}.centre-tour-fallback{padding:2rem 2rem 5.5rem;color:#18315d}.centre-video-stage iframe{min-height:0!important;height:100%}.centre-tour-label>svg{flex:none}@media(max-width:760px){.centre-tour-play{font-size:.94rem;bottom:.8rem;left:.8rem;min-height:48px}.centre-tour-play>span{width:48px;height:48px}.centre-tour-label{font-size:.75rem;top:.7rem;left:.7rem;max-width:calc(100% - 1.4rem)}.centre-tour-fallback{padding:1rem 1rem 5rem}}
</style>
