---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from './Icon.astro';
import {Image} from 'astro:assets';
import family from '../assets/enrolment-family-life-path-branded-20260929.png';
import shareCard from '../assets/enrolment-share-20260929.jpg';
import everydayPractice from '../assets/enrolment-everyday-practice.webp';
import HeroProofPanel from './HeroProofPanel.astro';
import EnrolmentJourney from './EnrolmentJourney.astro';
import EnrolmentCentreCard from './EnrolmentCentreCard.astro';
import centres from '../data/centre-directory.json';
import {phone,url,origin} from '../data/site';
import {speechOffer} from '../data/speech-offer';
import '../styles/enrolment.css';
import '../styles/enrolment-story.css';
const {previewOnly=true,apiEndpoint=''}=Astro.props;
const livePath='/enroll-autism-speech-aba-therapies-india';
const path=previewOnly?'/pinnacle-pages-preview/enrolment':livePath;
if(!previewOnly){
 const endpoint=new URL(apiEndpoint,origin);
 if(!apiEndpoint||endpoint.origin!==origin||!endpoint.pathname.startsWith('/api/')||endpoint.search||endpoint.hash||endpoint.username||endpoint.password)throw new Error('Live enrolment requires the approved same-origin Cloudflare API path.');
}
const services=[['help','Help me choose','compass'],['autism','Autism / integrated support','people'],['speech','Speech & language','voice'],['occupational','Occupational therapy','home'],['aba','ABA / behavioural support','heart'],['education','Special education','book'],['other','Another service','people']];
const regions=[...new Set(centres.map(c=>c.region))].sort((a,b)=>a.localeCompare(b));
const proof=[
 ['compass','A purpose you can recognise','Your child’s everyday life gives abilities, goals, practice and review their direction.','Read the life-first approach','/verify/evidence/pinnacle-paradigm-shift.html'],
 ['shield','Licensed developmental-support software','PinnacleAI® GPT-OS v1.0.0 is licensed as Class B, non-diagnostic developmental-support software for children aged 0–12.','Read the MD-5 record','/verify/evidence/records/md5.html'],
 ['book','Research you can read','Explore published methods and study summaries, with each source’s status and scope explained.','Explore the research library','/verify/evidence/research-library.html'],
 ['people','An organisation you can identify','Pinnacle Blooms Network is operated by Bharath Healthcare Laboratories Private Limited.','Verify the organisation','/verify/evidence/records/lei.html']
];
const citations=proof.map(p=>url(p[4])).concat([url('/verify/#family-observations'),url('/verify/#feedback-changes-plan')]);
const questions=[
 ['What makes the Pinnacle approach different?','We begin with the life your child is growing toward. Greater independence and participation in family, school and community give assessment, goals, therapies, everyday practice and review one shared purpose.'],
 ['What can I discuss in the first conversation?','Tell us about everyday moments you want to make easier: communicating a need, managing a routine, learning or taking part with others. Ask about assessment, suitable support, the centre and fees. You do not need to know the name of a therapy to begin.'],
 ['How will my family be involved?','Your priorities and observations help shape the work. Parent-guided everyday practice connects developing abilities with daily routines, and review helps the team decide what to adjust next.'],
 ['What should I bring to a visit?','Bring your questions and any existing reports you would like the professional to consider. The team will confirm what is relevant for your appointment. There is no need to upload medical information to this enquiry form.'],
 ['Do I need to choose a therapy before contacting you?','No. Select “Help me choose” or call us. An appropriate professional assessment helps determine what support is suitable.'],
 ['What happens after I request a visit?','The team contacts you to discuss your priorities and confirm the centre, professional, appointment and any fees. A request is the first step; your appointment is confirmed with you.'],
 ['Is the assessment free?','The current speech and language assessment campaign offers a FREE assessment. Other assessments and ongoing therapy may have different fees. Confirm the service and its charges with the team before your visit.']
];
---
<PageLayout path={path} label="Arrange a visit" title="Enrol at Pinnacle | A Life-First Path for Your Child" description="Start your child’s life-first journey toward greater independence and participation. Explore Pinnacle’s approach and enrol or call 9100 181 181." shareImage={shareCard} imageAlt="Pinnacle Blooms enrolment card showing an Indian family beginning a child-development conversation, Pinnacle Verify proof and the phone number 9100 181 181." imageCaption="Start with your child’s life: enrol at Pinnacle Blooms Network." citations={citations} faqs={questions.map(([question,answer])=>({question,answer}))} pageType="ContactPage" publishedOn="2026-09-28" updatedOn="2026-09-30" documentOnly previewOnly={previewOnly} enquiry={{url:'#enrolment-form',mobileLabel:'Start a conversation'}}>
 <section class="enrol-hero wrap" aria-labelledby="enrol-title">
  <div><p class="eyebrow">Pinnacle Blooms Network · Every child. One life. One clear direction.</p><h1 id="enrol-title">Every therapy matters.<br/><em>Your child’s life matters most.</em></h1><p class="enrol-lead">Pinnacle starts with the life you want your child to grow toward—greater independence and participation in family, learning, school and community—then gives abilities, goals, therapies, family practice and every review one clear purpose. You see the direction. You help shape every next step.</p><div class="enrol-hero-actions"><a href="#enrolment-form" class="button primary">Start my family’s conversation <Icon name="arrow"/></a><a href={phone.href} class="button outline" data-cta="hero-call"><Icon name="phone"/> Call {phone.display}</a></div><p class="enrol-hero-help">Different concerns may bring you here. You should not have to assemble the journey alone—or know which therapy to choose before we listen.</p></div>
  <figure class="enrol-hero-art"><Image src={family} widths={[480,720,1080,1536]} sizes="(min-width:900px) 48vw, 100vw" width={1536} height={864} format="webp" quality={82} loading="eager" fetchpriority="high" alt="An Indian mother, father and child speaking with a child-development professional, connected to everyday home routines and school participation."/><HeroProofPanel compact/><figcaption>One child. One life. Every step working toward it.</figcaption></figure>
 </section>
 <span id="speech-assessment-enquiry" class="anchor-target" aria-hidden="true"></span>
 <section class="enrol-body wrap" id="enrolment-form" aria-labelledby="request-title">
  <div class="enrol-card"><p class="eyebrow">Let’s make the first step simple</p><h2 id="request-title">Tell us how to reach you.<br/>We’ll listen first.</h2><p class="enrol-form-intro">Your name and number are enough. You do not need to choose a therapy or explain your child’s whole history here.</p>
   <aside id="enrol-speech-offer" class="enrol-speech-offer" hidden aria-labelledby="enrol-speech-offer-title"><p class="eyebrow">Speech and language assessment</p><h3 id="enrol-speech-offer-title"><s>{speechOffer.listedDisplay}</s> <strong>FREE</strong></h3><p>Request the confirmed FREE speech and language assessment. Ongoing therapy and other assessments are priced separately; the team confirms your appointment and the suitable professional.</p><a href={url('/speech-therapy/service-information')}>Read the offer and included service details →</a><p><a href="/top-speech-therapy-center-india-proven-improvement-rate">Understand the speech pathway →</a></p></aside>
   {previewOnly&&<p class="enrol-preview-note">Design preview · This form does not send enquiries. To contact us now, <a href={url(livePath)}>use the live enrolment form</a> or call {phone.display}.</p>}
   <form id="pinnacle-enrolment" method="post" action={previewOnly?'#':apiEndpoint} novalidate data-preview={String(previewOnly)} data-api-endpoint={previewOnly?'':apiEndpoint} data-source-path={livePath} aria-describedby="enrol-privacy">
    <noscript><p class="enrol-error-summary">Please enable JavaScript to use this form, or <a href={phone.href}>call {phone.display}</a>.</p></noscript>
    <p id="enrol-unavailable" class="field-help">Loading the form… If it stays unavailable, please <a href={phone.href}>call {phone.display}</a>.</p>
    <div id="enrol-error-summary" class="enrol-error-summary" role="alert" tabindex="-1" hidden></div>
    <fieldset disabled data-enrol-fields><legend><span>1</span>Your contact details</legend><div class="enrol-fields">
     <div><label for="parent-name">Your name <span>(required)</span></label><input id="parent-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="parent-name-error"/><p class="field-error" id="parent-name-error"></p></div>
     <div><label for="parent-phone">Mobile number <span>(required)</span></label><input id="parent-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="25" placeholder="Your contact number" aria-describedby="phone-help parent-phone-error"/><p class="field-help" id="phone-help">Outside India? Include your country code.</p><p class="field-error" id="parent-phone-error"></p></div>
    </div></fieldset>
    <fieldset disabled data-enrol-fields><legend><span>2</span>Your preferences <small>(optional)</small></legend>
     <details class="enrol-preferences" id="enrol-preferences" open><summary>Choose a service or centre <span>(optional)</span></summary><div class="enrol-preferences-body">
      <p class="enrol-choice-label" id="service-label">What would you like help with?</p><div class="enrol-service-options" role="radiogroup" aria-labelledby="service-label">{services.map(([value,label,icon])=><label class="enrol-service-choice"><input type="radio" name="service" value={value} checked={value==='help'}/><Icon name={icon}/><span>{label}</span></label>)}</div>
      <div class="enrol-fields"><div class="full"><label for="preferred-centre">Preferred centre</label><select id="preferred-centre" name="centre"><option value="">Help me find a centre</option>{regions.map(region=><optgroup label={region}>{centres.filter(c=>c.region===region).sort((a,b)=>a.city.localeCompare(b.city)||a.name.localeCompare(b.name)).map(c=><option value={c.id}>{c.city} — {c.name}</option>)}</optgroup>)}</select><p class="field-help">We’ll confirm the service and availability before you travel.</p></div></div>
      <EnrolmentCentreCard/>
     </div></details>
     <details class="enrol-optional"><summary>Add an email or a short note <span>(optional)</span></summary><div class="enrol-fields">
      <div class="full"><label for="parent-email">Email</label><input id="parent-email" name="email" type="email" autocomplete="email" maxlength="254" aria-describedby="parent-email-error"/><p class="field-error" id="parent-email-error"></p></div>
      <div class="full"><label for="family-priority">Anything you’d like us to know?</label><textarea id="family-priority" name="message" rows="3" maxlength="500" aria-describedby="message-help" placeholder="For example: I would like to understand the assessment process."></textarea><p class="field-help" id="message-help">A short enquiry is enough. Please save medical reports and detailed child information for your private conversation with the team.</p></div>
     </div></details>
    </fieldset>
    <div class="enrol-submit"><p id="enrol-privacy">We use your details to respond to this enquiry. <a href={url('/privacy-policy')}>Privacy policy</a>.</p><button class="button primary" type="submit" id="enrol-submit" disabled>{previewOnly?'Check form preview':'Request a family conversation'} <Icon name="arrow"/></button><div id="enrol-status" role="status" aria-live="polite" tabindex="-1"></div><p class="field-help">Your appointment, service and fees are confirmed by the team.</p><p class="enrol-call-alternative">Prefer to talk? <a href={phone.href} data-cta="final-call">Call {phone.display}</a>.</p></div>
   </form>
  </div>
  <aside class="enrol-aside">
   <div class="enrol-decision"><span class="enrol-icon"><Icon name="heart" size={32}/></span><p class="eyebrow">This is more than a form</p><h2>You are choosing a direction<br/><em>for your child’s life.</em></h2><p>Tell us what you hope your child can do more independently—communicate, learn, manage everyday routines, join school or participate with others. We begin there.</p></div>
   <section class="enrol-next"><p class="eyebrow">What happens next</p><h2>A clear beginning. No pressure.</h2><ol><li><Icon name="phone"/><div><h3>We begin with your priorities</h3><p>Share the everyday changes that would matter most to your child and family.</p></div></li><li><Icon name="pin"/><div><h3>We arrange the right starting conversation</h3><p>Confirm the centre, professional, appointment, any fees and what to bring.</p></div></li><li><Icon name="compass"/><div><h3>You decide with clarity</h3><p>Understand the assessment and recommendations before choosing ongoing support.</p></div></li></ol></section>
   <section class="enrol-trust"><Icon name="shield" size={30}/><h3>Confidence you can inspect.</h3><p>See the licensed software scope, the research behind the approach and the organisation accountable for it.</p><a href="#enrol-evidence">See the evidence below ↓</a><a href={url('/verify/evidence/pinnacleai-regulatory-journey.html')}>The complete PinnacleAI story →</a></section>
  </aside>
 </section>
 <section class="wrap enrol-reasons" aria-labelledby="why-pinnacle-title"><div class="enrol-reasons-heading"><p class="eyebrow">Why families choose Pinnacle</p><h2 id="why-pinnacle-title">A direction you understand.<br/><em>A journey you help shape.</em></h2><p><strong>Your child is one whole life.</strong> Assessment, therapy and technique matter. At Pinnacle, every part of the work serves the abilities your child needs in everyday life.</p></div><div class="enrol-reason-grid">
  <article><span class="enrol-icon"><Icon name="compass" size={30}/></span><h3>Begin with the life you want for your child.</h3><p>Growing independence and mainstream participation give abilities, goals and support their direction.</p><a href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>See the paradigm shift →</a></article>
  <article><span class="enrol-icon"><Icon name="people" size={30}/></span><h3>Stay part of every important decision.</h3><p>Your priorities, everyday observations and guided practice help shape what the team reviews next.</p><a href={url('/verify/#family-observations')}>See your family’s role →</a></article>
  <article><span class="enrol-icon"><Icon name="loop" size={30}/></span><h3>Make progress in real life the test.</h3><p>What is changing outside the therapy room helps the team review, correct and continue the plan.</p><a href={url('/verify/#feedback-changes-plan')}>See how the plan changes →</a></article>
 </div></section>
 <EnrolmentJourney/>
 <section class="enrol-everyday section" aria-labelledby="everyday-title"><div class="wrap"><div class="enrol-everyday-intro"><div class="enrol-section-heading"><p class="eyebrow">Where therapy proves its value</p><h2 id="everyday-title">The session is not the destination.<br/><em>Your child’s everyday life is.</em></h2><p>“I want my child to be able to ask for water.” A real-life priority turns development into something the child and family can use.</p></div><figure class="enrol-story-figure enrol-practice-figure"><Image src={everydayPractice} widths={[480,720,900]} sizes="(min-width:900px) 43vw, 100vw" width={900} format="webp" quality={80} loading="lazy" decoding="async" alt="A child practising a useful everyday routine with family and professional guidance."/><figcaption><strong>From guided work to everyday life.</strong> A developing ability becomes meaningful when the child can use it in the moments that matter.</figcaption></figure></div><div class="enrol-example-grid"><article><Icon name="voice" size={32}/><h3>Agree a useful goal</h3><p>The professional and family explore how the child currently communicates a need and what to work toward.</p></article><article><Icon name="home" size={32}/><h3>Practise where it matters</h3><p>Guided practice brings the goal into suitable moments at home and in other everyday routines.</p></article><article><Icon name="track" size={32}/><h3>Notice. Review. Adjust.</h3><p>What happened? What support helped? Family observations contribute to the next review.</p></article></div><p class="enrol-example-note">An illustration of the approach. Goals, communication methods and support are individual to each child.</p><a class="text-link" href={url('/verify/#goals-to-everyday-practice')}>See how goals become everyday practice →</a></div></section>
 <section class="section wrap enrol-proof" id="enrol-evidence" aria-labelledby="enrol-proof-title"><div class="enrol-section-heading"><p class="eyebrow">Open. Honest. Transparent. Self-critical.</p><h2 id="enrol-proof-title">Hope deserves proof<br/><em>you can inspect.</em></h2><p>See the life-first method, the licensed software scope, the research trail and the legal organisation accountable for the work.</p></div><div class="enrol-proof-grid">{proof.map(([icon,title,body,label,href])=><article><Icon name={icon} size={30}/><h3>{title}</h3><p>{body}</p><a href={url(href)}>{label} →</a></article>)}</div><p class="enrol-proof-note">The software licence describes its permitted scope; your child’s plan and progress are individual. Research records distinguish methods, preliminary findings and company study summaries.</p></section>
 <section class="section wrap enrol-questions" id="questions" aria-labelledby="enrol-questions-title"><h2 id="enrol-questions-title">Before your first visit</h2>{questions.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</section>
 <section class="wrap enrol-close" aria-labelledby="enrol-close-title"><Icon name="sun" size={42}/><div><p class="enrol-life-ribbon">SELF-SUFFICIENT · MAINSTREAM · WONDERFUL LIFE · POSSIBLE.</p><h2 id="enrol-close-title">Begin a journey built<br/>around your child’s life.</h2><p>Start with a conversation. We will listen to what matters, help identify a suitable first step and explain the options before you decide.</p></div><div class="enrol-close-actions"><a class="button primary" href="#enrolment-form">Start my family’s conversation <Icon name="arrow"/></a><a class="button outline" href={phone.href} data-cta="final-call">Call {phone.display}</a></div></section>
 <script is:inline type="module" src="/pinnacle-pages-scripts/enrolment.js"></script>
</PageLayout>
