---
import Icon from './Icon.astro';
---
<div class="visit-infographic" role="group" aria-label="From your enquiry to your first assessment">
  <ol>
    <li><span class="visit-number">1</span><Icon name="phone" size={30}/><h3>Tell us what matters.</h3><p>Call or request your FREE assessment. Share your preferred centre.</p></li>
    <li><span class="visit-number">2</span><Icon name="people" size={30}/><h3>Confirm your visit.</h3><p>Our team confirms the professional, appointment and what to bring.</p></li>
    <li><span class="visit-number">3</span><Icon name="plan" size={30}/><h3>Understand the next step.</h3><p>Discuss the assessment findings, your report and the options for your child.</p></li>
  </ol>
</div>
