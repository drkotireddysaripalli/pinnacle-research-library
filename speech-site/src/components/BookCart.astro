---
import '../styles/book-cart.css';
import translations from '../data/book-cart-locales.json';
const locale = ['hi','te'].includes(Astro.props.locale) ? Astro.props.locale : 'en';
const strings = {...translations.en,...translations[locale]};
const routes = {...translations.routes[locale],...(Astro.props.samplesPath?{samples:Astro.props.samplesPath}:{}),...(Astro.props.collectionPath?{compareCollections:Astro.props.collectionPath,collections:Astro.props.collectionPath}:{})};
import books from '../data/book-catalog.json';
import languageBooks from '../data/book-locales.json';
import merchantEditions from '../data/book-merchant-editions.json';
import presentation from '../data/shop-presentation.json';
const singles = books.filter(book => !book.physical && !book.bundle);
const cartCatalogue = Object.fromEntries(books.filter(book => !book.physical).map(book => [book.sku, {
  title: book.title,
  path: book.path,
  price: book.price,
  editionPaths: books.filter(item => item.groupKey === book.groupKey).map(item => item.path),
  books: book.includesSkus.map(sku => {
    const member = singles.find(item => item.sku === sku)!;
    const visual = presentation.books.find(item => item.fallback_url.endsWith(member.path))!;
    return { sku: member.sku, title: member.title, discipline: member.discipline, cover: '/pinnacle-pages-assets/shop-20261002/' + visual.asset, sample: visual.sample_url };
  })
}]));
Object.assign(cartCatalogue,Object.fromEntries(languageBooks.filter(book=>book.available).map(book=>[book.sku,{title:book.title+' · '+book.languageName,path:book.path,price:book.price,editionPaths:[book.path],books:book.members.map(member=>({sku:member.sku,title:member.title+' · '+book.languageName,discipline:member.discipline,cover:member.front,sample:member.sample}))}])));
if(locale==='en')for(const edition of merchantEditions){const entry=cartCatalogue[edition.sku];if(entry){entry.title=edition.title;entry.path=edition.path;entry.editionPaths=[edition.path];entry.books=edition.included_books.map(member=>({sku:member.sku,title:member.title_english+' · '+edition.edition_label,discipline:member.discipline_english,cover:member.cover_url,sample:member.sample_url}));}}
---
<div class:list={["pbn-commerce","pbn-commerce-lang-"+locale]} data-book-commerce data-cart-locale={locale} data-cart-strings={JSON.stringify(strings)} data-cart-collections={routes.compareCollections} data-cart-catalogue={JSON.stringify(cartCatalogue)}>
  <nav class="pbn-commerce-nav" aria-label={strings.navAria}>
    <a href={routes.shop}>{strings.navShop}</a><a href={routes.books}>{strings.navBooks}</a><a href={routes.collections}>{strings.navCollections}</a><a href={routes.samples}>{strings.navSamples}</a>
    <button type="button" data-cart-open>{strings.bookBag} <span data-cart-count>0</span></button>
  </nav>
  <dialog class="pbn-cart" aria-labelledby="pbn-cart-title">
    <header class="pbn-cart-heading">
      <div><p class="pbn-cart-eyebrow">{strings.brandEyebrow}</p><h2 id="pbn-cart-title">{strings.bagHeadline}</h2></div>
      <button type="button" data-cart-close aria-label={strings.closeBagAria}>×</button>
    </header>
    <div class="pbn-cart-layout">
      <section class="pbn-cart-selection" aria-label={strings.selectionAria}>
        <p class="pbn-cart-intro">{strings.bagIntro}</p>
        <div data-cart-items></div>
        <div class="pbn-cart-reassurance">
          <span>{strings.reassuranceColour}</span><span>{strings.reassurancePages}</span><span>{strings.reassuranceDevices}</span>
        </div>
        <section class="pbn-cart-reading" aria-labelledby="pbn-cart-reading-title">
          <p class="pbn-cart-eyebrow">{strings.readingEyebrow}</p>
          <h3 id="pbn-cart-reading-title">{strings.readingHeadline}</h3>
          <p>{strings.readingDescription}</p>
          <p class="pbn-cart-authors">{strings.authors}<br/><a href="/leadership" target="_blank" rel="noopener">{strings.meetAuthors}</a></p>
        </section>
      </section>
      <aside class="pbn-cart-summary" aria-label={strings.summaryAria}>
        <div class="pbn-cart-bottom">
          <p class="pbn-cart-total-label">{strings.yourTotal} <strong data-cart-total>₹0</strong></p>
          <p class="pbn-cart-note" data-cart-file-count>{strings.selectBook}</p>
          <a class="pbn-cart-checkout" data-cart-checkout hidden>{strings.checkout}</a>
          <p class="pbn-cart-message" role="status" aria-live="polite" data-cart-message></p>
          <div class="pbn-cart-delivery">
            <h3>{strings.deliveryHeadline}</h3>
            <ol><li>{strings.deliveryStepEmail}</li><li>{strings.deliveryStepPay}</li><li>{strings.deliveryStepDownload}</li></ol>
            <p>{strings.deliveryNote}</p>
          </div>
          <a class="pbn-cart-support" href="tel:+919100181181"><span>{strings.supportQuestion}</span><strong>{strings.supportCall}</strong></a>
          <a class="pbn-cart-email" href="mailto:care@pinnacleblooms.org">care@pinnacleblooms.org</a><br />
          <a class="pbn-cart-email" href={'https://wa.me/919100181181?text='+encodeURIComponent(strings.whatsappMessage)} target="_blank" rel="noopener noreferrer" aria-label={strings.whatsappAria}>{strings.whatsappSupport}</a>
        </div>
      </aside>
      <section class="pbn-cart-proof" aria-labelledby="pbn-cart-proof-title">
        <div class="pbn-cart-proof-intro"><p class="pbn-cart-eyebrow">{strings.evidenceEyebrow}</p><h3 id="pbn-cart-proof-title">{strings.evidenceHeadline}</h3><p>{strings.evidenceDescription}</p><a href="/verify/" target="_blank" rel="noopener">{strings.evidenceExplore}</a></div>
        <div class="pbn-cart-proof-links">
          <a href="/verify/evidence/records/md5.html" target="_blank" rel="noopener"><span class="pbn-cart-proof-tag">PinnacleAI® · MD-5</span><strong>{strings.licenceTitle}</strong><span>MFG/MD/2026/000248<br/>{strings.licenceAuthority}</span><span class="pbn-cart-proof-action">{strings.licenceAction}</span></a>
          <a href="/verify/evidence/records/bis.html" target="_blank" rel="noopener"><span class="pbn-cart-proof-tag">{strings.qualityTag}</span><strong>{strings.qualityTitle}</strong><span>MD/L-2026029599<br/>IS 23485:2019</span><span class="pbn-cart-proof-action">{strings.qualityAction}</span></a>
        </div>
        <p class="pbn-cart-scope">{strings.scope}</p>
      </section>
    </div>
  </dialog>
  <p class="pbn-commerce-status" role="status" aria-live="polite" data-shop-status></p>
</div>
<style>.pbn-commerce-lang-hi,.pbn-commerce-lang-hi :is(h2,h3,p,a,button,span,strong,li){font-family:AnekHindi,sans-serif}.pbn-commerce-lang-te,.pbn-commerce-lang-te :is(h2,h3,p,a,button,span,strong,li){font-family:AnekTelugu,sans-serif}</style>
<script is:inline src="/pinnacle-pages-scripts/book-commerce.js" defer></script>
