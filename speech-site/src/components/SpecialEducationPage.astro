---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSlider from './HeroSlider.astro';
import ActionStrip from './ActionStrip.astro';
import Icon from './Icon.astro';
import '../styles/special-education.css';
import TherapyTogether from './TherapyTogether.astro';
import CentreDirectory from './CentreDirectory.astro';
import EvidenceLinks from './EvidenceLinks.astro';
import { Image } from 'astro:assets';
import emblem from '../assets/pinnacle-emblem-official.png';
import learningCreative from '../assets/special-education-creative-20261005.png';
import shareCard from '../assets/special-education-share-20260929.jpg';
import { specialEducationContent as content, specialEducationEnquiry } from '../data/special-education-content';
import { proofCards } from '../data/speech';
import { phone, url } from '../data/site';

const conversationLens = [
  ['book','The learning moment','What is the child being asked to understand, communicate or do?'],
  ['sun','Strengths and interests','What already makes engagement, attention or participation easier?'],
  ['voice','Communication access','How does the child understand instructions, ask for help and show choices?'],
  ['home','Activity and environment','Do the steps, materials, pace, sensory conditions or setting create a barrier?'],
  ['people','Family and teacher knowledge','What do the adults who know the child notice across everyday settings?'],
  ['compass','A useful direction','What change would make learning or participation more possible in daily life?']
];
const exampleSteps = [
  ['What the child already does','With one familiar object and its matching picture in view, the child points to the match after the educator names it. This is an observed strength with adult support.'],
  ['Where the activity stops','With six pictures on a worksheet and three spoken instructions together—find, circle, then put away—the child looks between the sheet and the adult and stops. The observation does not tell us why.'],
  ['The barrier to investigate','The educator first checks whether the number of choices and instruction sequence make access harder. This is a working explanation to test, not a label for the child.'],
  ['The adaptation we choose','Keep the same familiar matching goal. Present two large picture cards, say “Point to the ball” and accept pointing as the response. Offer time, help and a way to pause.']
];
const stageLinks = ['/abilityscore','/prognose','/therapeuticai','/everyday-therapy','/fusion-module','/reassess-review-repeat','/mainstream'];
const stageLabels = ['AbilityScore®','Readiness & planning','TherapeuticAI®','Everyday Therapy','Fusion: track & correct','Reassessment','Mainstream participation'];
const disciplines = [
  ['book','Special educator','Adapts teaching, learning materials, activities and support around the educational need.'],
  ['voice','Speech and communication','Supports ways to understand, express, ask, answer and participate when indicated.'],
  ['home','Occupational therapy','Considers activities, materials, routines, sensory-motor access and environments.'],
  ['heart','Behavioural support','Helps understand patterns and build useful, respectful participation abilities.'],
  ['people','Family and teacher','Bring priorities and observations from the child’s everyday learning settings.'],
  ['shield','Relevant professionals','Contribute health, psychological or other expertise when the child-specific need indicates it.']
];
---
<PageLayout path={content.path} label={content.label} serviceName={content.name} serviceType={content.type} title={content.title} description={content.description} citations={content.citations} faqs={content.faqs} imageAlt="Pinnacle Blooms Special Education: learning, communication and participation connected to the child’s life. Call 9100 181 181." imageCaption="Special education support connected to learning access, participation and the child’s wider life at Pinnacle Blooms Network." shareImage={shareCard} publishedOn="2026-09-29" updatedOn="2026-10-05" enquiry={content.enquiry}>
  <HeroSlider content={content} /><ActionStrip focused firstLabel="First conversation" firstHref="#first-conversation" evidenceHref="#evidence" enrolHref={specialEducationEnquiry} />

  <section class="section wrap service-fit special-fit" id="service-fit" aria-labelledby="special-fit-title">
    <div class="fit-heading"><p class="eyebrow">Start with the learner, the moment and the life ahead</p><h2 id="special-fit-title">Where should learning<br/><em>become more possible?</em></h2></div>
    <p class="occupational-intro">Special education is more than finishing a worksheet. It helps make teaching and learning accessible to the individual child—and connects a developing ability with communication, school participation and everyday life.</p>
    <div class="concern-grid special-concern-grid">{content.concerns.map(concern=><article><span class="concern-icon"><Icon name={concern.icon} size={30}/></span><h3>{concern.title}</h3><p>{concern.copy}</p></article>)}</div>
    <aside class="special-direct-answer"><Icon name="book" size={36}/><div><p class="eyebrow">A direct answer</p><h3>What is special education support?</h3><p>It is child-specific educational support. A professional may adapt teaching, communication, materials, activities, pace or the learning environment so the child can access learning and participate. Assessment guides what is appropriate.</p></div><a href="https://www.unesco.org/en/inclusion-education">Read UNESCO on removing barriers to learning ↗</a></aside>
    <p class="source-note">UNESCO and UNICEF explain inclusive education and access to learning; they do not endorse Pinnacle or establish a particular professional’s credentials.</p>
    <div class="assessment-route"><a href="#first-conversation"><Icon name="clock"/>First conversation</a><a href="#learning-example"><Icon name="people"/>See one learning example</a><a href="#centres"><Icon name="pin"/>Find a centre</a></div>
  </section>

  <section class="section aba-first special-first" id="first-conversation" aria-labelledby="special-first-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">Bring one learning moment</p><h2 id="special-first-title">We listen for what matters.<br/><em>Then examine access and participation.</em></h2></div><p>You do not need to choose a therapy before you call. Tell us what your child is trying to understand, communicate or do—and what you would like to become more possible at home, in learning or at school.</p></div>
    <div class="aba-lens-grid">{conversationLens.map(([icon,title,text])=><article><span><Icon name={icon} size={27}/></span><h3>{title}</h3><p>{text}</p></article>)}</div>
    <div class="technology-bridge"><Icon name="shield" size={30}/><p><strong>Know what you are coming for.</strong> We’ll confirm the suitable professional, centre, appointment and fees. Bring one example of your child’s learning, and any reports you already have. The first visit helps clarify the learning need and next step; it is separate from school admission.</p></div>
    <div class="special-visit-steps"><article><span>01</span><h3>Tell us about your child</h3><p>Describe one learning moment and the ability you want your child to use.</p></article><article><span>02</span><h3>Confirm the first visit</h3><p>Understand the professional, location, appointment and fees before deciding.</p></article><article><span>03</span><h3>Agree what to work toward</h3><p>Discuss the learning priority, useful support, your role and how the next step will be reviewed.</p></article></div><div class="aba-first-actions"><a class="button primary" href={phone.href}><Icon name="phone"/>Call {phone.display}</a><a class="button outline" href={specialEducationEnquiry}>Arrange a first conversation <Icon name="arrow"/></a></div>
  </div></section>

  <section class="section occupational-example special-example" id="learning-example" aria-labelledby="special-example-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">One learning example · Start with what your child can do</p><h2 id="special-example-title">The child knows the match.<br/><em>Let’s make the next step accessible.</em></h2></div><p>A five-year-old enjoys matching familiar objects. A crowded worksheet and several instructions arrive together—and the activity stops. We look at the teaching and support, then choose a clearer way to begin.</p></div>
    <figure class="special-creative"><Image src={learningCreative} widths={[480,800,1200,1672]} sizes="(min-width:1360px) 1280px, calc(100vw - 36px)" width={1672} height={941} format="webp" quality={82} loading="lazy" decoding="async" alt="Pinnacle Blooms Network special education creative: Learning that opens up life. A child chooses between picture cards with an educator and parent; linked home and classroom scenes show supported participation. Call 9100 181 181."/><figcaption>Understand · Adapt · Participate · Review. A child-specific plan connected with home, learning and life.</figcaption></figure>
    <p class="source-note">Illustrative learning example; not a patient report or an individual teaching prescription.</p>
    <aside class="special-chosen-step"><Icon name="plan" size={30}/><div><h3>The chosen next step</h3><p><strong>Two clear choices. One instruction. A response the child can use.</strong> We simplify the presentation while keeping the matching goal. The next observation will tell us whether this support helps.</p></div></aside>
    <ol class="aba-cycle special-cycle">{exampleSteps.map(([title,text],i)=><li><span>{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
    <div class="special-checkpoint"><p class="eyebrow">The next response is not yet observed</p><h3>Does the simpler presentation help the child take part?</h3><p>Notice the child's choice, comfort and response, the time offered and any adult cue. A point after an adult prompt is useful information—it is not an independent response.</p><div class="special-review-branches"><article><Icon name="sun"/><h4>If the child chooses with this support</h4><p>Keep the accessible format, record the help still needed and review the next small step with the educator. Do not assume the ability has transferred to a worksheet or classroom.</p></article><article><Icon name="heart"/><h4>If the child pauses or turns away</h4><p>Respect the pause. Revisit communication, comfort, materials and the goal with the professional; another discipline may contribute where indicated. More pressure is not the next step.</p></article></div></div>
    <div class="special-example-actions"><a class="button primary" href={phone.href}><Icon name="phone"/>Talk about your child's learning</a><a href={url('/fusion-module')}>How observations shape the next decision →</a></div>
  </div></section>

  <section class="section wrap difference special-difference" id="pinnacle-difference" aria-labelledby="special-difference-title">
    <div class="story-heading"><p class="eyebrow">Seven connected stages · One life in view</p><h2 id="special-difference-title">Do not stop at completing the task.<br/><em>Build the ability the child can use.</em></h2><p>A brick matters because it helps form a home. A lesson, activity or teaching technique gains its direction from the life your child is growing toward. That direction helps organise what to understand, what to teach, who to involve, where to practise and what to review.</p></div>
    <p class="life-purpose-line">The life we work toward: <strong>growing self-sufficiency · mainstream participation · a wonderful life.</strong></p>
    <ol class="life-path special-stage-grid">{content.pathway.stages.map(([icon,title,text],i)=><li><div class="path-symbol"><span class="care-number">{i+1}</span><Icon name={icon} size={32}/></div><div><h3>{title}</h3><p>{text}</p><a href={url(stageLinks[i])}>{stageLabels[i]} <Icon name="arrow" size={18}/></a></div></li>)}</ol>
    <div class="special-system-route"><Icon name="loop" size={32}/><p><strong>One child's life gives these steps their direction.</strong> A useful lesson should become a way to understand, choose, communicate or participate. Family and teacher observations help us decide what should happen next.</p><a href={url('/pinnacleai')}>Explore the PinnacleAI system →</a></div>
    <div class="special-paradigm-links"><a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Read the documented life-first approach <Icon name="arrow"/></a><EvidenceLinks group="practice" label="See how goals, practice and feedback connect"/></div>
    <p class="source-note">This is Pinnacle’s programme direction. “Toward” describes the purpose of planning and review; it is not a guarantee of independence, school admission, mainstream inclusion or a particular result.</p>
  </section>

  <section class="section wrap occupational-family special-family" id="family-school" aria-labelledby="special-family-title"><div><p class="eyebrow">Family and teacher knowledge belongs in the plan</p><h2 id="special-family-title">The learning session sees one moment.<br/><em>You see the rest of the day.</em></h2><p>Parents, caregivers and teachers can show the team where learning becomes possible, where it breaks down and what support the child still needs. Those observations help review the next step without turning home into a test or blaming the family.</p><EvidenceLinks group="practice" label="How family observations shape the next step"/></div><div class="occupational-family-cards"><article><Icon name="home"/><h3>At home</h3><p>Use manageable moments that fit family life and the agreed educational direction.</p></article><article><Icon name="book"/><h3>At school</h3><p>With appropriate consent, share useful observations about instructions, activities and participation.</p></article><article><Icon name="loop"/><h3>Back in review</h3><p>Use what happened to refine the goal, teaching, material, environment or support.</p></article></div></section>

  <section class="section wrap aba-team special-team" id="integrated-support" aria-labelledby="special-team-title">
    <div class="split-heading"><div><p class="eyebrow">One child. Distinct contributions. One shared direction.</p><h2 id="special-team-title">Learning access may connect<br/><em>with a larger picture.</em></h2></div><p>The child-specific need determines which people and supports are relevant. Every child does not need every therapy, and one discipline should not silently replace another.</p></div>
    <div class="aba-discipline-grid">{disciplines.map(([icon,title,text])=><article><span><Icon name={icon} size={28}/></span><h3>{title}</h3><p>{text}</p></article>)}</div>
  </section>

  <section class="section aba-review special-review" id="measurement-and-review" aria-labelledby="special-review-title"><div class="wrap aba-review-grid">
    <div><p class="eyebrow">Measurement with the child’s life still in view</p><h2 id="special-review-title">PinnacleAI supports review.<br/><em>People remain responsible for education and care.</em></h2><p>PinnacleAI GPT-OS v1.0.0 supports developmental ability measurement, readiness tracking, progress forecasting and adaptive plan support within its licensed non-diagnostic scope for children aged 0–12. Educators are among its intended users; professionals and families interpret the information and make decisions.</p><div class="aba-proof-links"><a href={url('/verify/evidence/records/md5.html')}>Inspect the MD-5 licensed scope ↗</a><a href={url('/verify/evidence/records/bis.html')}>Inspect the BIS schedule and limits ↗</a><a href={url('/verify/evidence/research-library.html')}>Inspect research status and methods ↗</a></div></div>
    <aside class="aba-observation"><Icon name="loop" size={34}/><p class="eyebrow">Bring these questions into review</p><h3>Is the child accessing and using the learning?</h3><ul><li>What could the child understand or do?</li><li>What helped the child communicate or participate?</li><li>Which instruction, material or environment worked?</li><li>What support was still needed?</li><li>Did the ability appear in another relevant setting?</li><li>What should the team change next?</li></ul></aside>
  </div></section>

  <TherapyTogether current="education" />

  <section class="section evidence-section" id="evidence" aria-labelledby="special-evidence-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">Confidence you can inspect</p><h2 id="special-evidence-title">Hope with direction.<br/><em>Claims with a visible source trail.</em></h2></div><p>Pinnacle publishes source documents, status labels and limits. Licences define the software and management-system scope; they do not certify a special educator, school admission or an individual educational outcome.</p></div>
    <div class="evidence-cards">{proofCards.map(card=><article><span class="proof-icon"><Icon name={card.title.startsWith('Class')?'shield':card.title.startsWith('BIS')?'plan':'book'} size={35}/></span><span class="card-tag">{card.tag}</span><h3>{card.title}</h3><p>{card.text}</p><span class="record-reference">{card.ref}</span><a class="text-link" href={url(card.link)}>{card.label} <Icon name="arrow"/></a></article>)}</div>
    <div class="aba-source-grid special-source-grid"><article><h3>Remove barriers to learning</h3><p>UNESCO describes inclusion as identifying and removing barriers across curriculum, pedagogy and teaching.</p><a href="https://www.unesco.org/en/inclusion-education">UNESCO inclusion in education ↗</a></article><article><h3>Learning and participation together</h3><p>UNICEF describes inclusive education as real learning opportunities and children learning together.</p><a href="https://www.unicef.org/education/inclusive-education">UNICEF inclusive education ↗</a></article><article><h3>Ask about professional registration</h3><p>RCI publishes its recognized rehabilitation-professional categories and Central Rehabilitation Register pathway. Families can ask for the professional’s current qualification and registration where applicable.</p><a href="https://rehabcouncil.nic.in/categories-u-s-19/">Rehabilitation Council of India ↗</a></article></div>
    <div class="special-provider-check"><Icon name="shield" size={34}/><div><p class="eyebrow">Four questions before you choose</p><h3>Ask what the professional will understand, teach and review.</h3><ol><li>What qualification and current registration applies to this professional?</li><li>What child-specific learning or participation goal are we agreeing?</li><li>How will family and teacher observations be used?</li><li>When will we review progress and adjust the plan?</li></ol></div></div>
    <div class="aba-transparency"><a href={url('/verify/')}><Icon name="shield"/>Verify evidence library</a><a href={url('/verify/evidence/records/appreciations.html')}><Icon name="book"/>Government source letters</a><a href={url('/verify/evidence/records/awards.html')}><Icon name="sun"/>Awards and stage records</a><a href={url('/verify/evidence/cite.html')}><Icon name="link"/>Cite Pinnacle sources</a></div>
    <p class="source-note">External education sources explain applicable principles and do not endorse Pinnacle. Government letters retain their stated context; they are not presented as educational or clinical endorsement. Award and nomination records retain their documented stage.</p>
    <p class="source-note source-downloads"><a href={'https://wa.me/?text='+encodeURIComponent('Special Education at Pinnacle Blooms Network — learning connected to life. '+url(content.path))} target="_blank" rel="noopener noreferrer">Share with your family on WhatsApp</a> · <a href="/pinnacle-pages-data/special-education-machine.md">Readable page and sources</a> · <a href="/pinnacle-pages-data/special-education-evidence.txt">Claims and sources for this page</a> · <a href="/pinnacle-pages-data/special-education-evidence.json">Download source map (JSON)</a></p>
  </div></section>

  <CentreDirectory pagePath={content.path} enquiryTarget={specialEducationEnquiry} compact serviceNotice="Call to confirm the special educator, current service availability, appointment and fees. These are published centre listings, not a verified special-education staffing roster."/>

  <section class="section wrap faq-section" id="questions" aria-labelledby="special-faq-title"><div><p class="eyebrow">Before you decide</p><h2 id="special-faq-title">Clear answers.<br/><em>A child-specific first step.</em></h2><a class="text-link" href="https://www.unicef.org/education/inclusive-education">Inclusive education · UNICEF ↗</a></div><div>{content.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></section>

  <section class="final-cta" id="next-step" aria-labelledby="special-next-title"><div class="wrap"><div class="close-sun official-close"><Image src={emblem} width={96} height={96} format="webp" loading="lazy" alt="Pinnacle official pinwheel emblem"/></div><p class="eyebrow">Every Child Counts®</p><h2 id="special-next-title">Start with one learning moment<br/>you want to become more possible.</h2><p>Tell us what your child is trying to understand, communicate or do.<br/>We’ll help you find a suitable centre and first professional conversation.</p><div class="final-actions"><a class="button white" href={phone.href}><Icon name="phone"/>Call {phone.display}</a><a class="button light-outline" href={specialEducationEnquiry}>Start a conversation <Icon name="arrow"/></a></div><div class="close-moments"><span><Icon name="book"/>A lesson to access.</span><span><Icon name="voice"/>A way to ask for help.</span><span><Icon name="people"/>A life to take part in.</span></div><p class="final-guidance">Free guidance, 24/7 · Service, professional, appointment and fees confirmed by the team.</p><a class="helpline-link" href={url('/national-autism-helpline')}>Pinnacle / BHCL National Autism Helpline →</a></div></section>
</PageLayout>
