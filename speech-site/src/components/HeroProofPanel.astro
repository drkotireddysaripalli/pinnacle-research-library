---
import { Image } from 'astro:assets';
import emblem from '../assets/pinnacle-emblem-official.png';
import { url } from '../data/site';
const { compact = false } = Astro.props;
---
<aside class:list={['hero-proof-panel',{'hero-proof-compact':compact}]} aria-label="Pinnacle evidence shortcuts">
  <a class="hero-proof-brand" href={url('/verify/')}>
    <Image src={emblem} width={54} height={54} format="webp" alt="Pinnacle official pinwheel emblem" />
    <span><strong>Pinnacle Verify</strong><small>Evidence you can inspect</small></span>
  </a>
  <div class="hero-proof-links">
    <a href={url('/verify/evidence/records/md5.html')}><strong>Class B SaMD</strong><span>MD-5 licence</span></a>
    <a href={url('/verify/evidence/records/bis.html')}><strong>BIS IS 23485</strong><span>Licensed scope</span></a>
    <a href={url('/verify/evidence/cite.html')}><strong>36 records</strong><span>Cite &amp; download</span></a>
  </div>
</aside>
