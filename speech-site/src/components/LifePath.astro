---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ServiceContent } from '../data/service-content';
interface Props { pathway: ServiceContent['pathway'] }
const { pathway } = Astro.props;
const stages = pathway.stages;
---
<div class="life-path-story">
  <ol class="life-path">{stages.map(([icon,title,text],i)=><li><div class="path-symbol"><span class="care-number">{i+1}</span><Icon name={icon} size={39} /></div><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
  <div class="path-review"><Icon name="loop" size={25} /><p><strong>Your child’s needs guide the pace.</strong> Your family helps shape the plan. Reassessment brings us back to what matters next.</p></div>
  <figure class="life-horizon"><Image src={pathway.image} widths={[480,800,1200,1600]} sizes="(min-width: 1360px) 1280px, calc(100vw - 36px)" width={1600} height={900} format="webp" quality={78} alt={pathway.alt} loading="lazy" decoding="async" /><div class="life-horizon-labels"><span><Icon name="home" />At home</span><span><Icon name="people" />With other people</span><span><Icon name="book" />In school</span></div></figure>
</div>
