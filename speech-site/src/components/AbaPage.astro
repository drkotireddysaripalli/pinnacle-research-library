---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSlider from './HeroSlider.astro';
import ActionStrip from './ActionStrip.astro';
import Icon from './Icon.astro';
import CentreDirectory from './CentreDirectory.astro';
import { Image } from 'astro:assets';
import emblem from '../assets/pinnacle-emblem-official.png';
import communicationJourney from '../assets/aba-transition-choice-20260930.png';
import reviewArtwork from '../assets/aba-family-review-20260930.png';
import abaSocial from '../assets/aba-social-life-first-20260930.png';
import { abaContent as content, abaEnquiry } from '../data/aba-content';
import { phone, url } from '../data/site';
const whatsappShare='https://wa.me/?text='+encodeURIComponent('ABA therapy and behavioural support for everyday life · Pinnacle Blooms Network\n'+url(content.path));

const firstCallSteps=[
  ['people','Tell us one moment','What happened, how did your child communicate and what matters to your family?'],
  ['shield','Check the right starting point','The team helps check a suitable professional, location, appointment and current fees.'],
  ['compass','Decide together','At a professional visit, discuss what to understand next and whether behavioural support fits.']
];

const assessmentLens = [
  ['voice','Communication','How the child expresses needs, refusal, discomfort, help or a break.'],
  ['heart','Health and wellbeing','Whether pain, sleep, anxiety or another health need may require appropriate review.'],
  ['home','Environment','Noise, sensory demands, predictability, task demands, routines and available choices.'],
  ['people','People and patterns','What happens before, during and after the moment across relevant settings.'],
  ['sun','Strengths and interests','What the child already does successfully and what helps engagement.'],
  ['book','Family and school knowledge','What parents, caregivers and teachers notice in everyday life.']
];
const exampleSteps = [
  ['Start with what the child shows','Imagine a child who points to choose blocks, but covers their ears and moves away when a noisy group activity begins. The family wants their child to be heard and feel able to join play.'],
  ['Make the request accessible','After checking contributing needs, the professional and family agree a familiar gesture or picture for “break”. Adults recognise that request and offer a quieter space; a break is not earned by complying first.'],
  ['Describe what happened, including help','In this illustration, the child uses the break picture after an adult points to it, takes a pause and later chooses blocks beside one peer. The record includes the adult cue and quieter setting.'],
  ['Let that observation change the next step','The team keeps the cue available and plans another supported opportunity in a familiar routine. It has not yet established an independent request or comfortable participation in a noisy group.']
];
const stageLinks=[['/abilityscore','AbilityScore®'],['/prognose','Readiness and planning'],['/autism-therapy','Integrated therapies'],['/everyday-therapy','Everyday Therapy'],['/fusion-module','Track & correct'],['/reassess-review-repeat','Reassess'],['/self-sufficient','Self-sufficient life']];
const reviewBranches=[
  ['track','A request works with support','Record the cue, setting and response. Keep the useful support and review whether the request becomes accessible across another relevant routine. Independence is a separate observation.'],
  ['heart','Discomfort or difficulty continues','Pause the demand and revisit communication, health, sensory and environmental factors with the relevant professional. Change the plan or seek another assessment rather than simply repeat the task.']
];
const abaProof=[
  {icon:'shield',tag:'Licensed support technology',title:'Class B · non-diagnostic',text:'Form MD-5 lists PinnacleAI GPT-OS v1.0.0 as developmental-support software. It does not license ABA practice or guarantee a child’s outcome.',link:'/verify/evidence/records/md5.html',label:'Inspect the MD-5 scope'},
  {icon:'measure',tag:'Published software scope',title:'BIS · named modules',text:'The BIS record describes the named PinnacleAI software and modules. It does not certify a behavioural professional, centre or therapy result.',link:'/verify/evidence/records/bis.html',label:'Inspect the BIS record'},
  {icon:'book',tag:'Research trail',title:'Status beside every source',text:'Explore original publications and summaries with their actual study and publication status. A listed study is not a promised result for your child.',link:'/verify/evidence/research-library.html',label:'Explore the research library'}
];
const disciplines = [
  ['heart','ABA / behavioural support','Understand observable patterns and develop useful, acceptable alternatives.'],
  ['voice','Speech and communication','Support ways to express needs, preferences, choices and ideas.','/top-speech-therapy-center-india-proven-improvement-rate'],
  ['home','Occupational therapy','Consider routines, activities, sensory-motor access and environments.','/best-occupational-therapy-center-india-proven-improvement-rate'],
  ['book','Special education','Support learning access, classroom participation and educational abilities.','/best-special-education-center-call-9100181181'],
  ['people','Family and school','Contribute priorities and observations from the child’s daily life.'],
  ['shield','Relevant health professionals','Examine medical or mental-health factors when indicated.']
];
---
<PageLayout path={content.path} label={content.label} serviceName={content.name} serviceType={content.type} serviceAreaServed={null} title={content.title} description={content.description} socialTitle="ABA Therapy for Children | Understand First | Pinnacle Blooms" socialDescription="Communication, choice and everyday participation guide respectful behavioural support. Call 9100 181 181." citations={content.citations} faqs={content.faqs} imageAlt="Pinnacle Blooms Network ABA Therapy: a child makes a choice with family and professional support. Call 9100 181 181." imageCaption="ABA and behavioural support connected to communication, choice and everyday life at Pinnacle Blooms Network." shareImage={abaSocial} shareVersion="20260930-aba-life-first" publishedOn="2026-09-29" updatedOn="2026-10-05" enquiry={content.enquiry}>
  <HeroSlider content={content} /><ActionStrip focused firstLabel="First conversation" firstHref="#first-visit" evidenceHref="#evidence" enrolHref={abaEnquiry} />

  <section class="section wrap service-fit aba-fit" id="service-fit" aria-labelledby="aba-fit-title">
    <div class="fit-heading"><p class="eyebrow">ABA therapy · A child’s life gives the goal direction</p><h2 id="aba-fit-title">Understand the moment. <em>Then choose a goal that matters.</em></h2></div>
    <aside class="aba-direct-answer"><Icon name="book" size={34}/><div><p class="eyebrow">What is ABA therapy for children?</p><h3>Observation and learning, in service of everyday life.</h3><p>Applied Behavior Analysis, also written Applied Behaviour Analysis, uses observation and learning principles to understand behaviour and support useful abilities. The right goal is chosen with the child and family, should help communication, safety or participation, and needs review in daily life.</p></div><a href="https://www.cdc.gov/autism/treatment/index.html">Read the CDC treatment overview ↗</a></aside>
    <p class="source-note">Individual assessment and professional judgement guide whether behavioural support is appropriate. The CDC explains approaches and progress measurement; it does not endorse a provider.</p>
    <p class="aba-intro">A child moving away from a busy transition may need a way to say “break”, a calmer setting or a different plan. Communication, health, sensory and environmental factors belong in the conversation before a goal is chosen.</p>
    <div class="concern-grid">{content.concerns.map(concern=><article><span class="concern-icon"><Icon name={concern.icon} size={30}/></span><h3>{concern.title}</h3><p>{concern.copy}</p></article>)}</div>
    <div class="assessment-route"><a href="#first-visit"><Icon name="clock"/>What happens when you call?</a><a href="#everyday-example"><Icon name="people"/>Explore an everyday example</a><a href="#centres"><Icon name="pin"/>Find a centre</a></div>
  </section>

  <section class="section aba-first" id="first-visit" aria-labelledby="aba-first-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">Free guidance by phone · 24/7</p><h2 id="aba-first-title">Tell us one everyday moment. <em>We’ll help find the right starting point.</em></h2></div><p>You do not need to decide whether ABA is right before calling. Tell us what happens, what seems to help and what you hope can become easier. The team can check a suitable professional, centre, appointment and current fees before you travel.</p></div>
    <ol class="aba-first-steps">{firstCallSteps.map(([icon,title,text],i)=><li><span>{i+1}</span><Icon name={icon} size={26}/><h3>{title}</h3><p>{text}</p></li>)}</ol>
    <div class="aba-visit-expectation"><Icon name="people" size={30}/><div><h3>After the call: meet, understand, decide.</h3><p>Before a visit, the team confirms the location, professional, appointment and fees. At the visit, share an everyday example and any relevant reports you already have. The professional may observe your child’s communication, play or routine, discuss what needs further assessment and explain the proposed next step. Ask what the goal is, how it will be reviewed and what you can realistically practise at home before deciding.</p></div></div>
    <details class="aba-lens-disclosure"><summary>What a professional may look at when planning support <span aria-hidden="true">+</span></summary><div class="aba-lens-grid">{assessmentLens.map(([icon,title,text])=><article><span><Icon name={icon} size={27}/></span><h3>{title}</h3><p>{text}</p></article>)}</div></details>
    <div class="technology-bridge"><Icon name="shield" size={30}/><p><strong>A safety boundary.</strong> Behavioural support should not replace assessment of pain, health, mental-health, communication, sensory or environmental factors. Relevant professionals should be involved when indicated. <a href="https://www.nice.org.uk/guidance/cg170/chapter/recommendations">Read NICE recommendations 1.4.7–1.4.9 ↗</a></p></div>
    <div class="aba-first-actions"><a class="button primary" href={phone.href} data-cta="aba-first-call"><Icon name="phone"/>Call {phone.display}</a><a class="button outline" href="#centres" data-cta="aba-first-centres">Find a centre <Icon name="arrow"/></a></div>
    <p class="source-note">The telephone guidance is free; ordinary network call charges may apply. A centre visit or therapy has separately confirmed fees.</p>
  </div></section>

  <section class="section aba-example" id="everyday-example" aria-labelledby="aba-example-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">One everyday example · Let the child’s voice lead</p><h2 id="aba-example-title">A difficult transition. <em>A way to say “break”.</em></h2></div><p>Suppose a busy transition feels difficult. The useful question is what this child may need and how adults can respond—not how quickly the child can be made to comply.</p></div>
    <figure class="aba-story"><Image src={communicationJourney} widths={[480,800,1200,1680]} sizes="(min-width:1360px) 1280px, calc(100vw - 36px)" width={communicationJourney.width} height={communicationJourney.height} format="webp" quality={82} loading="lazy" decoding="async" alt="A child communicates a need for a pause while his mother and a white-coated professional respond, then chooses a play activity with a peer."/><figcaption>Illustrative process: the child communicates a choice, adults respond and the team reviews participation.</figcaption></figure>
    <ol class="aba-cycle">{exampleSteps.map(([title,text],i)=><li><span>{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
    <div class="aba-next-decision" role="region" aria-labelledby="aba-decision-title"><p class="eyebrow">The next decision follows the child’s response</p><h3 id="aba-decision-title">A quieter moment is useful. <em>Understanding why it helped is useful too.</em></h3><div class="aba-review-branches">{reviewBranches.map(([icon,title,text])=><article><Icon name={icon} size={28}/><h4>{title}</h4><p>{text}</p></article>)}</div><p><strong>Still to be observed:</strong> what happens in the next routine, with which adult support, and whether the child’s communication and comfort carry over. This is an illustrative learning process, not a reported patient outcome.</p></div>
    <p class="source-note">This example explains how a conversation may work. The professional decides the suitable assessment and support with the family; it is not an individual treatment plan or promised result.</p>
  </div></section>

  <section class="section wrap difference aba-difference" id="pinnacle-difference" aria-labelledby="aba-difference-title">
    <div class="story-heading"><p class="eyebrow">The PinnacleAI® life-first direction</p><h2 id="aba-difference-title">A technique is a step. <em>Your child’s life gives it direction.</em></h2><p>Start with what your child should be able to communicate and do in their own life. That purpose helps choose what to understand, the suitable people and methods, where to practise and what to review. A behaviour count alone is not the destination.</p></div>
    <p class="life-purpose-line">The life we work toward: <strong>growing self-sufficiency · mainstream participation · a wonderful life.</strong></p>
    <ol class="aba-stage-grid">{content.pathway.stages.map(([icon,title,text],i)=><li><span class="aba-stage-icon"><b>{i+1}</b><Icon name={icon} size={29}/></span><h3>{title}</h3><p>{text}</p><a class="text-link" href={url(stageLinks[i][0])}>{stageLinks[i][1]} <Icon name="arrow" size={18}/></a></li>)}</ol>
    <div class="aba-paradigm-links"><a class="text-link" href={url('/verify/evidence/pinnacle-paradigm-shift.html')}>Read the documented life-first approach <Icon name="arrow"/></a><a class="text-link" href={url('/verify/evidence/paradigm/06-feedback-that-shapes-care.html')}>See how family observations shape review <Icon name="arrow"/></a></div>
    <p class="source-note">Explore <a href="/pinnacleai">the whole PinnacleAI system</a> and its <a href="/mainstream">mainstream-inclusion direction</a>. The programme is built around individual needs and reviewed progress; independence, school entry and outcomes vary by child.</p>
  </section>

  <section class="section wrap aba-team" id="integrated-support" aria-labelledby="aba-team-title">
    <div class="split-heading"><div><p class="eyebrow">One child. Distinct contributions. One shared direction.</p><h2 id="aba-team-title">Behaviour may be one part<br/><em>of a larger picture.</em></h2></div><p>The child-specific plan determines which professionals and supports are relevant. Every child does not need every therapy, and one discipline should not silently take the place of another. <a href={url('/autism-therapy')}>See how autism support can connect them.</a></p></div>
    <div class="aba-discipline-grid">{disciplines.map(([icon,title,text,href])=><article><span><Icon name={icon} size={28}/></span><h3>{href?<a href={url(href)}>{title}</a>:title}</h3><p>{text}</p></article>)}</div>
  </section>

  <section class="section aba-review" id="measurement-and-review" aria-labelledby="aba-review-title"><div class="wrap aba-review-grid">
    <div><p class="eyebrow">Measurement with the child’s life still in view</p><h2 id="aba-review-title">PinnacleAI supports review.<br/><em>People remain responsible for care.</em></h2><p>PinnacleAI GPT-OS v1.0.0 supports developmental ability measurement, readiness tracking, progress forecasting and adaptive plan support within its licensed non-diagnostic scope. Professionals and families interpret the information and make care decisions.</p><div class="aba-proof-links"><a href={url('/verify/evidence/records/md5.html')}>Inspect the MD-5 licensed scope ↗</a><a href={url('/verify/evidence/records/bis.html')}>Inspect the BIS schedule and limits ↗</a><a href={url('/verify/evidence/research-library.html')}>Inspect research status and methods ↗</a></div></div>
    <aside class="aba-observation"><Icon name="loop" size={34}/><p class="eyebrow">Bring these questions into review</p><h3>Your child’s voice and your family’s knowledge belong here.</h3><ul><li>What mattered to the child?</li><li>How did the child communicate choice, refusal or discomfort?</li><li>What happened more easily?</li><li>What support was still needed?</li><li>Did it work in another relevant setting?</li><li>What should the team change next?</li></ul></aside>
    <figure class="aba-review-art"><Image src={reviewArtwork} widths={[480,800,1200,1680]} sizes="(min-width:1360px) 1280px, calc(100vw - 36px)" width={reviewArtwork.width} height={reviewArtwork.height} format="webp" quality={80} loading="lazy" decoding="async" alt="A mother observes her child choosing an activity at home, then discusses the observation with a white-coated professional while her child plays nearby."/><figcaption><Image src={emblem} width={34} height={34} format="webp" alt=""/>What a family notices in daily life helps shape the next professional review.</figcaption></figure>
  </div></section>

  <section class="section evidence-section" id="evidence" aria-labelledby="aba-evidence-title"><div class="wrap">
    <div class="split-heading"><div><p class="eyebrow">Confidence you can inspect</p><h2 id="aba-evidence-title">Know the approach. <em>Check the sources.</em></h2></div><p>Pinnacle publishes original records with status and limits. They establish the organisation’s documented approach and the named software’s scope; they do not certify a local ABA professional or predict your child’s result.</p></div>
    <div class="evidence-cards">{abaProof.map(card=><article><span class="proof-icon"><Icon name={card.icon} size={35}/></span><span class="card-tag">{card.tag}</span><h3>{card.title}</h3><p>{card.text}</p><a class="text-link" href={url(card.link)}>{card.label} <Icon name="arrow"/></a></article>)}</div>
    <div class="aba-source-grid"><article><h3>Functional, measurable support</h3><p>NICE describes functional assessment, environmental factors, quality-of-life-linked outcomes, before-and-after measurement and agreement across the people involved.</p><a href="https://www.nice.org.uk/guidance/cg170/chapter/recommendations">NICE CG170 recommendations ↗</a></article><article><h3>Behaviour, communication and learning</h3><p>The CDC explains behavioural, developmental and educational approaches, including ABA, and describes tracking and measuring progress.</p><a href="https://www.cdc.gov/autism/treatment/index.html">US Centers for Disease Control and Prevention ↗</a></article><article><h3>Independence and participation</h3><p>WHO describes rehabilitation as person- and family-centred support for functioning, independence and participation in education and community life.</p><a href="https://www.who.int/news-room/fact-sheets/detail/rehabilitation">World Health Organization ↗</a></article></div>
    <div class="aba-transparency"><a href={url('/verify/')}><Icon name="shield"/>Verify evidence library</a><a href={url('/verify/evidence/centre-entity-reference.html')}><Icon name="pin"/>Centre identity sources</a><a href={url('/verify/evidence/cite.html')}><Icon name="link"/>Cite Pinnacle sources</a></div>
    <p class="source-note">NICE, the CDC and WHO explain relevant principles. Their publications do not endorse Pinnacle or verify a specific centre’s service or results.</p>
    <p class="source-note source-downloads"><a href="/pinnacle-pages-data/aba-therapy-evidence.txt">Claims and sources for this page</a> · <a href="/pinnacle-pages-data/aba-therapy-evidence.json">Download source map (JSON)</a></p>
  </div></section>

  <CentreDirectory compact pagePath={content.path} enquiryTarget={abaEnquiry} serviceNotice="These are published Pinnacle network locations. Call to confirm current ABA support, the appropriate professional, appointment and fees at your chosen centre before you travel."/>

  <section class="section wrap faq-section" id="questions" aria-labelledby="aba-faq-title"><div><p class="eyebrow">Before you decide</p><h2 id="aba-faq-title">Clear answers.<br/><em>A respectful first step.</em></h2><a class="text-link" href="https://www.nice.org.uk/guidance/cg170/chapter/recommendations">Functional assessment and support · NICE ↗</a></div><div>{content.faqs.map(f=><details><summary>{f.question}<span aria-hidden="true">+</span></summary><p>{f.answer}</p></details>)}</div></section>

  <section class="final-cta aba-final" id="next-step" aria-labelledby="aba-next-title"><div class="wrap"><div class="close-sun official-close"><Image src={emblem} width={96} height={96} format="webp" loading="lazy" alt="Pinnacle Blooms Network emblem"/></div><p class="eyebrow">Every Child Counts®</p><h2 id="aba-next-title">Start with one everyday moment that matters.</h2><p>Tell us what happens and what you hope can become easier. We’ll listen, help identify a suitable first professional conversation and explain the next step before you decide.</p><div class="final-actions"><a class="button white" href={phone.href} data-cta="aba-final-call"><Icon name="phone"/>Call {phone.display}</a><a class="button light-outline" href="#centres" data-cta="aba-final-centres">Find a centre <Icon name="arrow"/></a><a class="button light-outline" href={abaEnquiry} data-cta="aba-final-enrol">Begin enrolment <Icon name="arrow"/></a></div><p class="final-guidance">Free, staffed telephone guidance 24/7. Ordinary network call charges may apply. Centre visits and therapy have separately confirmed fees.</p><div class="aba-share-actions"><a href={whatsappShare} target="_blank" rel="noopener noreferrer" data-cta="aba-share-whatsapp">Share this page on WhatsApp ↗</a><button type="button" data-aba-share hidden>Share with family</button><button type="button" data-aba-copy hidden>Copy page link</button><p data-aba-share-status role="status" aria-live="polite"></p></div><a class="helpline-link" href={url('/national-autism-helpline')}>Pinnacle / BHCL National Autism Helpline →</a></div></section>
<script>
  const shareButton=document.querySelector<HTMLButtonElement>('[data-aba-share]');
  const copyButton=document.querySelector<HTMLButtonElement>('[data-aba-copy]');
  const status=document.querySelector<HTMLElement>('[data-aba-share-status]');
  const pageUrl=document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href||location.href;
  if(shareButton&&navigator.share){shareButton.hidden=false;shareButton.addEventListener('click',async()=>{try{await navigator.share({title:'ABA Therapy for Everyday Life | Pinnacle Blooms',url:pageUrl});}catch(error){if((error as Error).name!=='AbortError'&&status)status.textContent='Use the WhatsApp link or copy the page link.';}});}
  if(copyButton&&navigator.clipboard){copyButton.hidden=false;copyButton.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(pageUrl);if(status)status.textContent='Page link copied.';}catch{if(status)status.textContent='Copy was unavailable. Use the WhatsApp link.';}});}
</script>
</PageLayout>

<style>
.aba-review-grid>div>.eyebrow{color:#f5d8f0}
.aba-team .split-heading p a{text-decoration:underline;text-underline-offset:4px}
.aba-visit-expectation{display:grid;grid-template-columns:32px minmax(0,1fr);gap:18px;padding:25px 0;border-top:1px solid #e5dce7;color:#233453}
.aba-visit-expectation h3{font-size:1.2rem;margin:0 0 9px}.aba-visit-expectation p{font-size:1rem;line-height:1.8;margin:0}
.aba-next-decision{margin-top:30px;padding:30px;border:1px solid #c7ddd9;border-left:5px solid #08796e;border-radius:18px;background:#fff}
.aba-next-decision>h3{font-size:clamp(1.35rem,2.3vw,1.8rem);line-height:1.45;max-width:850px}.aba-next-decision>h3 em{font-style:normal;color:#08796e}.aba-next-decision>p:last-child{font-size:.96rem;line-height:1.8;margin:18px 0 0}
.aba-review-branches{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:24px}
.aba-review-branches article{border-top:2px solid #8f2879;padding-top:18px;min-width:0}.aba-review-branches h4{font-size:1.08rem;line-height:1.5;margin:10px 0}.aba-review-branches p{font-size:.95rem;line-height:1.8;margin:0}
.aba-stage-grid .text-link{font-size:.88rem;display:inline-flex;align-items:center;gap:7px;margin-top:14px;text-decoration:underline;text-underline-offset:4px}
@media(max-width:620px){.aba-review-branches{grid-template-columns:1fr;gap:22px}.aba-next-decision{padding:22px 18px}.aba-visit-expectation{gap:12px}}
</style>
