---
import PinnacleWaveExperience from '../components/PinnacleWaveExperience.astro';
import ReadinessPage from '../components/ReadinessPage.astro';
import {pinnacleWave} from '../data/pinnacleai-wave';
import PolicyPage from '../components/PolicyPage.astro';
import policies from '../data/policy-presentation';
import institutional from '../data/institutional-content.json';
import InstitutionalPage from '../components/InstitutionalPage.astro';
export function getStaticPaths(){return [...pinnacleWave.filter(page=>page.slug!=='abilityscore').map(page=>({params:{slug:page.slug},props:{page,kind:'wave'}})),...policies.map(page=>({params:{slug:page.slug},props:{page,kind:'policy'}})),...institutional.map(page=>({params:{slug:page.slug},props:{page,kind:'institutional'}}))];}
const {page,kind}=Astro.props;
---
{kind==='policy'?<PolicyPage page={page}/>:kind==='institutional'?<InstitutionalPage page={page}/>:page.slug==='seven-readiness-indexes'?<ReadinessPage/>:<PinnacleWaveExperience page={page}/>}
