---
import PageLayout from '../layouts/PageLayout.astro';
import article from '../data/everyday-home-study-20261007.html?raw';
import social from '../assets/pinnacleai-everyday-social-20260930.png';
const description='Read Pinnacle’s published Everyday Therapy home integration study: methods, observations from 80 parents, results, limitations and proposed next steps.';
---
<PageLayout path="/everyday-therapy-home-study" label="Everyday Therapy home study" title="Everyday Therapy Home Integration Study | Pinnacle Blooms Network" description={description} shareImage={social} includeService={false} imageAlt="Everyday Therapy: meaningful practice in family life, Pinnacle Blooms Network." imageCaption="Everyday Therapy illustrated brand creative" updatedOn="2026-10-08" breadcrumbParent={{name:'Everyday Therapy',path:'/everyday-therapy'}}>
  <div class="study-page">
    <section class="study-context" aria-label="How to read this study">
      <p class="eyebrow">PinnacleAI® · Published study summary</p>
      <p class="study-intro">How does guided practice become part of family life?</p>
      <p>This is Pinnacle’s published observational study summary, restored with its methods, results and limitations. Read the observations in their study context; they do not guarantee another child’s result.</p>
      <ul class="study-facts"><li><strong>80 parents</strong><span>Study participants</span></li><li><strong>3 months</strong><span>Observation period</span></li><li><strong>Observational</strong><span>Read the limitations below</span></li></ul>
      <div class="study-actions"><a href="tel:+919100181181" data-cta="study-call">Call 9100 181 181</a><a href="/everyday-therapy">Explore Everyday Therapy</a><a href="/verify/">Verify Pinnacle’s evidence</a></div>
    </section>
    <div set:html={article}></div>
    <aside class="study-source"><strong>Source and interpretation</strong><p>The article above retains the published text captured on 7 October 2026. The policy recommendations are proposals in that text. Naming an institution does not establish its endorsement or adoption.</p><p>Discuss an assessment, a child-specific plan and how progress will be reviewed. <a href="/enroll-autism-speech-aba-therapies-india">Arrange a first conversation</a>.</p></aside>
  </div>
</PageLayout>
<style>
  .study-page{max-width:1050px;margin:auto;padding:clamp(24px,5vw,64px) 22px;color:#193357;font-size:18px;line-height:1.75}.study-context{padding-bottom:32px;border-bottom:1px solid #dce7ed;margin-bottom:40px}.eyebrow{font-size:14px;color:#8f2879;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.study-intro{font-size:clamp(29px,4vw,44px);font-weight:700;line-height:1.2}.study-facts{display:grid;grid-template-columns:repeat(3,1fr);padding:0;list-style:none;gap:16px}.study-facts li{border-left:4px solid #008b95;background:#f3fafb;padding:14px}.study-facts strong,.study-facts span{display:block}.study-facts strong{font-size:24px}.study-actions{display:flex;flex-wrap:wrap;gap:14px}.study-actions a{padding:12px 16px;border:1px solid #8f2879;border-radius:12px;color:#8f2879;font-weight:700;text-decoration:none}.study-actions a:first-child{color:#fff;background:#8f2879}.study-source{padding:24px;margin-top:36px;border-left:4px solid #8f2879;background:#faf7fb}.study-page :global(.published-study h1){font-size:clamp(28px,4vw,42px);line-height:1.25;color:#193357}.study-page :global(.published-study h2){font-size:28px;margin-top:36px;color:#006d76;line-height:1.3}.study-page :global(.published-study h3){font-size:22px;margin-top:28px;line-height:1.4}.study-page :global(.published-study img){display:block;width:100%;height:auto;margin:28px auto;border-radius:20px}.study-page :global(.study-table){max-width:100%;overflow-x:auto;margin:24px 0}.study-page :global(table){border-collapse:collapse;width:100%;font-size:16px}.study-page :global(th),.study-page :global(td){padding:12px;border:1px solid #dce7ed;text-align:left}.study-page :global(th){background:#f1f7f9}.study-page :global(a){color:#842174}.study-page :global(blockquote){margin:24px 0;padding:16px 24px;border-left:4px solid #008b95;background:#f3fafb}.study-page :global(section){margin-bottom:30px}@media(max-width:560px){.study-facts{grid-template-columns:1fr}.study-facts li{padding:12px 16px}.study-page{padding-bottom:96px}.study-actions a{min-height:48px}}
</style>
