---
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import lockup from '../assets/pinnacle-blooms-network-lockup.png';
import policies from '../data/policy-presentation';
import '../styles/policy-pages.css';
const origin='https://www.pinnacleblooms.org';
const groups=['Your care and payments','Your information','Using our website','Help and accountability'];
const graph=[{'@type':'CollectionPage','@id':origin+'/policies#collection',name:'Pinnacle policies and your rights',url:origin+'/policies',dateModified:'2026-10-01',hasPart:policies.map(page=>({'@type':'WebPage',name:page.label,url:origin+page.path}))},{'@type':'ItemList','@id':origin+'/policies#list',numberOfItems:policies.length,itemListElement:policies.map((page,i)=>({'@type':'ListItem',position:i+1,name:page.label,url:origin+page.path}))}];
---
<PageLayout title="Policies & Your Rights | Pinnacle Blooms Network" description="Find Pinnacle’s 15 policies on care, payments, privacy, children, website use and ethical conduct. Contact our team or named privacy grievance officer." path="/policies" label="Policies" shareImage={lockup} shareFit="contain" imageAlt="Pinnacle Blooms Network official emblem and wordmark" includeService={false} documentOnly={true} updatedOn="2026-10-01" entityGraph={graph}>
 <section class="wrap policy-hub-hero"><p class="eyebrow">Pinnacle Blooms Network · Bharath Healthcare Laboratories Private Limited</p><h1>Clear policies.<br/><em>Confident choices.</em></h1><p>Understand your choices before you enquire, share information, book care or make a payment. Find the policy you need, with its own permanent page and a plain reading version.</p><div class="policy-hub-actions"><a href="tel:+919100181181"><Icon name="phone"/>9100 181 181</a><a href="mailto:care@pinnacleblooms.org"><Icon name="mail"/>care@pinnacleblooms.org</a></div><p class="policy-hub-small">Effective 1 October 2026 · 15 policy documents · Free telephone guidance is separate from paid services and centre appointments.</p></section>
 <nav class="wrap policy-group-nav" aria-label="Policy categories">{groups.map((group,i)=><a href={'#policy-group-'+i}>{group}<Icon name="arrow" size={18}/></a>)}</nav>
 <div class="wrap policy-hub-groups">{groups.map((group,i)=><section id={'policy-group-'+i}><h2>{group}</h2><div class="policy-hub-grid">{policies.filter(page=>page.group===group).map(page=><a class="policy-hub-card" href={page.path}><span class="policy-hub-icon"><Icon name={page.icon} size={32}/></span><h3>{page.label}</h3><p>{page.summary}</p><span class="policy-hub-read">Read the policy <Icon name="arrow" size={19}/></span></a>)}</div></section>)}</div>
 <section class="wrap policy-hub-help"><div><p class="eyebrow">A named privacy contact</p><h2>Need help with your information?</h2><p><strong>Mr. Gokul Krishna Rao</strong><br/>Privacy Grievance Officer · Bharath Healthcare Laboratories Private Limited</p><p>Email <a href="mailto:care@pinnacleblooms.org?subject=Privacy%20request%20%E2%80%94%20Grievance%20Officer">care@pinnacleblooms.org</a> with the subject “Privacy request — Grievance Officer”. Keep your sent email and include only the information needed to explain the request.</p><a href="/privacy-policy#policy-section-6">Your choices and privacy requests →</a></div><div><Icon name="shield" size={42}/><h3>DPDP: a phased transition.</h3><p>Our Privacy Policy distinguishes the rules applicable today from the main DPDP requirements scheduled for May 2027. A policy page alone does not establish implemented compliance.</p><a href="/privacy-policy#policy-section-7">Read the dated legal position →</a></div></section>
 <section class="wrap policy-hub-reading"><h2>Read, share or refer back.</h2><p>Each policy keeps its own URL. Share the relevant policy or section, and use its dated edition when referring to a booking, request or concern. Applicable statutory rights remain available.</p><a href="/pinnacle-pages-data/policies-policy.md">Plain reading directory</a> · <a href="/pinnacle-pages-data/policies-policy-source.json">Policy directory and editions</a> · <a href="/contact-information">Contact and grievance information</a></section>
</PageLayout>
