---
import BookPlayPurchase from '../../../../components/BookPlayPurchase.astro';
import PageLayout from '../../../../layouts/PageLayout.astro';
import BookCart from '../../../../components/BookCart.astro';
import books from '../../../../data/book-locales.json';
import copy from '../../../../data/book-merchant-editions.json';
import '../../../../styles/book-languages.css';
export function getStaticPaths(){return copy.map(presentation=>({params:{locale:presentation.locale,slug:presentation.slug},props:{presentation,book:books.find(b=>b.sku===presentation.sku)}}));}
const {presentation:p,book:b}=Astro.props,origin='https://www.pinnacleblooms.org';
const language=b.locale==='hi'?'Hindi':'Telugu';
const related=copy.filter(q=>q.locale===b.locale&&q.sku!==b.sku).map(q=>({...q,book:books.find(v=>v.sku===q.sku)}));
const full=related.find(q=>q.book.bookCount===4)||{path:p.path};
const faqs=[{question:'What language are the books in?',answer:`All ${b.bookCount} included PDF ${b.bookCount===1?'book is':'books are'} in ${language}. This information page is in English. Preview the actual ${language} pages before buying.`},{question:'How will I receive my ebooks?',answer:p.delivery_copy_when_enabled+' Enter the email address you want to use at checkout. Keep the order email to return to your downloads.'},{question:'Can I order a printed copy?',answer:'Softcover and hardbound editions are currently out of stock. This purchase includes PDF files only.'},{question:'Who is this book for?',answer:'Parents, caregivers and educators sharing everyday learning with children. Choose ideas that suit the child’s interests, development, comfort and access. This is general education; individual support decisions belong with the child’s professional team.'}];
const graph=[{'@type':b.bookCount===1?['Book','Product']:'Product','@id':origin+p.path+'#product',name:p.title,description:p.short_description,url:origin+p.path,sku:b.sku,brand:{'@id':origin+'/verify/#pinnacle-brand'},image:[origin+b.front,...(b.back?[origin+b.back]:[])],inLanguage:b.language,...(b.bookCount===1?{bookFormat:'https://schema.org/EBook',numberOfPages:45,author:b.authors.map(name=>({'@type':'Person',name,url:origin+'/leadership'})),publisher:{'@type':'Organization',name:'Pinnacle Blooms Network'}}:{}),offers:{'@type':'Offer',price:b.price,priceCurrency:'INR',availability:'https://schema.org/'+(b.available?'InStock':'OutOfStock'),itemCondition:'https://schema.org/NewCondition',url:origin+p.path}}];
---
<PageLayout title={p.seo_title} description={p.seo_description} path={p.path} label={p.title} contentLanguage="en-IN" shareStatic={b.front} imageAlt={p.title} documentOnly={true} includeService={false} primaryEntityId={origin+p.path+'#product'} entityGraph={graph} faqs={faqs} breadcrumbParent={{name:'Pinnacle books',path:'/books'}}>
<BookCart locale="en" collectionPath={full.path} samplesPath="#preview"/>
<article class="pbn-native">
<section class="pbn-native-wrap pbn-native-product"><div class="pbn-native-cover"><img src={b.front} alt={p.title} width="1492" height="1054" fetchpriority="high"/>{b.back&&<details><summary>Explore the back cover</summary><img src={b.back} alt={p.title+' — back cover'} width="1492" height="1054" loading="lazy"/></details>}</div><div><p class="pbn-native-kicker">Pinnacle Blooms Network · {p.edition_label} · PDF ebook</p><h1>{p.headline}</h1><h2>{p.title}</h2><p class="pbn-native-intro">{p.short_description}</p><p>{p.subtitle}</p><p class="pbn-native-authors">By <a href="/leadership">{p.authors.join(' & ')}</a></p><div class="pbn-native-offer"><span>{p.edition_label} · {b.bookCount} PDF {b.bookCount===1?'book':'books'}</span><strong>₹{b.price.toLocaleString('en-IN')}</strong>{b.saving>0&&<p>Save ₹{b.saving} compared with buying the ebooks separately.</p>}<button class="pbn-native-button" type="button" disabled data-book-sku={b.available?b.sku:undefined} data-book-price={b.price}>{b.available?'Buy the '+p.edition_label:'Ebook being prepared'}</button><p>{b.available?p.delivery_copy_when_enabled:'Read the sample or contact Pinnacle while this edition is prepared.'}</p><p>{p.format_disclosure}</p></div>{b.bookCount===1&&<BookPlayPurchase bookKey={b.bookKeys[0]} locale={b.locale} contentLocale="en"/>}<div class="pbn-native-actions"><a href="#preview">Preview the actual pages ↓</a><a href={b.path}>{p.native_page_label} ↗</a></div></div></section>
<section id="preview" class="pbn-native-wrap pbn-native-section"><h2>See the pages. Choose with confidence.</h2><p>{p.preview_copy}</p><div class="pbn-native-grid">{p.included_books.map(member=><article class="pbn-native-card"><img src={member.cover_url} alt={member.title_english+' — '+p.edition_label} width="1492" height="1054" loading="lazy"/><h3>{member.title_english}</h3><p>{member.discipline_english} · {language} · 45 pages</p><a class="pbn-native-button" href={member.sample_url} target="_blank" rel="noopener">Read the {language} sample ↗</a></article>)}</div></section>
<section class="pbn-native-wrap pbn-native-section"><h2>What comes with your purchase</h2>{p.description.split('\n\n').map(paragraph=><p>{paragraph}</p>)}<div class="pbn-native-formats"><div><h3>{language} PDF {b.bookCount===1?'ebook':'collection'}</h3><strong>₹{b.price.toLocaleString('en-IN')}</strong><p>{b.available?'Download after successful payment.':'Being prepared.'}</p></div><div><h3>Softcover</h3><strong>₹{b.price.toLocaleString('en-IN')}</strong><p>Out of stock</p></div><div><h3>Hardbound</h3><strong>₹{b.hardPrice.toLocaleString('en-IN')}</strong><p>Out of stock</p></div></div></section>
<section id="questions" class="pbn-native-wrap pbn-native-section"><h2>Before you choose</h2>{faqs.map(q=><details><summary>{q.question}</summary><p>{q.answer}</p></details>)}</section>
<section class="pbn-native-wrap pbn-native-section"><h2>More ways to build your {language} library</h2><div class="pbn-native-grid pbn-native-grid-pairs">{related.map(item=><article class="pbn-native-card"><a href={item.path}><img src={item.book.front} alt={item.title} width="1492" height="1054" loading="lazy"/><h3>{item.title}</h3></a><p>{item.book.bookCount} PDF {item.book.bookCount===1?'book':'books'} · {language}</p><div class="pbn-native-price"><strong>₹{item.book.price.toLocaleString('en-IN')}</strong></div><a class="pbn-native-button" href={item.path}>Explore this edition →</a></article>)}</div></section>
<section class="pbn-native-wrap pbn-native-help"><div><h2>A question before you choose?</h2><p>Tell Pinnacle which {language} book interests you. We can help you find the sample, understand the format and choose a collection.</p><p>{p.institutional_evidence_copy}</p><a href="/verify/">Explore Pinnacle Verify ↗</a> · <a href="/pinnacleai">PinnacleAI ↗</a></div><div><a class="pbn-native-button" href="tel:+919100181181">Call 9100 181 181 ↗</a><a class="pbn-native-sample" href={'https://wa.me/919100181181?text='+encodeURIComponent('Hello Pinnacle, I am interested in '+p.title+': '+origin+p.path)} target="_blank" rel="noopener">Ask on WhatsApp ↗</a><p><a href="/refund-policy">Refund policy</a> · <a href="/privacy-policy">Privacy</a></p></div></section>
</article></PageLayout>
