---
import BookStoreChoices from '../../../components/BookStoreChoices.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import BookCart from '../../../components/BookCart.astro';
import BookLanguageNav from '../../../components/BookLanguageNav.astro';
import NativeBookCard from '../../../components/NativeBookCard.astro';
import editions from '../../../data/book-locales.json';
import '../../../styles/book-languages.css';
export function getStaticPaths(){return editions.map(book=>({params:{locale:book.locale,slug:book.slug},props:{book}}));}
const {book}=Astro.props,u=book.ui,origin='https://www.pinnacleblooms.org';
const related=editions.filter(b=>b.locale===book.locale&&b.path!==book.path&&(book.bookCount===1?b.bookCount>1&&b.bookKeys.includes(book.bookKeys[0]):b.bookCount===1&&book.bookKeys.includes(b.bookKeys[0])));
const alternates=[{language:'en-IN',path:book.englishPath},...editions.filter(b=>b.englishPath===book.englishPath).map(b=>({language:b.language,path:b.path})),{language:'x-default',path:book.englishPath}];
const graph=[{'@type':book.bookCount===1?['Book','Product']:'Product','@id':origin+book.path+'#product',name:book.title,description:book.shortDescription,url:origin+book.path,sku:book.sku,brand:{'@id':origin+'/verify/#pinnacle-brand'},image:[origin+book.front,...(book.back?[origin+book.back]:[])],inLanguage:book.language,...(book.bookCount===1?{bookFormat:'https://schema.org/EBook',numberOfPages:46,author:book.authors.map(name=>({'@type':'Person',name,url:origin+'/leadership'})),publisher:{'@type':'Organization',name:'Pinnacle Blooms Network',url:origin+'/books'}}:{}),offers:{'@type':'Offer',price:book.price,priceCurrency:'INR',availability:'https://schema.org/'+(book.available?'InStock':'OutOfStock'),itemCondition:'https://schema.org/NewCondition',url:origin+book.path}}];
---
<PageLayout title={book.seoTitle} description={book.seoDescription} path={book.path} label={book.title} contentLanguage={book.language} languageAlternates={alternates} shareStatic={book.front} imageAlt={book.title} documentOnly={true} includeService={false} primaryEntityId={origin+book.path+'#product'} entityGraph={graph} faqs={book.faqs} breadcrumbParent={{name:u.shop,path:'/books/'+book.locale}}>
<BookCart locale={book.locale}/><BookLanguageNav englishPath={book.englishPath} locale={book.locale} label={u.language}/>
<p class="pbn-native-wrap"><a href={"/books/editions/"+book.locale+"/"+book.slug}>English product details · {book.locale==='hi'?'Hindi':'Telugu'} edition ↗</a></p>
<article class:list={['pbn-native','pbn-native-'+book.locale]} lang={book.language}>
<section class="pbn-native-wrap pbn-native-product"><div class="pbn-native-cover"><img src={book.front} alt={book.title+' · '+u.name} width="1492" height="1054" fetchpriority="high"/>{book.back&&<details><summary>{book.locale==='hi'?'पिछला कवर देखें':'వెనుక కవర్ చూడండి'}</summary><img src={book.back} alt={book.title+' · back cover'} width="1492" height="1054" loading="lazy"/></details>}</div><div><p class="pbn-native-kicker">Pinnacle Blooms Network · {u.name} · 101</p><h1>{book.title}</h1><p class="pbn-native-intro">{book.subtitle}</p><p>{book.shortDescription}</p><p class="pbn-native-authors">{u.authors}<br/><a href="/leadership">{book.authors.join(' & ')}</a></p><div class="pbn-native-offer"><span>{u.name} · {book.bookCount} · {u.pdf}</span><strong>₹{book.price.toLocaleString('en-IN')}</strong>{book.saving>0&&<p>{u.save} ₹{book.saving}</p>}<button class="pbn-native-button" type="button" disabled data-book-sku={book.available?book.sku:undefined} data-book-price={book.price}>{book.available?u.buy:u.ready}</button><p>{book.available?u.delivery:u.helpText}</p></div><BookStoreChoices sku={book.sku} locale={book.locale}/><div class="pbn-native-actions"><a href="#preview">{u.preview} ↓</a><a href="tel:+919100181181">9100 181 181 ↗</a><a href={u.helplineUrl}>{u.helpline} ↗</a></div></div></section>
<section id="preview" class="pbn-native-wrap pbn-native-section"><h2>{u.look}</h2><p>{u.lookText}</p><div class="pbn-native-grid">{book.members.map(member=><article class="pbn-native-card"><a href={member.sample} target="_blank" rel="noopener"><img src={member.front} alt={member.title} width="1492" height="1054" loading="lazy"/><h3>{member.title}</h3></a><a class="pbn-native-button" href={member.sample} target="_blank" rel="noopener">{u.preview} ↗</a></article>)}</div></section>
<section class="pbn-native-wrap pbn-native-section pbn-native-detail"><h2>{book.bookCount===1?u.contents:u.included}</h2><p>{book.description}</p><p>{u.note}</p>{book.members.map(member=><details open={book.bookCount===1}><summary>{member.title}</summary><ol class="pbn-native-contents">{member.contents.map(page=><li>{page.title}</li>)}</ol></details>)}</section>
<section class="pbn-native-wrap pbn-native-section"><h2>{u.format}</h2><div class="pbn-native-formats"><div><h3>{u.pdf}</h3><strong>₹{book.price.toLocaleString('en-IN')}</strong><p>{book.available?u.delivery:u.ready}</p></div><div><h3>{u.soft}</h3><strong>₹{book.price.toLocaleString('en-IN')}</strong><p>{u.out}</p></div><div><h3>{u.hard}</h3><strong>₹{book.hardPrice.toLocaleString('en-IN')}</strong><p>{u.out}</p></div></div></section>
<section id="questions" class="pbn-native-wrap pbn-native-section"><h2>{u.question}</h2>{book.faqs.map(q=><details><summary>{q.question}</summary><p>{q.answer}</p></details>)}</section>
<section class="pbn-native-wrap pbn-native-section"><h2>{book.bookCount===1?u.pairs:u.included}</h2><div class="pbn-native-grid pbn-native-grid-pairs">{related.map(item=><NativeBookCard book={item}/>)}</div></section>
<section class="pbn-native-wrap pbn-native-help"><div><h2>{u.help}</h2><p>{u.helpText}</p><p class="pbn-native-scope">{u.scope}</p><a href="https://www.pinnacleblooms.org/verify">{u.verify} ↗</a> · <a href="/pinnacleai">PinnacleAI ↗</a></div><div><a class="pbn-native-button" href="tel:+919100181181">{u.call} · 9100 181 181 ↗</a><a class="pbn-native-sample" href={'https://wa.me/919100181181?text='+encodeURIComponent('Hello Pinnacle, I am interested in '+book.title+' ('+u.name+'): '+origin+book.path)} target="_blank" rel="noopener">{u.whatsapp} ↗</a><a href={'/books/'+book.locale}>{u.allBooks} →</a><p><a href="/books/refund-and-delivery-policy">Refund policy</a> · <a href="/privacy-policy">Privacy</a></p></div></section>
</article></PageLayout>
