---
import PageLayout from '../../../layouts/PageLayout.astro';
import BookCart from '../../../components/BookCart.astro';
import BookLanguageNav from '../../../components/BookLanguageNav.astro';
import NativeBookCard from '../../../components/NativeBookCard.astro';
import editions from '../../../data/book-locales.json';
import '../../../styles/book-languages.css';
export function getStaticPaths(){return ['hi','te'].map(locale=>({params:{locale}}));}
const {locale}=Astro.params;
const books=editions.filter(b=>b.locale===locale),u=books[0].ui,all=books.find(b=>b.bookCount===4)!;
const origin='https://www.pinnacleblooms.org',path='/books/'+locale;
const alternates=[{language:'en-IN',path:'/books'},{language:'hi-IN',path:'/books/hi'},{language:'te-IN',path:'/books/te'},{language:'x-default',path:'/books'}];
const graph=[{'@type':'ItemList',name:u.shop,numberOfItems:books.length,itemListElement:books.map((b,i)=>({'@type':'ListItem',position:i+1,name:b.title,url:origin+b.path}))}];
---
<PageLayout title={u.shop+' | Pinnacle 101'} description={u.intro+' '+u.note} path={path} label={u.shop} contentLanguage={locale+'-IN'} languageAlternates={alternates} shareStatic={all.front} imageAlt={u.all} documentOnly={true} includeService={false} entityGraph={graph}>
<BookCart locale={locale}/><BookLanguageNav locale={locale} label={u.language}/>
<article class:list={['pbn-native','pbn-native-'+locale]} lang={locale+'-IN'}>
<section class="pbn-native-wrap pbn-native-library"><div><p class="pbn-native-kicker">Pinnacle Blooms Network · {u.name} · 101</p><h1>{u.headline}</h1><p class="pbn-native-intro">{u.intro}</p><div class="pbn-native-actions"><a class="pbn-native-button" href="#singles">{u.single} ↗</a><a href="#collections">{u.all} ↓</a></div><div class="pbn-native-values"><span>1 · ₹799</span><span>2 · ₹1,399</span><span>4 · ₹2,499</span></div></div><img src={all.front} alt={u.all} width="1600" height="1160" fetchpriority="high"/></section>
{[{count:1,id:'singles',title:u.single},{count:2,id:'pairs',title:u.pairs},{count:4,id:'collections',title:u.all}].map(group=><section id={group.id} class="pbn-native-wrap pbn-native-section"><h2>{group.title}</h2><div class:list={['pbn-native-grid',{'pbn-native-grid-pairs':group.count===2}]}>{books.filter(b=>b.bookCount===group.count).map(book=><NativeBookCard book={book}/>)}</div></section>)}
<section class="pbn-native-wrap pbn-native-help"><div><h2>{u.help}</h2><p>{u.helpText}</p><p>{u.note}</p></div><div><a class="pbn-native-button" href="tel:+919100181181">{u.call} · 9100 181 181 ↗</a><a class="pbn-native-sample" href={'https://wa.me/919100181181?text='+encodeURIComponent('Hello Pinnacle, please help me choose a '+u.name+' 101 book or collection.')} target="_blank" rel="noopener">{u.whatsapp} ↗</a><a href="/verify/">{u.verify} ↗</a></div></section>
</article></PageLayout>
