---
import BookCart from '../../components/BookCart.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import books from '../../data/book-catalog.json';
import type { ImageMetadata } from 'astro';
import '../../styles/book-pages.css';
export function getStaticPaths(){return books.map(book=>({params:{slug:book.slug},props:{book}}));}
const {book}=Astro.props;
const origin='https://www.pinnacleblooms.org';
const images=import.meta.glob<ImageMetadata>('../../assets/books/*.{png,jpg}',{eager:true,import:'default'});
const covers=Object.fromEntries(Object.entries(images).map(([p,image])=>[p.split('/').pop()!.replace(/\.(png|jpg)$/,''),image]));
const siblings=books.filter(x=>x.groupKey===book.groupKey);
const ebook= siblings.find(x=>!x.physical)!;
const collectionOffers=books.filter(x=>x.bundle&&x.formatCode===book.formatCode&&(book.bundle?x.bookCount>book.bookCount:x.memberKeys.includes(book.bookKey)));
const editionName=(x:any)=>!x.physical?(x.bundle?x.bookCount+'-ebook collection (PDF)':'Ebook (PDF)'):x.formatCode==='PB'?'Softcover':'Hardbound';
const members=books.filter(x=>!x.bundle&&x.formatCode===book.formatCode&&book.memberKeys.includes(x.bookKey));
const related=book.bundle?members:books.filter(x=>!x.bundle&&x.formatCode===book.formatCode&&x.bookKey!==book.bookKey);
const sampleFiles={speech:'speech',occupational:'ot',behaviour:'aba',learning:'special-education'};
const samplePages={speech:[5,15],occupational:[4,16],behaviour:[3,6],learning:[11,17]};
const sampleBase='/pinnacle-pages-assets/book-samples-sales-v2-20261002/';
const sampleUrl=(key:string)=>sampleBase+sampleFiles[key]+'-sample.pdf';
const sampleImage=(key:string,i:number)=>sampleBase+sampleFiles[key]+'-sample-'+(i+1)+'.jpg';
const saving=members.reduce((total,b)=>total+b.price,0)-book.price;
const money=(value:number)=>'₹'+value.toLocaleString('en-IN');
const title=book.bundle?book.feedTitle:book.title+' — '+book.discipline+' — '+book.format;
const graph=[{'@type':book.bundle?'Product':['Book','Product'],'@id':origin+book.path+'#product',name:title,description:book.shortDescription,url:origin+book.path,sku:book.sku,brand:{'@id':origin+'/verify/#pinnacle-brand'},image:[origin+book.front,...(book.back?[origin+book.back]:[])],...(book.bundle?{}:{inLanguage:'en-IN',bookFormat:'https://schema.org/'+(!book.physical?'EBook':book.sku.endsWith('-PB')?'Paperback':'Hardcover'),author:book.authors.map(name=>({'@type':'Person',name,url:origin+'/leadership'})),publisher:{'@type':'Organization',name:'Pinnacle Blooms Network',url:origin+'/books'}}),offers:{'@type':'Offer',price:book.price,priceCurrency:'INR',availability:'https://schema.org/'+(book.acceptOrders?'InStock':'OutOfStock'),itemCondition:'https://schema.org/NewCondition',url:origin+book.path}}];
---
<PageLayout title={title+' | Pinnacle Blooms Network'} description={book.shortDescription} path={book.path} label={book.title} shareImage={covers[book.assetId]} shareFit="contain" imageAlt={book.coverAlt} includeService={false} documentOnly={true} primaryEntityId={origin+book.path+'#product'} entityGraph={graph} breadcrumbParent={{name:'Parent books',path:'/books'}}>
 <BookCart />
 <article class="pbn-book-page">
  <div class="wrap pbn-book-crumb"><a href="/books">← All Pinnacle 101 books</a></div>
  <section class="wrap pbn-book-hero">
   <div class="pbn-book-art"><img src={book.front} alt={book.coverAlt} width={book.bundle?1600:1492} height={book.bookCount===2?650:book.bundle?1160:1054} fetchpriority="high" /><p>{book.bundle?book.bookCount+'-book collection':'Front cover · '+book.discipline}</p></div>
   <div class="pbn-book-intro"><p class="eyebrow">Pinnacle Blooms Network · {book.discipline}</p><h1>{book.title}</h1><p class="pbn-book-subtitle">{book.subtitle}</p><p class="pbn-book-hook">{book.hook}</p><p class="pbn-book-authors">By {book.authors.join(' & ')}</p>
    <nav class="pbn-book-formats" aria-label="Choose book format">{siblings.map(x=><a href={x.path} aria-current={x.sku===book.sku?'page':undefined}>{editionName(x)}<strong>{money(x.price)}</strong></a>)}</nav>
    <div class="pbn-book-offer"><p class="pbn-book-format">{book.format} · English</p><p class="pbn-book-price">{money(book.price)} <span>INR</span></p>{book.bundle&&<p class="pbn-book-saving">Save {money(saving)} compared with the individual listed editions.</p>}{book.physical?<button disabled>{book.statusText}</button>:<button type="button" class="pbn-add-to-cart" data-book-sku={book.sku} data-book-price={book.price} disabled>Add ebook to bag</button>}<p>{book.statusDetail}</p><p class="pbn-book-sku">Product ID: {book.sku}</p></div>
    <div class="pbn-book-actions"><a class="pbn-book-preview-button" href="#preview">{book.bundle?'Preview the included books':'Read the free sample'}</a><a href="#collections">{book.bundle?'Explore the complete collection':'Save with an ebook or book collection'} ↓</a></div>
    {!book.physical&&<p class="pbn-book-digital-note"><strong>{book.bookCount===1?'The complete 45-page ebook':book.bookCount+' complete ebooks'} · Full-colour PDF</strong><br/>Read on a phone, tablet or computer. For purchase assistance, <a href="tel:+919100181181">call 9100 181 181</a>. Select your ebook above and continue to secure checkout.</p>}
   </div>
  </section>
  {collectionOffers.length>0&&<section id="collections" class="wrap pbn-book-section pbn-book-bundle-choice"><p class="eyebrow">More books. Better value.</p><h2>{!book.physical?'Choose an ebook collection.':'Choose a book collection.'}</h2><p>{book.bundle?'Complete your Pinnacle 101 library.':'This book is also included in these collections.'} Each collection contains the complete books, in the edition you select.</p><div class="pbn-book-upsells">{collectionOffers.map(x=><a href={x.path}><img src={x.front} alt={x.coverAlt} width="1600" height={x.bookCount===2?650:1160} loading="lazy" /><span class="eyebrow">{x.bookCount===4?'Complete library':'Two-book collection'} · {editionName(x)}</span><h3>{x.title}</h3><strong>{money(x.price)}</strong><span class="pbn-book-saving">Save {money(x.memberKeys.reduce((sum,key)=>sum+(books.find(b=>!b.bundle&&b.bookKey===key&&b.formatCode===x.formatCode)?.price||0),0)-x.price)}</span><span>Explore this collection →</span></a>)}</div><p><a href="/books#collections">Compare every collection and format →</a></p></section>}
  <section id="preview" class="wrap pbn-book-section"><p class="eyebrow">Look inside · Free preview</p><h2>See the pages. Find your starting point.</h2><p>Each free sample includes the cover, two illustrated learning pages, a guide to the full book, Pinnacle’s credentials and the complete collection. Read it now—no sign-up needed.</p>{!book.bundle?<><div class="pbn-book-preview-grid">{samplePages[book.bookKey].map((page:number,i:number)=><figure><a href={sampleUrl(book.bookKey)} target="_blank" rel="noopener" aria-label={'Open six-page PDF sample: '+book.title}><img src={sampleImage(book.bookKey,i)} alt={book.contents.find(p=>p.page===page)?.title+' — sample learning page from '+book.title} width="1200" height="848" loading="lazy" /></a><figcaption>Learning page {page} · {book.contents.find(p=>p.page===page)?.title}</figcaption></figure>)}</div><div class="pbn-book-actions"><a class="pbn-book-preview-button" href={sampleUrl(book.bookKey)} target="_blank" rel="noopener">Open the six-page sample ↗</a><a href={sampleUrl(book.bookKey)} download>Download free sample PDF</a></div><p class="pbn-book-sample-note">The full book contains 31 core learning pages plus the PinnacleAI and Verify section. Choose the edition above to see its price and availability.</p></>:<div class="pbn-book-sample-list">{members.map(x=><article><h3>{x.title}</h3><p>{x.discipline}</p><a href={sampleUrl(x.bookKey)} target="_blank" rel="noopener">Read the six-page sample ↗</a></article>)}</div>}</section>
  <section id="inside" class="wrap pbn-book-section"><p class="eyebrow">Small moments. Useful possibilities.</p><h2>{book.bundle?(book.bookCount===2?'Two perspectives. More everyday possibilities.':'Four perspectives on everyday life.'):'A picture-led guide for everyday life.'}</h2><div class="pbn-book-description">{book.description.split('\n\n').map(p=><p>{p}</p>)}</div><ul class="pbn-book-features">{book.features.map(p=><li>{p}</li>)}</ul></section>
  {!book.bundle&&<section class="wrap pbn-book-section"><div class="pbn-book-section-heading"><div><p class="eyebrow">31 illustrated learning pages</p><h2>Find a useful place to begin.</h2><p>101 identifies the introductory volume. Choose pages for the child’s interests, comfort and access.</p></div></div><ol class="pbn-book-contents">{book.contents.map(p=><li>{p.title}</li>)}</ol></section>}
  {book.back&&<section class="wrap pbn-book-section pbn-book-back"><div><p class="eyebrow">Meet the book</p><h2>A clear purpose.<br/>A colourful way to share it.</h2><p>Full-colour landscape artwork, with an adult guiding the reading and selecting suitable ideas. The same nine-page PinnacleAI and Verify information section accompanies each volume.</p><p>Software licences and company evidence describe their named scopes. They do not certify this book or promise an individual outcome.</p><a href="/leadership">About the authors and Pinnacle’s leadership →</a></div><img src={book.back} alt={'Rear cover of '+book.title} width="1492" height="1054" loading="lazy" /></section>}
  {book.faqs.length>0&&<section class="wrap pbn-book-section pbn-book-faq"><p class="eyebrow">Before you choose</p><h2>Questions families ask.</h2>{book.faqs.map(q=><details><summary>{q.question}</summary><p>{q.answer}</p></details>)}</section>}
  <section class="wrap pbn-book-section"><h2>{book.bundle?'The books in this collection.':'Explore the other 101 books.'}</h2><div class="pbn-book-related">{related.map(x=><a href={x.path}><img src={x.front} alt={x.coverAlt} width="1492" height="1054" loading="lazy" /><h3>{x.title}</h3><p>{x.discipline} · {x.format}</p></a>)}</div></section>
  <section class="wrap pbn-book-section pbn-book-help"><div><p class="eyebrow">Connected to Pinnacle</p><h2>Explore the people, ideas and evidence.</h2><ul>{book.links.map(x=><li><a href={x.url}>{x.label}</a></li>)}</ul></div><div><h3>Book and edition enquiries</h3><p>Call <a href="tel:+919100181181">9100 181 181</a> or email <a href="mailto:care@pinnacleblooms.org">care@pinnacleblooms.org</a>.</p><p>PDF downloads are issued after successful payment. Printed editions are out of stock. Book editions do not include therapy sessions, assessments or software access.</p><a href="/payment-and-billing">Payment information</a> · <a href="/refund-policy">Refund policy</a> · <a href="/privacy-policy">Privacy</a></div></section>
 </article>
</PageLayout>
