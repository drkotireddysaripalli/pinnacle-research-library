---
import BookStoreChoices from '../../components/BookStoreChoices.astro';
import {paperbackForGroup,paperbackPanel} from '../../../deployment/book-paperback-links.mjs';
import {hardcoverForPath,hardcoverForGroup,hardcoverPanel,wrapHardcoverCard,hardcoverHubStock} from '../../../deployment/book-hardcover-links.mjs';
import {kindleForSku,kindleLinkStyle} from '../../../deployment/book-kindle-links.mjs';
import {FIRST_CONVERSATION_LINK} from '../../../deployment/first-conversation-links.mjs';
import BookLanguageNav from '../../components/BookLanguageNav.astro';
import BookCart from '../../components/BookCart.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import books from '../../data/book-catalog.json';
import collection from '../../assets/books/collection.png';
import '../../styles/book-pages.css';
const titles=books.filter(b=>!b.physical&&!b.bundle);
const sets=books.filter(b=>b.bookCount===4);
const pairs=books.filter(b=>b.bookCount===2&&b.formatCode==='PDF');
const completeEbooks=sets.find(b=>!b.physical)!;
const editionName=(b:any)=>!b.physical?(b.bundle?b.bookCount+' ebooks (PDF)':'Ebook (PDF)'):b.formatCode==='PB'?'Softcover':'Hardbound';
const sampleFiles={speech:'speech',occupational:'ot',behaviour:'aba',learning:'special-education'};
const graph=[{'@type':'ItemList',name:'Pinnacle 101 Parent Visual Library',numberOfItems:books.length,itemListElement:books.map((b,i)=>({'@type':'ListItem',position:i+1,name:b.feedTitle,url:'https://www.pinnacleblooms.org'+b.path}))}];
---
<PageLayout title="Pinnacle 101 Parent Books | Speech, OT, Behaviour & Learning" description="Explore Pinnacle Blooms Network books on speech, occupational therapy, ABA parent education and special education. Read samples and choose a 46-page PDF guide." path="/books" label="Parent books" shareImage={collection} languageAlternates={[{language:'en-IN',path:'/books'},{language:'hi-IN',path:'/books/hi'},{language:'te-IN',path:'/books/te'},{language:'x-default',path:'/books'}]} shareFit="contain" imageAlt="The four Pinnacle 101 parent book covers" includeService={false} documentOnly={true} entityGraph={graph}>
 <BookCart /><BookLanguageNav/>
 <article class="pbn-book-page"><section class="wrap pbn-book-library-hero"><p class="eyebrow">Pinnacle Blooms Network · Books & Ebook Collections</p><h1>Everyday moments.<br/><em>New possibilities.</em></h1><p>Four illustrated guides to communication, participation, understanding behaviour and learning through play. Choose one ebook, a two-book collection or the complete library.</p><p class="pbn-book-authors">By Dr. Koti Reddy Saripalli & Dr. Sreeja Reddy Saripalli</p><nav class="pbn-book-shop-shortcuts" aria-label="Explore ebooks and collections"><a href="#choose"><span>One complete ebook</span><strong>₹799</strong><span>Choose your book →</span></a><a href="#pairs"><span>Any two-book ebook collection</span><strong>₹1,399</strong><span>Explore six combinations →</span></a><a href={completeEbooks.path}><span>All four ebooks</span><strong>₹2,499</strong><span>Explore the complete library →</span></a></nav><p class="pbn-book-hero-formats">Full-colour PDF ebooks · Softcover books · Premium hardbound books</p><img src="/pinnacle-pages-assets/books-20261002/four-book-collection.png" alt="Front covers of all four Pinnacle 101 books" width="1600" height="1160" fetchpriority="high" /></section>
 <section id="choose" class="wrap pbn-book-section"><p class="eyebrow">Preview first. Choose your format.</p><h2>Choose the starting point that matters.</h2><p>Read a free six-page sample from each book: the cover, two learning pages and three pages to explore the complete book, Pinnacle’s credentials and the collection. Each complete 46-page PDF has 31 illustrated learning pages, nine shared PinnacleAI and Verify pages, a service page, covers, publication credits, a reading guide and a family reflection page.</p><div class="pbn-book-library-grid">{titles.map(b=><article><a href={b.path}><img src={b.front} alt={b.coverAlt} width="1492" height="1054" loading="lazy" /><p class="eyebrow">{b.discipline}</p><h3>{b.title}</h3></a><p>{b.shortDescription}</p><a class="pbn-book-preview-button" href={'/pinnacle-pages-assets/book-samples-sales-v2-20261002/'+sampleFiles[b.bookKey]+'-sample.pdf'} target="_blank" rel="noopener">Read the free six-page sample ↗</a><nav aria-label={b.title+' editions'}>{books.filter(x=>x.groupKey===b.groupKey).map(x=><a href={x.path}>{editionName(x)} · ₹{x.price.toLocaleString('en-IN')} →</a>)}{kindleForSku(b.sku)&&<a href={kindleForSku(b.sku)?.url} target="_blank" rel="noopener noreferrer" data-kindle-purchase={kindleForSku(b.sku)?.asin} style={kindleLinkStyle}>Buy on Amazon Kindle ↗</a>}</nav><BookStoreChoices sku={b.sku} compact={true}/></article>)}</div></section>
 <section id="collections" class="wrap pbn-book-section"><p class="eyebrow">The complete Pinnacle 101 library</p><h2>All four, together.</h2><p>Communication, everyday participation, understanding behaviour and early learning. Four complete books in your chosen format.</p><BookStoreChoices sku={completeEbooks.sku} compact={true}/><div class="pbn-book-sets">{sets.map(b=><Fragment set:html={`<a href="${b.path}"><h3>${editionName(b)}</h3><strong>₹${b.price.toLocaleString('en-IN')}</strong><p>${b.physical?'Out of stock':'Four complete PDF ebooks · Save ₹697'}</p><span>Explore the collection →</span></a>`}/>)}</div><p>Choose an ebook and continue to secure checkout. For purchase assistance, <a href="tel:+919100181181">call 9100 181 181</a>. {hardcoverHubStock}</p></section>
 <section id="pairs" class="wrap pbn-book-section"><p class="eyebrow">Six ebook collections · ₹1,399 each</p><h2>Two books. More everyday possibilities.</h2><p>Save ₹199 with any pair of complete ebooks. Every combination also comes as a softcover or hardbound set.</p><div class="pbn-book-pairs">{pairs.map(b=><article><a href={b.path}><img src={b.front} alt={b.coverAlt} width="1600" height="650" loading="lazy" /><h3>{b.title}</h3></a><p>{b.hook}</p><nav aria-label={b.title+' formats'}>{books.filter(x=>x.groupKey===b.groupKey).map(x=><a class={!x.physical?'pbn-book-pair-ebook':undefined} href={x.path}>{editionName(x)} · ₹{x.price.toLocaleString('en-IN')} →</a>)}</nav><BookStoreChoices sku={b.sku} compact={true}/></article>)}</div></section>
 <section class="wrap pbn-book-section pbn-book-help"><div><h2>Picture-led. Parent-guided.</h2><p>Choose ideas that fit the child’s development, preferences, comfort and access. 101 is a volume label, not an activity count. Educational books support shared exploration; individual care decisions need suitable professional advice.</p></div><div><h3>Connect with Pinnacle</h3><Fragment set:html={FIRST_CONVERSATION_LINK}/><p><a href="https://www.pinnacleblooms.org/national-autism-helpline">National Autism Helpline · 9100 181 181</a></p><p><a href="/pinnacleai">PinnacleAI</a> · <a href="https://www.pinnacleblooms.org/verify">Verify and evidence</a> · <a href="/leadership">The authors and leadership</a></p><p><a href="tel:+919100181181">9100 181 181</a> · <a href="mailto:care@pinnacleblooms.org">care@pinnacleblooms.org</a></p></div></section></article>
</PageLayout>
