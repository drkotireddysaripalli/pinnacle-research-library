---
import PageLayout from '../../../layouts/PageLayout.astro';
import ResourceActions from '../../../components/ResourceActions.astro';
import {url,phone} from '../../../data/site';
import previewImage from '../../../../public/books/resources/first-conversation-preview.jpg';
const path='/books/resources/first-conversation';
const pdf='/books/resources/Pinnacle-First-Conversation-v1.pdf';
const steps=[
 ['01','Choose one everyday moment','Choose one everyday moment you want to discuss.'],
 ['02','Start with what you notice','Note what you have observed and what seems to help.'],
 ['03','Bring your child’s perspective','Describe how your child communicates and what matters to them.'],
 ['04','Leave space for your questions','Write the questions you want to ask and the next step agreed during the conversation.']
];
const graph=[{'@type':'CreativeWork','@id':url(path)+'#planning-sheet',name:'Your first conversation — a free Pinnacle family planning sheet',url:url(path),version:'1.0',inLanguage:'en',isAccessibleForFree:true,datePublished:'2026-10-04',publisher:{'@id':url('/verify/#organization')},encoding:{'@type':'MediaObject',contentUrl:url(pdf),encodingFormat:'application/pdf',contentSize:'4165 bytes'},description:'One-page appointment-planning aid for private family observations and questions. Not a diagnostic or screening tool.'}];
---
<PageLayout path={path} label="First conversation" title="Free First Conversation Planning Sheet | Pinnacle Blooms" description="Prepare questions about your child’s communication, learning and everyday activities. Download Pinnacle’s free one-page English planning sheet, with no sign-in." documentOnly includeService={false} publishedOn="2026-10-04" updatedOn="2026-10-04" breadcrumbParent={{name:'Parent books & resources',path:'/books'}} shareImage={previewImage} shareFit="contain" imageAlt="The original one-page Pinnacle First Conversation planning sheet" imageCaption="Your first conversation · Free Pinnacle family resource" entityGraph={graph} primaryEntityId={url(path)+'#planning-sheet'} measurementScript="/books/resources/measurement-v1.js">
 <article class="first-conversation">
  <section class="wrap fc-hero" aria-labelledby="fc-title">
   <div>
    <p class="eyebrow">Pinnacle First Steps · Free family resource</p>
    <h1 id="fc-title">Prepare for a useful conversation <em>about your child.</em></h1>
    <p class="fc-intro">If you have questions about your child's communication, learning or everyday activities, it can help to put a few observations and questions on one page. This free Pinnacle sheet gives you space to describe what matters to your family before you speak with a professional or enquire about an appointment.</p>
    <a class="button primary fc-download" href={pdf} download data-cta="resource-download" data-resource="first_conversation_v1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 17v4h16v-4"/></svg>Download the free planning sheet <span>(English PDF, 1 page)</span></a>
    <p class="fc-private">Free to use · No sign-in · No personal details to upload</p>
   </div>
   <a class="fc-sheet" href={pdf} aria-label="Open the original one-page planning sheet"><img src="/books/resources/first-conversation-preview.jpg" width="893" height="1263" alt="Preview of the planning sheet: everyday moments, observations, communication and questions, with space for private notes." fetchpriority="high"/><span>See the one-page sheet ↗</span></a>
  </section>
  <section class="wrap fc-use" aria-labelledby="fc-use-title">
   <p class="eyebrow">Your observations. Your questions.</p><h2 id="fc-use-title">How to use it</h2>
   <ol class="fc-steps">{steps.map(([number,title,copy])=><li><span class="fc-number" aria-hidden="true">{number}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol>
   <p class="fc-note">Use only the sections that help. Keep completed notes private and share only what you wish to discuss. You do not need to upload personal details to use the sheet.</p>
  </section>
  <section class="wrap fc-support" aria-labelledby="fc-support-title"><div><p class="eyebrow">Speak with Pinnacle</p><h2 id="fc-support-title">Make the next conversation useful.</h2><p>Have questions about available support or an assessment appointment? Call Pinnacle's National Autism Helpline on <strong>+91 9100 181 181</strong>.</p><a class="button primary" href={phone.href} data-cta="final-call">Call {phone.display}</a><p><a href="/national-autism-helpline">Helpline service details →</a></p></div><div class="fc-scope"><h3>What this resource offers</h3><p>Pinnacle does not charge for helpline guidance. Assessment and therapy fees are separate; telephone-network charges depend on your plan.</p><p>The sheet is not a diagnostic or screening tool, and the helpline is not an emergency service.</p></div></section>
  <section class="wrap fc-source" aria-labelledby="fc-source-title"><h2 id="fc-source-title">Keep it. Share it. Start when you’re ready.</h2><p>Share this resource page with a family who may find it useful.</p><ResourceActions/><p>Prepared by Pinnacle Blooms Network. Read <a href="/verify/">Pinnacle identity and evidence</a> and <a href="/national-autism-helpline">helpline service details</a>.</p><p>Version 1.0 · 4 October 2026. This preparation sheet makes no diagnosis, treatment or efficacy claim.</p><p class="fc-citation">Suggested citation: Pinnacle Blooms Network. <em>Your first conversation: a free family planning sheet.</em> Version 1.0, 4 October 2026. <a href={url(path)}>View this resource</a>.</p><p><a href="/books">Explore parent books and samples →</a> · <a href="/speech-therapy/first-visit-guide">Preparing for a speech assessment →</a></p></section>
 </article>
</PageLayout>
<style>
 .first-conversation{background:#fff;color:#20375d}.fc-hero{display:grid;grid-template-columns:1.35fr .75fr;gap:4rem;align-items:center;padding-top:3.5rem;padding-bottom:3.5rem}.fc-hero h1{font-size:clamp(2rem,3.6vw,3.4rem);line-height:1.16;max-width:19ch;margin:1rem 0 1.5rem}.fc-hero h1 em{color:#8f2879;font-style:normal}.fc-intro{font-size:1.1rem;line-height:1.8}.fc-download{display:flex;flex-wrap:wrap;gap:.55rem;max-width:fit-content;margin-top:1.5rem}.fc-download svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:2}.fc-download span{font-size:.875rem}.fc-private{font-size:.9rem;color:#3e516b;margin-top:1rem}.fc-sheet{display:block;padding:1rem;background:#f8f7fa;border:1px solid #dfd5e1;border-radius:18px;box-shadow:0 16px 35px #182c5012;transform:rotate(1deg)}.fc-sheet img{display:block;width:100%;height:auto;border:1px solid #e2e2e2}.fc-sheet span{display:block;text-align:center;font-weight:700;color:#8f2879;margin-top:.7rem}.fc-use,.fc-source{padding-top:3rem;padding-bottom:3rem;border-top:1px solid #e6e4ea}.first-conversation h2{font-size:clamp(1.6rem,2.6vw,2.3rem);line-height:1.3}.first-conversation h3{font-size:1.15rem;line-height:1.4;margin:0 0 .5rem}.first-conversation p{line-height:1.75}.fc-steps{list-style:none;display:grid;grid-template-columns:1fr 1fr;padding:0;gap:1.4rem 2rem;margin:2rem 0}.fc-steps li{display:flex;gap:1rem;padding:1.2rem 0;border-top:3px solid #078f95}.fc-number{font-size:1.65rem;color:#8f2879;font-weight:700}.fc-steps p{margin:0}.fc-note{padding:1.2rem 1.5rem;border-left:4px solid #8f2879;background:#fbf8fc}.fc-support{display:grid;grid-template-columns:1.2fr 1fr;gap:3rem;padding:2.5rem;border-radius:20px;background:#f7fbfb;border:1px solid #d8ebea;margin-bottom:3rem}.fc-scope{border-left:3px solid #078f95;padding-left:1.5rem;align-self:center}.fc-citation{font-size:.95rem}.first-conversation a:not(.button):not(.fc-sheet){text-decoration:underline;text-underline-offset:.2em}.fc-source{max-width:900px;margin-bottom:2rem}@media(max-width:700px){.fc-hero{grid-template-columns:1fr;gap:2rem;padding-top:2rem;padding-bottom:2rem}.fc-sheet{max-width:330px;margin:auto;transform:none}.fc-steps{grid-template-columns:1fr;gap:.8rem}.fc-support{grid-template-columns:1fr;gap:1.5rem;padding:1.5rem;width:calc(100% - 2rem)}.fc-intro{font-size:1rem}.fc-download{font-size:.95rem;justify-content:center}.fc-source,.fc-use{padding-top:2rem;padding-bottom:2rem}}@media print{.fc-hero{display:block}.fc-sheet,.fc-download,.fc-private,.print-actions{display:none}.fc-support{break-inside:avoid}.first-conversation{color:#111}}
</style>
