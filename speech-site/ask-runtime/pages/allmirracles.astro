---
import {env} from 'cloudflare:workers';import KnowledgeLayout from '../../src/layouts/KnowledgeLayout.astro';import Pagination from '../../src/components/knowledge/Pagination.astro';import NextStep from '../../src/components/knowledge/NextStep.astro';import Icon from '../../src/components/Icon.astro';
import {data,ORIGIN,requestedPage,pageURL} from '../../src/lib/knowledge/catalogues';
const page=requestedPage(Astro.url.searchParams.get('page')),size=60;let manifest:any={},items:any[]=[],error=false,missing=false;
try{manifest=await data(env,'manifest');const total=manifest.mirraclesCount,start=(page-1)*size,end=Math.min(start+size,total);missing=page<1||start>=total;
 if(!missing){for(let chunk=Math.floor(start/1000);chunk<=Math.floor((end-1)/1000);chunk++){const rows=await data(env,'mirracles-'+chunk);items.push(...rows.slice(Math.max(0,start-chunk*1000),Math.min(1000,end-chunk*1000)));}}
}catch{error=true;}
const title='Mirracles: Pinnacle’s published progress stories'+(page>1?' · Page '+page:'')+' | Pinnacle Blooms Network',description='Browse Pinnacle Blooms Network’s published video and progress-story archive. Explore individual experiences, understand the evidence and discuss your child’s next step.',robots=error||missing?'noindex, follow':'index, follow, max-image-preview:large';
Astro.response.status=error?503:missing?404:200;Astro.response.headers.set('Cache-Control',error||missing?'private, no-store':'public, max-age=0, s-maxage=300');Astro.response.headers.set('X-Robots-Tag',robots);
const schema=[{'@type':'ItemList',name:'Mirracles published story archive',itemListElement:items.map((x,i)=>({'@type':'ListItem',position:(page-1)*size+i+1,name:x.title,url:ORIGIN+x.url}))}];
---
<KnowledgeLayout title={title} description={description} path={pageURL('/allmirracles',page)} schema={schema} reader={false} robots={robots} crumbs={[{name:'Mirracles',url:'/allmirracles'}]}>
 <header class="knowledge-hero"><p class="knowledge-kicker"><Icon name="video"/>Pinnacle Blooms Network · Mirracles</p><h1>{error?'The story archive is temporarily unavailable.':missing?'That page was not found.':'Moments of progress. A child’s life in view.'}</h1><p>Explore our published video and progress stories. Each child’s goals, support and experience are individual. Use the stories to shape your questions, then talk with us about what would be meaningful for your child.</p><div class="knowledge-actions"><a class="knowledge-primary" href="tel:+919100181181"><Icon name="phone"/>Call 9100 181 181</a><a href="/verify/">Explore the evidence <Icon name="arrow"/></a></div></header>
 {!missing&&!error&&<><p class="knowledge-caption">Published archive · {manifest.mirraclesCount.toLocaleString('en-IN')} story links. Individual records are not a prediction of another child’s result.</p><div class="knowledge-grid">{items.map((x,i)=><article class="knowledge-card"><a href={x.url}>{x.image&&<img src={x.image} alt="" width="400" height="225" loading="lazy" decoding="async"/>}<h2>{x.title}</h2><span class="knowledge-read"><Icon name="video"/>Open this story →</span></a></article>)}</div><Pagination base="/allmirracles" page={page} pages={Math.ceil(manifest.mirraclesCount/size)} total={manifest.mirraclesCount}/><NextStep/></>}
 {(missing||error)&&<p class="knowledge-empty"><a href="/allmirracles">Return to the story archive →</a></p>}
</KnowledgeLayout>
