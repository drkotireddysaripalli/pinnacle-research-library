---
// Public, identity-free assembly input for the portal video library. No user data.
import AskGate from '../../../src/components/ask/AskGate.astro';
import AskNavigation from '../../../src/components/ask/AskNavigation.astro';
import AskVerification from '../../../src/components/ask/AskVerification.astro';
import VernacularTypography from '../../../src/components/VernacularTypography.astro';
import ReaderJourney from '../../../src/components/knowledge/ReaderJourney.astro';
import measurement from '../../../public/pinnacle-pages-scripts/speech-measurement.js?url';
import '../../../src/styles/ask.css';
