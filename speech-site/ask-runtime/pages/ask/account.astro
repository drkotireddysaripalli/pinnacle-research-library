---
import {env} from 'cloudflare:workers';
import {context,safeReturn} from '../../../src/lib/ask/auth.mjs';
import {libraryReturn,readerSignInPath} from '../../../src/lib/reader-source.mjs';
// Compatibility destination only. Sign-in now lives on the reader's Ask page.
const c=context(Astro.request,env);
const target=new URL(safeReturn(Astro.url.searchParams.get('returnTo')||c.cookies.get('pinnacle-ask-return')),Astro.url.origin);
const status=Astro.url.searchParams.get('status');
if(libraryReturn(target.pathname+target.search+target.hash))return c.redirect(readerSignInPath(target.pathname+target.search+target.hash,status?(['wait','registration'].includes(status)?status:'sign-in'):null));
if(status)target.searchParams.set('ask_signin',['wait','registration'].includes(status)?status:'sign-in');
return c.redirect(target.pathname+target.search+target.hash);
---
