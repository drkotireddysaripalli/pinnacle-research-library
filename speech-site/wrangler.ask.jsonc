{
  "name": "pinnacle-ask",
  "main": "ask-runtime/worker.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/ask/*", "/faq*", "/sunshine*", "/allmirracles*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "KOSA_CACHE",
      "id": "d4401f15f2d04e399c3fdf617f7a529c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OG_BUCKET",
      "bucket_name": "pinnacle-ask-og"
    }
  ],
  "ratelimits": [{
    "name": "ASK_AUTH_RATE_LIMIT",
    "namespace_id": "202610030531",
    "simple": {"limit": 8, "period": 60}
  }],
  "vars": {
    "ASK_BASE": "/ask",
    "CANONICAL_ORIGIN": "https://pinnacleblooms.org",
    "ASK_AUTH_ENABLED": "true",
    "ASK_OAUTH_PROVIDERS": "google",
    "ASK_GOOGLE_CLIENT_ID": "562897376075-uk7a8vqmudls29rl46l96r6e5n92kn3o.apps.googleusercontent.com",
    "ASK_WHATSAPP_ENABLED": "true",
    "WATI_TENANT_ID": "531",
    "WATI_CHANNEL_NUMBER": "919100181181",
    "WATI_TEMPLATE_NAME": "code_template_pbn_v3",
    "WATI_OTP_PARAMETER_NAMES": "[\"1\"]"
  },
  "observability": {
    "enabled": false
  }
}
