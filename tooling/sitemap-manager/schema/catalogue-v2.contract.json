    "xsi:schemaLocation": "Optional validation hint consisting of namespace/schema URL pairs; no ranking benefit.",
    "declaration": {
      "version": "1.0",
      "encoding": "UTF-8",
      "standalone": "Optional XML infrastructure; not an SEO data attribute."
    },
    "rule": "Do not add arbitrary attributes to sitemap elements. Namespace declarations are infrastructure, not additional metadata fields."
  },
  "output_constants": {
    "index_root": "{http://www.sitemaps.org/schemas/sitemap/0.9}sitemapindex",
    "page_root": "{http://www.sitemaps.org/schemas/sitemap/0.9}urlset",
    "alternate_rel": "alternate"
  },
  "profile_validation_rules": {
    "file_limits": {
      "url_entries": 50000,
      "index_members": 50000,
      "uncompressed_bytes": 52428800,
      "image_children_per_parent": 1000,
      "news_children_per_file": 1000
    },
    "serialization": {
      "encoding": "UTF-8",
      "absolute_urls": true,
      "xml_escape_values": true,
      "DTD_external_entities": "forbidden",
      "schemaLocation": "optional_infrastructure"
    },
    "optional_unknown_values": {
      "store": null,
      "emit": false,
      "reason_required": true
    },
    "sparse_storage": "Register property definitions once; store values only when supplied. Do not allocate thousands of empty metadata rows per asset.",
    "page": {
      "priority": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "finite": true
      },
      "change_frequency": {
        "type": "string",
        "enum": [
          "always",
          "hourly",
          "daily",
          "weekly",
          "monthly",
          "yearly",
          "never"
        ]
      }
    },
    "video": {
      "required": [
        "thumbnail_rendition_id",
        "title",
        "description"
      ],
      "at_least_one": [
        "content_rendition_id",
        "player_url_id"
      ],
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "duration_seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 28800
      },
      "rating": {
        "type": "number",
        "minimum": 0,
        "maximum": 5,
        "finite": true
      },
      "view_count": {
        "type": "integer",
        "minimum": 0
      },
      "yes_no_fields": [
        "family_friendly",
        "requires_subscription",
        "live"
      ],
      "tags": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "uploader_name": {
        "type": "string",
        "maxLength": 255
      },
      "uploader_info_host": "same_as_parent_page",
      "country_relationship": {
        "enum": [
          "allow",
          "deny"
        ],
        "requires_nonempty_country_list": true
      },
      "countries": "ISO3166-1 alpha2 membership requires pinned production codebook",
      "platform_relationship": {
        "enum": [
          "allow",
          "deny"
        ],
        "requires_nonempty_platform_list": true
      },
      "platforms": {
        "type": "array",
        "minItems": 1,
        "items": {
          "enum": [
            "web",
            "mobile",
            "tv"
          ]
        }
      },
